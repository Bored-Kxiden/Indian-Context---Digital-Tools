---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import { componentById, type ComponentId } from '../data/components';
import { url } from '../utils/url';

// Placeholder for components that are not built yet. It says so plainly and points to
// the components that are ready. No invented content.

interface Props {
  component: ComponentId;
}

const comp = componentById[Astro.props.component];
const title = comp.number ? `${comp.number} · ${comp.name}` : comp.name;
---

<BaseLayout title={comp.name} description={comp.blurb} component={comp.c}>
  <div class="page-head">
    <div class="wrap">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Components', href: '/components/' }, { label: comp.short }]} />
      <div class="chip-row chips">
        <span class="chip chip--quiet">{comp.short}</span>
        <span class="chip chip--quiet">Coming next</span>
      </div>
      <h1>{title}</h1>
      <p class="lead">{comp.blurb}</p>
    </div>
  </div>
  <div class="wrap body">
    <div class="callout">
      <strong>This component isn’t on the site yet.</strong>
      <p>The toolkit is being built one component at a time. The other files are ready to use now.</p>
    </div>
    <p class="go">
      <a class="btn btn--accent" href={url('/components/')}>See what’s ready <Icon name="arrow" size={18} /></a>
      <a class="btn btn--outline" href={url('/components/#i-want-to')}>Find a tool by what you want to do</a>
    </p>
  </div>
</BaseLayout>

<style>
  .chips {
    margin-bottom: var(--sp-3);
  }
  .page-head h1 {
    max-width: 16ch;
  }
  .page-head .lead {
    max-width: 44rem;
    margin-bottom: 0;
  }
  .body {
    padding-block: var(--sp-6) var(--sp-12);
    max-width: 64rem;
    margin-inline: 0;
  }
  .go {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-3) 0 0;
  }
</style>
