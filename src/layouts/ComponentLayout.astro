---
import BaseLayout from './BaseLayout.astro';
import FileShell from '../components/file/FileShell.astro';
import SubBar from '../components/file/SubBar.astro';
import { componentById, fileNo } from '../data/components';
import { verbFor } from '../data/goals';
import { railFor, type RailComponentId } from '../data/rail';

// Shell for a file's own pages: its overview, "Pick a product", "Before you start", "Ask your participants",
// the Look back pages. The file's folder and paper (FileShell, D41) hold everything: an optional `top` slot
// (the overview's opening), the row of steps, then the page.

interface Props {
  component: RailComponentId;
  /** "overview", or the slug of the page (matches the step row). */
  current: string;
  title: string;
  heading: string;
  lead?: string;
  description?: string;
  /** Kept for older pages; shown as small facts under the title. */
  chips?: string[];
  /** Last breadcrumb label. Leave out on the overview. */
  crumb?: string;
}

const { component, current, title, heading, lead, description, chips = [], crumb } = Astro.props;
const comp = componentById[component];
const rail = railFor(component);
const path = `${comp.href}${current === 'overview' ? '' : `${current}/`}`;
const verb = current === 'overview' ? comp.verb : verbFor(path);
const crumbs = [crumb ? { label: `File ${fileNo(comp)} · ${comp.short}`, href: comp.href } : { label: `File ${fileNo(comp)} · ${comp.short}` }, ...(crumb ? [{ label: crumb }] : [])];
const stepNo = rail.items.findIndex((i) => i.slug === current);
---

<BaseLayout title={title} description={description ?? lead} component={comp.c}>
  <FileShell comp={comp} crumbs={crumbs} verb={verb} title={heading} lead={lead} stamp={`${fileNo(comp)}${stepNo >= 0 ? `.${stepNo + 1}` : ''}`}>
    <Fragment slot="head">
      {chips.length > 0 && <ul class="facts">{chips.map((c) => <li>{c}</li>)}</ul>}
      <slot name="head" />
    </Fragment>
    <slot name="top" />
    <SubBar rail={rail} current={current} />
    <slot />
  </FileShell>
</BaseLayout>

<style>
  .facts {
    list-style: none;
    padding: 0;
    margin: var(--sp-3) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .facts li {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    border: 1px solid rgb(27 27 27 / 0.3);
    border-radius: 999px;
    padding: 4px 12px;
  }
</style>
