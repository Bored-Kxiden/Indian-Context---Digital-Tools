---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ComponentStepper from '../components/ComponentStepper.astro';
import { componentById } from '../data/components';
import { railFor, type RailComponentId } from '../data/rail';

// Shell for a component's own pages: its overview, "Pick a product", "Before you start",
// "Ask your participants". The step bar under the heading lists every page of the
// component in order; the content is a stack of Sections that run the full width.

interface Props {
  component: RailComponentId;
  /** "overview", or the slug of the page (matches the step bar). */
  current: string;
  title: string;
  heading: string;
  lead?: string;
  description?: string;
  /** Chips above the heading. */
  chips?: string[];
  /** Last breadcrumb label. Leave out on the overview. */
  crumb?: string;
}

const { component, current, title, heading, lead, description, chips = [], crumb } = Astro.props;
const comp = componentById[component];
const rail = railFor(component);
const compLabel = comp.number ? `${comp.number} · ${comp.short}` : comp.short;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Components', href: '/components/' },
  crumb ? { label: compLabel, href: comp.href } : { label: compLabel },
  ...(crumb ? [{ label: crumb }] : []),
];
---

<BaseLayout title={title} description={description ?? lead} component={comp.c}>
  <div class="page-head">
    <div class="wrap head-grid">
      <div class="hl">
        <Breadcrumb items={crumbs} />
        {chips.length > 0 && <div class="chip-row chips">{chips.map((c) => <span class="chip chip--quiet">{c}</span>)}</div>}
        <h1>{heading}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot name="head" />
      </div>
      <span class="bignum" aria-hidden="true">{comp.number ?? 'R'}</span>
    </div>
  </div>

  <ComponentStepper rail={rail} current={current} />

  <slot />
</BaseLayout>

<style>
  .head-grid {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
  }
  @media (min-width: 64rem) {
    .head-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--sp-8);
    }
  }
  .chips {
    margin-bottom: var(--sp-3);
  }
  .page-head h1 {
    margin-bottom: var(--sp-2);
    max-width: 18ch;
  }
  .page-head .lead {
    max-width: 44rem;
    margin-bottom: 0;
  }
  /* The component's number, large, in its own colour */
  .bignum {
    display: none;
    font-size: clamp(9rem, 16vw, 16rem);
    line-height: 0.75;
    font-weight: 800;
    letter-spacing: -0.06em;
    color: var(--accent);
    user-select: none;
  }
  @media (min-width: 64rem) {
    .bignum {
      display: block;
    }
  }
</style>
