---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ComponentStepper from '../components/ComponentStepper.astro';
import PageFigure from '../components/PageFigure.astro';
import DownloadCard from '../components/DownloadCard.astro';
import Icon from '../components/Icon.astro';
import type { Tool } from '../data/booklet/types';
import { componentById } from '../data/components';
import { railFor } from '../data/rail';
import { boardById, sheetById, sheetMeta } from '../data/card-kit';
import { getDownloadById, getDownloadsForPage } from '../data/downloads';
import { bookletImage, cardKitImage } from '../utils/assets';
import { nativeExamples } from '../components/examples';
import { toolPanels } from '../components/panels';
import { url } from '../utils/url';

// One page per tool in Components 1 to 4. Tabs, always in the same order:
// Guide · (extra tabs a tool asks for) · Example · Template · Card kit (Component 1 only). Component 1's
// pages are templates with the example in [brackets], so there the Example and Template tabs are one.
// Without JavaScript the panels simply stack; with it they become tabs.
// The layout uses the whole width: examples sit side by side when there is room, and
// each one puts its steps beside the page or below it, whichever leaves the page larger.

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const comp = componentById[tool.component];
const rail = railFor(tool.component);
const pagePath = `${comp.href}${tool.slug}/`;
const idx = rail.items.findIndex((i) => i.slug === tool.slug);
const prev = idx > 0 ? rail.items[idx - 1] : undefined;
const next = idx >= 0 && idx < rail.items.length - 1 ? rail.items[idx + 1] : undefined;

// Component 1's pages are templates, each with the example written into the fields, so it has no
// separate guide page (and no separate example and blank): its page tab is one "Template".
const guideImage = tool.guidePage ? bookletImage(tool.guidePage) : undefined;
// Components 1 and 4 show the booklet's guide page beside the text. In Components 2 and 3 the
// booklet colours each tool's page differently (indigo, terracotta, turmeric), which would clash
// with the site's one-colour-per-component rule, and the page repeats the text. So there it sits
// under the text, one click away, and the text uses the width.
const pageBeside = !!guideImage && (tool.component === 'existing-products' || tool.component === 'material-reality');
const multi = tool.parts.length > 1;
const oneTemplate = tool.parts.every((p) => p.blank.shared && p.blank.page === p.example.page);
const tplDl = (p: (typeof tool.parts)[number]) => getDownloadById(`tpl-${p.blank.pdf.replace(/\.pdf$/, '')}`);
const kit = tool.cardKit;
const templates = getDownloadsForPage(pagePath);
// Component 2 is worked on a FigJam board; its tools point at the part of the board that does their job.
// Component 1's pages also come as a Figma file, offered beside each tool's template.
const figjam = tool.component === 'visual-culture' ? getDownloadById('visual-culture-figjam') : undefined;
const c1Figma = tool.component === 'existing-products' ? getDownloadById('existing-products-figma') : undefined;

const panels = (tool.panels ?? []).filter((p) => toolPanels[`${tool.component}/${tool.slug}/${p.id}`]);
const afterGuide = panels.filter((p) => (p.after ?? 'guide') === 'guide');
const atEnd = panels.filter((p) => p.after === 'end');
const tabs = [
  { id: 'guide', label: 'Guide', icon: 'info' },
  ...afterGuide.map((p) => ({ id: p.id, label: p.label, icon: p.icon })),
  ...(oneTemplate
    ? [{ id: 'example', label: 'Template', icon: 'file' }]
    : [
        { id: 'example', label: 'Example', icon: 'bulb' },
        { id: 'blank', label: 'Template', icon: 'file' },
      ]),
  ...atEnd.map((p) => ({ id: p.id, label: p.label, icon: p.icon })),
  ...(kit ? [{ id: 'card-kit', label: 'Card kit', icon: 'cards' }] : []),
];
const blankParts = tool.parts.filter((p) => !p.blank.skip);
const sampleNote =
  tool.sampleNote ??
  'Follow the steps, then do the same for your own person. On your table, use real ads, real quotes and real words.';
const blankNote =
  tool.blankNote ??
  'Print it on A4, or copy it onto a big sheet. Write on sticky notes. Where the page shows [bracketed] text, it is an example: write over it with your own.';

const eyebrow = [
  tool.number ? `Tool ${tool.number} of ${tool.of}` : (tool.kind ?? 'Closing'),
  tool.worksOnItsOwn ? 'Works on its own' : 'Needs the tools before it',
];
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Components', href: '/components/' },
  { label: `${comp.number} · ${comp.short}`, href: comp.href },
  { label: tool.short },
];
---

<BaseLayout title={`${tool.name}: ${comp.short}`} description={tool.question} component={comp.c}>
  <div class="page-head">
    <div class="wrap head-grid">
      <div class="hl">
        <Breadcrumb items={crumbs} />
        <div class="chip-row eyebrow-row">
          {eyebrow.map((e) => <span class="chip chip--quiet">{e}</span>)}
          {tool.kind && tool.number && <span class="chip chip--quiet">{tool.kind}</span>}
        </div>
        <h1>{tool.name}</h1>
        <p class="lead q">{tool.question}</p>
        <ul class="meta" aria-label="About this tool">
          <li><Icon name="clock" size={20} /> <span><b>{tool.time}</b></span></li>
          {tool.group && <li><Icon name="people" size={20} /> <span>{tool.group}</span></li>}
          {tool.mode && <li><Icon name="pin" size={20} /> <span>{tool.mode}</span></li>}
          {
            tool.effort && (
              <li>
                <Icon name="bolt" size={20} />
                <span>
                  Effort
                  <span class="effort" role="img" aria-label={`${tool.effort} out of 3`}>
                    {[1, 2, 3].map((n) => <i class:list={{ on: n <= (tool.effort ?? 0) }}></i>)}
                  </span>
                </span>
              </li>
            )
          }
        </ul>
      </div>
      <div class="hr">
        <div class="callout"><strong>What it shows you</strong><p>{tool.shows}</p></div>
        <div class="callout callout--done"><strong>You’re done when</strong><p>{tool.done}</p></div>
      </div>
    </div>
  </div>

  <ComponentStepper rail={rail} current={tool.slug} />

  <div class="wrap body" data-tool>
    <div class="main">
      <div class="tabbar" data-tabbar hidden>
        <div class="tabs" data-tabs>
          {
            tabs.map((t) => (
              <button type="button" class="tab" data-tab={t.id} aria-selected="false">
                <Icon name={t.icon as any} size={20} /> {t.label}
              </button>
            ))
          }
        </div>
        {
          kit && (
            <div class="mode" data-mode-switch role="group" aria-label="How are you working?">
              <div class="seg">
                <button type="button" data-mode="paper" aria-pressed="true">
                  <Icon name="print" size={18} /> Paper
                </button>
                <button type="button" data-mode="cards" aria-pressed="false">
                  <Icon name="cards" size={18} /> Cards
                </button>
              </div>
            </div>
          )
        }
      </div>

      <!-- Guide -->
      <section class="panel" id="guide" data-panel="guide">
        <h2 class="panel-h">Guide</h2>
        <div class="guide-grid" data-beside={String(pageBeside)}>
          <div class="g-text">
           <div class="g-a">
            <h3 class="sub">What is it?</h3>
            {tool.whatIsIt.map((p) => <p class="body-p">{p}</p>)}

            {
              tool.stepsList && (
                <>
                  <h3 class="sub">{tool.stepsTitle ?? 'The steps'}</h3>
                  <ol class="seven">
                    {tool.stepsList.map((s, i) => (
                      <li class="stp">
                        <b>{i + 1}</b>
                        <span>
                          <strong>{s.title}.</strong> {s.body}
                        </span>
                      </li>
                    ))}
                  </ol>
                </>
              )
            }

            {
              tool.words.length > 0 && (
                <>
                  <h3 class="sub">Words you’ll see</h3>
                  <dl class="words">
                    {tool.words.map((w) => (
                      <>
                        <dt>{w.term}</dt>
                        <dd>{w.def}</dd>
                      </>
                    ))}
                  </dl>
                </>
              )
            }

           </div>
           <div class="g-b">
            {
              tool.extras.map((e) => (
                <div class:list={['callout', { 'callout--warn': e.tone === 'care' }]}>
                  <strong>{e.title}</strong>
                  {e.body && <p>{e.body}</p>}
                  {e.list && e.chips && (
                    <ul class="chip-row chips-in">
                      {e.list.map((li) => <li class="chip">{li}</li>)}
                    </ul>
                  )}
                  {e.list && !e.chips && (
                    <ul class="plain">
                      {e.list.map((li) => <li>{li}</li>)}
                    </ul>
                  )}
                </div>
              ))
            }

            {
              tool.refs && tool.refs.length > 0 && (
                <>
                  <h3 class="sub">Go deeper</h3>
                  <ul class="refs">
                    {tool.refs.map((r) => (
                      <li>
                        <a href={url(r.href)}>
                          <b>{r.label}</b>
                          <span>{r.blurb}</span>
                          <Icon name="arrow" size={20} />
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              )
            }

            {
              tool.isItWorking && (
                <>
                  <h3 class="sub">Is it working?</h3>
                  <div class="two-up iw">
                    <div class="callout">
                      <strong>Good signs</strong>
                      <ul class="plain">
                        {tool.isItWorking.good.map((g) => <li>{g}</li>)}
                      </ul>
                    </div>
                    <div class="callout callout--warn">
                      <strong>Warning signs, and what to do</strong>
                      <ul class="plain">
                        {tool.isItWorking.warnings.map((w) => (
                          <li>
                            {w.sign} <em>{w.fix}</em>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </>
              )
            }
           </div>
          </div>

          {
            pageBeside && guideImage ? (
              <div class="g-page">
                <PageFigure
                  image={guideImage}
                  alt={`The booklet’s guide page for ${tool.name}, page ${tool.guidePage}.`}
                  caption={`The booklet page, p.${tool.guidePage}`}
                />
              </div>
            ) : guideImage ? (
              <details class="g-compare">
                <summary>
                  Compare with the booklet page <span>p.{tool.guidePage}</span>
                </summary>
                <PageFigure
                  image={guideImage}
                  alt={`The booklet’s guide page for ${tool.name}, page ${tool.guidePage}.`}
                  caption="The booklet colours each tool’s page differently. On this site the colour stays with the component."
                />
              </details>
            ) : null
          }
        </div>
      </section>

      {
        afterGuide.map((pd) => {
          const Panel = toolPanels[`${tool.component}/${tool.slug}/${pd.id}`];
          return (
            <section class="panel" id={pd.id} data-panel={pd.id}>
              <h2 class="panel-h">{pd.label}</h2>
              <Panel tool={tool} />
            </section>
          );
        })
      }

      <!-- Example -->
      <section class="panel" id="example" data-panel="example">
        <h2 class="panel-h">{oneTemplate ? 'Template' : 'Example'}</h2>
        <p class="sample-banner">
          <strong>Illustrative example.</strong> {sampleNote}
        </p>
        <div class="parts">
          {
            tool.parts.map((p) => {
              const Native = nativeExamples[p.example.page];
              return (
              <article class="part" id={`part-${p.id}`}>
                <div class="part-in">
                  <header class="part-head">
                    <div>
                      <p class="eb">{multi ? p.label : tool.name}</p>
                      <h3>{p.title}</h3>
                    </div>
                    <div class="part-acts">
                      {p.board && (
                        <a class="kp" href={url(`/card-kit/#${p.board.toLowerCase()}`)}>
                          <b>Card kit</b> Board {p.board}
                        </a>
                      )}
                      {oneTemplate && tplDl(p) && (
                        <a class="btn btn--accent" href={url(tplDl(p)!.href)} download>
                          <Icon name="download" size={20} /> Download template
                          <span class="btn-meta" data-no-index>
                            {tplDl(p)!.format} · {tplDl(p)!.size}
                          </span>
                        </a>
                      )}
                    </div>
                  </header>
                  {Native ? <Native alt={p.example.alt} caption={p.example.note} /> : <PageFigure image={bookletImage(p.example.page)} alt={p.example.alt} caption={p.example.note} />}
                  <div class="how">
                    <h4>How to use it</h4>
                    <ol class="steps-list">
                      {p.steps.map((s, i) => (
                        <li class="stp">
                          <b>{i + 1}</b>
                          <span>{s}</span>
                        </li>
                      ))}
                    </ol>
                  </div>
                </div>
              </article>
              );
            })
          }
        </div>
      </section>

      <!-- Blank template (Component 1 has none: its one page tab is the template) -->
      {!oneTemplate && (
      <section class="panel" id="blank" data-panel="blank">
        <h2 class="panel-h">Template</h2>
        <p class="body-p">{blankNote}</p>
        {
          figjam && tool.figjamSection && (
            <div class="callout figma-note">
              <strong>Or work in FigJam</strong>
              <p>
                The FigJam template has {tool.figjamSection}. <a href={url(figjam.href)} download>Download the board ({figjam.size})</a>, or read how it is laid out on the{' '}
                <a href={url('/components/visual-culture/#template')}>overview</a>.
              </p>
            </div>
          )
        }
        <div class="parts">
          {
            blankParts.map((p) => {
              const dl = getDownloadById(`tpl-${p.blank.pdf.replace(/\.pdf$/, '')}`);
              return (
                <article class="part" id={`blank-part-${p.id}`}>
                  <div class="part-in">
                    <header class="part-head">
                      <div>
                        <p class="eb">{multi ? p.label : tool.name}</p>
                        <h3>{p.title}</h3>
                      </div>
                      {dl && (
                        <a class="btn btn--accent" href={url(dl.href)} download>
                          <Icon name="download" size={20} /> Download template
                          <span class="btn-meta" data-no-index>
                            {dl.format} · {dl.size}
                          </span>
                        </a>
                      )}
                    </header>
                    {p.blank.shared ? (
                      <div class="callout">
                        <strong>Example and blank share one page.</strong>
                        <p>
                          {p.blank.sharedNote ?? `On p.${p.blank.page} of the booklet, the filled example sits above the blank to fill in. The download is that page.`}{' '}
                          <a href={url(`${pagePath}#part-${p.id}`)}>See the example</a>
                        </p>
                      </div>
                    ) : (
                      <PageFigure image={bookletImage(p.blank.page)} alt={p.blank.alt} caption={p.blank.note} />
                    )}
                    <p class="small">Booklet <span class="mono">{p.blank.printed}</span> · A4</p>
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>
      )}

      {
        atEnd.map((pd) => {
          const Panel = toolPanels[`${tool.component}/${tool.slug}/${pd.id}`];
          return (
            <section class="panel" id={pd.id} data-panel={pd.id}>
              <h2 class="panel-h">{pd.label}</h2>
              <Panel tool={tool} />
            </section>
          );
        })
      }

      <!-- Card kit -->
      {
        kit && (
          <section class="panel" id="card-kit" data-panel="card-kit">
            <h2 class="panel-h">Card kit</h2>
            <div class="kit-intro">
              <div>
                <p class="body-p">{kit.intro}</p>
                <p class="small">
                  Booklet <span class="mono">{kit.page}</span>. <a href={url('/card-kit/')}>All boards and sheets</a>
                </p>
              </div>
              <div>
                <h3 class="sub">At the table</h3>
                <ol class="steps-list at-table">
                  {kit.steps.map((s, i) => (
                    <li class="stp">
                      <b>{i + 1}</b>
                      <span>{s}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>

            <h3 class="sub">{kit.boards.length > 1 ? 'Boards' : 'Board'}</h3>
            <div class="kit-figs kit-figs--boards">
              {kit.boards.map((id) => {
                const b = boardById[id];
                const dl = getDownloadById(`board-${id.toLowerCase()}`);
                return (
                  <div class="kit-fig" id={`kit-${id.toLowerCase()}`}>
                    <PageFigure
                      image={cardKitImage(id)}
                      alt={`Board ${id}, ${b.name}, from the card kit. Print at A2 landscape.`}
                      caption={`Board ${id} · ${b.name} · ${b.page}`}
                    />
                    {dl && <DownloadCard item={dl} compact />}
                  </div>
                );
              })}
            </div>

            <h3 class="sub">{kit.sheets.length > 1 ? 'Card sheets' : 'Card sheet'}</h3>
            <div class="kit-figs kit-figs--sheets">
              {kit.sheets.map((id) => {
                const s = sheetById[id];
                const dl = getDownloadById(`sheet-${id.toLowerCase()}`);
                return (
                  <div class="kit-fig" id={`kit-${id.toLowerCase()}`}>
                    <PageFigure
                      image={cardKitImage(id)}
                      alt={`Card sheet ${id}, ${s.name}, from the card kit. Print on A4 card and cut along the dashed lines.`}
                      caption={`Sheet ${id} · ${s.name} · ${sheetMeta(s)} · ${s.page}`}
                    />
                    {dl && <DownloadCard item={dl} compact />}
                  </div>
                );
              })}
            </div>
          </section>
        )
      }

      <nav class="pn" aria-label="Previous and next">
        {
          prev ? (
            <a class="prev" href={url(prev.href)}>
              <Icon name="arrow-left" size={20} />
              <span>
                <small>Before</small>
                <b>{prev.label}</b>
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="next" href={url(next.href)}>
              <span>
                <small>Next</small>
                <b>{next.label}</b>
              </span>
              <Icon name="arrow" size={20} />
            </a>
          ) : (
            <a class="next" href={url(comp.href)}>
              <span>
                <small>Back to</small>
                <b>{comp.name}</b>
              </span>
              <Icon name="arrow" size={20} />
            </a>
          )
        }
      </nav>
    </div>

    <aside class="side" aria-label="Print and prepare">
      <div class="card">
        <h2 class="side-h"><Icon name="print" size={20} /> Print</h2>
        <div class="dl-list">
          {templates.map((d) => <DownloadCard item={d} compact />)}
          {figjam && tool.figjamSection && <DownloadCard item={figjam} compact />}
          {c1Figma && <DownloadCard item={c1Figma} compact />}
        </div>
        {
          kit && (
            <p class="small">
              Playing on the table? <a href={url('/card-kit/')}>Print the boards and card sheets</a>.
            </p>
          )
        }
      </div>
      <div class="card">
        <h2 class="side-h">You need</h2>
        <p>{tool.need}</p>
        <h2 class="side-h">You end up with</h2>
        <p class="end">{tool.endUp}</p>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-tool]');
  if (root) {
    const bar = root.querySelector<HTMLElement>('[data-tabbar]');
    const tablist = root.querySelector<HTMLElement>('[data-tabs]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const ids = tabs.map((t) => t.dataset.tab ?? '');
    const modeBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    const KEY = 'toolkit-mode';

    const readMode = () => {
      try {
        return localStorage.getItem(KEY) === 'cards' ? 'cards' : 'paper';
      } catch {
        return 'paper';
      }
    };
    const saveMode = (m: string) => {
      try {
        localStorage.setItem(KEY, m);
      } catch {
        /* private window or blocked storage: the switch still works for this visit */
      }
    };
    const paintMode = (m: string) => modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));

    let current = '';
    const show = (id: string) => {
      current = id;
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== id;
      });
    };

    // Turn the stacked sections into tabs.
    if (bar && tablist && tabs.length) {
      bar.hidden = false;
      tablist.setAttribute('role', 'tablist');
      tablist.setAttribute('aria-label', 'Parts of this tool');
      tabs.forEach((t) => {
        const id = t.dataset.tab ?? '';
        t.setAttribute('role', 'tab');
        t.id = `tab-${id}`;
        t.setAttribute('aria-controls', id);
      });
      panels.forEach((p) => {
        p.setAttribute('role', 'tabpanel');
        p.setAttribute('aria-labelledby', `tab-${p.dataset.panel}`);
        p.querySelector('.panel-h')?.classList.add('visually-hidden');
      });

      const fromHash = (scroll: boolean) => {
        // Component 1 has one "Template" tab where the others have Example and Blank template: old
        // #blank links land on it.
        let h = decodeURIComponent(location.hash.slice(1));
        if (h === 'blank' && !ids.includes('blank') && ids.includes('example')) h = 'example';
        if (h.startsWith('blank-part-') && !document.getElementById(h) && ids.includes('example')) h = h.replace('blank-part-', 'part-');
        if (h && ids.includes(h)) {
          show(h);
          // Keep the tab bar in view, not just the panel under it.
          if (scroll) bar.scrollIntoView();
          return;
        }
        const el = h ? document.getElementById(h) : null;
        const panel = el?.closest<HTMLElement>('[data-panel]');
        if (el && panel && panel.dataset.panel) {
          show(panel.dataset.panel);
          if (scroll) el.scrollIntoView();
          return;
        }
        if (!current) show(readMode() === 'cards' && ids.includes('card-kit') ? 'card-kit' : 'guide');
      };
      fromHash(true);
      window.addEventListener('hashchange', () => fromHash(true));

      tabs.forEach((t, i) => {
        t.addEventListener('click', () => {
          const id = t.dataset.tab ?? 'guide';
          show(id);
          history.replaceState(null, '', `#${id}`);
          // A long panel scrolled far down: bring the new panel's top into view.
          const top = bar.getBoundingClientRect().top;
          if (top < 0) bar.scrollIntoView();
        });
        t.addEventListener('keydown', (e) => {
          const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
          if (!(e.key in keys)) return;
          e.preventDefault();
          const n = tabs[(keys[e.key] + tabs.length) % tabs.length];
          n.focus();
          n.click();
        });
      });
    }

    // Paper | Cards: remembers how you work, and opens the matching tab.
    if (modeBtns.length) {
      paintMode(readMode());
      modeBtns.forEach((b) =>
        b.addEventListener('click', () => {
          const m = b.dataset.mode ?? 'paper';
          saveMode(m);
          paintMode(m);
          if (!tabs.length) return;
          if (m === 'cards' && ids.includes('card-kit')) show('card-kit');
          else if (current === 'card-kit') show('guide');
          history.replaceState(null, '', `#${current}`);
        }),
      );
    }
  }
</script>

<style is:global>
  /* Room for the sticky strip and the tab bar when jumping to an anchor */
  :root:has([data-tool]) {
    --scroll-offset: 152px;
  }
</style>

<style>
  .head-grid {
    display: grid;
    gap: var(--sp-4) var(--sp-8);
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
  }
  @media (min-width: 64rem) {
    .head-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .eyebrow-row {
    margin-bottom: var(--sp-3);
  }
  .page-head h1 {
    font-size: var(--fs-h1);
    margin-bottom: var(--sp-2);
  }
  .q {
    max-width: 40rem;
    margin-bottom: var(--sp-3);
  }
  .meta {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    color: var(--ink-soft);
    font-size: var(--fs-ui);
  }
  .meta li {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
  }
  .meta b {
    color: var(--ink);
  }
  .effort {
    display: inline-flex;
    gap: var(--sp-half);
    margin-left: var(--sp-1);
    vertical-align: middle;
  }
  .effort i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--ink);
  }
  .effort i.on {
    background: var(--ink);
  }
  .hr {
    display: grid;
    gap: var(--sp-2);
  }
  .hr .callout {
    margin: 0;
    padding: var(--sp-3);
  }
  .callout p {
    margin: 0;
  }
  .callout--done {
    background: var(--ink);
    color: #fff;
  }

  /* ---------- Body: main column and a sticky side column ---------- */
  .body {
    display: grid;
    gap: var(--sp-4) var(--sp-5);
    grid-template-columns: minmax(0, 1fr);
    padding-block: 0 var(--sp-10);
    align-items: start;
  }
  @media (min-width: 72rem) {
    .body {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
    .side {
      position: sticky;
      top: calc(var(--strip-h) + var(--sp-3));
    }
  }
  .main {
    min-width: 0;
  }
  .side {
    display: grid;
    gap: var(--sp-2);
    padding-top: var(--sp-4);
  }
  .side .card {
    padding: var(--sp-3);
  }
  .side-h {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
    margin: 0 0 var(--sp-1);
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }
  .side p {
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-ui);
  }
  .side p:last-child {
    margin-bottom: 0;
  }
  .end {
    font-weight: 700;
  }
  .dl-list {
    display: grid;
    gap: var(--sp-1);
    margin-bottom: var(--sp-2);
  }
  .dl-list:empty {
    display: none;
  }

  /* ---------- Tabs: sticky under the component strip ---------- */
  .tabbar {
    position: sticky;
    top: var(--sticky-top, 72px);
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    background: var(--ground);
    border-bottom: 2px solid var(--line-strong);
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }
  @media (min-width: 64rem) {
    .tabbar {
      --sticky-top: var(--strip-h);
    }
  }
  @media (min-width: 72rem) {
    .tabbar {
      margin-right: 0;
      padding-right: 0;
    }
  }
  .tabs {
    flex: 1;
    min-width: 0;
  }
  .mode {
    flex: none;
  }
  @media (max-width: 48rem) {
    .mode {
      display: none;
    }
  }

  .panel {
    padding-block: var(--sp-4) var(--sp-2);
  }
  .panel + .panel {
    border-top: 1px solid var(--line-strong);
    margin-top: var(--sp-4);
  }
  .panel[hidden] + .panel {
    margin-top: 0;
  }
  .panel:focus-visible {
    outline-offset: -3px;
  }
  .panel-h {
    font-size: var(--fs-h2);
    margin-bottom: var(--sp-2);
  }
  .sub {
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: var(--sp-4) 0 var(--sp-2);
  }
  .g-a > .sub:first-child,
  .g-b > .sub:first-child,
  .kit-intro .sub:first-child {
    margin-top: 0;
  }
  .figma-note {
    margin: var(--sp-3) 0;
    max-width: 52rem;
  }
  .part-acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1);
  }
  .body-p {
    font-size: var(--fs-lead);
    max-width: var(--measure);
    color: var(--ink-soft);
  }
  .small {
    font-size: var(--fs-ui);
    color: var(--muted);
    margin: var(--sp-1) 0 0;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 0.9em;
    letter-spacing: 0.04em;
  }

  /* Guide: the words on the left, the booklet page alongside */
  .guide-grid {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  /* Page beside the text: the two blocks read as one column. */
  .guide-grid[data-beside='true'] .g-text > div {
    display: contents;
  }
  /* Page under the text: the text uses the width, in two columns. */
  .guide-grid[data-beside='false'] .g-text {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  .guide-grid[data-beside='false'] .g-b > .callout:first-child {
    margin-top: 0;
  }
  .g-compare {
    grid-column: 1 / -1;
    max-width: 44rem;
    border: 2px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    padding: var(--sp-1) var(--sp-2);
  }
  .g-compare summary {
    cursor: pointer;
    min-height: 40px;
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    font-weight: 700;
    font-size: var(--fs-ui);
  }
  .g-compare summary span {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--muted);
  }
  .g-compare[open] summary {
    margin-bottom: var(--sp-2);
  }
  @media (min-width: 64rem) {
    .guide-grid[data-beside='false'] .g-text {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--sp-6);
    }
    .guide-grid[data-beside='true'] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .g-page {
      position: sticky;
      top: calc(var(--strip-h) + 56px + var(--sp-3));
    }
  }
  .words {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr);
    gap: var(--sp-1) var(--sp-3);
    margin: 0;
    max-width: var(--measure);
  }
  .words dt {
    font-weight: 700;
  }
  .words dd {
    margin: 0;
    color: var(--ink-soft);
  }
  @media (max-width: 34rem) {
    .words {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .words dd {
      margin-bottom: var(--sp-2);
    }
  }
  .plain {
    margin: var(--sp-half) 0 0;
    padding-left: var(--sp-3);
  }
  .plain li {
    margin-bottom: var(--sp-1);
  }
  .plain em {
    display: block;
    font-style: normal;
    color: var(--ink-soft);
  }
  .seven {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-2);
    max-width: var(--measure);
  }
  .seven li {
    margin: 0;
  }
  .two-up {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .two-up .callout {
    margin: 0;
  }

  /* Example and Blank: parts side by side when the column is wide enough.
     Each part checks its own width (a container query): steps beside the page only when
     that still leaves the page big; otherwise the steps go below it. */
  .parts {
    display: grid;
    gap: var(--sp-6) var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 50rem), 1fr));
    align-items: start;
  }
  .part {
    container-type: inline-size;
    scroll-margin-top: var(--scroll-offset);
  }
  .part-in {
    display: grid;
    gap: var(--sp-2);
  }
  .part-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .part-head .eb {
    margin-bottom: var(--sp-half);
    color: var(--accent-deep);
    font-weight: 600;
  }
  .part h3 {
    margin: 0;
    font-size: clamp(1.5rem, 1.2rem + 0.9vw, 2rem);
  }
  .how h4 {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: var(--sp-2);
  }
  .how .steps-list {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--sp-2) var(--sp-3);
  }
  @container (min-width: 80rem) {
    .part-in {
      grid-template-columns: minmax(0, 1fr) 20rem;
      column-gap: var(--sp-4);
    }
    .part-head {
      grid-column: 1 / -1;
    }
    .how {
      align-self: start;
    }
    .how .steps-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .btn-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.9;
    margin-left: var(--sp-1);
  }

  /* Card kit */
  .kit-intro {
    display: grid;
    gap: var(--sp-4) var(--sp-6);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .kit-intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }
  .kit-figs {
    display: grid;
    gap: var(--sp-4);
  }
  .kit-figs--boards {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 52rem), 1fr));
  }
  .kit-figs--sheets {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 36rem), 1fr));
  }
  .kit-figs--boards .kit-fig {
    --fig-max: 90rem;
  }
  .kit-fig {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    scroll-margin-top: var(--scroll-offset);
  }

  /* Previous and next */
  .pn {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-top: var(--sp-8);
    padding-top: var(--sp-3);
    border-top: 2px solid var(--line-strong);
  }
  .pn a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 64px;
    padding: var(--sp-1) var(--sp-3);
    border: 2px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    transition:
      background-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }
  .pn a:hover {
    background: var(--ink);
    color: #fff;
  }
  .pn small {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .pn b {
    display: block;
    line-height: 1.2;
  }
  .pn .next {
    margin-left: auto;
    text-align: right;
  }
  /* "Go deeper": pages that belong to this tool */
  .chips-in {
    list-style: none;
    padding: 0;
    margin: var(--sp-1) 0 0;
  }
  .chips-in li {
    margin: 0;
  }
  .refs {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
    display: grid;
    gap: var(--sp-1);
  }
  .refs li {
    margin: 0;
  }
  .refs a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px var(--sp-2);
    align-items: center;
    padding: var(--sp-2);
    border: 2px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition:
      background-color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .refs a:hover {
    background: var(--accent-tint);
    border-color: var(--accent);
  }
  .refs b {
    grid-column: 1;
    font-size: var(--fs-lead);
    line-height: 1.25;
  }
  .refs span {
    grid-column: 1;
    color: var(--ink-soft);
    font-size: var(--fs-ui);
  }
  .refs a > :global(svg) {
    grid-row: 1 / span 2;
    grid-column: 2;
  }
</style>
