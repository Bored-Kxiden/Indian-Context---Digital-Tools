---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ComponentNav from '../components/ComponentNav.astro';
import Finder from '../components/Finder.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  /** Sets the accent colour: which component the visitor is in. */
  component?: 'c1' | 'c2' | 'c3' | 'c4' | 'ink';
}

const { title, description = site.description, component } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name}: a toolkit for designing in Indian contexts`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f0" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preload" href={url('/fonts/BricolageGrotesque-Variable.woff2')} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body data-c={component}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <ComponentNav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Finder />
  </body>
</html>
