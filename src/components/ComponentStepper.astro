---
import type { Rail } from '../data/rail';
import { url } from '../utils/url';

// The tools of a component as one row of steps: overview first, then in order.
// It replaces the left column, so the page can use the full width, and it works the same
// on a phone (the row scrolls sideways and keeps the current step in view).
interface Props {
  rail: Rail;
  /** Slug of the page being viewed, or "overview". */
  current: string;
}

const { rail, current } = Astro.props;
---

<nav class="stepper" aria-label={`${rail.name}: steps`} data-c={rail.c}>
  <div class="wrap">
    <ol data-stepper>
      <li>
        <a href={url(rail.overviewHref)} aria-current={current === 'overview' ? 'page' : undefined}>
          <span class="n" aria-hidden="true">{rail.number ?? '·'}</span>
          <span class="t"><b>Overview</b></span>
        </a>
      </li>
      {
        rail.items.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={item.slug === current ? 'page' : undefined}>
              <span class="n" aria-hidden="true">{item.n ?? '›'}</span>
              <span class="t">
                <b>{item.label}</b>
                {item.meta && <small>{item.meta}</small>}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<script>
  // Keep the current step in view when the row scrolls sideways (phones, narrow windows),
  // and fade the edge that still has more steps beyond it.
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((row) => {
    const here = row.querySelector<HTMLElement>('[aria-current="page"]');
    if (here && row.scrollWidth > row.clientWidth) {
      row.scrollLeft = here.offsetLeft - (row.clientWidth - here.offsetWidth) / 2;
    }
    const edges = () => {
      const more = row.scrollWidth - row.clientWidth > 4;
      row.dataset.more = more ? (row.scrollLeft + row.clientWidth >= row.scrollWidth - 4 ? 'start' : row.scrollLeft > 4 ? 'both' : 'end') : 'none';
    };
    edges();
    row.addEventListener('scroll', edges, { passive: true });
    window.addEventListener('resize', edges);
  });
</script>

<style>
  .stepper {
    background: var(--surface);
    border-bottom: 1px solid var(--line-strong);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--sp-1);
    overflow-x: auto;
    scrollbar-width: thin;
    scroll-snap-type: x proximity;
  }
  ol[data-more='end'] {
    mask-image: linear-gradient(to right, #000 calc(100% - 56px), transparent);
  }
  ol[data-more='start'] {
    mask-image: linear-gradient(to left, #000 calc(100% - 56px), transparent);
  }
  ol[data-more='both'] {
    mask-image: linear-gradient(to right, transparent, #000 56px, #000 calc(100% - 56px), transparent);
  }
  li {
    margin: 0;
    flex: none;
    scroll-snap-align: center;
  }
  a {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    min-height: 64px;
    padding: 0 var(--sp-2);
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 4px solid transparent;
    transition:
      background-color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  a:hover {
    background: var(--accent-tint);
    color: var(--ink);
  }
  a[aria-current='page'] {
    color: var(--ink);
    background: var(--accent-tint);
    border-bottom-color: var(--accent);
  }
  a:focus-visible {
    outline-offset: -3px;
  }
  .n {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    flex: none;
    font-size: var(--fs-sm);
    font-weight: 800;
    color: var(--accent-deep);
    box-shadow: inset 0 0 0 2px var(--accent);
    background: var(--surface);
  }
  a[aria-current='page'] .n {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .t {
    display: grid;
    line-height: 1.25;
  }
  .t b {
    font-size: var(--fs-ui);
    white-space: nowrap;
  }
  .t small {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
