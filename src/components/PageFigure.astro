---
import { url } from '../utils/url';
import type { PageImage } from '../utils/assets';

interface Props {
  image: PageImage;
  alt: string;
  caption?: string;
  /** Widest the picture gets on screen. Portrait pages default to a narrower measure. */
  wide?: boolean;
  /** Lazy-load (default). Turn off for the first image on a page. */
  eager?: boolean;
  id?: string;
}

const { image, alt, caption, wide = false, eager = false, id } = Astro.props;
const landscape = image.width > image.height;
---

<figure class:list={['pg', { 'pg--landscape': landscape || wide }]} id={id}>
  <a class="zoom" href={url(image.src)} target="_blank" rel="noopener">
    <img
      src={url(image.src)}
      width={image.width}
      height={image.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="visually-hidden"> (opens full size in a new tab)</span>
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .pg {
    margin: 0;
    max-width: 44rem;
  }
  .pg--landscape {
    max-width: 62rem;
  }
  .zoom {
    display: block;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    cursor: zoom-in;
  }
  .zoom:focus-visible {
    outline: 3px solid var(--accent, var(--ink));
    outline-offset: 3px;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
