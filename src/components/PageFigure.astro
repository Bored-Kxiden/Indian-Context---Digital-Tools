---
import { url } from '../utils/url';
import type { PageImage } from '../utils/assets';

// A booklet or card-kit page shown at the full width of its column, with a link to the
// full-size image. Width and height are set so the page never jumps while it loads.
interface Props {
  image: PageImage;
  alt: string;
  caption?: string;
  /** Lazy-load (default). Turn off for the first image on a page. */
  eager?: boolean;
  id?: string;
}

const { image, alt, caption, eager = false, id } = Astro.props;
---

<figure class="pg" id={id}>
  <a class="zoom" href={url(image.src)} target="_blank" rel="noopener">
    <img
      src={url(image.src)}
      width={image.width}
      height={image.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="visually-hidden"> (opens full size in a new tab)</span>
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .pg {
    margin: 0;
    max-width: var(--fig-max, 60rem);
  }
  .zoom {
    display: block;
    border: 2px solid var(--line-strong);
    border-radius: var(--r-md);
    overflow: hidden;
    background: #fff;
    cursor: zoom-in;
    transition:
      border-color var(--t-fast) var(--ease),
      box-shadow var(--t-med) var(--ease);
  }
  .zoom:hover {
    border-color: var(--ink);
    box-shadow: 0 16px 32px -20px rgb(22 20 15 / 0.45);
  }
  .zoom:focus-visible {
    outline-offset: 4px;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: var(--sp-1);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
</style>
