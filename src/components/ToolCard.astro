---
import ModuleChip from './ModuleChip.astro';
import Icon from './Icon.astro';
import { toolHref, type Tool } from '../data/tools';
import { url } from '../utils/url';

// One tool as a wide row: number, name and kind, what it does, the modules it serves.
interface Props {
  tool: Tool;
  /** Position in the list, shown as a numeral. */
  index?: number;
}

const { tool, index } = Astro.props;
---

<article class="tool">
  {index !== undefined && <span class="num" aria-hidden="true">{index}</span>}
  <div class="main">
    <p class="kind">{tool.kind}</p>
    <h3><a href={url(toolHref(tool.slug))}>{tool.name}</a></h3>
    <p class="blurb">{tool.blurb}</p>
  </div>
  <div class="chip-row mods">
    {tool.modules.map((m) => <ModuleChip id={m} />)}
  </div>
  <span class="go" aria-hidden="true"><Icon name="arrow" size={24} /></span>
</article>

<style>
  .tool {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-1);
    border-bottom: 1px solid var(--line-strong);
    transition: background-color var(--t-fast) var(--ease);
  }
  .tool:hover,
  .tool:focus-within {
    background: var(--accent-tint);
  }
  .num {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--accent);
    min-width: 1ch;
  }
  .kind {
    margin: 0 0 var(--sp-half);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h3 {
    margin: 0 0 var(--sp-1);
    font-size: var(--fs-h3);
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  /* The whole row is clickable, but the heading link stays the accessible target. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:focus-visible {
    outline: none;
  }
  h3 a:focus-visible::after {
    outline: 3px solid var(--ink);
    outline-offset: -3px;
    border-radius: var(--r-sm);
  }
  .blurb {
    color: var(--ink-soft);
    margin: 0;
    max-width: 44rem;
  }
  .go {
    display: inline-flex;
    color: var(--ink);
    transition: transform var(--t-fast) var(--ease);
  }
  .tool:hover .go {
    transform: translateX(4px);
  }
  @media (max-width: 56rem) {
    .tool {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .mods,
    .go {
      display: none;
    }
    .num {
      font-size: 3rem;
    }
  }
</style>
