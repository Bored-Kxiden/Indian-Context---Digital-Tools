---
import Icon from './Icon.astro';
import { componentById, liveComponents } from '../data/components';
import { url } from '../utils/url';

// Component 1 is the tallest tile, then 3 (the second tallest). 2 and 4 are the short ones:
// one colour per component, and the biggest block goes to the component with the most in it.

const reflection = componentById['reflection'];
---

<div class="bento">
  {
    liveComponents.map((c) => (
      <article class={`big big--${c.c}`} data-c={c.c} data-tile={c.c}>
        <div class="top">
          <span class="num" aria-hidden="true">{c.number}</span>
          {c.hours && <span class="pill">{c.hours}</span>}
        </div>
        <h3>
          <a href={url(c.href)}>
            <span class="visually-hidden">Component {c.number}: </span>
            {c.name}
          </a>
        </h3>
        <p>{c.blurb}</p>
        <ul class="tags" aria-label="Tools">
          {c.tags.map((t) => <li>{t}</li>)}
        </ul>
        <span class="open" aria-hidden="true">
          Open component <Icon name="arrow" size={20} />
        </span>
      </article>
    ))
  }
</div>

<article class="refl" data-c="ink">
  <span class="rn" aria-hidden="true">R</span>
  <div class="rt">
    <p class="rl">Runs through every component</p>
    <h3>
      <a href={url(reflection.href)}>{reflection.name}</a>
    </h3>
    <p class="rb">{reflection.blurb}</p>
    <ul class="rtags" aria-label="Steps">
      {reflection.tags.map((t, n) => <li><span aria-hidden="true">{n + 1}</span> {t}</li>)}
    </ul>
  </div>
  <span class="open" aria-hidden="true">
    Open <Icon name="arrow" size={20} />
  </span>
</article>

<style>
  .bento {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        'c1 c2'
        'c1 c3'
        'c4 c3';
    }
    [data-tile='c1'] {
      grid-area: c1;
    }
    [data-tile='c2'] {
      grid-area: c2;
    }
    [data-tile='c3'] {
      grid-area: c3;
    }
    [data-tile='c4'] {
      grid-area: c4;
    }
  }
  .big {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    border-radius: var(--r-lg);
    padding: var(--sp-4);
    background: var(--accent);
    color: var(--accent-ink);
    transition:
      transform var(--t-med) var(--ease),
      box-shadow var(--t-med) var(--ease);
  }
  /* A pale circle bleeding off the corner: the mark of the toolkit */
  .big::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 22rem;
    height: 22rem;
    right: -7rem;
    bottom: -9rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
  }
  .big--c1::before {
    width: 34rem;
    height: 34rem;
    right: -10rem;
    bottom: -14rem;
  }
  .big:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -24px rgb(22 20 15 / 0.6);
  }
  .big--c1 {
    min-height: 32rem;
  }
  .big--c2,
  .big--c3,
  .big--c4 {
    min-height: 15rem;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-2);
  }
  .num {
    font-size: 5rem;
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .big--c1 .num {
    font-size: 9rem;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    padding: var(--sp-1) var(--sp-2);
    white-space: nowrap;
  }
  h3 {
    margin: var(--sp-1) 0 0;
    font-size: clamp(1.75rem, 1.2rem + 1.2vw, 2.5rem);
    line-height: 1.1;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* The whole tile is the link */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:focus-visible {
    outline: none;
  }
  h3 a:focus-visible::after {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
    border-radius: var(--r-lg);
  }
  p {
    margin: 0;
    color: inherit;
    max-width: 34rem;
    font-size: var(--fs-body);
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: var(--sp-1) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .tags li {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    padding: 4px 12px;
  }
  .open {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-weight: 700;
    padding-top: var(--sp-2);
  }

  /* Reflection runs through the four components, so it sits under them as one wide band */
  .refl {
    position: relative;
    margin-top: var(--sp-3);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: 2px solid var(--ink);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--ink);
    transition:
      transform var(--t-med) var(--ease),
      box-shadow var(--t-med) var(--ease);
  }
  .refl:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -24px rgb(22 20 15 / 0.6);
  }
  .rn {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1;
  }
  .rl {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--sp-1);
  }
  .refl h3 {
    margin: 0 0 var(--sp-1);
  }
  .refl h3 a::after {
    border-radius: var(--r-lg);
  }
  .rb {
    color: var(--ink-soft);
    max-width: 44rem;
  }
  .rtags {
    list-style: none;
    padding: 0;
    margin: var(--sp-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .rtags li {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    padding: 4px 12px;
  }
  .rtags li span {
    font-weight: 600;
    margin-right: 2px;
  }
  @media (max-width: 40rem) {
    .refl {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      padding: var(--sp-3);
    }
    .rn {
      width: 48px;
      height: 48px;
      font-size: var(--fs-h3);
    }
    .refl .open {
      display: none;
    }
  }
</style>
