---
import Icon from './Icon.astro';
import { liveComponents, soonComponents } from '../data/components';
import { url } from '../utils/url';

// Component 1 is the tallest tile, then 3 (the second tallest). 2 and 4 are the short ones:
// one colour per component, and the biggest block goes to the component with the most in it.
---

<div class="bento">
  {
    liveComponents.map((c) => (
      <article class={`big big--${c.c}`} data-c={c.c} data-tile={c.c}>
        <div class="top">
          <span class="num" aria-hidden="true">{c.number}</span>
          {c.hours && <span class="pill">{c.hours}</span>}
        </div>
        <h3>
          <a href={url(c.href)}>
            <span class="visually-hidden">Component {c.number}: </span>
            {c.name}
          </a>
        </h3>
        <p>{c.blurb}</p>
        <ul class="tags" aria-label="Tools">
          {c.tags.map((t) => <li>{t}</li>)}
        </ul>
        <span class="open" aria-hidden="true">
          Open component <Icon name="arrow" size={20} />
        </span>
      </article>
    ))
  }
</div>

<ul class="soon">
  {
    soonComponents.map((c) => (
      <li data-c={c.c}>
        <a href={url(c.href)}>
          <span class="n" aria-hidden="true">{c.number ?? '↺'}</span>
          <span>
            <b>{c.name}</b>
            <small>Coming next</small>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .bento {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        'c1 c2'
        'c1 c3'
        'c4 c3';
    }
    [data-tile='c1'] {
      grid-area: c1;
    }
    [data-tile='c2'] {
      grid-area: c2;
    }
    [data-tile='c3'] {
      grid-area: c3;
    }
    [data-tile='c4'] {
      grid-area: c4;
    }
  }
  .big {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    border-radius: var(--r-lg);
    padding: var(--sp-4);
    background: var(--accent);
    color: var(--accent-ink);
    transition:
      transform var(--t-med) var(--ease),
      box-shadow var(--t-med) var(--ease);
  }
  /* A pale circle bleeding off the corner: the mark of the toolkit */
  .big::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 22rem;
    height: 22rem;
    right: -7rem;
    bottom: -9rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
  }
  .big--c1::before {
    width: 34rem;
    height: 34rem;
    right: -10rem;
    bottom: -14rem;
  }
  .big:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -24px rgb(22 20 15 / 0.6);
  }
  .big--c1 {
    min-height: 32rem;
  }
  .big--c2,
  .big--c3,
  .big--c4 {
    min-height: 15rem;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-2);
  }
  .num {
    font-size: 5rem;
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.04em;
  }
  .big--c1 .num {
    font-size: 9rem;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    padding: var(--sp-1) var(--sp-2);
    white-space: nowrap;
  }
  h3 {
    margin: var(--sp-1) 0 0;
    font-size: clamp(1.75rem, 1.2rem + 1.2vw, 2.5rem);
    line-height: 1.1;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  /* The whole tile is the link */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:focus-visible {
    outline: none;
  }
  h3 a:focus-visible::after {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
    border-radius: var(--r-lg);
  }
  p {
    margin: 0;
    color: inherit;
    max-width: 34rem;
    font-size: var(--fs-body);
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: var(--sp-1) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .tags li {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    padding: 4px 12px;
  }
  .open {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-weight: 700;
    padding-top: var(--sp-2);
  }

  .soon {
    list-style: none;
    padding: 0;
    margin: var(--sp-3) 0 0;
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .soon li {
    margin: 0;
  }
  .soon a {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 80px;
    padding: var(--sp-2) var(--sp-3);
    border: 2px dashed var(--line-strong);
    border-radius: var(--r-md);
    background: transparent;
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease);
  }
  .soon a:hover {
    background: var(--surface);
    border-color: var(--ink);
  }
  .n {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex: none;
    font-size: var(--fs-h3);
    font-weight: 800;
    color: var(--muted);
    box-shadow: inset 0 0 0 2px var(--line-strong);
  }
  .soon b {
    display: block;
    line-height: 1.2;
  }
  .soon small {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
