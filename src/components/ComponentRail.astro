---
import Icon from './Icon.astro';
import type { Rail } from '../data/rail';
import { url } from '../utils/url';

interface Props {
  rail: Rail;
  /** Slug of the page being viewed, or "overview". */
  current: string;
}

const { rail, current } = Astro.props;
const label = rail.number ? `Component ${rail.number}` : 'Component';
---

<aside class="rail" aria-label={`${rail.name}: pages`}>
  <details class="rail-box" open data-rail>
    <summary>
      <span class="s-l">
        <span class="s-n">{rail.number ?? '·'}</span>
        <span>{rail.name}</span>
      </span>
      <Icon name="arrow" size={16} />
    </summary>

    <div class="inner">
      <a class="head" href={url(rail.overviewHref)} aria-current={current === 'overview' ? 'page' : undefined}>
        <span class="n">{rail.number ?? '·'}</span>
        <span class="t">
          <small>{label}</small>
          <b>{rail.name}</b>
        </span>
      </a>

      <ol class="list">
        {
          rail.items.map((item) => {
            const isCurrent = item.slug === current;
            return (
              <li>
                <a href={url(item.href)} aria-current={isCurrent ? 'page' : undefined} class:list={{ on: isCurrent }}>
                  <span>{item.label}</span>
                  {item.meta && <small>{item.meta}</small>}
                </a>
                {isCurrent && item.parts && (
                  <ul class="parts">
                    {item.parts.map((p) => (
                      <li>
                        <a href={url(item.href) + p.hash}>{p.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ol>

      {
        rail.hasCardKit && (
          <div class="mode" data-mode-switch hidden>
            <span class="eb">Working with</span>
            <div class="seg" role="group" aria-label="How are you working?">
              <button type="button" data-mode="paper" aria-pressed="true">
                <Icon name="print" size={16} /> Paper
              </button>
              <button type="button" data-mode="cards" aria-pressed="false">
                <Icon name="cards" size={16} /> Cards
              </button>
            </div>
            <p class="hint">Paper: print a blank. Cards: play on the table.</p>
          </div>
        )
      }
    </div>
  </details>
</aside>

<script>
  // Open on wide screens; start closed on narrow ones so the page opens on the tool.
  const box = document.querySelector<HTMLDetailsElement>('[data-rail]');
  if (box) {
    const wide = window.matchMedia('(min-width: 62rem)');
    if (!wide.matches) box.open = false;
    wide.addEventListener('change', () => {
      if (wide.matches) box.open = true;
    });
  }
</script>

<style>
  .rail {
    align-self: start;
  }
  @media (min-width: 62rem) {
    .rail {
      position: sticky;
      top: 1.5rem;
    }
  }
  .rail-box {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
  }
  @media (min-width: 62rem) {
    .rail-box {
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
    }
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    cursor: pointer;
    font-weight: 700;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(svg) {
    transition: transform 0.15s ease;
    transform: rotate(90deg);
  }
  .rail-box[open] summary :global(svg) {
    transform: rotate(-90deg);
  }
  .s-l {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .s-n {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .inner {
    padding: 0.5rem 0.6rem 1rem;
  }
  @media (min-width: 62rem) {
    .inner {
      padding: 1rem 0.75rem 1.1rem;
    }
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem 0.55rem 0.9rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    margin-bottom: 0.5rem;
  }
  .head:hover .t b {
    text-decoration: underline;
  }
  .n {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    flex: none;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 1.35rem;
    font-weight: 800;
  }
  .t small {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .t b {
    line-height: 1.2;
    display: block;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list > li {
    margin: 0;
  }
  .list > li > a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.55rem 0.6rem;
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .list > li > a:hover {
    background: var(--ground);
  }
  .list > li > a.on {
    background: var(--accent-tint);
  }
  .list small {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    font-weight: 400;
  }
  .parts {
    list-style: none;
    margin: 0.15rem 0 0.4rem 1.3rem;
    padding: 0 0 0 0.75rem;
    border-left: 2px solid var(--line-strong);
  }
  .parts li {
    margin: 0;
  }
  .parts a {
    display: block;
    padding: 0.3rem 0.4rem;
    font-size: 0.86rem;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .parts a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .mode {
    margin-top: 1rem;
    padding: 1rem 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  .mode .eb {
    margin: 0 0 0.5rem;
  }
  .hint {
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  /* Wide screens: the rail is always open, so the phone-only summary goes. */
  @media (min-width: 62rem) {
    .rail-box summary {
      display: none;
    }
  }
</style>
