---
import { entryStep, loopText, modules } from '../data/modules';
import { toolBySlug, toolHref, tools } from '../data/tools';
import { url } from '../utils/url';

// Renders the process as plain HTML (an ordered list per module) rather than a
// picture, so it reads properly on phones, in screen readers, and when printed.
---

<div class="flow">
  <div class="entry">
    <p class="tag">{entryStep.title}</p>
    <p class="entry-text"><strong>{entryStep.text}</strong> {entryStep.detail}</p>
  </div>

  <div class="arrow down" aria-hidden="true"></div>

  <ol class="modules">
    {
      modules.map((m) => {
        let n = 0;
        const moduleTools = tools.filter((t) => t.modules.includes(m.id));
        return (
          <li class={`module m-${m.id}`}>
            <header>
              <span class="badge" aria-hidden="true">{m.number}</span>
              <div>
                <p class="cadence">{m.cadence}</p>
                <h3>
                  <span class="visually-hidden">Module {m.number}: </span>
                  {m.title}
                </h3>
              </div>
            </header>
            <p class="purpose">{m.purpose}</p>
            <ol class="steps">
              {m.items.map((item) => {
                if (item.kind === 'step') {
                  n += 1;
                  return <li class="step" value={n}>{item.text}</li>;
                }
                if (item.kind === 'note') {
                  return (
                    <li class="note">
                      <b>{item.label}:</b> {item.text}
                    </li>
                  );
                }
                const tool = toolBySlug[item.tool];
                return (
                  <li class="gate">
                    <p class="q">
                      <span aria-hidden="true">◆</span> Decision: {item.question}
                    </p>
                    <p>{item.no}</p>
                    <p>{item.yes}</p>
                    <p class="backed">
                      Backed by <a href={url(toolHref(tool.slug))}>{tool.name}</a>
                    </p>
                  </li>
                );
              })}
            </ol>
            <p class="used">
              <span>Tools</span>
              {moduleTools.map((t) => <a class="chip" href={url(toolHref(t.slug))}>{t.name.replace(/^The /, '')}</a>)}
            </p>
          </li>
        );
      })
    }
  </ol>

  <div class="loop">
    <span class="loop-icon" aria-hidden="true">↺</span>
    <p><strong>{loopText.label}.</strong> {loopText.text}</p>
  </div>
</div>

<style>
  .flow {
    display: grid;
    gap: var(--sp-2);
  }
  .entry {
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: var(--r-md);
    padding: var(--sp-2) var(--sp-3);
  }
  .tag {
    margin: 0 0 var(--sp-half);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .entry-text {
    margin: 0;
  }
  .arrow {
    justify-self: center;
    width: 2px;
    height: 1.5rem;
    background: var(--line-strong);
    position: relative;
  }
  .arrow::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -1px;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--line-strong);
    border-bottom: 0;
  }

  .modules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
    counter-reset: none;
  }
  .module {
    --mod: var(--m-context);
    --mod-soft: var(--m-context-soft);
    /* Text and badge colours that stay readable on the module's own colour. */
    --mod-ink: var(--ink);
    --mod-text: var(--c3-deep);
    position: relative;
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 5px solid var(--mod);
    border-radius: var(--r-md);
    padding: var(--sp-3);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow);
  }
  .m-person {
    --mod: var(--m-person);
    --mod-soft: var(--m-person-soft);
    --mod-ink: var(--ink);
    --mod-text: var(--c3-deep);
  }
  .m-interpret {
    --mod: var(--m-interpret);
    --mod-soft: var(--m-interpret-soft);
    --mod-ink: #fff;
    --mod-text: var(--c3-deep);
  }
  /* Arrow to the next module: down on phones, right on wide screens. */
  .module:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -1.65rem;
    transform: translateX(-50%);
    border: 0.6rem solid transparent;
    border-top-color: var(--line-strong);
    border-bottom: 0;
  }

  .module header {
    display: flex;
    gap: var(--sp-2);
    align-items: center;
    margin-bottom: var(--sp-1);
  }
  .badge {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--mod);
    color: var(--mod-ink);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--fs-lead);
  }
  .cadence {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mod-text);
  }
  h3 {
    margin: 0;
    font-size: var(--fs-lead);
  }
  .purpose {
    color: var(--ink-soft);
    font-size: var(--fs-ui);
  }

  .steps {
    list-style: none;
    margin: 0 0 var(--sp-2);
    padding: 0;
    display: grid;
    gap: var(--sp-1);
    flex: 1;
    align-content: start;
  }
  .steps li {
    margin: 0;
    font-size: var(--fs-ui);
    line-height: 1.45;
  }
  .step {
    position: relative;
    padding-left: var(--sp-4);
    counter-increment: none;
  }
  .step::before {
    content: attr(value);
    position: absolute;
    left: 0;
    top: 0.05em;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--mod-soft);
    color: var(--mod-text);
    font-size: var(--fs-xs);
    font-weight: 700;
    display: grid;
    place-items: center;
  }
  .note {
    margin-left: var(--sp-4);
    padding: var(--sp-1) var(--sp-1);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--ink-soft);
    font-size: var(--fs-ui);
  }
  .gate {
    border: 2px solid var(--mod);
    border-radius: var(--radius-sm);
    padding: var(--sp-1) var(--sp-2);
    background: var(--mod-soft);
  }
  .gate p {
    margin: 0 0 var(--sp-half);
    font-size: var(--fs-ui);
  }
  .gate .q {
    font-weight: 700;
    color: var(--mod-text);
    font-size: var(--fs-ui);
  }
  .gate .backed {
    margin: var(--sp-1) 0 0;
    font-size: var(--fs-ui);
  }
  .used {
    margin: 0;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
    align-items: center;
  }
  .used span {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-right: var(--sp-half);
  }

  .loop {
    display: flex;
    gap: var(--sp-2);
    align-items: center;
    padding: var(--sp-2) var(--sp-3);
    border: 2px dashed var(--line-strong);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .loop p {
    margin: 0;
  }
  .loop-icon {
    font-size: 2rem;
    line-height: 1;
    color: var(--accent);
  }

  @media (min-width: 62rem) {
    .modules {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-5);
      align-items: stretch;
    }
    .module:not(:last-child)::after {
      left: auto;
      right: -1.65rem;
      bottom: auto;
      top: 2.4rem;
      transform: none;
      border: 0.6rem solid transparent;
      border-left-color: var(--line-strong);
      border-right: 0;
    }
  }
</style>
