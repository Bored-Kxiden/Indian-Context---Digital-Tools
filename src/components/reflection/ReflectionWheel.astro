---
import { wheel } from '../../data/reflection';

// The Look back wheel: twelve blank wedges in three rings (outer: touched it, middle: looked into it,
// centre: in depth). Same geometry as the printed page (R·E2); drawn in the site's ink and sand.
const C = 200;
const R_OUT = 185;
const R_MID = 138;
const R_IN = 92;
const R_HUB = 44;
const spokes = Array.from({ length: 12 }, (_, i) => {
  const a = (i * 30 - 90) * (Math.PI / 180);
  const p = (r: number) => [(C + r * Math.cos(a)).toFixed(1), (C + r * Math.sin(a)).toFixed(1)];
  const [x1, y1] = p(R_HUB);
  const [x2, y2] = p(R_OUT);
  return { x1, y1, x2, y2 };
});
---

<figure class="wheel">
  <svg viewBox="0 0 400 400" role="img" aria-labelledby="wheel-t wheel-d">
    <title id="wheel-t">A blank wheel of twelve wedges</title>
    <desc id="wheel-d">
      Three rings. The outer ring means you touched that dimension, the middle ring that you looked into it, and the centre that you went
      in depth. Write one dimension on each wedge and shade it as far in as you went.
    </desc>
    <circle cx={C} cy={C} r={R_OUT} class="disc" />
    <circle cx={C} cy={C} r={R_MID} class="ring" />
    <circle cx={C} cy={C} r={R_IN} class="ring" />
    {spokes.map((s) => <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} class="spoke" />)}
    <circle cx={C} cy={C} r={R_HUB} class="hub" />
    <text x={C} y={C - 4} text-anchor="middle" class="hubt">EXPLORE</text>
    <text x={C} y={C + 10} text-anchor="middle" class="hubt">IN DEPTH</text>
  </svg>
  <figcaption>
    <ul>
      {wheel.rings.map((r) => <li><b>{r.name}</b> · {r.means}</li>)}
    </ul>
  </figcaption>
</figure>

<style>
  .wheel {
    margin: 0;
    display: grid;
    gap: var(--sp-2);
    justify-items: center;
  }
  svg {
    width: min(100%, 30rem);
    height: auto;
    display: block;
  }
  .disc {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .ring {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .spoke {
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .hub {
    fill: var(--ink);
  }
  .hubt {
    fill: #fff;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 1px;
  }
  figcaption ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-1) var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  figcaption li {
    margin: 0;
  }
</style>
