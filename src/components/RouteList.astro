---
import Icon from './Icon.astro';
import { url } from '../utils/url';

interface Item {
  label: string;
  href: string;
  blurb: string;
  time?: string;
}
interface Props {
  items: Item[];
  /** Show 1, 2, 3… in a circle. */
  numbered?: boolean;
}

const { items, numbered = false } = Astro.props;
---

<ol class="route">
  {
    items.map((i, n) => (
      <li>
        <a href={url(i.href)}>
          {numbered ? <span class="n" aria-hidden="true">{n + 1}</span> : <span class="dot" aria-hidden="true" />}
          <span class="body">
            <b>{i.label}</b>
            <span>{i.blurb}</span>
          </span>
          {i.time && <span class="time">{i.time}</span>}
          <Icon name="arrow" size={20} />
        </a>
      </li>
    ))
  }
</ol>

<style>
  .route {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--line-strong);
  }
  .route li {
    margin: 0;
    border-bottom: 1px solid var(--line-strong);
  }
  a {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 72px;
    padding: var(--sp-2) var(--sp-1);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease);
  }
  a:hover {
    background: var(--accent-tint);
  }
  a:hover b {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  a:focus-visible {
    outline-offset: -3px;
  }
  a :global(svg) {
    transition: transform var(--t-fast) var(--ease);
    flex: none;
  }
  a:hover :global(svg) {
    transform: translateX(4px);
  }
  .n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 800;
  }
  .dot {
    width: 16px;
    height: 16px;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
    margin-inline: var(--sp-1);
  }
  .body {
    flex: 1;
    display: grid;
    gap: var(--sp-half);
  }
  .body b {
    font-size: var(--fs-h4);
    line-height: 1.25;
  }
  .body span {
    color: var(--ink-soft);
  }
  .time {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    padding: 4px 12px;
    white-space: nowrap;
    color: var(--muted);
  }
  @media (max-width: 36rem) {
    .time {
      display: none;
    }
  }
</style>
