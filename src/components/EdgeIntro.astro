---
import Section from './Section.astro';
import { intro, site } from '../data/site';

// The toolkit's introductory statement, set out in the owner's words (see `intro` in site.ts).
---

<Section id="premise" eyebrow="Introduction" title="Start from the situation, not the default." tone="white" split>
  <div class="prose-big">
    {intro.opening.map((p) => <p>{p}</p>)}
    <p class="turn">{intro.turn}</p>
  </div>
  <p class="purpose"><b>{site.name}</b> {intro.purpose}</p>
  <p class="move-lead">{intro.shift.lead}</p>
  <div class="move">
    <figure class="mv mv--from">
      <figcaption class="lbl">From</figcaption>
      <blockquote>{intro.shift.from}</blockquote>
    </figure>
    <span class="arrow" aria-hidden="true">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </span>
    <figure class="mv mv--to">
      <figcaption class="lbl">To</figcaption>
      <blockquote>{intro.shift.to}</blockquote>
    </figure>
  </div>
</Section>

<style>
  .prose-big {
    max-width: 44rem;
  }
  .prose-big p {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    margin: 0 0 var(--sp-2);
  }
  .prose-big .turn {
    color: var(--ink);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.25;
    letter-spacing: -0.005em;
    margin-top: var(--sp-3);
    padding-left: var(--sp-2);
    border-left: 4px solid var(--ink);
  }
  .purpose {
    font-size: var(--fs-lead);
    max-width: 44rem;
    margin: var(--sp-4) 0 var(--sp-2);
  }
  .move-lead {
    margin: 0 0 var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .move {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
  }
  .mv {
    margin: 0;
    border-radius: var(--r-lg);
    padding: var(--sp-3) var(--sp-4);
  }
  .mv blockquote {
    margin: var(--sp-1) 0 0;
    font-size: var(--fs-h3);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.005em;
  }
  .mv--from {
    background: var(--ground);
    border: 2px solid var(--line-strong);
  }
  .mv--to {
    background: var(--ink);
    border: 2px solid var(--ink);
    color: #fff;
  }
  .mv--to .lbl {
    color: rgb(255 255 255 / 0.85);
  }
  .arrow {
    display: none;
    align-self: center;
    color: var(--ink);
  }
  @media (min-width: 48rem) {
    .move {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: var(--sp-2);
    }
    .arrow {
      display: inline-flex;
    }
  }
</style>
