---
import Icon from './Icon.astro';
import type { Download } from '../data/downloads';
import { url } from '../utils/url';

interface Props {
  item: Download;
  /** Smaller, one-line version for lists inside a tool page. */
  compact?: boolean;
}

const { item, compact = false } = Astro.props;
---

{
  compact ? (
    <a class="dl-row" href={url(item.href)} download>
      <span class="ic"><Icon name="download" size={18} /></span>
      <span class="t">
        {item.title}
        <span class="m" data-no-index>
          {item.format} · {item.size}
        </span>
      </span>
    </a>
  ) : (
    <article class="card dl" data-c={item.component}>
      <div class="top" data-no-index>
        <span class="fmt">{item.format}</span>
        <div class="meta">
          <span>{item.size}</span>
          {item.pages && <span>{item.pages} {item.pages === 1 ? 'page' : 'pages'}</span>}
          {item.status && <span class:list={['chip', item.status === 'Final' ? 'chip--ok' : 'chip--warn']}>{item.status}</span>}
        </div>
      </div>
      <h3>{item.title}</h3>
      <p>{item.description}</p>
      {item.note && <p class="note-line">{item.note}</p>}
      <div class="actions">
        <a class="btn btn--sm btn--accent" href={url(item.href)} download>
          <Icon name="download" size={16} /> Download {item.format}
          <span class="visually-hidden">: {item.title}</span>
        </a>
        {item.page && <a href={url(item.page)}>Where it’s used</a>}
      </div>
    </article>
  )
}

<style>
  .dl {
    display: flex;
    flex-direction: column;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
  }
  .fmt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent-tint);
    color: var(--accent-deep);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-half) var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  h3 {
    margin-bottom: var(--sp-1);
    font-size: var(--fs-h4);
  }
  p {
    margin-bottom: var(--sp-1);
    color: var(--ink-soft);
  }
  .note-line {
    font-size: var(--fs-ui);
    color: var(--muted);
  }
  .actions {
    margin-top: auto;
    padding-top: var(--sp-1);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-3);
    font-size: var(--fs-ui);
  }

  .dl-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 56px;
    padding: var(--sp-1) var(--sp-2);
    border: 2px solid var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--fs-ui);
    transition: border-color var(--t-fast) var(--ease);
  }
  .dl-row:hover {
    border-color: var(--ink);
  }
  .dl-row .ic {
    display: inline-flex;
    color: var(--accent-deep);
  }
  .dl-row .t {
    font-weight: 600;
    flex: 1;
    line-height: 1.3;
    display: grid;
    gap: 2px;
  }
  .dl-row .m {
    font-weight: 400;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
