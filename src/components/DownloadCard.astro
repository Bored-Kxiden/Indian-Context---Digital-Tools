---
import Icon from './Icon.astro';
import type { Download } from '../data/downloads';
import { url } from '../utils/url';

interface Props {
  item: Download;
  /** Smaller, one-line version for lists inside a tool page. */
  compact?: boolean;
}

const { item, compact = false } = Astro.props;
---

{
  compact ? (
    <a class="dl-row" href={url(item.href)} download>
      <span class="ic"><Icon name="download" size={18} /></span>
      <span class="t">{item.title}</span>
      <span class="m">
        {item.format} · {item.size}
      </span>
    </a>
  ) : (
    <article class="card dl" data-c={item.component}>
      <div class="top">
        <span class="fmt">{item.format}</span>
        <div class="meta">
          <span>{item.size}</span>
          {item.pages && <span>{item.pages} {item.pages === 1 ? 'page' : 'pages'}</span>}
          {item.status && <span class:list={['chip', item.status === 'Final' ? 'chip--ok' : 'chip--warn']}>{item.status}</span>}
        </div>
      </div>
      <h3>{item.title}</h3>
      <p>{item.description}</p>
      {item.note && <p class="note-line">{item.note}</p>}
      <div class="actions">
        <a class="btn btn--sm btn--accent" href={url(item.href)} download>
          <Icon name="download" size={16} /> Download {item.format}
          <span class="visually-hidden">: {item.title}</span>
        </a>
        {item.page && <a href={url(item.page)}>Where it’s used</a>}
      </div>
    </article>
  )
}

<style>
  .dl {
    display: flex;
    flex-direction: column;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .fmt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--accent-tint);
    color: var(--ink);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  h3 {
    margin-bottom: 0.4rem;
    font-size: 1.2rem;
  }
  p {
    margin-bottom: 0.6rem;
    color: var(--ink-soft);
  }
  .note-line {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .actions {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.2rem;
    font-size: 0.95rem;
  }

  .dl-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .dl-row:hover {
    border-color: var(--ink);
  }
  .dl-row .ic {
    display: inline-flex;
    color: var(--accent);
  }
  .dl-row .t {
    font-weight: 600;
    flex: 1;
    line-height: 1.3;
  }
  .dl-row .m {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
