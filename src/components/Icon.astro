  bolt: '<path d="M13 3 5 13h6l-1 8 8-10h-6z"/>',
  pin: '<path d="M12 21s6-5.2 6-10a6 6 0 0 0-12 0c0 4.8 6 10 6 10z"/><circle cx="12" cy="11" r="2.2"/>',
