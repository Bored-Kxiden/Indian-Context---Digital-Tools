---
// Four overlapping circles: one per component, with "you" where they meet. Decorative.
---

<svg viewBox="0 0 520 470" role="img" aria-label="Four overlapping circles for the four files: existing products, visual culture, language, and material reality, with “you” in the middle." class="venn">
  <g class="circles">
    <circle class="c c1" cx="205" cy="190" r="125" fill="#1e6b52" style="--d: 0ms"></circle>
    <circle class="c c2" cx="315" cy="190" r="125" fill="#e8a92a" style="--d: 90ms"></circle>
    <circle class="c c3" cx="205" cy="300" r="125" fill="#b8492c" style="--d: 180ms"></circle>
    <circle class="c c4" cx="315" cy="300" r="125" fill="#3144a6" style="--d: 270ms"></circle>
  </g>
  <circle cx="260" cy="245" r="30" fill="#faf7f0"></circle>
  <text x="260" y="251" text-anchor="middle" class="you">YOU</text>
  <g class="lab" fill="#fff">
    <text x="128" y="128" class="n">1</text>
    <text x="128" y="152" class="w">EXISTING</text>
    <text x="128" y="168" class="w">PRODUCTS</text>
    <g fill="#16140f">
      <text x="392" y="128" class="n" text-anchor="end">2</text>
      <text x="392" y="152" class="w" text-anchor="end">VISUAL</text>
      <text x="392" y="168" class="w" text-anchor="end">CULTURE</text>
    </g>
    <text x="128" y="342" class="n">3</text>
    <text x="128" y="366" class="w">LANGUAGE</text>
    <text x="392" y="342" class="n" text-anchor="end">4</text>
    <text x="392" y="366" class="w" text-anchor="end">MATERIAL</text>
    <text x="392" y="382" class="w" text-anchor="end">REALITY</text>
  </g>
</svg>

<style>
  .venn {
    width: 100%;
    max-width: 44rem;
    height: auto;
  }
  .c {
    fill-opacity: 0.88;
    transform-box: fill-box;
    transform-origin: center;
    animation: pop 700ms var(--ease) both;
    animation-delay: var(--d);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.82);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .lab text {
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .lab .n {
    font-family: var(--font-body);
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .lab .w {
    font-size: 14px;
  }
  .you {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    font-weight: 600;
    fill: #16140f;
  }
</style>
