---
import Icon from './Icon.astro';
import { functionsUrl } from '../data/backend';
import { url } from '../utils/url';
import '../styles/ask.css';

// "Ask the toolkit" as a chat popup, on every page except /ask/ itself. The guide in the header (the bubble with
// eyes, D47) opens a small chat window in the bottom right corner, on phones as well as on large screens. The page
// stays usable behind it (the popup is not modal); the guide closes it again, and so do the close button and Escape.
// The "Ask" links in the menu, footer and the "Find a tool" search open the popup too (with a question, if the search
// had one); only the popup's expand link goes to the full /ask/ page.
// The answer code and data load only when someone opens it (pages stay light on prepaid data), the conversation
// follows the reader from page to page for the visit, and on a tool page the suggestions are about that tool.
// On a large screen an open popup stays open on the next page, so a link in an answer doesn't lose the chat.
// Without JavaScript the guide is a link to /ask/.

const tries = ['What is reverse thick translation?', 'Which tool shows who people depend on?', 'Kahavat kya hai?', 'How do I run the Villain Story?'];
---

<aside class="chat" aria-label="Ask the toolkit" data-chat data-functions={functionsUrl} data-base={url('/')}>
  <section class="pop" id="chat-panel" role="dialog" aria-labelledby="chat-title" aria-describedby="chat-sub" tabindex="-1" hidden data-chat-panel>
    <div class="ph">
      <h2 id="chat-title">Ask the toolkit</h2>
      <button type="button" class="x" data-chat-close title="Close the chat"><span aria-hidden="true">×</span><span class="visually-hidden">Close the chat</span></button>
    </div>

    <div class="body" data-chat-scroll>
      <div class="intro" data-chat-intro>
        <p class="hello">Hello. Ask me about any tool in the kit, or what to use first.</p>
        <p class="tl" id="chat-tries">Try asking</p>
        <ul class="tries" data-chat-tries aria-labelledby="chat-tries">
          {
            tries.map((t) => (
              <li>
                <button type="button" class="try" data-try={t}>
                  {t}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
      <ol class="log" data-chat-log aria-label="Questions and answers"></ol>
    </div>

    <form class="bar" data-chat-form autocomplete="off">
      <label for="chat-q" class="visually-hidden">Your question</label>
      <input id="chat-q" name="q" type="text" maxlength="300" required placeholder="Ask a question…" enterkeyhint="send" />
      <button class="send" type="submit">Send</button>
    </form>
    <p class="fine" id="chat-sub">
      Answers come from the toolkit’s own pages, in English, Hindi or Hinglish (no AI). Don’t type participants’ names.
      <a href={url('/ask/')}>Full page</a>
      <button type="button" class="clear" data-chat-clear>Clear</button>
    </p>
    <p class="visually-hidden" role="status" aria-live="polite" data-chat-status></p>
  </section>

</aside>

<script>
  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) {
    // The guide in the header is the button that opens and closes the popup.
    const launcher = document.querySelector<HTMLAnchorElement>('[data-chat-open]');
    const panel = root.querySelector<HTMLElement>('[data-chat-panel]')!;
    const scroller = root.querySelector<HTMLElement>('[data-chat-scroll]')!;
    const log = root.querySelector<HTMLOListElement>('[data-chat-log]')!;
    const intro = root.querySelector<HTMLElement>('[data-chat-intro]')!;
    const tries = root.querySelector<HTMLElement>('[data-chat-tries]')!;
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!;
    const input = root.querySelector<HTMLInputElement>('#chat-q')!;
    const status = root.querySelector<HTMLElement>('[data-chat-status]')!;
    const dot = document.querySelector<HTMLElement>('[data-chat-dot]');
    const small = matchMedia('(max-width: 40rem)');
    // Touch screens: don't jump straight into the text box, or the keyboard covers the popup as it opens.
    const touch = matchMedia('(pointer: coarse)');
    const OPEN = 'bte-ask-open';

    type Chat = ReturnType<typeof import('../scripts/ask/ui').createAsk>;
    let chat: Chat | null = null;
    let starting: Promise<Chat> | null = null;

    const session = {
      get: (k: string) => {
        try {
          return sessionStorage.getItem(k);
        } catch {
          return null;
        }
      },
      set: (k: string, v: string | null) => {
        try {
          if (v === null) sessionStorage.removeItem(k);
          else sessionStorage.setItem(k, v);
        } catch {
          /* ignore */
        }
      },
    };
    const saved = () => {
      try {
        return (JSON.parse(session.get('bte-ask-v1') ?? '[]') as unknown[]).length > 0;
      } catch {
        return false;
      }
    };
    if (dot) dot.hidden = !saved();
    if (launcher) {
      launcher.setAttribute('role', 'button');
      launcher.setAttribute('aria-controls', 'chat-panel');
      launcher.setAttribute('aria-expanded', 'false');
    }

    const syncIntro = () => (intro.hidden = log.children.length > 0);
    new MutationObserver(syncIntro).observe(log, { childList: true });

    // The answer code is loaded on first open only.
    function start() {
      starting ??= import('../scripts/ask/ui').then(({ createAsk }) => {
        chat = createAsk({ log, status, base: root!.dataset.base ?? '/', functionsUrl: root!.dataset.functions ?? '', scroller });
        chat.restore();
        syncIntro();
        chat.suggestionsFor(location.pathname, []).then((qs) => {
          if (!qs.length) return;
          tries.replaceChildren(
            ...qs.map((q) => {
              const li = document.createElement('li');
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'try';
              b.textContent = q;
              b.addEventListener('click', () => chat?.ask(q));
              li.append(b);
              return li;
            }),
          );
        });
        return chat;
      });
      return starting;
    }

    function open(focus = true) {
      if (!panel.hidden) {
        if (focus) input.focus();
        return;
      }
      panel.hidden = false;
      root!.classList.add('is-open');
      launcher?.setAttribute('aria-expanded', 'true');
      session.set(OPEN, '1');
      if (focus) (touch.matches ? panel : input).focus();
      return start();
    }
    function close(returnFocus = true) {
      panel.hidden = true;
      root!.classList.remove('is-open');
      launcher?.setAttribute('aria-expanded', 'false');
      session.set(OPEN, null);
      if (dot) dot.hidden = !saved();
      if (returnFocus) launcher?.focus();
    }

    launcher?.addEventListener('click', (e) => {
      // Ctrl/Cmd-click still opens the full /ask/ page.
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      if (panel.hidden) open();
      else close();
    });
    // It is a link that acts as a button, so Space works too.
    launcher?.addEventListener('keydown', (e) => {
      if (e.key === ' ') {
        e.preventDefault();
        launcher.click();
      }
    });
    // The guide's tour and nudges can open the chat.
    document.addEventListener('bte:ask-open', () => open());
    root.querySelector('[data-chat-close]')!.addEventListener('click', () => close());
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        e.stopPropagation();
        close();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = input.value;
      input.value = '';
      (await start()).ask(q);
    });
    root.querySelectorAll<HTMLButtonElement>('[data-try]').forEach((b) => b.addEventListener('click', async () => (await start()).ask(b.dataset.try ?? '')));
    root.querySelector('[data-chat-clear]')!.addEventListener('click', async () => {
      (await start()).clear();
      input.focus();
    });
    // Following a link from an answer: on a phone the popup closes, so the new page isn't under it. On a large
    // screen it stays open and opens again on the next page.
    log.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a');
      if (link && small.matches && !link.hasAttribute('download')) close(false);
    });

    // "Ask" links elsewhere on the page (header, menu, footer, "Find a tool") open the popup instead of the full page.
    // A question in the link (?q=…) is asked straight away. Ctrl/Cmd-click still opens the full page.
    document.addEventListener('click', async (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-ask-open]');
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      const q = new URL(a.href, location.href).searchParams.get('q')?.trim();
      // Let a menu or search dialog close first, then move focus into the popup.
      await new Promise((r) => setTimeout(r));
      await open(!q);
      if (q) (await start()).ask(q);
    });

    // Open again after moving to another page, on a large screen only, without taking focus from the page.
    if (session.get(OPEN) === '1' && !small.matches) open(false);
  }
</script>

<style>
  .chat {
    --gap: var(--sp-2);
    position: fixed;
    right: max(var(--gap), env(safe-area-inset-right));
    bottom: max(var(--gap), env(safe-area-inset-bottom));
    z-index: 60;
    font-size: var(--fs-ui);
  }
  @media (min-width: 64rem) {
    .chat {
      --gap: var(--sp-3);
    }
  }

  /* The popup, in the bottom right corner */
  .pop {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(380px, calc(100vw - 2 * var(--gap)));
    height: min(520px, calc(100dvh - var(--header-h) - 2 * var(--gap)));
    display: flex;
    flex-direction: column;
    background: #f7f5ef;
    color: #1b1b1b;
    border-radius: 4px;
    box-shadow: 0 24px 70px rgb(0 0 0 / 0.67);
    --focus: var(--ink);
    overflow: hidden;
    transform-origin: 100% 100%;
  }
  .pop[hidden] {
    display: none;
  }
  .pop:focus {
    outline: none;
  }
  .pop:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pop:not([hidden]) {
      animation: pop var(--t-med) var(--ease);
    }
    @keyframes pop {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.96);
      }
    }
  }
  .ph {
    background: #1b1b1b;
    color: #faf9f4;
    padding: 14px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .ph h2 {
    font-family: var(--font-cover);
    font-style: normal;
    font-weight: 400;
    font-size: 20px;
    text-transform: uppercase;
    line-height: 1.2;
    margin: 0;
    color: #faf9f4;
  }
  .x {
    width: 32px;
    height: 32px;
    margin: -6px -8px -6px 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }
  .x:hover {
    opacity: 0.85;
  }
  .x:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 0;
  }

  .body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 18px;
  }
  .intro[hidden] {
    display: none;
  }
  /* The opening line reads as the toolkit's first message */
  .hello {
    margin: 0 0 12px;
    max-width: 85%;
    background: #ece8df;
    border-radius: 3px;
    padding: 11px 14px;
    font-family: var(--font-read);
    font-size: 18px;
    line-height: 1.35;
  }
  .tl {
    margin: 0 0 var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .body :global(.try) {
    font: inherit;
    font-size: var(--fs-sm);
    text-align: left;
    min-height: 36px;
    padding: var(--sp-half) var(--sp-2);
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .body :global(.try:hover) {
    background: var(--ink);
    color: #fff;
  }
  .body :global(.try:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bar {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid #d9d5ca;
    background: #f7f5ef;
  }
  .bar input {
    flex: 1;
    min-width: 0;
    min-height: 0;
    height: auto;
    font-family: var(--font-ui);
    font-size: 13px;
    padding: 10px 14px;
    border: 1px solid #1b1b1b;
    border-radius: 99px;
    background: #fff;
    color: #1b1b1b;
    outline: none;
  }
  /* 16px on touch screens, so phones don't zoom in when the box gets focus */
  @media (pointer: coarse) {
    .bar input {
      font-size: 16px;
    }
  }
  .bar input:focus-visible {
    outline: 2px solid #1b1b1b;
    outline-offset: 2px;
  }
  .send {
    flex: none;
    border: 0;
    border-radius: 99px;
    padding: 10px 16px;
    background: #1b1b1b;
    color: #faf9f4;
    font-family: var(--font-ui);
    font-size: 13px;
    cursor: pointer;
  }
  .send:hover {
    opacity: 0.85;
  }
  .send:focus-visible {
    outline: 2px solid #1b1b1b;
    outline-offset: 2px;
  }
  .fine {
    margin: 0;
    padding: 0 12px 10px;
    background: #f7f5ef;
    font-family: var(--font-ui);
    font-size: 11px;
    line-height: 1.4;
    color: #5f5c56;
  }
  .fine a,
  .clear {
    font: inherit;
    background: none;
    border: 0;
    padding: 0 0 0 6px;
    color: #1b1b1b;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  /* Answers, tighter than on the full page: questions on the right, answers on the left, as chat bubbles */
  .body :global(.askui) {
    gap: var(--sp-3);
  }
  .body :global(.askui .turn > .q) {
    max-width: 85%;
    background: #1b1b1b;
    color: #faf9f4;
    padding: 11px 14px;
    border-radius: 3px;
    font-family: var(--font-read);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.35;
  }
  .body :global(.askui .a .ans) {
    padding: 11px 14px;
    border-radius: 3px;
    background: #ece8df;
    font-size: 18px;
    line-height: 1.35;
  }
  .body :global(.askui .a h3) {
    font-size: var(--fs-ui);
  }
  .body :global(.askui .a .tool .q) {
    font-size: var(--fs-sm);
  }
  .body :global(.askui .a .compare) {
    grid-template-columns: minmax(0, 1fr);
  }

  @media print {
    .chat {
      display: none;
    }
  }
</style>
