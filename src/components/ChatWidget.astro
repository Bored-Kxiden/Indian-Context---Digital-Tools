---
import Icon from './Icon.astro';
import { functionsUrl } from '../data/backend';
import { url } from '../utils/url';
import '../styles/ask.css';

// "Ask the toolkit" as a chat popup, on every page except /ask/ itself: a round button at the bottom right opens a
// small chat window just above it, on phones as well as on large screens. The page stays usable behind it (the popup
// is not modal); the button closes it again, and so does Escape. The "Ask" links in the header, menu, footer and the
// "Find a tool" search open the popup too (with a question, if the search had one); only the popup's expand link
// goes to the full /ask/ page.
// The answer code and data load only when someone opens it (pages stay light on prepaid data), the conversation
// follows the reader from page to page for the visit, and on a tool page the suggestions are about that tool.
// On a large screen an open popup stays open on the next page, so a link in an answer doesn't lose the chat.
// Without JavaScript the button is a link to /ask/.

const tries = ['What is reverse thick translation?', 'Which tool shows who people depend on?', 'Kahavat kya hai?', 'How do I run the Villain Story?'];
---

<aside class="chat" aria-label="Ask the toolkit" data-chat data-functions={functionsUrl} data-base={url('/')}>
  <section class="pop" id="chat-panel" role="dialog" aria-labelledby="chat-title" aria-describedby="chat-sub" tabindex="-1" hidden data-chat-panel>
    <div class="ph">
      <span class="av" aria-hidden="true"><Icon name="chat" size={20} /></span>
      <div class="pt">
        <h2 id="chat-title">Ask the toolkit</h2>
        <p class="sub" id="chat-sub">From the toolkit’s own pages · no AI</p>
      </div>
      <a class="hb" href={url('/ask/')} title="Open as a full page">
        <Icon name="expand" size={20} />
        <span class="visually-hidden">Open as a full page</span>
      </a>
      <button type="button" class="hb" data-chat-close title="Close the chat">
        <Icon name="chevron-down" size={22} />
        <span class="visually-hidden">Close the chat</span>
      </button>
    </div>

    <div class="body" data-chat-scroll>
      <div class="intro" data-chat-intro>
        <p class="hello">Ask about any tool, step or term, in English, Hindi or Hinglish. Answers come from the toolkit’s own pages.</p>
        <p class="tl" id="chat-tries">Try asking</p>
        <ul class="tries" data-chat-tries aria-labelledby="chat-tries">
          {
            tries.map((t) => (
              <li>
                <button type="button" class="try" data-try={t}>
                  {t}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
      <ol class="log" data-chat-log aria-label="Questions and answers"></ol>
    </div>

    <form class="bar" data-chat-form autocomplete="off">
      <label for="chat-q" class="visually-hidden">Your question</label>
      <input id="chat-q" name="q" type="text" maxlength="300" required placeholder="Type a question…" enterkeyhint="send" />
      <button class="send" type="submit" title="Ask">
        <Icon name="arrow" size={20} />
        <span class="visually-hidden">Ask</span>
      </button>
    </form>
    <p class="fine">
      Don’t type participants’ names or personal details.
      <button type="button" class="clear" data-chat-clear>Clear</button>
    </p>
    <p class="visually-hidden" role="status" aria-live="polite" data-chat-status></p>
  </section>

  <button type="button" class="launcher" hidden data-chat-open aria-controls="chat-panel" aria-expanded="false" title="Ask the toolkit">
    <span class="ics" aria-hidden="true">
      <span class="ic ic-open"><Icon name="chat" size={24} /></span>
      <span class="ic ic-close"><Icon name="x" size={22} /></span>
    </span>
    <span class="ll ll-open">Ask a question</span>
    <span class="ll ll-close">Close</span>
    <span class="dot" hidden data-chat-dot><span class="visually-hidden">(conversation in progress)</span></span>
  </button>
  <noscript>
    <a class="launcher" href={url('/ask/')} title="Ask the toolkit">
      <span class="ic ic-open"><Icon name="chat" size={24} /></span>
      <span class="ll">Ask a question</span>
    </a>
  </noscript>
</aside>

<script>
  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) {
    const launcher = root.querySelector<HTMLButtonElement>('[data-chat-open]')!;
    const panel = root.querySelector<HTMLElement>('[data-chat-panel]')!;
    const scroller = root.querySelector<HTMLElement>('[data-chat-scroll]')!;
    const log = root.querySelector<HTMLOListElement>('[data-chat-log]')!;
    const intro = root.querySelector<HTMLElement>('[data-chat-intro]')!;
    const tries = root.querySelector<HTMLElement>('[data-chat-tries]')!;
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!;
    const input = root.querySelector<HTMLInputElement>('#chat-q')!;
    const status = root.querySelector<HTMLElement>('[data-chat-status]')!;
    const dot = root.querySelector<HTMLElement>('[data-chat-dot]')!;
    const small = matchMedia('(max-width: 40rem)');
    // Touch screens: don't jump straight into the text box, or the keyboard covers the popup as it opens.
    const touch = matchMedia('(pointer: coarse)');
    const OPEN = 'bte-ask-open';

    type Chat = ReturnType<typeof import('../scripts/ask/ui').createAsk>;
    let chat: Chat | null = null;
    let starting: Promise<Chat> | null = null;

    const session = {
      get: (k: string) => {
        try {
          return sessionStorage.getItem(k);
        } catch {
          return null;
        }
      },
      set: (k: string, v: string | null) => {
        try {
          if (v === null) sessionStorage.removeItem(k);
          else sessionStorage.setItem(k, v);
        } catch {
          /* ignore */
        }
      },
    };
    const saved = () => {
      try {
        return (JSON.parse(session.get('bte-ask-v1') ?? '[]') as unknown[]).length > 0;
      } catch {
        return false;
      }
    };
    dot.hidden = !saved();
    launcher.hidden = false;

    const syncIntro = () => (intro.hidden = log.children.length > 0);
    new MutationObserver(syncIntro).observe(log, { childList: true });

    // The answer code is loaded on first open only.
    function start() {
      starting ??= import('../scripts/ask/ui').then(({ createAsk }) => {
        chat = createAsk({ log, status, base: root!.dataset.base ?? '/', functionsUrl: root!.dataset.functions ?? '', scroller });
        chat.restore();
        syncIntro();
        chat.suggestionsFor(location.pathname, []).then((qs) => {
          if (!qs.length) return;
          tries.replaceChildren(
            ...qs.map((q) => {
              const li = document.createElement('li');
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'try';
              b.textContent = q;
              b.addEventListener('click', () => chat?.ask(q));
              li.append(b);
              return li;
            }),
          );
        });
        return chat;
      });
      return starting;
    }

    function open(focus = true) {
      if (!panel.hidden) {
        if (focus) input.focus();
        return;
      }
      panel.hidden = false;
      root!.classList.add('is-open');
      launcher.setAttribute('aria-expanded', 'true');
      launcher.title = 'Close the chat';
      session.set(OPEN, '1');
      if (focus) (touch.matches ? panel : input).focus();
      return start();
    }
    function close(returnFocus = true) {
      panel.hidden = true;
      root!.classList.remove('is-open');
      launcher.setAttribute('aria-expanded', 'false');
      launcher.title = 'Ask the toolkit';
      session.set(OPEN, null);
      dot.hidden = !saved();
      if (returnFocus) launcher.focus();
    }

    launcher.addEventListener('click', () => (panel.hidden ? open() : close()));
    root.querySelector('[data-chat-close]')!.addEventListener('click', () => close());
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        e.stopPropagation();
        close();
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = input.value;
      input.value = '';
      (await start()).ask(q);
    });
    root.querySelectorAll<HTMLButtonElement>('[data-try]').forEach((b) => b.addEventListener('click', async () => (await start()).ask(b.dataset.try ?? '')));
    root.querySelector('[data-chat-clear]')!.addEventListener('click', async () => {
      (await start()).clear();
      input.focus();
    });
    // Following a link from an answer: on a phone the popup closes, so the new page isn't under it. On a large
    // screen it stays open and opens again on the next page.
    log.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a');
      if (link && small.matches && !link.hasAttribute('download')) close(false);
    });

    // "Ask" links elsewhere on the page (header, menu, footer, "Find a tool") open the popup instead of the full page.
    // A question in the link (?q=…) is asked straight away. Ctrl/Cmd-click still opens the full page.
    document.addEventListener('click', async (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-ask-open]');
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      const q = new URL(a.href, location.href).searchParams.get('q')?.trim();
      // Let a menu or search dialog close first, then move focus into the popup.
      await new Promise((r) => setTimeout(r));
      await open(!q);
      if (q) (await start()).ask(q);
    });

    // Open again after moving to another page, on a large screen only, without taking focus from the page.
    if (session.get(OPEN) === '1' && !small.matches) open(false);
  }
</script>

<style>
  .chat {
    --gap: var(--sp-2);
    --btn: 60px;
    position: fixed;
    right: max(var(--gap), env(safe-area-inset-right));
    bottom: max(var(--gap), env(safe-area-inset-bottom));
    z-index: 60;
    font-size: var(--fs-ui);
  }
  @media (min-width: 64rem) {
    .chat {
      --gap: var(--sp-3);
    }
  }

  /* The round button */
  /* A labelled pill, so it says what it does: "Ask a question", then "Close" while open */
  .launcher {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    height: var(--btn);
    padding: 0 var(--sp-3) 0 var(--sp-2);
    border: 0;
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: var(--fs-ui);
    font-weight: 800;
    background: var(--ink);
    color: #fff;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 10px 28px -10px rgb(22 20 15 / 0.6);
    transition:
      transform var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease);
  }
  /* On the dark home page the button turns light, so it stays visible */
  :global(body[data-theme='night']) .launcher {
    background: var(--on-night);
    color: var(--ink);
  }
  .launcher[hidden] {
    display: none;
  }
  .launcher:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -12px rgb(22 20 15 / 0.7);
  }
  .launcher:active {
    transform: scale(0.96);
  }
  .launcher:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
    box-shadow: 0 0 0 3px #fff;
  }
  .ics {
    display: grid;
    place-items: center;
  }
  .ll-close,
  .is-open .ll-open {
    display: none;
  }
  .is-open .ll-close {
    display: inline;
  }
  @media (max-width: 26rem) {
    .ll-open {
      font-size: 0;
    }
    .ll-open::after {
      content: 'Ask';
      font-size: var(--fs-ui);
    }
  }
  .ic {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      opacity var(--t-fast) var(--ease),
      transform var(--t-fast) var(--ease);
  }
  .ic-close,
  .is-open .ic-open {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }
  .is-open .ic-close {
    opacity: 1;
    transform: none;
  }
  .dot {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c2);
    border: 2px solid var(--ink);
  }
  .dot[hidden],
  .is-open .dot {
    display: none;
  }

  /* The popup, just above the button */
  .pop {
    position: absolute;
    right: 0;
    bottom: calc(var(--btn) + var(--sp-2));
    width: min(24rem, calc(100vw - 2 * var(--gap)));
    height: min(36rem, calc(100dvh - var(--btn) - var(--sp-2) - 2 * var(--gap) - var(--sp-2)));
    display: flex;
    flex-direction: column;
    background: var(--surface);
    color: var(--ink);
    border-radius: var(--r-md);
    box-shadow: 0 24px 70px rgb(0 0 0 / 0.55);
    --focus: var(--ink);
    overflow: hidden;
    transform-origin: calc(100% - var(--btn) / 2) 100%;
  }
  .pop[hidden] {
    display: none;
  }
  .pop:focus {
    outline: none;
  }
  .pop:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pop:not([hidden]) {
      animation: pop var(--t-med) var(--ease);
    }
    @keyframes pop {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.96);
      }
    }
  }
  @media (max-width: 40rem) {
    .chat {
      --btn: 56px;
    }
    .pop {
      height: min(32rem, calc(100dvh - var(--btn) - var(--sp-2) - 2 * var(--gap) - var(--sp-4)));
    }
  }

  .ph {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    padding: var(--sp-1) var(--sp-half) var(--sp-1) var(--sp-2);
    background: var(--ink);
    color: #fff;
  }
  .av {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
  }
  .pt {
    flex: 1;
    min-width: 0;
  }
  .ph h2 {
    font-family: var(--font-cover);
    font-style: normal;
    font-weight: 400;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.2;
    margin: 0;
    color: #fff;
  }
  .sub {
    margin: 2px 0 0;
    font-size: var(--fs-xs);
    color: var(--on-dark);
    line-height: 1.3;
  }
  .hb {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--r-sm);
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  .hb:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .hb:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -3px;
  }

  .body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--sp-2);
  }
  .intro[hidden] {
    display: none;
  }
  /* The opening line reads as the toolkit's first message */
  .hello {
    margin: 0 0 var(--sp-2);
    max-width: 90%;
    background: var(--ground);
    border-radius: var(--r-sm);
    padding: 11px 14px;
    font-size: 1.125rem;
    line-height: 1.35;
  }
  .tl {
    margin: 0 0 var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .body :global(.try) {
    font: inherit;
    font-size: var(--fs-sm);
    text-align: left;
    min-height: 36px;
    padding: var(--sp-half) var(--sp-2);
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .body :global(.try:hover) {
    background: var(--ink);
    color: #fff;
  }
  .body :global(.try:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bar {
    display: flex;
    gap: var(--sp-1);
    padding: var(--sp-1) var(--sp-1) 0 var(--sp-2);
    border-top: 1px solid var(--line-strong);
    background: var(--surface);
  }
  .bar input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    font: inherit;
    font-size: 1rem; /* 16px or more, so phones don't zoom in on focus */
    padding: 0 var(--sp-2);
    border: 1.5px solid var(--field);
    border-radius: 999px;
    background: var(--surface);
  }
  .bar input:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 1px;
  }
  .send {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    cursor: pointer;
  }
  .send:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .fine {
    margin: 0;
    padding: var(--sp-half) var(--sp-1) var(--sp-half) var(--sp-2);
    background: var(--surface);
    font-size: var(--fs-xs);
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-1);
  }
  .clear {
    font: inherit;
    background: none;
    border: 0;
    padding: 0 var(--sp-1);
    min-height: 24px;
    color: var(--ink);
    text-decoration: underline;
    cursor: pointer;
  }

  /* Answers, tighter than on the full page: questions on the right, answers on the left, as chat bubbles */
  .body :global(.askui) {
    gap: var(--sp-3);
  }
  .body :global(.askui .turn > .q) {
    max-width: 85%;
    font-size: 1.0625rem;
    border-radius: var(--r-sm);
  }
  .body :global(.askui .a .ans) {
    padding: var(--sp-2);
    border-radius: var(--r-sm);
    font-size: 1.0625rem;
  }
  .body :global(.askui .a h3) {
    font-size: var(--fs-ui);
  }
  .body :global(.askui .a .tool .q) {
    font-size: var(--fs-sm);
  }
  .body :global(.askui .a .compare) {
    grid-template-columns: minmax(0, 1fr);
  }

  @media print {
    .chat {
      display: none;
    }
  }
</style>
