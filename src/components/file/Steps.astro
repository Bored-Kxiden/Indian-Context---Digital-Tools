---
import { url } from '../../utils/url';

// "How do I use it?", as in the owner's v3 template (D48): one row per step, its number ("01") on the left and the
// step on the right, a thin rule under each. A step that is a tool links to it.
interface Props {
  steps: (string | { title: string; body: string; href?: string; meta?: string })[];
}
const { steps } = Astro.props;
---

<ol class="fsteps">
  {
    steps.map((s, i) => (
      <li>
        <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div class="t">
          {typeof s === 'string' ? (
            s
          ) : (
            <>
              <span class="hd">
                {s.href ? <a href={url(s.href)}>{s.title} →</a> : <b>{s.title}</b>}
                {s.meta && <span class="meta">{s.meta}</span>}
              </span>
              <span class="sb">{s.body}</span>
            </>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .fsteps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid #d9d5ca;
    margin: 0;
  }
  .n {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    padding-top: 0.45em;
  }
  .t {
    font-family: var(--font-read);
    font-size: clamp(20px, 1.6vw, 25px);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .hd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }
  .hd a {
    color: inherit;
    text-underline-offset: 4px;
  }
  .hd b {
    font-weight: 600;
  }
  .meta {
    font-family: var(--font-ui);
    font-size: 12px;
    text-transform: uppercase;
    color: #6f6c66;
  }
  .sb {
    display: block;
  }
</style>
