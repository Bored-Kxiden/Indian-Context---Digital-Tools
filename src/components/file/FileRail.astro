---
import { files, fileNo, type ComponentId } from '../../data/components';
import { url } from '../../utils/url';

// "All files in the kit", as in the owner's v3 template's footer (D47, D48): the five files as folders in a row that
// scrolls sideways. On a file's own pages the file you are in is faded ("You are here") and the next one is raised
// with an outline ("Next file →"). The template also fades the other folders; here they keep their full colour so
// their white labels stay readable.
interface Props {
  current?: ComponentId;
}
const { current } = Astro.props;
const at = files.findIndex((f) => f.id === current);
const next = at >= 0 ? files[(at + 1) % files.length] : undefined;
---

<nav class="rail" aria-labelledby="rail-h">
  <div class="rh">
    <h2 id="rail-h">All files in the kit</h2>
    <span aria-hidden="true">scroll →</span>
  </div>
  <ol class="row">
    {
      files.map((f) => {
        const here = f.id === current;
        const nx = next?.id === f.id;
        return (
          <li class:list={['fold', { here, nx }]} data-c={f.c}>
            <a href={url(f.href)} aria-current={here ? 'page' : undefined}>
              <span class="ftab" aria-hidden="true">
                <svg viewBox="0 0 300 66" preserveAspectRatio="none">
                  <path d="M0,66 C26,66 30,0 62,0 H238 C270,0 274,66 300,66 Z" />
                </svg>
                <span>{fileNo(f)}</span>
              </span>
              <span class="body">
                <span class="tag">{nx ? 'Next file →' : here ? 'You are here' : `Tool ${fileNo(f)}`}</span>
                <span class="nm">{f.name}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .rail {
    padding: 90px 0 20px;
    max-width: 1500px;
    margin: 0 auto;
  }
  .rh {
    display: flex;
    justify-content: space-between;
    padding: 0 48px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: #5f5c56;
    margin-bottom: 28px;
  }
  :global(body[data-theme='night']) .rh {
    color: #a9a8a3;
  }
  .rh h2 {
    font: inherit;
    margin: 0;
  }
  .row {
    list-style: none;
    margin: 0;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding: 80px 48px 20px;
  }
  .fold {
    margin: 0;
    flex: 0 0 360px;
  }
  a {
    position: relative;
    display: block;
    height: 220px;
    color: var(--accent-ink);
    text-decoration: none;
    transition: transform 0.3s;
  }
  a:hover {
    transform: translateY(-10px);
  }
  .nx a {
    transform: translateY(-14px);
  }
  .ftab {
    position: absolute;
    bottom: 100%;
    left: 20px;
    height: 52px;
    padding: 0 44px;
    display: flex;
    align-items: center;
    margin-bottom: -1px;
  }
  .ftab svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--accent);
  }
  .ftab span {
    position: relative;
    font-family: var(--font-ui);
    font-size: 18px;
  }
  .body {
    height: 100%;
    background: var(--accent);
    border-radius: 0 4px 4px 4px;
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .nx .body {
    outline: 3px solid #1b1b1b;
    outline-offset: 5px;
  }
  .tag {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .nm {
    font-family: var(--font-read);
    font-size: 30px;
    line-height: 1.08;
  }
  /* The file you are in, faded */
  .here .body,
  .here .ftab svg {
    background: color-mix(in srgb, var(--accent) 35%, #ece8df);
    fill: color-mix(in srgb, var(--accent) 35%, #ece8df);
  }
  .here a {
    color: #1b1b1b;
  }
  @media (max-width: 48rem) {
    .rh {
      padding: 0 16px;
    }
    .row {
      padding: 70px 16px 20px;
      gap: 14px;
    }
    .fold {
      flex-basis: 260px;
    }
    a {
      height: 170px;
    }
    .nm {
      font-size: 24px;
    }
  }
</style>
