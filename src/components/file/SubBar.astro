---
import type { Rail } from '../../data/rail';
import { components } from '../../data/components';
import { url } from '../../utils/url';

// Every step of a file as a row of cards, exactly as in the owner's v3 template (D47, D48): a picture of the step's
// worksheet or board, its number and name, how demanding it is and how long it takes. The row scrolls sideways; the
// card you are on is highlighted and scrolled into view. Each card opens its page at this row (#steps, set by
// FileShell), so only what is below it changes.
interface Props {
  rail: Rail;
  /** Slug of the page being viewed, or "overview". */
  current: string;
}
const { rail, current } = Astro.props;
const comp = components.find((c) => c.href === rail.overviewHref);
const items = [{ slug: 'overview', label: 'Overview', href: rail.overviewHref, thumb: rail.overviewThumb, level: comp?.level, meta: comp?.hours }, ...rail.items];
const levels = ['', 'Light', 'Moderate', 'Complex'];
const pad = (k: number) => String(k).padStart(2, '0');
---

<nav class="strip" aria-label="Steps in this file" data-tour="strip" data-strip>
  {
    items.map((item, k) => (
      <a href={`${url(item.href)}#steps`} aria-current={item.slug === current ? 'page' : undefined}>
        <span class="th" aria-hidden="true">{item.thumb ? <span class="im" style={`background-image:url(${url(item.thumb)})`} /> : <span class="stripes" />}</span>
        <span class="nm">
          <span class="n">{pad(k)}</span>
          <span class="t">{item.label}</span>
        </span>
        <span class="mt">
          <span>{item.level ? levels[item.level] : ''}</span>
          <span class="mn">{item.meta}</span>
        </span>
      </a>
    ))
  }
</nav>

<script>
  // If the card you are on is off to the right, scroll the row just far enough to show it (never the page itself).
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((row) => {
    const on = row.querySelector<HTMLElement>('[aria-current="page"]');
    if (!on) return;
    const end = on.offsetLeft + on.offsetWidth + 40;
    if (end > row.clientWidth) row.scrollLeft = end - row.clientWidth;
  });
</script>

<style>
  .strip {
    margin-top: 14px;
    margin-right: -70px;
    border-top: 1px solid #d9d5ca;
    border-bottom: 1px solid #d9d5ca;
    background: #fff;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 18px 40px 18px 18px;
    position: relative;
  }
  a {
    flex: 0 0 232px;
    display: block;
    padding: 10px;
    border-radius: 4px;
    color: #1b1b1b;
    text-decoration: none;
    transition: background 0.2s;
  }
  a:hover {
    opacity: 0.85;
  }
  a[aria-current='page'] {
    background: #e7efe9;
    outline: 2px solid #2f5a48;
    outline-offset: -2px;
  }
  .th {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #ece8df;
    position: relative;
    margin-bottom: 10px;
  }
  .im {
    display: block;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: top;
  }
  .stripes {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(135deg, #e4e0d6 0 10px, #ebe7de 10px 20px);
  }
  .nm {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
  }
  .n {
    font-family: var(--font-ui);
    font-size: 12px;
    color: #5f5c56;
  }
  .t {
    font-family: var(--font-read);
    font-size: 21px;
    line-height: 1.15;
  }
  .mt {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 12px;
    color: #5f5c56;
  }
  .mn {
    text-transform: uppercase;
    text-align: right;
  }
  @media (max-width: 64rem) {
    .strip {
      margin-right: -24px;
    }
  }
  @media (max-width: 48rem) {
    .strip {
      margin-right: -16px;
      margin-left: -16px;
      padding: 14px 16px;
    }
    a {
      flex-basis: 200px;
    }
  }
</style>
