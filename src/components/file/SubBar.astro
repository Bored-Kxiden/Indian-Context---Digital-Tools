---
import type { Rail } from '../../data/rail';
import { url } from '../../utils/url';

// Every step of a file, as buttons that wrap onto as many rows as they need (no sideways scrolling, D44).
// The step you are on is filled and says "You are here".
interface Props {
  rail: Rail;
  /** Slug of the page being viewed, or "overview". */
  current: string;
}
const { rail, current } = Astro.props;
const items = [{ slug: 'overview', label: 'Overview', href: rail.overviewHref, glyph: '★', meta: 'Start here' }, ...rail.items];
---

<nav class="subs" aria-labelledby="subs-h">
  <h2 id="subs-h" class="subs-h">Steps in this file</h2>
  <ol>
    {
      items.map((item) => {
        const here = item.slug === current;
        return (
          <li>
            <a href={url(item.href)} aria-current={here ? 'page' : undefined}>
              <span class="n" aria-hidden="true">
                {'n' in item && item.n ? item.n : (item.glyph ?? '›')}
              </span>
              <span class="t">
                <b>{item.label}</b>
                <small>{here ? 'You are here' : item.meta}</small>
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .subs {
    margin: var(--sp-6) 0 var(--sp-2);
    padding: var(--sp-3);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .subs-h {
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--sp-2);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
    gap: var(--sp-1);
  }
  li {
    margin: 0;
  }
  a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    height: 100%;
    padding: var(--sp-1) var(--sp-2) var(--sp-1) var(--sp-1);
    border: 2px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color var(--t-fast) var(--ease),
      transform var(--t-fast) var(--ease),
      background-color var(--t-fast) var(--ease);
  }
  a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .n {
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--accent-deep);
    color: var(--accent-deep);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .t {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
  }
  .t b {
    font-weight: 800;
  }
  .t small {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  a[aria-current='page'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  a[aria-current='page'] .n {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
    color: var(--accent);
  }
  a[aria-current='page'] small {
    color: inherit;
    font-weight: 700;
  }
</style>
