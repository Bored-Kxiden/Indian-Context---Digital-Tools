---
import { files, fileNo, type ToolkitComponent } from '../../data/components';
import { url } from '../../utils/url';

// A file of the kit, as in the owner's template (D41): a title on the desk, then the file's coloured folder
// holding a sheet of paper (punched holes, a margin rule, a "File №" stamp). Tabs down the folder's right
// edge open the other files. Everything a page says goes on the paper (the default slot).
interface Props {
  comp: ToolkitComponent;
  /** Breadcrumb after "All files"; the last one is the page itself. */
  crumbs: { label: string; href?: string }[];
  /** "I want to …", shown in italics over the title. */
  verb?: string;
  title: string;
  /** Under the title, one short line. */
  lead?: string;
  /** The stamp on the paper: "02" or "02.3". */
  stamp?: string;
}
const { comp, crumbs, verb, title, lead, stamp = fileNo(comp) } = Astro.props;
---

<section class="fhead">
  <nav class="crumbs-f" aria-label="Breadcrumb">
    <ol>
      <li><a href={url('/')}>All files</a></li>
      {
        crumbs.map((c) => (
          <li>
            <span class="sep" aria-hidden="true">›</span>
            {c.href ? <a href={url(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </li>
        ))
      }
    </ol>
  </nav>
  {verb && <p class="verb">“{verb}”</p>}
  <h1>{title}</h1>
  {lead && <p class="flead">{lead}</p>}
  <slot name="head" />
</section>

<div class="fwrap">
  <div class="folder" data-c={comp.c}>
    <nav class="stabs" aria-label="Files">
      {
        files.map((f) => (
          <a href={url(f.href)} data-c={f.c} class:list={{ on: f.id === comp.id }} aria-current={f.id === comp.id ? 'true' : undefined}>
            <svg viewBox="0 0 62 300" preserveAspectRatio="none" aria-hidden="true">
              <path d="M0,0 C0,24 62,28 62,58 V242 C62,272 0,276 0,300 Z" />
            </svg>
            <span class="lg">{f.name.replace('Reading ', '')}</span>
            <span class="sm">{fileNo(f)} {f.short.split(' ')[0]}</span>
          </a>
        ))
      }
    </nav>
    <div class="paper">
      <span class="margin" aria-hidden="true"></span>
      <span class="holes" aria-hidden="true">{[0, 1, 2, 3, 4, 5].map(() => <i></i>)}</span>
      <span class="stamp" aria-hidden="true">File {stamp}</span>
      <div class="sheet">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .fhead {
    max-width: 1500px;
    margin: 0 auto;
    padding: clamp(var(--sp-5), 5vw, 70px) var(--gutter) clamp(var(--sp-4), 3.5vw, 50px);
  }
  .crumbs-f ol {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-half) var(--sp-1);
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--muted);
  }
  .sep {
    font-size: 1.1em;
  }
  .crumbs-f li {
    margin: 0;
    display: inline-flex;
    gap: var(--sp-1);
    align-items: center;
  }
  .crumbs-f a {
    color: inherit;
    text-underline-offset: 3px;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
  .verb {
    font-family: var(--font-read);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    color: var(--ink-soft);
    margin: 0 0 var(--sp-1);
  }
  .fhead h1 {
    margin: 0;
    max-width: 22ch;
  }
  .flead {
    font-size: var(--fs-lead);
    max-width: 44rem;
    margin: var(--sp-2) 0 0;
    color: var(--ink-soft);
  }

  .fwrap {
    max-width: 1500px;
    margin: 0 auto;
    position: relative;
  }
  .folder {
    position: relative;
    background: var(--accent);
    border-radius: var(--r-lg) var(--r-lg) var(--r-lg) var(--r-lg);
    padding: var(--sp-1) var(--sp-1) var(--sp-4);
  }
  .paper {
    position: relative;
    background: var(--surface);
    color: var(--ink);
    border-radius: var(--r-md);
    box-shadow: 0 2px 0 rgb(0 0 0 / 0.13);
    padding: var(--sp-6) var(--sp-2) var(--sp-6);
    --focus: var(--ink);
  }
  .margin,
  .holes {
    display: none;
  }
  .stamp {
    position: absolute;
    top: var(--sp-2);
    right: var(--sp-2);
    border: 1.5px solid var(--accent-deep);
    color: var(--accent-deep);
    padding: 2px 8px;
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 6px;
    transform: rotate(3deg);
  }
  /* One left edge for everything on the paper */
  .sheet {
    position: relative;
    min-width: 0;
    max-width: 72rem;
  }

  /* Phones and tablets: the five files as tabs along the folder's top edge (they wrap, never scroll) */
  .stabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 0 var(--sp-1);
    margin-bottom: -2px;
  }
  .stabs a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 12px 12px 0 0;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(6px);
    transition: transform var(--t-fast) var(--ease);
  }
  .stabs a:hover,
  .stabs a.on {
    transform: none;
  }
  .stabs a.on {
    min-height: 46px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .stabs svg,
  .stabs .lg {
    display: none;
  }

  @media (min-width: 48rem) {
    .folder {
      padding: var(--sp-4) 0 var(--sp-8) var(--sp-4);
    }
    .paper {
      padding: var(--sp-8) var(--sp-5) var(--sp-8) 96px;
    }
    .margin {
      display: block;
      position: absolute;
      left: 72px;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--line);
    }
    .holes {
      position: absolute;
      left: 24px;
      top: 120px;
      bottom: 120px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .holes i {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--accent);
    }
    .stamp {
      top: 28px;
      right: 34px;
    }
  }
  @media (min-width: 64rem) {
    .fwrap {
      padding-right: 120px;
    }
    .folder {
      padding: 50px 0 80px 50px;
    }
    .paper {
      padding: 70px 70px 90px 130px;
    }
    .margin {
      left: 88px;
    }
    .holes {
      left: 30px;
    }
    .holes i {
      width: 28px;
      height: 28px;
    }
    /* Tabs down the folder's right edge, one per file; they slide out when you point at them */
    .stabs {
      position: absolute;
      top: 30px;
      left: 100%;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 0;
      margin: 0;
    }
    .stabs a {
      width: 62px;
      height: 200px;
      min-height: 0;
      padding: 0;
      justify-content: center;
      border-radius: 0;
      background: none;
      transform: translateX(-6px);
      transition:
        transform var(--t-med) var(--ease),
        height var(--t-med) var(--ease);
    }
    .stabs a:hover,
    .stabs a:focus-visible {
      transform: translateX(4px);
    }
    .stabs a.on {
      height: 260px;
      transform: none;
      text-decoration: none;
    }
    .stabs svg {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      fill: var(--accent);
    }
    .stabs .sm {
      display: none;
    }
    .stabs .lg {
      display: block;
      position: relative;
      writing-mode: vertical-rl;
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 1.1875rem;
      white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .folder {
      animation: folderIn 0.7s var(--ease) both;
    }
    .paper {
      animation: paperIn 0.8s 0.2s var(--ease) both;
    }
    @keyframes folderIn {
      from {
        opacity: 0;
        transform: translateY(60px);
      }
    }
    @keyframes paperIn {
      from {
        opacity: 0;
        transform: translateY(40px) rotate(0.6deg);
      }
    }
  }

  /* Anything placed on the paper: full-width bands become plain sections of the sheet */
  .sheet :global(.wrap) {
    max-width: none;
    padding-inline: 0;
  }
  @media print {
    .stabs,
    .holes,
    .margin,
    .stamp {
      display: none !important;
    }
    .folder {
      background: none;
      padding: 0;
    }
    .paper {
      box-shadow: none;
      padding: 0;
    }
  }
</style>
