---
// "Level of Involvement", exactly as in the owner's v3 template (D47, D48): three bars (light, moderate, complex)
// filled in the file's colour, the level under them, and what the step asks of you.
interface Props {
  level: 1 | 2 | 3;
  text: string;
  /** Kept for older callers; the template shows no facts here. */
  facts?: string[];
}
const { level, text } = Astro.props;
const names = ['', 'Light', 'Moderate', 'Complex'];
---

<section class="inv" aria-labelledby="inv-h">
  <div class="meter">
    <div class="bars" role="img" aria-label={`${names[level]}: ${level} of 3`}>
      {[1, 2, 3].map((n) => <i class:list={{ on: n <= level }} style={`height:${18 + n * 18}px`}></i>)}
    </div>
    <p class="lv" aria-hidden="true">{names[level]} · {level} / 3</p>
  </div>
  <div>
    <h3 id="inv-h" class="lbl-h">Level of Involvement</h3>
    <p class="txt">{text}</p>
  </div>
</section>

<style>
  .inv {
    padding-top: 34px;
    border-top: 1px solid #d9d5ca;
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 50px;
    align-items: start;
  }
  .meter {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .bars {
    display: flex;
    gap: 6px;
    align-items: flex-end;
    height: 72px;
  }
  .bars i {
    width: 24px;
    background: transparent;
    border: 1.5px solid #1b1b1b;
    border-radius: 2px;
  }
  .bars i.on {
    background: var(--accent);
  }
  .lv {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
  }
  .lbl-h {
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 12px;
  }
  .txt {
    margin: 0;
    max-width: 820px;
    font-family: var(--font-read);
    font-size: clamp(20px, 1.6vw, 25px);
    line-height: 1.55;
    text-wrap: pretty;
  }
  @media (max-width: 48rem) {
    .inv {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
