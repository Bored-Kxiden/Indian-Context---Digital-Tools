---
// A section of a file's paper, as in the owner's v3 template (D47): a rule, then the question in italics on the
// left and the answer on the right. On narrower screens the answer goes under the question.
interface Props {
  id: string;
  title: string;
  level?: 2 | 3;
}
const { id, title, level = 2 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
---

<section class="psec" id={id} aria-labelledby={`${id}-h`}>
  <H id={`${id}-h`} class="ph">{title}</H>
  <div class="pb">
    <slot />
  </div>
</section>

<style>
  .psec {
    margin-top: clamp(var(--sp-6), 5vw, 56px);
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 64rem) {
    .psec {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 50px;
      align-items: start;
    }
  }
  .ph {
    font-family: var(--font-read);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 1.4rem + 1.6vw, 2.875rem);
    line-height: 1.05;
    margin: 0 0 var(--sp-3);
    max-width: 30ch;
  }
  @media (min-width: 64rem) {
    .ph {
      margin: 0;
    }
  }
  .pb {
    min-width: 0;
  }
  .pb > :global(:last-child) {
    margin-bottom: 0;
  }
  .pb :global(p) {
    max-width: var(--measure);
  }
</style>
