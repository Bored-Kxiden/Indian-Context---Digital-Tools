---
// A section of a file's paper: a rule, a question as the heading, then the answer underneath, all on one left
// edge (D44: one column reads more calmly than the template's two).
interface Props {
  id: string;
  title: string;
  level?: 2 | 3;
}
const { id, title, level = 2 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
---

<section class="psec" id={id} aria-labelledby={`${id}-h`}>
  <H id={`${id}-h`} class="ph">{title}</H>
  <div class="pb">
    <slot />
  </div>
</section>

<style>
  .psec {
    margin-top: clamp(var(--sp-6), 5vw, var(--sp-8));
    padding-top: var(--sp-5);
    border-top: 2px solid var(--line);
  }
  .ph {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.625rem, 1.3rem + 1vw, 2.25rem);
    line-height: 1.15;
    margin: 0 0 var(--sp-3);
    max-width: 30ch;
  }
  .pb {
    min-width: 0;
  }
  .pb > :global(:last-child) {
    margin-bottom: 0;
  }
  .pb :global(p) {
    max-width: var(--measure);
  }
</style>
