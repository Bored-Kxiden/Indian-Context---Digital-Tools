---
import Involvement from './Involvement.astro';
import DownloadNotes, { type Note } from './DownloadNotes.astro';
import PaperSection from './PaperSection.astro';
import Steps from './Steps.astro';
import type { ToolkitComponent } from '../../data/components';

// The middle of a file's overview, in the template's order: level of involvement, the ways to work as
// sticky notes, "What is it and why should I do it?" and "How do I use it?".
interface Props {
  comp: ToolkitComponent;
  facts?: string[];
  notes: Note[];
  why: string[];
  how: (string | { title: string; body: string; href?: string; meta?: string })[];
}
const { comp, facts = [], notes, why, how } = Astro.props;
---

<Involvement level={comp.level} text={comp.involve} facts={facts} />
<DownloadNotes notes={notes} />
<PaperSection id="why" title="What is it and why should I do it?">
  {why.map((p) => <p>{p}</p>)}
  <slot name="why" />
</PaperSection>
<PaperSection id="how" title="How do I use it?">
  <Steps steps={how} />
  <slot name="how" />
</PaperSection>
