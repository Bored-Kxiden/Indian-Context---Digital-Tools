---
import Icon from './Icon.astro';
import { files, fileNo } from '../data/components';
import { site } from '../data/site';
import { isActive, url } from '../utils/url';

// The header, exactly as in the owner's v3 template (D47, D48): the kit's name, "Tour ↺", a "Find a tool" search box
// with its results right under it, and the guide (the bubble with eyes, which is "Ask the toolkit": it opens the chat
// popup). A small "Menu" pill in the same style keeps the site's other pages one click away. Dark on the home page
// (body[data-theme='night']). The guide's eyes, the tour and the nudges are in src/scripts/guide.ts.
// On phones the search box becomes a magnifier that opens the full search (Finder.astro).
// Without JavaScript the search box asks the toolkit (/ask/?q=…) and the guide is a link to /ask/.
const current = Astro.url.pathname;
const more = [
  { href: '/components/', label: 'All tools' },
  { href: '/card-kit/', label: 'Card kit' },
  { href: '/guideline/', label: 'How to use the kit' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/my-work/', label: 'My work' },
  { href: '/downloads/', label: 'Downloads' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <a class="logo" href={url('/')}>Beyond the Edge Case</a>

  <div class="acts">
    <button type="button" class="pill tour" hidden data-tour-start>Tour ↺</button>

    <form class="srch" action={url('/ask/')} method="get" role="search" data-tour="search" data-hsearch>
      <label class="box">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="6" cy="6" r="4.5"></circle><path d="M9.5 9.5L13 13"></path></svg>
        <span class="visually-hidden">Find a tool</span>
        <input
          type="search"
          name="q"
          placeholder="Find a tool"
          autocomplete="off"
          spellcheck="false"
          aria-describedby="hres-n"
          data-hsearch-q
        />
      </label>
      <div class="hres" id="hres" hidden data-hsearch-res>
        <ul data-hsearch-list></ul>
        <p class="none" hidden data-hsearch-none></p>
      </div>
      <p class="visually-hidden" id="hres-n" role="status" aria-live="polite" data-hsearch-n></p>
    </form>
    <a class="find-m" href={url('/components/')} data-finder-open data-tour="search" title="Find a tool">
      <Icon name="search" size={18} />
      <span class="visually-hidden">Find a tool</span>
    </a>

    <details class="menu">
      <summary class="pill">
        <span>Menu</span>
      </summary>
      <div class="panel">
        <p class="mh">All files</p>
        <ul class="files">
          {
            files.map((c) => (
              <li>
                <a href={url(c.href)} data-c={c.c} aria-current={isActive(current, c.href) ? 'page' : undefined}>
                  <span class="sq" aria-hidden="true" />
                  <span class="no">{fileNo(c)}</span>
                  <span class="nm">{c.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mh">More</p>
        <ul class="more">
          {
            more.map((m) => (
              <li>
                <a href={url(m.href)} aria-current={isActive(current, m.href) ? 'page' : undefined}>
                  {m.label}
                </a>
              </li>
            ))
          }
        </ul>
        <button type="button" class="mtour" hidden data-tour-start>Take the tour ↺</button>
        <a class="dl" href={url(site.bookletPdf)} download>The whole booklet (PDF) ↓</a>
      </div>
    </details>

    <a class="guide" href={url('/ask/')} data-chat-open data-tour="guide" title="Ask the toolkit">
      <svg class="bub" width="50" height="58" viewBox="0 0 50 58" aria-hidden="true">
        <path d="M10 4 H36 Q45 4 45 13 V34 Q45 42 37 42 H33 L28 53 Q26 56 24 53 L21 42 H13 Q5 42 5 34 V13 Q5 4 10 4 Z" />
      </svg>
      <span class="eyes" aria-hidden="true" data-eyes>
        <span class="eye"><i data-pupil></i></span>
        <span class="eye"><i data-pupil></i></span>
      </span>
      <span class="visually-hidden">Ask the toolkit</span>
      <span class="dot" hidden data-chat-dot><span class="visually-hidden">(conversation in progress)</span></span>
    </a>
  </div>
</header>

<script>
  // Close the menu after choosing a link, with Escape, and when clicking outside it.
  const menu = document.querySelector<HTMLDetailsElement>('.site-header .menu');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a, [data-tour-start]')) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }

  // "Find a tool": results drop down under the box as you type (the template's search). They come from the full
  // search's list (Finder.astro), so every tool, step and page can be found. Enter opens the first result;
  // the arrow keys move through them; Escape clears the box.
  const form = document.querySelector<HTMLFormElement>('[data-hsearch]');
  const finder = document.querySelector<HTMLDialogElement>('#finder');
  if (form && finder) {
    const q = form.querySelector<HTMLInputElement>('[data-hsearch-q]')!;
    const res = form.querySelector<HTMLElement>('[data-hsearch-res]')!;
    const list = form.querySelector<HTMLUListElement>('[data-hsearch-list]')!;
    const none = form.querySelector<HTMLElement>('[data-hsearch-none]')!;
    const n = form.querySelector<HTMLElement>('[data-hsearch-n]')!;
    const items = [...finder.querySelectorAll<HTMLElement>('[data-finder-item]')];
    const askBase = form.getAttribute('action') ?? '/ask/';
    const MAX = 8;

    const show = (on: boolean) => {
      res.hidden = !on;
    };
    const links = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];

    function render() {
      const term = q.value.trim().toLowerCase();
      if (!term) {
        show(false);
        n.textContent = '';
        return;
      }
      const words = term.split(/\s+/);
      const hits = items.filter((i) => words.every((w) => (i.dataset.text ?? '').includes(w)));
      list.replaceChildren(
        ...hits.slice(0, MAX).map((i) => {
          const src = i.querySelector<HTMLAnchorElement>('a')!;
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = src.href;
          if (src.dataset.c) a.dataset.c = src.dataset.c;
          const sq = document.createElement('span');
          sq.className = 'sq';
          sq.setAttribute('aria-hidden', 'true');
          const t = document.createElement('span');
          t.className = 'nm';
          t.textContent = src.querySelector('.t')?.childNodes[0]?.textContent?.trim() ?? src.textContent ?? '';
          const h = document.createElement('span');
          h.className = 'hn';
          h.textContent = src.querySelector('small')?.textContent ?? '';
          const col = document.createElement('span');
          col.className = 'col';
          col.append(t, h);
          a.append(sq, col);
          li.append(a);
          return li;
        }),
      );
      // Always offer to ask the toolkit with the same words.
      const li = document.createElement('li');
      const ask = document.createElement('a');
      ask.href = `${askBase}?q=${encodeURIComponent(q.value.trim())}`;
      ask.dataset.askOpen = '';
      ask.className = 'ask';
      ask.textContent = `Ask the toolkit: “${q.value.trim()}”`;
      li.append(ask);
      list.append(li);
      none.hidden = hits.length > 0;
      none.textContent = `No tool matches “${q.value.trim()}”`;
      n.textContent = hits.length ? `${hits.length} ${hits.length === 1 ? 'result' : 'results'}` : 'No tool matches';
      show(true);
    }

    q.addEventListener('input', render);
    q.addEventListener('focus', () => q.value.trim() && render());
    form.addEventListener('submit', (e) => {
      const first = links()[0];
      if (first) {
        e.preventDefault();
        first.click();
      }
    });
    form.addEventListener('keydown', (e) => {
      const ls = links();
      const at = ls.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown' && ls.length) {
        e.preventDefault();
        ls[Math.min(at + 1, ls.length - 1)].focus();
      } else if (e.key === 'ArrowUp' && ls.length) {
        e.preventDefault();
        if (at <= 0) q.focus();
        else ls[at - 1].focus();
      } else if (e.key === 'Escape') {
        q.value = '';
        show(false);
        q.focus();
      }
    });
    list.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        show(false);
        q.value = '';
      }
    });
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target as Node)) show(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
    padding: 14px 32px;
    background: var(--ground);
    color: var(--ink);
    border-bottom: 1px solid rgb(27 27 27 / 0.13);
    font-family: var(--font-ui);
    transition: background-color 0.5s;
    --rule2: rgb(27 27 27 / 0.33);
  }
  :global(body[data-theme='night']) .site-header {
    background: var(--night);
    color: var(--on-night);
    border-bottom-color: #333;
    --focus: #fff;
    --rule2: #555;
  }
  .logo {
    font-family: var(--font-cover);
    font-weight: 400;
    font-size: 28px;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .logo:hover {
    opacity: 0.85;
  }
  .acts {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-shrink: 0;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
    color: inherit;
    background: none;
    border: 1px solid var(--rule2);
    border-radius: 99px;
    padding: 9px 14px;
    cursor: pointer;
  }
  .pill:hover {
    opacity: 0.85;
  }
  .tour[hidden],
  .mtour[hidden] {
    display: none;
  }

  /* Search box, results under it */
  .srch {
    position: relative;
    margin: 0;
  }
  .box {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--rule2);
    border-radius: 99px;
    padding: 8px 16px;
    width: 260px;
  }
  .box input {
    flex: 1;
    min-width: 0;
    min-height: 0;
    height: auto;
    width: auto;
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    outline: none;
    line-height: 1.4;
    color: inherit;
    font-family: var(--font-ui);
    font-size: 14px;
    padding: 0;
    -webkit-appearance: none;
    appearance: none;
  }
  .box input::placeholder {
    color: inherit;
    opacity: 0.55;
  }
  .box input::-webkit-search-cancel-button {
    display: none;
  }
  .box:focus-within {
    outline: 2px solid var(--focus, currentColor);
    outline-offset: 2px;
  }
  .hres {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 340px;
    max-height: calc(100dvh - var(--header-h) - 24px);
    overflow-y: auto;
    background: #f7f5ef;
    color: #1b1b1b;
    border-radius: 4px;
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.45);
    padding: 6px;
    --focus: #1b1b1b;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hres:not([hidden]) {
      animation: hpop 0.2s ease;
    }
    @keyframes hpop {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }
  }
  .hres ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hres li {
    margin: 0;
  }
  .hres :global(a) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 3px;
    color: inherit;
    text-decoration: none;
  }
  .hres :global(a:hover),
  .hres :global(a:focus-visible) {
    background: #ece8df;
  }
  .hres :global(.sq) {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: var(--accent, #1b1b1b);
    flex-shrink: 0;
  }
  .hres :global(.nm) {
    font-family: var(--font-read);
    font-size: 20px;
    line-height: 1.15;
  }
  .hres :global(.col) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .hres :global(.hn) {
    font-family: var(--font-ui);
    font-size: 11px;
    line-height: 1.35;
    color: #5f5c56;
  }
  .hres :global(.ask) {
    font-size: 12px;
    color: #4a4843;
    border-top: 1px solid #d9d5ca;
    border-radius: 0;
    margin-top: 4px;
  }
  .none {
    font-size: 12px;
    color: #6f6c66;
    padding: 12px;
    margin: 0;
  }
  .find-m {
    display: none;
  }

  /* Menu */
  .menu {
    position: relative;
  }
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: min(22rem, calc(100vw - 32px));
    max-height: calc(100dvh - var(--header-h) - var(--sp-2));
    overflow-y: auto;
    background: #f7f5ef;
    color: #1b1b1b;
    border-radius: 4px;
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.45);
    padding: 14px;
    display: grid;
    gap: 6px;
    --focus: #1b1b1b;
  }
  .mh {
    margin: 6px 0 0;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6f6c66;
  }
  .panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .panel li {
    margin: 0;
  }
  .files a {
    display: flex;
    gap: 12px;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 3px;
    color: inherit;
    text-decoration: none;
  }
  .sq {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .no {
    font-size: 12px;
    color: #6f6c66;
  }
  .nm {
    font-family: var(--font-read);
    font-size: 20px;
    line-height: 1.15;
  }
  .files a:hover,
  .more a:hover,
  .mtour:hover,
  .files a[aria-current='page'],
  .more a[aria-current='page'] {
    background: #ece8df;
  }
  .more {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .more a,
  .mtour,
  .dl {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 3px;
    font-size: 13px;
    color: inherit;
    text-decoration: none;
  }
  .mtour {
    border: 0;
    background: none;
    font-family: var(--font-ui);
    cursor: pointer;
    text-align: left;
    width: 100%;
  }
  .dl {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The guide: a speech bubble with eyes, tilted until you point at it. It is "Ask the toolkit". */
  .guide {
    position: relative;
    display: block;
    flex: none;
    width: 50px;
    height: 58px;
    margin: -6px 0 -10px;
    color: inherit;
    transform: rotate(-6deg);
    transition: transform 0.25s;
  }
  .guide:hover,
  .guide[aria-expanded='true'] {
    transform: rotate(0deg) scale(1.08);
  }
  .guide:focus-visible {
    outline-offset: 2px;
    border-radius: 12px;
  }
  .bub {
    position: absolute;
    inset: 0;
    filter: drop-shadow(0 3px 6px rgb(0 0 0 / 0.25));
  }
  .bub path {
    fill: #111;
    stroke: #faf9f4;
    stroke-width: 3.5;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  .eyes {
    position: absolute;
    left: 11px;
    top: 13px;
    display: flex;
    gap: 3px;
    transform-origin: center;
  }
  .eye {
    position: relative;
    width: 13px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
  }
  .eye i {
    position: absolute;
    left: 3.5px;
    top: 5px;
    width: 6px;
    height: 7px;
    border-radius: 50%;
    background: #111;
  }
  @media (prefers-reduced-motion: no-preference) {
    .eyes {
      animation: blink 4.6s infinite;
    }
    @keyframes blink {
      0%,
      92%,
      100% {
        transform: scaleY(1);
      }
      95% {
        transform: scaleY(0.08);
      }
    }
  }
  .dot {
    position: absolute;
    top: 0;
    right: -2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c2);
    border: 2px solid #faf9f4;
  }
  .dot[hidden],
  .guide[aria-expanded='true'] .dot {
    display: none;
  }

  /* Narrower screens: a smaller search box, then a magnifier that opens the full search */
  @media (max-width: 64rem) {
    .site-header {
      padding: 12px 20px;
      gap: 16px;
    }
    .acts {
      gap: 12px;
    }
    .box {
      width: 200px;
    }
  }
  @media (max-width: 48rem) {
    .tour,
    .srch {
      display: none;
    }
    .find-m {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--rule2);
      border-radius: 50%;
      color: inherit;
    }
    .menu summary {
      min-height: 44px;
    }
  }
  @media (max-width: 26rem) {
    .site-header {
      padding: 10px 16px;
      gap: 8px;
    }
    .acts {
      gap: 8px;
    }
    .logo {
      font-size: 22px;
      white-space: normal;
      line-height: 0.95;
      max-width: 9ch;
    }
  }
</style>
