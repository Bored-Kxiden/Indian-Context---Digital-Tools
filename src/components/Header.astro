---
import { nav, site } from '../data/site';
import { isActive, url } from '../utils/url';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')}>
      <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" width="28" height="28">
        <rect x="1" y="1" width="30" height="30" rx="7" fill="currentColor"></rect>
        <path d="M8 21V11l4 5 4-5v10M20 11h5M20 16h5M20 21h5" fill="none" stroke="var(--bg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.85rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
  }
  .brand span {
    color: var(--ink);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav li {
    margin: 0;
  }
  nav a {
    display: inline-block;
    padding: 0.35rem 0;
    color: var(--ink-soft);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
