---
import Icon from './Icon.astro';
import { files, fileNo } from '../data/components';
import { site } from '../data/site';
import { isActive, url } from '../utils/url';

// The template's header (v3, D47): the kit's name, "Tour", "Find a tool", the guide (the bubble with eyes, which is
// "Ask the toolkit": it opens the chat popup) and a menu with the five files and everything else. Dark on the home
// page (body[data-theme='night']). The guide's eyes, the tour and the nudges are in src/scripts/guide.ts.
const current = Astro.url.pathname;
const more = [
  { href: '/card-kit/', label: 'Card kit' },
  { href: '/guideline/', label: 'How to use the kit' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/my-work/', label: 'My work' },
  { href: '/downloads/', label: 'Downloads' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="bar">
    <a class="logo" href={url('/')}>Beyond the Edge Case</a>

    <div class="acts">
      <button type="button" class="tour" hidden data-tour-start>Tour <span aria-hidden="true">↺</span></button>
      <a class="find" href={url('/components/')} data-finder-open data-tour="search">
        <Icon name="search" size={16} />
        <span class="find-l">Find a tool</span>
        <kbd class="find-k" aria-hidden="true">/</kbd>
      </a>
      <details class="menu">
        <summary>
          <Icon name="menu" size={18} />
          <span>Menu</span>
        </summary>
        <div class="panel">
          <p class="mh">All files</p>
          <ul class="files">
            {
              files.map((c) => (
                <li>
                  <a href={url(c.href)} data-c={c.c} aria-current={isActive(current, c.href) ? 'page' : undefined}>
                    <span class="sq" aria-hidden="true" />
                    <span class="no">{fileNo(c)}</span>
                    <span class="nm">{c.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mh">More</p>
          <ul class="more">
            {
              more.map((m) => (
                <li>
                  <a href={url(m.href)} aria-current={isActive(current, m.href) ? 'page' : undefined}>
                    {m.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <button type="button" class="mtour" hidden data-tour-start>Take the tour <span aria-hidden="true">↺</span></button>
          <a class="btn btn--sm" href={url(site.bookletPdf)} download>
            <Icon name="download" size={16} /> The whole booklet (PDF)
          </a>
        </div>
      </details>
      <a class="guide" href={url('/ask/')} data-chat-open data-tour="guide" title="Ask the toolkit">
        <svg class="bub" width="50" height="58" viewBox="0 0 50 58" aria-hidden="true">
          <path d="M10 4 H36 Q45 4 45 13 V34 Q45 42 37 42 H33 L28 53 Q26 56 24 53 L21 42 H13 Q5 42 5 34 V13 Q5 4 10 4 Z" />
        </svg>
        <span class="eyes" aria-hidden="true" data-eyes>
          <span class="eye"><i data-pupil></i></span>
          <span class="eye"><i data-pupil></i></span>
        </span>
        <span class="visually-hidden">Ask the toolkit</span>
        <span class="dot" hidden data-chat-dot><span class="visually-hidden">(conversation in progress)</span></span>
      </a>
    </div>
  </div>
</header>

<script>
  // Close the menu after choosing a link, with Escape, and when clicking outside it.
  const menu = document.querySelector<HTMLDetailsElement>('.site-header .menu');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a, [data-tour-start]')) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ground);
    color: var(--ink);
    border-bottom: 1px solid rgb(27 27 27 / 0.13);
    transition: background-color var(--t-slow) var(--ease);
  }
  :global(body[data-theme='night']) .site-header {
    background: var(--night);
    color: var(--on-night);
    border-bottom-color: #333;
    --focus: #fff;
  }
  .bar {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-1) var(--gutter);
  }
  .logo {
    font-family: var(--font-cover);
    font-weight: 400;
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 1.75rem);
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .acts {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
  }
  .find,
  .tour,
  .menu summary {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-height: 44px;
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  /* Every control in the header looks like a button: a pill with a border */
  .tour,
  .menu summary {
    border: 2px solid rgb(27 27 27 / 0.25);
    border-radius: 999px;
    padding: 0 var(--sp-2);
    transition:
      background-color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  :global(body[data-theme='night']) .tour,
  :global(body[data-theme='night']) .menu summary {
    border-color: #6a6964;
  }
  .tour:hover,
  .menu summary:hover,
  .menu[open] summary {
    border-color: currentColor;
  }
  .tour {
    background: none;
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tour[hidden],
  .mtour[hidden] {
    display: none;
  }

  /* The guide: a speech bubble with eyes, tilted until you point at it. It is "Ask the toolkit". */
  .guide {
    position: relative;
    display: block;
    flex: none;
    width: 50px;
    height: 58px;
    margin: -4px 0 -8px;
    color: inherit;
    transform: rotate(-6deg);
    transition: transform var(--t-med) var(--ease);
  }
  .guide:hover,
  .guide[aria-expanded='true'] {
    transform: rotate(0deg) scale(1.08);
  }
  .guide:focus-visible {
    outline-offset: 2px;
    border-radius: 12px;
  }
  .bub {
    position: absolute;
    inset: 0;
    filter: drop-shadow(0 3px 6px rgb(0 0 0 / 0.25));
  }
  .bub path {
    fill: #111;
    stroke: #faf9f4;
    stroke-width: 3.5;
    stroke-linejoin: round;
    paint-order: stroke;
  }
  .eyes {
    position: absolute;
    left: 11px;
    top: 13px;
    display: flex;
    gap: 3px;
    transform-origin: center;
  }
  .eye {
    position: relative;
    width: 13px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
  }
  .eye i {
    position: absolute;
    left: 3.5px;
    top: 5px;
    width: 6px;
    height: 7px;
    border-radius: 50%;
    background: #111;
  }
  @media (prefers-reduced-motion: no-preference) {
    .eyes {
      animation: blink 4.6s infinite;
    }
    @keyframes blink {
      0%,
      92%,
      100% {
        transform: scaleY(1);
      }
      95% {
        transform: scaleY(0.08);
      }
    }
  }
  .dot {
    position: absolute;
    top: 0;
    right: -2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c2);
    border: 2px solid #faf9f4;
  }
  .dot[hidden],
  .guide[aria-expanded='true'] .dot {
    display: none;
  }
  .mtour {
    min-height: 44px;
    padding: 0 var(--sp-1);
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-align: left;
    border-radius: var(--r-sm);
    cursor: pointer;
  }
  .mtour:hover {
    background: var(--sand);
  }

  .find {
    border: 2px solid rgb(27 27 27 / 0.25);
    border-radius: 999px;
    padding: 0 var(--sp-2);
    width: clamp(12rem, 18vw, 16.25rem);
  }
  :global(body[data-theme='night']) .find {
    border-color: #6a6964;
  }
  .find-l {
    flex: 1;
    opacity: 0.75;
  }
  .find-k {
    font-size: var(--fs-xs);
    background: transparent;
    color: inherit;
    border-color: currentColor;
    opacity: 0.6;
    padding: 0 6px;
  }

  .menu {
    position: relative;
  }
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--sp-1));
    width: min(22rem, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100dvh - var(--header-h) - var(--sp-2));
    overflow-y: auto;
    background: var(--surface);
    color: var(--ink);
    border-radius: var(--r-md);
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.35);
    padding: var(--sp-2);
    display: grid;
    gap: var(--sp-1);
    --focus: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .panel {
      animation: rise var(--t-med) var(--ease);
    }
  }
  .mh {
    margin: var(--sp-1) 0 0;
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .panel li {
    margin: 0;
  }
  .files a {
    display: grid;
    grid-template-columns: 12px auto 1fr;
    gap: var(--sp-1) 12px;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--sp-1);
    border-radius: var(--r-sm);
    color: var(--ink);
    text-decoration: none;
  }
  .sq {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: var(--accent);
  }
  .no {
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .nm {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1.15;
  }
  .files a:hover,
  .more a:hover {
    background: var(--sand);
  }
  .files a[aria-current='page'],
  .more a[aria-current='page'] {
    background: var(--sand);
    font-weight: 600;
  }
  .more {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .more a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--sp-1);
    border-radius: var(--r-sm);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    color: var(--ink);
    text-decoration: none;
  }
  .panel .btn {
    margin-top: var(--sp-1);
  }

  /* Phones: icons only; the labels stay for screen readers */
  @media (max-width: 48rem) {
    .tour {
      display: none;
    }
    .find {
      width: 44px;
      padding: 0;
      justify-content: center;
      border-radius: 50%;
    }
    .find-k {
      display: none;
    }
    .find-l {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .acts {
      gap: var(--sp-half);
    }
  }
  /* Small phones: the menu becomes an icon too */
  @media (max-width: 26rem) {
    .bar {
      gap: var(--sp-1);
    }
    .logo {
      white-space: normal;
      line-height: 0.95;
      max-width: 10ch;
    }
    .menu summary {
      width: 44px;
      justify-content: center;
      padding: 0;
    }
    .menu summary span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
