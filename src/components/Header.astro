---
import LogoMark from './LogoMark.astro';
import Icon from './Icon.astro';
import { components } from '../data/components';
import { nav, site } from '../data/site';
import { isActive, url } from '../utils/url';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={url('/')}>
      <LogoMark />
      <span>
        {site.name}
        <small>Toolkit · BITSDES 2024–28</small>
      </span>
    </a>

    <nav aria-label="Main" class="main-nav">
      <ul>
        {
          nav
            .filter((item) => item.href !== '/components/')
            .map((item) => (
              <li>
                <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
        }
        <li>
          <a href={url('/downloads/')} aria-current={isActive(current, '/downloads/') ? 'page' : undefined}>Downloads</a>
        </li>
      </ul>
      <a class="btn btn--outline btn--sm booklet" href={url(site.bookletPdf)} download>
        <Icon name="download" size={16} />
        Booklet PDF
      </a>
    </nav>

    <div class="mobile">
      <a class="icon-btn" href={url('/#i-want-to')} data-finder-open aria-label="Find a tool">
        <Icon name="search" size={22} />
      </a>
      <details class="menu">
        <summary aria-label="Menu">
          <Icon name="menu" size={22} />
          <span>Menu</span>
        </summary>
        <div class="panel">
          <p class="eb">Components</p>
          <ul class="comp-list">
            {
              components.map((c) => (
                <li>
                  <a href={url(c.href)} data-c={c.c} aria-current={isActive(current, c.href) ? 'page' : undefined}>
                    <span class="dot" aria-hidden="true">{c.number ?? 'R'}</span>
                    <span>{c.name}</span>
                    {c.status === 'soon' && <small>Soon</small>}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="eb">Use it</p>
          <ul class="link-list">
            <li><a href={url('/#i-want-to')}>I want to…</a></li>
            <li><a href={url('/card-kit/')}>Card kit</a></li>
            <li><a href={url('/guideline/')}>The guideline</a></li>
            <li><a href={url('/guideline/#meera')}>Meet Meera</a></li>
            <li><a href={url('/downloads/')}>Downloads</a></li>
            <li><a href={url('/about/')}>About</a></li>
          </ul>
          <a class="btn btn--accent" href={url(site.bookletPdf)} download>
            <Icon name="download" size={18} /> Booklet PDF
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the phone menu after choosing a same-page link, and with Escape.
  const menu = document.querySelector<HTMLDetailsElement>('.site-header .menu');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--line-strong);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  @media (min-width: 64rem) {
    .site-header {
      position: static;
    }
  }
  .bar {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--ink);
    font-size: var(--fs-ui);
    font-weight: 800;
    line-height: 1.15;
    text-decoration: none;
    min-height: 48px;
  }
  .logo small {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 2px;
  }
  @media (max-width: 30rem) {
    .logo small {
      display: none;
    }
  }

  .main-nav {
    display: none;
  }
  @media (min-width: 64rem) {
    .main-nav {
      display: flex;
      align-items: center;
      gap: var(--sp-4);
    }
    .mobile {
      display: none !important;
    }
  }
  .main-nav ul {
    display: flex;
    gap: var(--sp-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav li {
    margin: 0;
  }
  .main-nav ul a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--sp-2);
    border-radius: var(--r-sm);
    color: var(--ink-soft);
    font-size: var(--fs-ui);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease);
  }
  .main-nav ul a:hover {
    background: var(--sand);
    color: var(--ink);
  }
  .main-nav ul a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -3px 0 var(--ink);
    border-radius: 0;
  }

  .mobile {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }
  .icon-btn,
  .menu summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-1);
    min-width: 48px;
    min-height: 48px;
    border-radius: 999px;
    border: 2px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    text-decoration: none;
    touch-action: manipulation;
  }
  .menu summary {
    padding: 0 var(--sp-2);
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu[open] summary {
    background: var(--ink);
    color: #fff;
  }
  .menu .panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100dvh - 72px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface);
    border-bottom: 2px solid var(--ink);
    padding: var(--sp-3) var(--gutter) var(--sp-4);
    box-shadow: 0 24px 32px -24px rgb(22 20 15 / 0.4);
  }
  .panel .eb {
    margin-top: var(--sp-2);
  }
  .panel ul {
    list-style: none;
    margin: 0 0 var(--sp-2);
    padding: 0;
  }
  .panel li {
    margin: 0;
  }
  .panel li a {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 48px;
    padding: 0 var(--sp-1);
    border-radius: var(--r-sm);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .panel li a:hover,
  .panel li a[aria-current='page'] {
    background: var(--accent-tint);
  }
  .comp-list .dot {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--fs-sm);
    font-weight: 800;
    flex: none;
  }
  .comp-list small {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 400;
  }
  .panel .btn {
    width: 100%;
  }
</style>
