---
import LogoMark from './LogoMark.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
import { isActive, url } from '../utils/url';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="bar">
    <a class="logo" href={url('/')}>
      <LogoMark />
      <span>
        {site.name}
        <small>Toolkit</small>
      </span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--outline btn--sm booklet" href={url(site.bookletPdf)} download>
        <Icon name="download" size={16} />
        Booklet PDF
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    max-width: 90rem;
    margin-inline: auto;
    min-height: 72px;
    padding: 0.6rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
  }
  .logo small {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.15rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 2rem;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav li {
    margin: 0;
  }
  nav ul a {
    display: inline-block;
    padding: 0.3rem 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }
  nav ul a:hover {
    color: var(--ink);
  }
  nav ul a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--ink);
  }
  .booklet {
    text-decoration: none;
  }
  @media (max-width: 40rem) {
    nav {
      gap: 0;
    }
    nav ul {
      gap: 0.15rem 1.1rem;
    }
    nav ul a {
      font-size: 0.9rem;
    }
    /* The booklet is one tap away on the home page, Downloads and the footer. */
    .booklet {
      display: none;
    }
  }
</style>
