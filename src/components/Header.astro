---
import Icon from './Icon.astro';
import { files, fileNo } from '../data/components';
import { site } from '../data/site';
import { isActive, url } from '../utils/url';

// The template's header: the kit's name, "Find a tool", "Ask the toolkit", and a menu with
// the five files and everything else. Dark on the home page (body[data-theme='night']).
const current = Astro.url.pathname;
const more = [
  { href: '/card-kit/', label: 'Card kit' },
  { href: '/guideline/', label: 'How to use the kit' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/my-work/', label: 'My work' },
  { href: '/downloads/', label: 'Downloads' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="bar">
    <a class="logo" href={url('/')}>Beyond the Edge Case</a>

    <div class="acts">
      <a class="find" href={url('/components/')} data-finder-open>
        <Icon name="search" size={16} />
        <span class="find-l">Find a tool</span>
        <kbd class="find-k" aria-hidden="true">/</kbd>
      </a>
      <a class="ask" href={url('/ask/')} data-ask-open>
        <Icon name="chat" size={18} />
        <span class="ask-l">Ask the toolkit</span>
      </a>
      <details class="menu">
        <summary>
          <Icon name="menu" size={18} />
          <span>Menu</span>
        </summary>
        <div class="panel">
          <p class="mh">All files</p>
          <ul class="files">
            {
              files.map((c) => (
                <li>
                  <a href={url(c.href)} data-c={c.c} aria-current={isActive(current, c.href) ? 'page' : undefined}>
                    <span class="sq" aria-hidden="true" />
                    <span class="no">{fileNo(c)}</span>
                    <span class="nm">{c.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mh">More</p>
          <ul class="more">
            {
              more.map((m) => (
                <li>
                  <a href={url(m.href)} aria-current={isActive(current, m.href) ? 'page' : undefined}>
                    {m.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="btn btn--sm" href={url(site.bookletPdf)} download>
            <Icon name="download" size={16} /> The whole booklet (PDF)
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the menu after choosing a link, with Escape, and when clicking outside it.
  const menu = document.querySelector<HTMLDetailsElement>('.site-header .menu');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ground);
    color: var(--ink);
    border-bottom: 1px solid rgb(27 27 27 / 0.13);
    transition: background-color var(--t-slow) var(--ease);
  }
  :global(body[data-theme='night']) .site-header {
    background: var(--night);
    color: var(--on-night);
    border-bottom-color: #333;
    --focus: #fff;
  }
  .bar {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-1) var(--gutter);
  }
  .logo {
    font-family: var(--font-cover);
    font-weight: 400;
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 1.75rem);
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .acts {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
  }
  .find,
  .ask,
  .menu summary {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-height: 44px;
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  /* Every control in the header looks like a button: a pill with a border */
  .ask,
  .menu summary {
    border: 2px solid rgb(27 27 27 / 0.25);
    border-radius: 999px;
    padding: 0 var(--sp-2);
    transition:
      background-color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  :global(body[data-theme='night']) .ask,
  :global(body[data-theme='night']) .menu summary {
    border-color: #6a6964;
  }
  .ask:hover,
  .menu summary:hover,
  .menu[open] summary {
    border-color: currentColor;
  }
  .find {
    border: 2px solid rgb(27 27 27 / 0.25);
    border-radius: 999px;
    padding: 0 var(--sp-2);
    width: clamp(12rem, 18vw, 16.25rem);
  }
  :global(body[data-theme='night']) .find {
    border-color: #6a6964;
  }
  .find-l {
    flex: 1;
    opacity: 0.75;
  }
  .find-k {
    font-size: var(--fs-xs);
    background: transparent;
    color: inherit;
    border-color: currentColor;
    opacity: 0.6;
    padding: 0 6px;
  }

  .menu {
    position: relative;
  }
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--sp-1));
    width: min(22rem, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100dvh - var(--header-h) - var(--sp-2));
    overflow-y: auto;
    background: var(--surface);
    color: var(--ink);
    border-radius: var(--r-md);
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.35);
    padding: var(--sp-2);
    display: grid;
    gap: var(--sp-1);
    --focus: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .panel {
      animation: rise var(--t-med) var(--ease);
    }
  }
  .mh {
    margin: var(--sp-1) 0 0;
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .panel li {
    margin: 0;
  }
  .files a {
    display: grid;
    grid-template-columns: 12px auto 1fr;
    gap: var(--sp-1) 12px;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--sp-1);
    border-radius: var(--r-sm);
    color: var(--ink);
    text-decoration: none;
  }
  .sq {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: var(--accent);
  }
  .no {
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .nm {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1.15;
  }
  .files a:hover,
  .more a:hover {
    background: var(--sand);
  }
  .files a[aria-current='page'],
  .more a[aria-current='page'] {
    background: var(--sand);
    font-weight: 600;
  }
  .more {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .more a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--sp-1);
    border-radius: var(--r-sm);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    color: var(--ink);
    text-decoration: none;
  }
  .panel .btn {
    margin-top: var(--sp-1);
  }

  /* Phones: icons only; the labels stay for screen readers */
  @media (max-width: 48rem) {
    .find,
    .ask {
      width: 44px;
      padding: 0;
      justify-content: center;
      border-radius: 50%;
    }
    .find-k {
      display: none;
    }
    .find-l,
    .ask-l {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .acts {
      gap: var(--sp-half);
    }
  }
  /* Small phones: the menu becomes an icon too */
  @media (max-width: 26rem) {
    .bar {
      gap: var(--sp-1);
    }
    .logo {
      white-space: normal;
      line-height: 0.95;
      max-width: 10ch;
    }
    .menu summary {
      width: 44px;
      justify-content: center;
      padding: 0;
    }
    .menu summary span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
