---
import Icon from './Icon.astro';
import { components } from '../data/components';
import { isActive, url } from '../utils/url';

// The sticky component strip: the four components (and Reflection) one click away from
// anywhere, each keeping its own colour. The current one is filled in.
const path = Astro.url.pathname;
---

<nav class="comp-strip" aria-label="Components">
  <div class="wrap strip">
    <ul>
      {
        components.map((c) => {
          const here = isActive(path, c.href);
          return (
            <li>
              <a href={url(c.href)} data-c={c.c} class:list={{ here, soon: c.status === 'soon' }} aria-current={here ? 'page' : undefined}>
                <span class="dot" aria-hidden="true">{c.number ?? 'R'}</span>
                <span class="name">{c.short}</span>
                {c.status === 'soon' && <span class="soon-tag">Soon</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
    <div class="tools">
      <a class="find" href={url('/#i-want-to')} data-finder-open aria-keyshortcuts="/" aria-label="Find a tool">
        <Icon name="search" size={18} />
        <span>Find a tool</span>
        <kbd aria-hidden="true">/</kbd>
      </a>
    </div>
  </div>
</nav>

<style>
  .comp-strip {
    display: none;
  }
  @media (min-width: 64rem) {
    .comp-strip {
      display: block;
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgb(255 255 255 / 0.96);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--line-strong);
    }
  }
  .strip {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: var(--sp-3);
    height: var(--strip-h);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--sp-half);
    overflow-x: auto;
    scrollbar-width: none;
  }
  li {
    margin: 0;
    display: flex;
  }
  li a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    padding: 0 var(--sp-2);
    color: var(--ink-soft);
    font-size: var(--fs-ui);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 4px solid transparent;
    white-space: nowrap;
    transition:
      background-color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  li a:hover {
    background: var(--accent-tint);
    color: var(--ink);
  }
  li a.here {
    color: var(--ink);
    background: var(--accent-tint);
    border-bottom-color: var(--accent);
  }
  li a.soon:not(.here) {
    color: var(--muted);
    font-weight: 600;
  }
  li a:focus-visible {
    outline-offset: -3px;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--fs-sm);
    font-weight: 800;
    line-height: 1;
  }
  li a.soon:not(.here) .dot {
    background: transparent;
    color: var(--muted);
    box-shadow: inset 0 0 0 2px var(--line-strong);
  }
  .soon-tag {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--muted);
  }
  .tools {
    display: flex;
    align-items: center;
  }
  .find {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-height: 40px;
    padding: 0 var(--sp-2);
    border: 2px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-decoration: none;
    background: var(--surface);
    transition:
      background-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }
  .find:hover {
    background: var(--ink);
    color: #fff;
  }
  .find kbd {
    background: var(--sand);
    color: var(--ink);
    border-color: var(--line-strong);
    padding: 0 6px;
  }
  .find:hover kbd {
    background: #fff;
  }
  @media (max-width: 80rem) {
    .find span {
      display: none;
    }
  }
</style>
