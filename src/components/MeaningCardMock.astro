---
import fields from '../../templates/meaning-card-fields.json';

interface Props {
  side: 'front' | 'back';
  /** Field values keyed by field id. Leave empty for a blank card. */
  values?: Record<string, string | boolean>;
}

const { side, values = {} } = Astro.props;
const list = fields[side];
const filled = Object.keys(values).length > 0;
---

<figure class:list={['mock', { filled }]}>
  <figcaption class="cap">
    <span>Meaning Card</span>
    <b>{side === 'front' ? 'Front' : 'Back'}</b>
  </figcaption>
  <div class="fields">
    {
      list.map((f) => {
        const v = values[f.id];
        if (f.layout === 'choice') {
          return (
            <div class="field choice">
              <span class="label">{f.label}</span>
              <span class="opts">
                {(f.options ?? []).map((o) => (
                  <span class:list={['opt', { on: v === o }]}>
                    <i aria-hidden="true">{v === o ? '☑' : '☐'}</i> {o}
                  </span>
                ))}
              </span>
            </div>
          );
        }
        if (f.layout === 'flag') {
          return (
            <div class="field flag">
              <span class="label">{f.label}</span>
              <span class:list={['opt', { on: v === true }]}>
                <i aria-hidden="true">{v === true ? '☑' : '☐'}</i> {f.flagText}
              </span>
            </div>
          );
        }
        return (
          <div class:list={['field', f.layout]}>
            <span class="label">
              {f.label}
              {'printHint' in f && f.printHint && <em> ({f.printHint})</em>}
            </span>
            <span class="val" lang={f.id === 'exactWords' || f.id === 'asked' || f.id === 'explanation' ? 'hi-Latn' : undefined}>
              {typeof v === 'string' ? v : ''}
            </span>
          </div>
        );
      })
    }
  </div>
</figure>

<style>
  .mock {
    margin: 0;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 12px;
    padding: var(--sp-2) var(--sp-2) var(--sp-2);
    box-shadow: var(--shadow);
    container-type: inline-size;
  }
  .cap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: var(--sp-1);
    margin-bottom: var(--sp-1);
    border-bottom: 1px solid var(--line-strong);
  }
  .cap b {
    color: var(--c3-deep);
  }
  .fields {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-1);
  }
  .field {
    grid-column: 1 / -1;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    padding: var(--sp-half) var(--sp-1) var(--sp-1);
    min-height: 3.6rem;
    background: var(--bg);
  }
  .field.third {
    grid-column: span 1;
    min-height: 3rem;
  }
  @container (max-width: 30rem) {
    .field.third {
      grid-column: 1 / -1;
    }
  }
  .field.choice,
  .field.flag {
    min-height: 0;
  }
  .label {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: var(--sp-half);
  }
  .label em {
    font-weight: 400;
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
  }
  .val {
    display: block;
    font-size: var(--fs-ui);
    line-height: 1.4;
  }
  .filled .val {
    font-family: var(--font-body);
  }
  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-half) var(--sp-2);
  }
  .opt {
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .opt.on {
    color: var(--ink);
    font-weight: 700;
  }
  .opt i {
    font-style: normal;
    font-size: 1.05em;
  }
</style>
