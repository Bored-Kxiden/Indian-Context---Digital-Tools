---
import FileRail from './file/FileRail.astro';
import { files } from '../data/components';
import { site } from '../data/site';
import { url } from '../utils/url';

// The template's footer: "All files in the kit" as folders (the one you are in faded, the next one raised; not on
// the home page, which has the drawer), then a short row of links to the site's other pages.
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const current = files.find((f) => path.startsWith(f.href))?.id;
// The home page has the drawer of folders instead (v3 template).
const onHome = path === '/' || path === '';
const links = [
  { href: '/components/', label: 'All tools' },
  { href: '/card-kit/', label: 'Card kit' },
  { href: '/guideline/', label: 'How to use the kit' },
  { href: '/glossary/', label: 'Glossary' },
  { href: '/my-work/', label: 'My work' },
  { href: '/downloads/', label: 'Downloads' },
  { href: '/about/', label: 'About' },
];
---

<footer class="site-footer">
  {!onHome && <FileRail current={current} />}
  <div class="base">
    <nav aria-label="More pages">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={url(l.href)}>{l.label}</a>
            </li>
          ))
        }
        <li><a href={url('/ask/')} data-ask-open>Ask the toolkit</a></li>
        <li><a href={url(site.bookletPdf)} download>Booklet (PDF)</a></li>
      </ul>
    </nav>
    <p class="legal">
      <span class="nm">{site.name}</span> · {site.eyebrow}. Examples are illustrative and use no real participant data. Site code:{' '}
      <a href={site.repoUrl}>{site.licenseName} License</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--sp-8);
    padding-bottom: var(--sp-6);
  }
  :global(body[data-theme='night']) .site-footer {
    color: var(--on-night);
    --muted: var(--on-night-soft);
    --focus: #fff;
  }
  .base {
    padding: var(--sp-3) var(--gutter) 0;
    border-top: 1px solid rgb(27 27 27 / 0.13);
    display: grid;
    gap: var(--sp-2);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
  }
  :global(body[data-theme='night']) .base {
    border-top-color: #333;
  }
  .base ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-3);
  }
  .base li {
    margin: 0;
  }
  .base ul a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
  }
  .legal {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-xs);
    line-height: 1.6;
  }
  .legal a {
    color: inherit;
  }
  .nm {
    font-family: var(--font-cover);
    text-transform: uppercase;
    font-size: var(--fs-sm);
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  :global(body[data-theme='night']) .nm {
    color: var(--on-night);
  }
</style>
