---
import LogoMark from './LogoMark.astro';
import { components } from '../data/components';
import { site } from '../data/site';
import { url } from '../utils/url';
---

<footer class="site-footer">
  <div class="cols">
    <div class="brand">
      <p class="logo">
        <LogoMark size={30} />
        <span>
          {site.name}
          <small>{site.eyebrow}</small>
        </span>
      </p>
      <p class="blurb">{site.tagline}</p>
    </div>

    <nav aria-label="Components">
      <p class="head">Components</p>
      <ul>
        {
          components
            .filter((c) => c.number !== null)
            .map((c) => (
              <li>
                <a href={url(c.href)}>
                  {c.number} · {c.short}
                </a>
                {c.status === 'soon' && <span class="soon"> (soon)</span>}
              </li>
            ))
        }
        <li>
          <a href={url('/components/reflection/')}>Reflection</a>
          <span class="soon"> (soon)</span>
        </li>
      </ul>
    </nav>

    <nav aria-label="Use it">
      <p class="head">Use it</p>
      <ul>
        <li><a href={url('/guideline/')}>The guideline</a></li>
        <li><a href={url('/guideline/#how-to-read')}>How to read a tool</a></li>
        <li><a href={url('/card-kit/')}>Card kit</a></li>
        <li><a href={url('/guideline/#meera')}>Meet Meera</a></li>
        <li><a href={url('/about/')}>About</a></li>
      </ul>
    </nav>

    <nav aria-label="Download">
      <p class="head">Download</p>
      <ul>
        <li><a href={url(site.bookletPdf)} download>Full booklet (A4)</a></li>
        <li><a href={url('/downloads/card-kit/card-sheets-s1-s8.pdf')} download>Card sheets (A4)</a></li>
        <li><a href={url('/downloads/card-kit/boards-b1-b7.pdf')} download>Boards (A2)</a></li>
        <li><a href={url('/downloads/')}>All downloads</a></li>
      </ul>
    </nav>
  </div>
  <p class="legal">
    Examples in the toolkit are illustrative and use no real participant data. Site code:
    <a href={site.repoUrl}>{site.licenseName} License</a>.
  </p>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--on-dark);
    padding: 3.5rem var(--gutter) 2rem;
    margin-top: 0;
    font-size: 0.95rem;
    line-height: 1.9;
  }
  .cols {
    max-width: 90rem;
    margin-inline: auto;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 2fr 1fr 1fr 1fr;
  }
  @media (max-width: 62rem) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 32rem) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #fff;
    font-weight: 800;
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }
  .logo small {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b9b1a0;
    margin-top: 0.15rem;
  }
  .blurb {
    max-width: 26rem;
    line-height: 1.6;
    margin: 0;
  }
  .head {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    font-weight: 600;
    margin: 0 0 0.4rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    margin: 0;
  }
  a {
    color: var(--on-dark);
    text-decoration: none;
  }
  a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .soon {
    color: #8f8878;
  }
  .legal {
    max-width: 90rem;
    margin: 2.5rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid #2e2a22;
    font-size: 0.85rem;
    color: #b9b1a0;
    line-height: 1.6;
  }
  .legal a {
    color: #fff;
    text-decoration: underline;
  }
</style>
