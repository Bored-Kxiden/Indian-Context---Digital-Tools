---
import Icon from './Icon.astro';
import type { Goal } from '../data/goals';
import { url } from '../utils/url';

// The "I want to…" index. One card per component, so a component reads as one thing
// however many groups it has. Every chip and header uses its own component's colour.
//   board: every component side by side (Home)
//   list:  one component, full width (a component overview)
interface Props {
  groups: Goal[];
  variant?: 'board' | 'list';
  /** Show the live search box. */
  search?: boolean;
}

const { groups, variant = 'board', search = true } = Astro.props;

const order: string[] = [];
const byComponent: Record<string, { c: Goal['component']; label: string; groups: Goal[] }> = {};
for (const g of groups) {
  if (!byComponent[g.component]) {
    byComponent[g.component] = { c: g.component, label: g.componentLabel, groups: [] };
    order.push(g.component);
  }
  byComponent[g.component].groups.push(g);
}
// In the template's file order (01 Reflection … 05 Language), numbered by file.
const fileOf: Record<string, number> = { ink: 1, c1: 2, c2: 3, c4: 4, c3: 5 };
const cards = order.map((k) => byComponent[k]).sort((a, b) => (fileOf[a.c] ?? 9) - (fileOf[b.c] ?? 9));
const numeral = (c: string) => String(fileOf[c] ?? '').padStart(2, '0');
const nameOf = (label: string) => label.split('·')[1]?.trim() ?? label;
---

<div class:list={['goals', variant]} data-goals>
  {
    search && (
      <div class="toolbar">
        <label class="search">
          <span class="visually-hidden">Search tools and steps</span>
          <Icon name="search" size={20} />
          <input type="search" placeholder="Find a tool or step…" autocomplete="off" spellcheck="false" data-goal-q />
        </label>
        <p class="status" role="status" aria-live="polite" data-goal-status />
      </div>
    )
  }

  <div class="cards">
    {
      cards.map((card) => (
        <article class="gcard" data-c={card.c} data-card={card.c} data-goal-card>
          <header class="gh">
            <span class="num" aria-hidden="true">{numeral(card.c)}</span>
            <div>
              <p class="eb">{card.c === 'ink' ? 'Runs through every file' : 'Reading file'}</p>
              <h3>{nameOf(card.label)}</h3>
            </div>
          </header>
          <div class="gb">
            {card.groups.map((g) => (
              <section class="group" data-group>
                {(card.groups.length > 1 || variant === 'list') && <h4>{g.title}</h4>}
                <ul>
                  {g.items.map((item) => (
                    <li data-item data-text={`${g.title} ${g.componentLabel} ${item.phrase} ${item.tag}`.toLowerCase()}>
                      <a class="row" href={url(item.href)}>
                        <span class="phrase">{item.phrase}</span>
                        <span class="tag">{item.tag}</span>
                        <span class="go" aria-hidden="true">
                          <Icon name="arrow" size={20} />
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <p class="none" data-goal-none hidden>
    Nothing matches. Try a broader word, such as “translate”, “blame”, “phone” or “trust”.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-goals]').forEach((root) => {
    const q = root.querySelector<HTMLInputElement>('[data-goal-q]');
    if (!q) return;
    const status = root.querySelector<HTMLElement>('[data-goal-status]');
    const none = root.querySelector<HTMLElement>('[data-goal-none]');
    const cards = [...root.querySelectorAll<HTMLElement>('[data-goal-card]')];
    q.addEventListener('input', () => {
      const words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        let inCard = 0;
        for (const group of card.querySelectorAll<HTMLElement>('[data-group]')) {
          let inGroup = 0;
          for (const el of group.querySelectorAll<HTMLElement>('[data-item]')) {
            const text = el.dataset.text ?? '';
            const ok = words.every((w) => text.includes(w));
            el.hidden = !ok;
            if (ok) inGroup += 1;
          }
          group.hidden = inGroup === 0;
          inCard += inGroup;
        }
        card.hidden = inCard === 0;
        shown += inCard;
      }
      if (none) none.hidden = shown !== 0 || words.length === 0;
      if (status) status.textContent = words.length ? `${shown} ${shown === 1 ? 'match' : 'matches'}` : '';
    });
  });
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-4);
  }
  .search {
    flex: 1 1 20rem;
    max-width: 32rem;
    position: relative;
    display: block;
  }
  .search :global(svg) {
    position: absolute;
    left: var(--sp-2);
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }
  .search input {
    padding-left: var(--sp-6);
    border-radius: 999px;
  }
  .status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .none {
    color: var(--muted);
    padding: var(--sp-3) 0;
    font-size: var(--fs-lead);
  }

  .cards {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  /* Home: two by two, in order. Each row is as tall as its taller card. */
  @media (min-width: 64rem) {
    .board .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'c1 c2'
        'c3 c4'
        'ink ink';
      align-items: stretch;
    }
    .board [data-card='c1'] {
      grid-area: c1;
    }
    .board [data-card='c2'] {
      grid-area: c2;
    }
    .board [data-card='c3'] {
      grid-area: c3;
    }
    .board [data-card='c4'] {
      grid-area: c4;
    }
    .board [data-card='ink'] {
      grid-area: ink;
    }
    .board .gcard {
      align-self: stretch;
    }
  }

  .gcard {
    align-self: start;
    background: var(--surface);
    border: 2px solid var(--accent);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .gh {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .num {
    font-size: 4rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .gh .eb {
    color: inherit;
    margin: 0 0 var(--sp-half);
  }
  .gh h3 {
    margin: 0;
    font-size: var(--fs-h3);
  }
  .gb {
    padding: var(--sp-1) var(--sp-4) var(--sp-3);
  }
  .group + .group {
    margin-top: var(--sp-2);
  }
  .group h4 {
    margin: var(--sp-3) 0 var(--sp-half);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }
  li:last-child {
    border-bottom: 0;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
    min-height: 56px;
    padding: var(--sp-1) var(--sp-1);
    margin-inline: calc(var(--sp-1) * -1);
    border-radius: var(--r-sm);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease);
  }
  .row:hover {
    background: var(--accent-tint);
  }
  .row:focus-visible {
    outline-offset: -3px;
  }
  .phrase {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.35;
  }
  .row:hover .phrase {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-deep);
    background: var(--accent-tint);
    border-radius: 999px;
    padding: 4px 12px;
    line-height: 1.5;
    text-align: right;
  }
  .go {
    display: inline-flex;
    color: var(--ink);
    transition: transform var(--t-fast) var(--ease);
  }
  .row:hover .go {
    transform: translateX(4px);
  }
  @media (max-width: 40rem) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .tag {
      grid-column: 1;
      justify-self: start;
      text-align: left;
    }
    .go {
      grid-row: 1;
      grid-column: 2;
    }
    .gb {
      padding-inline: var(--sp-3);
    }
    .gh {
      padding-inline: var(--sp-3);
    }
  }
  /* List variant: a single component, so its rows can sit in two columns on wide screens. */
  @media (min-width: 80rem) {
    .list .group ul {
      columns: 2;
      column-gap: var(--sp-6);
    }
    .list .group li {
      break-inside: avoid;
    }
  }
</style>
