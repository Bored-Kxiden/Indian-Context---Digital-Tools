---
import ModuleChip from './ModuleChip.astro';
import { goals, type GoalIcon } from '../data/goals';
import { url } from '../utils/url';

interface Props {
  /** Heading level for the "I want to…" title. */
  headingId?: string;
}

const { headingId = 'i-want-to-heading' } = Astro.props;

// Minimal stroke icons, one per kind of goal.
const icons: Record<GoalIcon, string> = {
  compass: '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>',
  listen: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>',
  translate: '<path d="M4 8h13l-3-3M20 16H7l3 3"/>',
  lens: '<circle cx="11" cy="11" r="6"/><path d="M16 16l5 5"/>',
  library: '<path d="M5 4v16M10 4v16M15 5l4 15"/>',
  print: '<path d="M7 9V4h10v5M7 17H5v-6h14v6h-2"/><path d="M8 14h8v6H8z"/>',
};
---

<div class="goals" id="i-want-to">
  <div class="head">
    <h2 id={headingId}>I want to…</h2>
    <label class="search">
      <span class="visually-hidden">Search tools and steps</span>
      <input type="search" id="goal-q" placeholder="Find a tool or step…" autocomplete="off" />
    </label>
  </div>

  <p class="none" id="goal-none" hidden>Nothing matches. Try a broader word, such as “translate”, “interview”, or “trust”.</p>

  <ol class="groups">
    {
      goals.map((g) => (
        <li class="group" data-group>
          <header>
            <span class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[g.icon]} />
            </span>
            <h3>{g.title}</h3>
            {g.module && <ModuleChip id={g.module} />}
          </header>
          <ul class="items">
            {g.items.map((item) => (
              <li class="item" data-item data-text={`${g.title} ${item.phrase} ${item.label}`.toLowerCase()}>
                <p class="phrase">{item.phrase}</p>
                <a class="tool" href={url(item.href)}>{item.label}</a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</div>

<script>
  const q = document.getElementById('goal-q') as HTMLInputElement | null;
  const none = document.getElementById('goal-none');
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];

  function apply() {
    const term = (q?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const g of groups) {
      const items = [...g.querySelectorAll<HTMLElement>('[data-item]')];
      let any = false;
      for (const el of items) {
        const ok = !term || (el.dataset.text ?? '').includes(term);
        el.hidden = !ok;
        if (ok) any = true;
      }
      g.hidden = !any;
      if (any) shown += 1;
    }
    if (none) none.hidden = shown !== 0;
  }

  q?.addEventListener('input', apply);
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1.5rem;
  }
  .head h2 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
  }
  .search {
    flex: 1 1 16rem;
    max-width: 24rem;
  }
  input {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 0.65rem 0.9rem;
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
  }
  input:focus-visible {
    border-color: var(--accent);
  }
  .none {
    color: var(--ink-soft);
    padding: 1rem 0;
  }

  .groups {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.25rem;
  }
  .group {
    margin: 0;
  }
  .group header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 3px solid var(--accent);
    margin-bottom: 1rem;
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 2px solid var(--ink);
    color: var(--ink);
    background: var(--surface);
  }
  h3 {
    margin: 0;
    font-size: 1.35rem;
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .item {
    margin: 0;
  }
  .phrase {
    margin: 0 0 0.15rem;
    color: var(--ink-soft);
    font-size: 0.97rem;
    line-height: 1.45;
  }
  .tool {
    display: inline-block;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent);
    padding-block: 0.2rem;
  }
  .tool:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
</style>
