---
import Icon from './Icon.astro';
import type { Goal } from '../data/goals';
import { url } from '../utils/url';

interface Props {
  groups: Goal[];
  /** Small text under the heading. */
  lead?: string;
  /** Show a live search box. */
  search?: boolean;
  /** Show the component label above each group title. */
  showComponent?: boolean;
  /** Put each group's title above its rows instead of beside them (for narrow columns). */
  stack?: boolean;
  /** Small mono label above the heading. */
  eyebrow?: string;
  id?: string;
  headingId?: string;
}

const {
  groups,
  lead,
  search = true,
  showComponent = true,
  stack = false,
  eyebrow = 'Start here',
  id = 'i-want-to',
  headingId = 'i-want-to-heading',
} = Astro.props;
---

<div class="goals" id={id} data-goals>
  <div class="head">
    <div>
      <p class="eb">{eyebrow}</p>
      <h2 id={headingId}>I want to…</h2>
      {lead && <p class="lead-sm">{lead}</p>}
    </div>
    {
      search && (
        <label class="search">
          <span class="visually-hidden">Search tools and steps</span>
          <Icon name="search" size={18} />
          <input type="search" placeholder="Find a tool or step…" autocomplete="off" data-goal-q />
        </label>
      )
    }
  </div>

  <p class="none" data-goal-none hidden>Nothing matches. Try a broader word, such as “translate”, “blame”, “phone” or “trust”.</p>

  <div class="groups">
    {
      groups.map((g) => (
        <section class:list={['group', { stack }]} data-group data-c={g.component}>
          <header>
            {showComponent && <p class="eb comp">{g.componentLabel}</p>}
            <h3>{g.title}</h3>
          </header>
          <ul class="rows">
            {g.items.map((item) => (
              <li data-item data-text={`${g.title} ${g.componentLabel} ${item.phrase} ${item.tag}`.toLowerCase()}>
                <a class="row" href={url(item.href)}>
                  <span class="phrase">{item.phrase}</span>
                  <span class={`tag tag--${item.tone}`}>{item.tag}</span>
                  <span class="go" aria-hidden="true">
                    <Icon name="arrow" size={18} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-goals]').forEach((root) => {
    const q = root.querySelector<HTMLInputElement>('[data-goal-q]');
    const none = root.querySelector<HTMLElement>('[data-goal-none]');
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    if (!q) return;
    q.addEventListener('input', () => {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      for (const g of groups) {
        let any = false;
        for (const el of g.querySelectorAll<HTMLElement>('[data-item]')) {
          const ok = !term || (el.dataset.text ?? '').includes(term);
          el.hidden = !ok;
          if (ok) any = true;
        }
        g.hidden = !any;
        if (any) shown += 1;
      }
      if (none) none.hidden = shown !== 0;
    });
  });
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1.5rem;
  }
  .head h2 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
  }
  .lead-sm {
    margin: 0.75rem 0 0;
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .search {
    flex: 1 1 18rem;
    max-width: 26rem;
    position: relative;
    display: block;
  }
  .search :global(svg) {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }
  .search input {
    padding-left: 2.6rem;
    border-radius: 999px;
  }
  .none {
    color: var(--muted);
    padding: 1rem 0;
  }

  .groups {
    display: grid;
    gap: 0;
  }
  .group {
    display: grid;
    gap: 0.5rem 3rem;
    grid-template-columns: 1fr;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 58rem) {
    .group {
      grid-template-columns: 17rem minmax(0, 1fr);
    }
  }
  .group header .comp {
    margin: 0 0 0.4rem;
    color: var(--accent);
    font-weight: 600;
  }
  .group h3 {
    margin: 0;
    font-size: 1.55rem;
  }
  .group.stack {
    grid-template-columns: minmax(0, 1fr);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    margin: 0;
    border-bottom: 1px solid var(--line);
  }
  .rows li:last-child {
    border-bottom: 0;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.95rem 0.25rem;
    color: var(--ink);
    text-decoration: none;
  }
  .phrase {
    flex: 1 1 18rem;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .row:hover .phrase {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .go {
    display: inline-flex;
    color: var(--ink);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
  }
  .tag--c1 { background: var(--c1); color: #fff; }
  .tag--c2 { background: var(--c2); color: var(--ink); }
  .tag--c3 { background: var(--c3); color: #fff; }
  .tag--c4 { background: var(--c4); color: #fff; }
  .tag--ink { background: var(--ink); color: #fff; }
</style>
