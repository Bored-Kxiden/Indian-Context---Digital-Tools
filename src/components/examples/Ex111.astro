---
import ExFrame from './ExFrame.astro';
import Tag from './Tag.astro';
import Lines from './Lines.astro';

// Booklet p.1.11 · Tool 2 History: The timeline (filled example).
interface Props {
  alt: string;
  caption: string;
}
const { alt, caption } = Astro.props;

const eras = [
  { h: 'Then', lines: ['Paper form from school.', 'Principal signs. Father takes it', 'to the district office. A clerk', 'checks it, and you can explain', 'your case.'] },
  { h: 'Recently', lines: ['Apply online, then hand a', 'printed copy and documents', 'to the college.'] },
  { h: 'Now', lines: ['Fully online. OTP to a', 'registered phone. The college', 'verifies on the portal.'] },
];
const arrows = [
  { cls: 'pp', label: 'People → product', lines: ['Seniors share the cybercafé’s “setting” for', 'getting PDFs under 200KB.'] },
  { cls: 'pq', label: 'Product → people', lines: ['Everyone now needs a PDF, an OTP number', 'and an email address.'] },
];
const asks = [
  { label: ['What it removed'], tag: true, lines: ['Pleading your case to a', 'person who could bend a', 'rule.'] },
  { label: ['Same power, new', 'medium'], tag: true, lines: ['The principal’s signature', 'became the college’s online', 'verification.'] },
  { label: ['Who shapes whom'], tag: false, lines: ['Product → people is much', 'stronger.'] },
];
---

<ExFrame page="1.11" alt={alt} caption={caption}>
  <div class="tlx">
    <div class="frame">
      <Tag>S1 Evidence · On the timeline</Tag>
      <div class="line" aria-hidden="true"><i></i><i></i><i></i></div>
      <ol class="eras">
        {
          eras.map((e) => (
            <li>
              <h4>{e.h}</h4>
              <p><Lines lines={e.lines} /></p>
            </li>
          ))
        }
      </ol>
      <div class="arrows">
        {
          arrows.map((a) => (
            <div class={`arrow ${a.cls}`}>
              <span class="lbl">{a.label}</span>
              <p class="stk"><Lines lines={a.lines} /></p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="asks">
      {
        asks.map((a) => (
          <section class="ask">
            <div class="hd">
              <span class="lbl">{a.label.map((l, i) => <>{l}{i < a.label.length - 1 && <br class="b" />}{i < a.label.length - 1 && ' '}</>)}</span>
              {a.tag && <Tag>S3 Question</Tag>}
            </div>
            <p><Lines lines={a.lines} /></p>
          </section>
        ))
      }
    </div>

    <div class="roles">
      <section class="role">
        <Tag>S3 People</Tag>
        <p><b>Lost a role:</b> <Lines lines={['the clerk who could explain and', 'make exceptions.']} /></p>
      </section>
      <section class="role">
        <Tag>S3 People</Tag>
        <p><b>Gained one:</b> <Lines lines={['cybercafé operators and form-', 'filling agents.']} /></p>
      </section>
    </div>
  </div>
</ExFrame>

<style is:global>
  .tlx {
    --bk-terra: #a8432a;
    --bk-teal-ink: #1f5d58;
    --shadow: calc(var(--u) * 2.2) calc(var(--u) * 2.2) 0 rgb(0 0 0 / 0.1216);
    display: grid;
    gap: calc(var(--u) * 12);
  }
  .tlx ol,
  .tlx p {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tlx .frame {
    position: relative;
    background: #fff;
    border: calc(var(--u) * 0.75) solid var(--bk-ink);
    border-radius: calc(var(--u) * 15);
    padding: calc(var(--u) * 19) calc(var(--u) * 14.6) calc(var(--u) * 14.6);
  }
  .tlx .frame > .tag {
    position: absolute;
    right: calc(var(--u) * 12.3);
    top: calc(var(--u) * -7.4);
  }
  .tlx .line {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin: 0 calc(var(--u) * 6);
    height: calc(var(--u) * 10.5);
  }
  .tlx .line::before {
    content: '';
    position: absolute;
    left: calc(var(--u) * 5);
    right: calc(var(--u) * 5);
    top: calc(var(--u) * 4.2);
    height: calc(var(--u) * 2.2);
    background: var(--bk-ink);
  }
  .tlx .line i {
    position: relative;
    width: calc(var(--u) * 10.5);
    height: calc(var(--u) * 10.5);
    border-radius: 50%;
    background: var(--bk-terra);
  }
  .tlx .eras {
    display: grid;
    grid-template-columns: calc(var(--u) * 164.45) calc(var(--u) * 164.45) minmax(0, 1fr);
    margin-top: calc(var(--u) * 10.7);
    white-space: nowrap;
  }
  .tlx .eras h4 {
    margin: 0 0 calc(var(--u) * 5.8);
    font-size: max(18px, calc(var(--u) * 15));
    font-variation-settings: 'opsz' 20;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0;
  }
  .tlx .eras p {
    line-height: 1.38;
  }
  .tlx .arrows {
    display: grid;
    grid-template-columns: repeat(2, calc(var(--u) * 235.4));
    gap: calc(var(--u) * 9);
    margin-top: calc(var(--u) * 14.5);
    white-space: nowrap;
  }
  .tlx .arrow {
    border-top: calc(var(--u) * 2.3) solid var(--bk-ink);
  }
  .tlx .arrow.pq {
    border-color: var(--bk-terra);
  }
  .tlx .arrow .lbl {
    margin: calc(var(--u) * 5.3) 0 calc(var(--u) * 5.5);
    color: var(--bk-ink);
    font-size: max(11px, calc(var(--u) * 7.5));
  }
  .tlx .arrow.pq .lbl {
    color: var(--bk-terra);
  }
  .tlx .stk,
  .tlx .ask {
    background: var(--bk-yellow-dot);
    box-shadow: var(--shadow);
  }
  .tlx .arrow .stk {
    padding: calc(var(--u) * 6.8) calc(var(--u) * 9) calc(var(--u) * 8);
    min-height: calc(var(--u) * 43.5);
    line-height: 1.36;
  }
  .tlx .asks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(var(--u) * 7.4);
    margin-top: calc(var(--u) * 0.3);
  }
  .tlx .ask {
    background: var(--bk-teal);
    padding: calc(var(--u) * 7.8) calc(var(--u) * 9) calc(var(--u) * 8);
    min-height: calc(var(--u) * 78.8);
    white-space: nowrap;
  }
  .tlx .ask .hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--u) * 4.5);
    margin-bottom: calc(var(--u) * 1.2);
  }
  .tlx .ask .lbl {
    margin: 0;
    color: var(--bk-teal-ink);
    font-weight: 600;
    font-size: max(11px, calc(var(--u) * 7.1));
    line-height: 1.37;
    white-space: normal;
  }
  .tlx .ask p {
    line-height: 1.36;
  }
  .tlx .roles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--u) * 7.5);
  }
  .tlx .role {
    position: relative;
    background: #fff;
    border: calc(var(--u) * 0.75) solid var(--bk-ink);
    padding: calc(var(--u) * 7.2) calc(var(--u) * 9) calc(var(--u) * 8.2);
    min-height: calc(var(--u) * 45);
    line-height: 1.36;
    white-space: nowrap;
  }
  .tlx .role .tag {
    position: absolute;
    right: calc(var(--u) * 8.3);
    top: calc(var(--u) * -7);
  }
  .tlx .role p {
    line-height: 1.36;
  }

  @container (max-width: 45rem) {
    .tlx .eras,
    .tlx .arrows,
    .tlx .asks,
    .tlx .roles,
    .tlx .eras p,
    .tlx .arrow .stk,
    .tlx .ask,
    .tlx .role {
      white-space: normal;
    }
    .tlx .frame {
      border-radius: var(--r-md);
      padding: var(--sp-3) var(--sp-2) var(--sp-2);
    }
    .tlx .frame > .tag {
      position: static;
      margin-bottom: var(--sp-2);
    }
    .tlx .line {
      display: none;
    }
    .tlx .eras {
      grid-template-columns: 1fr;
      margin-top: 0;
      gap: var(--sp-2);
      border-left: 2px solid var(--bk-ink);
      margin-left: 5px;
    }
    .tlx .eras li {
      position: relative;
      padding-left: var(--sp-3);
    }
    .tlx .eras li::before {
      content: '';
      position: absolute;
      left: -7px;
      top: 4px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--bk-terra);
    }
    .tlx .eras h4 {
      margin-bottom: 2px;
    }
    .tlx .arrows,
    .tlx .asks,
    .tlx .roles {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
    .tlx .arrows {
      margin-top: var(--sp-3);
    }
    .tlx .arrow .stk,
    .tlx .ask,
    .tlx .role {
      min-height: 0;
      padding: var(--sp-1) var(--sp-2);
    }
    .tlx .arrow .stk {
      padding-block: var(--sp-1);
    }
    .tlx .ask {
      box-shadow: 3px 3px 0 rgb(0 0 0 / 0.12);
    }
    .tlx .role {
      padding-top: var(--sp-3);
    }
    .tlx .role .tag {
      right: var(--sp-1);
      top: -12px;
    }
  }
</style>
