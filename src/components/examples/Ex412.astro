---
import ExFrame from './ExFrame.astro';
import Lines from './Lines.astro';

// Booklet p.4.12 · Tool 2 Break, Part A: the Whisper (filled example).
interface Props {
  alt: string;
  caption: string;
}
const { alt, caption } = Astro.props;

const facts = ['PDF only', 'Max 200KB', 'Income certificate', 'Dated after 1 April'];
// 1 = the fact survived (a dot), 0 = it was lost (a crossed circle)
const asked = [
  { who: 'Roommate', how: 'She told us', said: '“Make it a PDF, there’s some app for that.”', marks: [1, 0, 0, 0], adds: '+1 hr' },
  { who: 'Class WhatsApp', how: 'Screenshot', said: '“Scan all your docs, last date 30th.”', marks: [0, 0, 1, 0], adds: '+1 day' },
  { who: 'Senior', how: 'She told us', said: '“Just go to the cybercafé, bhaiya knows.”', marks: [0, 0, 0, 0], adds: '+ hours' },
];
const chips: [string, string, boolean][] = [
  ['PDF know-how', 'Cybercafé owner', false],
  ['OTP', 'Father', true],
  ['Wi-Fi drops', 'Her data pack', false],
  ['Data runs out', '✕ Nobody', true],
  ['Certificate', 'Father', true],
];
---

<ExFrame page="4.12" alt={alt} caption={caption}>
  <div class="wh">
    <section class="facts">
      <div class="top">
        <span class="lbl">The facts · from the portal’s notice</span>
        <b class="brk">Break: PDF know-how</b>
      </div>
      <ol>
        {facts.map((f, i) => <li><span class="b" aria-hidden="true">{i + 1}</span><b><span class="visually-hidden">Fact {i + 1}: </span>{f}</b></li>)}
      </ol>
    </section>

    <div class="tw" tabindex="0" role="region" aria-label="The Whisper: who she asked and what they told her">
      <table>
        <caption class="visually-hidden">Who Meera asked, what they told her, which of the four facts survived, and the time each added</caption>
        <colgroup>
          <col class="w0" />
          <col class="w1" />
          <col class="w2" /><col class="w2" /><col class="w2" /><col class="w2" />
          <col />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">Who she asked</th>
            <th scope="col">What they told her</th>
            {[1, 2, 3, 4].map((n) => <th scope="col" class="num"><span class="visually-hidden">Fact </span>{n}</th>)}
            <th scope="col" class="adds">Adds</th>
          </tr>
        </thead>
        <tbody>
          {
            asked.map((r) => (
              <tr>
                <th scope="row"><b>{r.who}</b><span class="lbl">{r.how}</span></th>
                <td class="said"><q>{r.said.replace(/[“”]/g, '')}</q></td>
                {
                  r.marks.map((m) => (
                    <td class="mk">
                      {
                        m ? (
                          <>
                            <svg viewBox="0 0 10.8 10.8" aria-hidden="true"><circle cx="5.4" cy="5.4" r="5.4" fill="currentColor" /></svg>
                            <span class="visually-hidden">Survived</span>
                          </>
                        ) : (
                          <>
                            <svg viewBox="0 0 10.2 10.2" aria-hidden="true" class="lost">
                              <circle cx="5.1" cy="5.1" r="4.4" fill="none" stroke="currentColor" stroke-width="1.35" />
                              <line x1="2.2" y1="8" x2="8" y2="2.2" stroke="currentColor" stroke-width="1.35" />
                            </svg>
                            <span class="visually-hidden">Lost</span>
                          </>
                        )
                      }
                    </td>
                  ))
                }
                <td class="adds">{r.adds}</td>
              </tr>
            ))
          }
          <tr class="big">
            <th scope="row"><b>Cybercafé owner</b><span class="lbl">We visited</span></th>
            <td colspan="6" class="bt">
              <div>
                <p><Lines lines={['Solves it for ₹30–50. Picks the file settings', 'himself.']} /></p>
                <span class="bp">Big player</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="rep">
      <p class="lbl">Repeat for every ✕ · the big players</p>
      <ul>
        {chips.map(([a, b, hot]) => <li class:list={{ hot }}>{a} → <b>{b}</b></li>)}
      </ul>
    </div>
  </div>
</ExFrame>

<style is:global>
  .wh {
    --bk-terra: #a8432a;
    display: grid;
    gap: calc(var(--u) * 10.5);
  }
  .wh .facts {
    background: #eef0f6;
    border: calc(var(--u) * 0.75) solid var(--bk-indigo);
    border-radius: calc(var(--u) * 12);
    padding: calc(var(--u) * 8.7) calc(var(--u) * 11.55) calc(var(--u) * 8.5) calc(var(--u) * 11.65);
  }
  .wh .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--u) * 4) calc(var(--u) * 8);
  }
  .wh .top .lbl {
    margin: 0;
    color: var(--bk-indigo);
    font-size: max(11px, calc(var(--u) * 7.5));
  }
  .wh .brk {
    background: var(--bk-terra);
    color: #fff;
    border-radius: calc(var(--u) * 4.5);
    padding: 0 calc(var(--u) * 8.4);
    height: calc(var(--u) * 16.4);
    min-height: 1.9em;
    display: inline-flex;
    align-items: center;
    font-size: max(13px, calc(var(--u) * 9.8));
    font-variation-settings: 'opsz' 13;
    font-weight: 600;
    white-space: nowrap;
  }
  .wh .facts ol {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--u) * 6) calc(var(--u) * 13.2);
    margin-top: calc(var(--u) * 6);
  }
  .wh .facts li {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 4.6);
    font-size: var(--t-body);
    white-space: nowrap;
  }
  .wh .facts li b {
    font-weight: 700;
  }
  .wh .facts .b {
    display: grid;
    place-items: center;
    flex: none;
    width: max(20px, calc(var(--u) * 16.5));
    height: max(20px, calc(var(--u) * 16.5));
    border-radius: 50%;
    background: var(--bk-ink);
    color: var(--bk-cream, #f5f0e6);
    font-size: max(11px, calc(var(--u) * 8.2));
    font-weight: 600;
    line-height: 1;
  }

  .wh .tw {
    background: #fff;
    border: calc(var(--u) * 0.75) solid var(--bk-ink);
    border-radius: calc(var(--u) * 12);
    overflow: hidden;
  }
  .wh table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: var(--t-body);
    line-height: 1.3;
  }
  .wh col.w0 {
    width: calc(var(--u) * 108.85);
  }
  .wh col.w1 {
    width: calc(var(--u) * 234.1);
  }
  .wh col.w2 {
    width: calc(var(--u) * 28.5);
  }
  .wh th,
  .wh td {
    padding: 0;
    text-align: left;
    font-weight: 400;
    vertical-align: middle;
    white-space: nowrap;
  }
  .wh tbody tr {
    height: calc(var(--u) * 42);
  }
  .wh thead tr {
    height: calc(var(--u) * 32.4);
  }
  .wh tr:not(.big) {
    background: linear-gradient(var(--bk-ink), var(--bk-ink)) calc(var(--u) * 10.1) 100% / calc(100% - var(--u) * 20.2) calc(var(--u) * 0.75) no-repeat;
  }
  .wh tbody tr:last-child:not(.big) {
    background: none;
  }
  .wh th:first-child {
    padding-left: calc(var(--u) * 13.85);
  }
  .wh td:nth-child(2) {
    padding-left: calc(var(--u) * 7);
  }
  .wh thead th {
    font-family: var(--font-mono);
    font-size: max(11px, calc(var(--u) * 7.5));
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3f3a33;
  }
  .wh thead th:nth-child(2) {
    padding-left: calc(var(--u) * 7);
  }
  .wh th.num,
  .wh td.mk {
    text-align: center;
  }
  .wh .adds {
    text-align: right;
    padding-right: calc(var(--u) * 14.15);
    font-family: var(--font-mono);
    font-size: max(11px, calc(var(--u) * 7.5));
    color: #3f3a33;
  }
  .wh tbody th b {
    display: block;
    font-size: var(--t-body);
    font-weight: 700;
    line-height: 1.2;
  }
  .wh tbody th .lbl {
    margin: calc(var(--u) * 2.4) 0 0;
    font-size: max(11px, calc(var(--u) * 6.8));
    line-height: 1.3;
  }
  .wh .said q {
    quotes: '“' '”';
    font-style: italic;
    font-size: var(--t-body);
  }
  .wh .mk svg {
    width: max(10px, calc(var(--u) * 10.8));
    height: max(10px, calc(var(--u) * 10.8));
    vertical-align: middle;
    color: var(--bk-ink);
  }
  .wh .mk svg.lost {
    color: var(--bk-terra);
  }
  .wh tr.big {
    background: var(--bk-ink);
    color: var(--bk-cream, #f5f0e6);
    height: calc(var(--u) * 43.5);
  }
  .wh tr.big th .lbl {
    color: #cfc8ba;
  }
  .wh tr.big .bt {
    padding-left: calc(var(--u) * 7);
    padding-right: calc(var(--u) * 13.85);
  }
  .wh tr.big .bt > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--u) * 8);
  }
  .wh .bp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: calc(var(--u) * 21.7);
    min-height: 2em;
    padding: 0 calc(var(--u) * 12);
    border-radius: 999px;
    background: #e3a72f;
    color: var(--bk-ink);
    font-family: var(--font-mono);
    font-size: max(11px, calc(var(--u) * 7.9));
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .wh .rep .lbl {
    margin: 0 0 calc(var(--u) * 7.3);
    color: var(--bk-ink);
    font-size: max(11px, calc(var(--u) * 7.5));
  }
  .wh .rep ul {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--u) * 5.3);
  }
  .wh .rep li {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--u) * 3);
    height: calc(var(--u) * 21);
    min-height: 2.1em;
    padding: 0 calc(var(--u) * 8.6);
    background: #fff;
    border: calc(var(--u) * 0.75) solid var(--bk-ink);
    border-radius: 999px;
    font-size: max(13px, calc(var(--u) * 10.1));
    font-variation-settings: 'opsz' 13.5;
    white-space: nowrap;
  }
  .wh .rep li b {
    font-weight: 700;
  }
  .wh .rep li.hot {
    border-color: var(--bk-terra);
  }
  .wh .rep li.hot b {
    color: var(--bk-terra);
  }

  @container (max-width: 45rem) {
    .wh .tw {
      overflow-x: auto;
      border-radius: var(--r-md);
    }
    .wh table {
      --u: calc(44rem / 511.5);
      width: 44rem;
    }
    .wh .tw:focus-visible {
      outline-offset: 2px;
    }
    .wh .facts {
      border-radius: var(--r-md);
      padding: var(--sp-2);
    }
    .wh .facts li,
    .wh .rep li {
      white-space: normal;
    }
  }
</style>
