---
import ExFrame from './ExFrame.astro';
import Lines from './Lines.astro';

// Booklet p.4.20 · Tool 4 Say: the brief pad (filled example).
interface Props {
  alt: string;
  caption: string;
}
const { alt, caption } = Astro.props;

const top = [
  { k: 'The product assumed…', lines: ['A computer, a scanner, steady internet, one sitting, an OTP on', 'her own phone.'] },
  { k: 'What existed was…', lines: ['Her own phone, patchy Wi-Fi, prepaid data, no scanner, the', 'certificate back home.'] },
  { k: 'So she…', lines: ['Asked around until she reached the cybercafé owner, and', 'relied on her father twice.'] },
  { k: 'It cost her…', lines: ['3 days+ · ₹30–50 + data · a family trip. It ate into Education, the', '2nd thing compromised.'] },
];
const asks = [
  { k: 'Whose decision was it?', lines: ['The scheme’s rules require a paper certificate from the', 'Tehsildar.'] },
  { k: 'Who benefits · who pays?', lines: ['The scheme avoids building an online check. Meera and her', 'family pay in time, travel and money.'], wrap: ['Who benefits · who', 'pays?'] },
  { k: 'Was it intentional?', lines: ['The rule was. The cost to families probably wasn’t thought', 'through.'] },
];
---

<ExFrame page="4.20" alt={alt} caption={caption}>
  <div class="bf">
    <div class="pad">
      <dl>
        {
          top.map((r, i) => (
            <div class:list={['row', { first: i === 0 }]}>
              <dt>{r.k}</dt>
              <dd><Lines lines={r.lines} /></dd>
            </div>
          ))
        }
        <div class="row">
          <dt>This is…</dt>
          <dd class="tags">
            <span class="ln"><b class="pill pill--o">Oversight</b> no photo-to-PDF, no saving halfway.</span>
            <span class="ln"><b class="pill pill--l">Offload</b> proof of income on paper only.</span>
          </dd>
        </div>
        {
          asks.map((r) => (
            <div class="row ask">
              <dt><span aria-hidden="true">↳</span> {r.wrap ? <Lines lines={r.wrap} /> : r.k}</dt>
              <dd><Lines lines={r.lines} /></dd>
            </div>
          ))
        }
        <div class="row one">
          <dt>It is true for…</dt>
          <dd class="hint">[How many — from the Count cards, with the source]</dd>
        </div>
        <div class="row last">
          <dt>Prototype next…</dt>
          <dd><Lines lines={['Photo-to-PDF in the portal · save and come back · OTP to a', 'number she chooses.']} /></dd>
        </div>
      </dl>
    </div>

    <section class="line">
      <p class="lbl">In one line</p>
      <p class="say"><Lines lines={['The problem isn’t the upload screen. It’s three things the portal', 'never helped her get, and one person she can’t do without.']} /></p>
    </section>
  </div>
</ExFrame>

<style is:global>
  .bf {
    --bk-terra: #a8432a;
    display: grid;
    gap: calc(var(--u) * 11);
  }
  .bf .pad {
    background: #fff;
    border: calc(var(--u) * 0.75) solid var(--bk-ink);
    border-radius: calc(var(--u) * 12);
    overflow: hidden;
  }
  .bf dl {
    margin: 0;
  }
  .bf .row {
    display: grid;
    grid-template-columns: calc(var(--u) * 152.9) minmax(0, 1fr);
    align-items: start;
    margin: 0 calc(var(--u) * 15.4);
    padding: calc(var(--u) * 6.9) 0 calc(var(--u) * 7.4);
    border-bottom: calc(var(--u) * 0.7) solid #cfc8ba;
    white-space: nowrap;
  }
  .bf .row.first {
    padding-top: calc(var(--u) * 8);
  }
  .bf dt {
    font-size: var(--t-head);
    font-variation-settings: 'opsz' 15;
    font-weight: 700;
    line-height: 1.34;
    padding-top: calc(var(--u) * 0.2);
  }
  .bf dd {
    margin: 0;
    font-size: max(14px, calc(var(--u) * 10.9));
    font-variation-settings: 'opsz' 14.5;
    line-height: 1.38;
  }
  .bf .row.ask {
    margin: 0;
    padding-left: calc(var(--u) * 25.8);
    padding-right: calc(var(--u) * 15.4);
    background: #f8ece8;
    min-height: calc(var(--u) * 44.6);
  }
  .bf .row.ask dt {
    font-size: max(14px, calc(var(--u) * 10.5));
    font-variation-settings: 'opsz' 14;
    padding-right: calc(var(--u) * 6);
  }
  .bf .row.ask {
    grid-template-columns: calc(var(--u) * 142.6) minmax(0, 1fr);
  }
  .bf .row.one {
    padding: calc(var(--u) * 6.4) 0 calc(var(--u) * 6.3);
  }
  .bf .row.last {
    border-bottom: 0;
    padding-bottom: calc(var(--u) * 10);
  }
  .bf .hint {
    color: var(--bk-muted);
  }
  .bf .tags .ln {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 5.2);
    min-height: calc(var(--u) * 15.2);
  }
  .bf .pill {
    display: inline-flex;
    align-items: center;
    height: calc(var(--u) * 14.5);
    min-height: 1.9em;
    padding: 0 calc(var(--u) * 6.4);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: max(11px, calc(var(--u) * 7.5));
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
  }
  .bf .pill--o {
    border: calc(var(--u) * 0.75) solid var(--bk-ink);
    background: #fff;
    color: var(--bk-ink);
  }
  .bf .pill--l {
    background: var(--bk-terra);
    color: #fff;
  }
  .bf .line {
    background: var(--bk-ink);
    color: var(--bk-cream, #f5f0e6);
    border-radius: calc(var(--u) * 12);
    padding: calc(var(--u) * 12.8) calc(var(--u) * 16.5);
  }
  .bf .line .lbl {
    margin: 0 0 calc(var(--u) * 6);
    color: #e3a72f;
    font-size: max(11px, calc(var(--u) * 8.2));
  }
  .bf .say {
    font-size: max(17px, calc(var(--u) * 15));
    font-variation-settings: 'opsz' 20;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
  }

  @container (max-width: 45rem) {
    .bf .row,
    .bf .row.ask {
      grid-template-columns: 1fr;
      gap: 4px;
      margin: 0 var(--sp-2);
      padding: var(--sp-2) 0;
      white-space: normal;
      min-height: 0;
    }
    .bf .row.ask {
      margin: 0;
      padding-inline: var(--sp-2);
    }
    .bf .row.first,
    .bf .row.one,
    .bf .row.last {
      padding-block: var(--sp-2);
    }
    .bf .pad {
      border-radius: var(--r-md);
    }
    .bf .tags .ln {
      flex-wrap: wrap;
    }
    .bf .line {
      border-radius: var(--r-md);
      padding: var(--sp-2);
    }
    .bf .say {
      white-space: normal;
    }
  }
</style>
