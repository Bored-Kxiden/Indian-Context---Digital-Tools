---
import ExFrame from './ExFrame.astro';

// Booklet p.3.09 · Tool 2 Translate, Part A: thick translation, the reverse survey and the
// support check (filled example).
interface Props {
  alt: string;
  caption: string;
}
const { alt, caption } = Astro.props;

const directions = [
  { title: 'Native|English', ask: 'Show the phrase. “What does it mean, in English?”', got: ['“It’s in God’s hands” · “the officials decide” [n of N]'] },
  {
    title: 'English|native',
    ask: 'Show “Your application is under review.” “How would you say it?”',
    got: ['“Pending mein hai” · “upar gaya hai”: ', 'pending', ' is borrowed'],
  },
  { title: 'Native|regional', ask: 'Ask the collaborator for the regional version, then test it.', got: ['[Regional version from your collaborator]'] },
];

const checks = [
  ['Source language', 'Hindi–English mix, recorded as such'],
  ['Who interpreted', 'Local collaborator'],
  ['Rendering', 'Conceptual gloss'],
  ['Single source?', 'No: a second reader agreed'],
];
---

<ExFrame page="3.09" alt={alt} caption={caption}>
  <div class="e309">
    <dl class="tt">
      <div class="r r--s">
        <dt class="lbl">As said</dt>
        <dd>
          <span class="dev" lang="hi">फ़ॉर्म तो भर दिया, अब ऊपर वाले की मर्ज़ी।</span>
          <span class="lat">Form toh bhar diya, ab upar wale ki marzi.</span>
        </dd>
      </div>
      <div class="r">
        <dt class="lbl">Literal</dt>
        <dd>“I’ve filled the form, now it’s the wish of the one above.”</dd>
      </div>
      <div class="r">
        <dt class="lbl">In context</dt>
        <dd>She has done her part. The outcome is decided somewhere she can’t see or reach.</dd>
      </div>
      <div class="r">
        <dt class="lbl">Alternatives</dt>
        <dd>“It’s in God’s hands.” · “It’s up to the officials now.” · “Nothing more I can do.”</dd>
      </div>
      <div class="r r--i">
        <dt class="lbl">Implied</dt>
        <dd><b>Loss of control, and not knowing who decides.</b> Resignation, with a little humour.</dd>
      </div>
      <div class="r">
        <dt class="lbl">Reviewed by</dt>
        <dd>Local language collaborator (Hindi, Bhojpuri). Agreed; added “the officials” reading.</dd>
      </div>
    </dl>

    <section aria-labelledby="e309-s">
      <h4 class="sec" id="e309-s">Reverse thick translation · survey in three directions</h4>
      <ul class="dirs">
        {
          directions.map((d) => (
            <li class="dc">
              <b>{d.title.split('|')[0]} <span class="ar" aria-hidden="true">→</span><span class="visually-hidden"> to </span> {d.title.split('|')[1]}</b>
              <span class="ask">{d.ask}</span>
              <span class="got">
                {d.got.length === 3 ? (
                  <>
                    {d.got[0]}
                    <i>{d.got[1]}</i>
                    {d.got[2]}
                  </>
                ) : (
                  d.got[0]
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="fin">
      <section class="chk" aria-labelledby="e309-c">
        <h4 class="sec" id="e309-c">Support check · all four needed</h4>
        <ul>
          {
            checks.map(([t, d]) => (
              <li>
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m2.5 8.6 3.6 3.6L13.5 3.8" /></svg>
                <span>
                  <b>{t}</b>
                  <span class="d">{d}</span>
                  <span class="visually-hidden">Ticked.</span>
                </span>
              </li>
            ))
          }
        </ul>
      </section>
      <div class="ok">
        <span class="lbl">Supported</span>
        <p>Store the pattern. Take it to Tool 3.</p>
      </div>
    </div>
  </div>
</ExFrame>

<style is:global>
  .e309 {
    --bk-terra: #a8432a;
    --bk-green: #2e5e4e;
    display: grid;
    gap: calc(var(--u) * 9);
  }
  .e309 .sec {
    margin: 0 0 calc(var(--u) * 6);
    font-family: var(--font-mono);
    font-size: max(11px, calc(var(--u) * 7.8));
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #6f695e;
  }

  /* The thick translation */
  .e309 .tt {
    margin: 0;
    background: #fff;
    border: calc(var(--u) * 1) solid var(--bk-ink);
    border-radius: calc(var(--u) * 10);
    overflow: hidden;
  }
  .e309 .r {
    display: grid;
    grid-template-columns: calc(var(--u) * 101.6) minmax(0, 1fr);
    align-items: center;
    min-height: calc(var(--u) * 26.6);
    padding: calc(var(--u) * 4.4) calc(var(--u) * 8) calc(var(--u) * 4.4) 0;
    border-top: calc(var(--u) * 0.7) solid #dfd9d0;
  }
  .e309 .r:first-child {
    border-top: 0;
  }
  .e309 .r--s {
    min-height: calc(var(--u) * 41);
    align-items: start;
    padding-top: calc(var(--u) * 6);
  }
  .e309 .r--i {
    background: #f0ddd6;
  }
  .e309 .r dt.lbl {
    margin: 0;
    padding-left: calc(var(--u) * 9.8);
    font-size: max(11px, calc(var(--u) * 6.9));
    letter-spacing: 0.1em;
    color: var(--bk-terra);
  }
  .e309 .r--s dt.lbl {
    padding-top: calc(var(--u) * 2.6);
  }
  .e309 .r dd {
    margin: 0;
    font-variation-settings: 'opsz' 13;
    font-size: max(14px, calc(var(--u) * 10.1));
    line-height: 1.3;
  }
  .e309 .r dd b {
    font-weight: 700;
  }
  .e309 .dev {
    display: block;
    font-size: max(15px, calc(var(--u) * 11));
    line-height: 1.35;
  }
  .e309 .lat {
    display: block;
    margin-top: calc(var(--u) * 2.5);
    font-size: max(13px, calc(var(--u) * 9.2));
    color: #6f695e;
  }

  /* The survey */
  .e309 .dirs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(var(--u) * 6.6);
  }
  .e309 .dc {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: calc(var(--u) * 0.75) solid #dcd6c9;
    border-radius: calc(var(--u) * 8);
    padding: calc(var(--u) * 8.5) calc(var(--u) * 8.3) calc(var(--u) * 7.6);
    min-height: calc(var(--u) * 87.5);
  }
  .e309 .dc b {
    font-variation-settings: 'opsz' 15;
    font-size: max(15px, calc(var(--u) * 11.4));
    font-weight: 700;
    line-height: 1.25;
  }
  .e309 .dc .ar {
    font-family: system-ui, sans-serif;
    font-weight: 400;
  }
  .e309 .dc .ask {
    margin-top: calc(var(--u) * 2.5);
    font-variation-settings: 'opsz' 12;
    font-size: max(14px, calc(var(--u) * 9.3));
    line-height: 1.4;
    color: #5a544b;
  }
  .e309 .dc .got {
    margin-top: auto;
    background: #fdf6e2;
    padding: calc(var(--u) * 3.5) calc(var(--u) * 4);
    font-variation-settings: 'opsz' 12;
    font-size: max(14px, calc(var(--u) * 9));
    line-height: 1.5;
  }

  /* The support check */
  .e309 .fin {
    display: grid;
    grid-template-columns: minmax(0, 362fr) minmax(0, 142fr);
    gap: calc(var(--u) * 7.5);
  }
  .e309 .chk {
    background: #fff;
    border: calc(var(--u) * 1) solid var(--bk-ink);
    border-radius: calc(var(--u) * 10);
    padding: calc(var(--u) * 8) calc(var(--u) * 10) calc(var(--u) * 7);
  }
  .e309 .chk .sec {
    margin-bottom: calc(var(--u) * 3.6);
  }
  .e309 .chk ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--u) * 4) calc(var(--u) * 8);
  }
  .e309 .chk li {
    display: grid;
    grid-template-columns: calc(var(--u) * 13) minmax(0, 1fr);
    align-items: start;
    gap: 0 calc(var(--u) * 1);
    font-variation-settings: 'opsz' 13;
  }
  .e309 .chk svg {
    width: calc(var(--u) * 9.5);
    height: calc(var(--u) * 9.5);
    min-width: 12px;
    margin-top: calc(var(--u) * 2);
    fill: none;
    stroke: var(--bk-green);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .e309 .chk b {
    display: block;
    font-size: max(14px, calc(var(--u) * 10));
    font-weight: 700;
    line-height: 1.3;
  }
  .e309 .chk .d {
    display: block;
    font-size: max(14px, calc(var(--u) * 9.4));
    line-height: 1.4;
    color: #3a362f;
  }
  .e309 .ok {
    background: var(--bk-green);
    color: #fff;
    border-radius: calc(var(--u) * 10);
    padding: calc(var(--u) * 9.5) calc(var(--u) * 6) calc(var(--u) * 9.5) calc(var(--u) * 10);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .e309 .ok .lbl {
    margin: 0 0 calc(var(--u) * 3);
    font-size: max(11px, calc(var(--u) * 7.2));
    letter-spacing: 0.1em;
    color: #d9e8e1;
  }
  .e309 .ok p {
    font-variation-settings: 'opsz' 15;
    font-size: max(15px, calc(var(--u) * 10.7));
    font-weight: 700;
    line-height: 1.3;
  }
  @container (max-width: 45rem) {
    .e309 {
      --u: 1.33px;
    }
    .e309 .r,
    .e309 .r--s {
      grid-template-columns: 1fr;
      padding: calc(var(--u) * 6) calc(var(--u) * 8);
      gap: var(--sp-half);
      min-height: 0;
    }
    .e309 .r dt.lbl,
    .e309 .r--s dt.lbl {
      padding: 0;
    }
    .e309 .dirs,
    .e309 .fin,
    .e309 .chk ul {
      grid-template-columns: minmax(0, 1fr);
    }
    .e309 .dc {
      min-height: 0;
      gap: var(--sp-half);
    }
    .e309 .dc .got {
      margin-top: var(--sp-1);
    }
  }
</style>
