---
import ExFrame from './ExFrame.astro';

// Booklet p.3.20 · Tool 5 Kahavat Relay, Part B: idiom cards. A print sheet: six Hindi examples
// and three blanks for idioms from the participants' own language.
interface Props {
  alt: string;
  caption: string;
}
const { alt, caption } = Astro.props;

const cards = [
  { hi: 'एक अनार, सौ बीमार', lat: 'Ek anaar, sau beemar', lit: 'One pomegranate, a hundred sick', mean: 'One thing, far too many people who need it.' },
  { hi: 'ऊँट के मुँह में ज़ीरा', lat: 'Oont ke munh mein jeera', lit: 'A cumin seed in a camel’s mouth', mean: 'Far too little for what’s needed.' },
  { hi: 'नाच न जाने, आँगन टेढ़ा', lat: 'Naach na jaane, aangan tedha', lit: 'Can’t dance, blames the crooked courtyard', mean: 'Blaming the surroundings for your own trouble.' },
  { hi: 'दूर के ढोल सुहावने', lat: 'Door ke dhol suhaavne', lit: 'Distant drums sound sweet', mean: 'Things look better from far away.' },
  { hi: 'आसमान से गिरा, खजूर में अटका', lat: 'Aasmaan se gira, khajoor mein atka', lit: 'Fell from the sky, stuck in a date palm', mean: 'Out of one trouble, straight into another.' },
  { hi: 'जितनी चादर, उतने पैर पसारो', lat: 'Jitni chaadar, utne pair pasaaro', lit: 'Stretch your legs only as far as the sheet', mean: 'Live within what you have.' },
];
---

<ExFrame page="3.20" alt={alt} caption={caption}>
  <div class="e320">
    <p class="pl">
      Six Hindi examples, three blanks. <b>Better: collect idioms from the participants’ own language</b> in Before you start, and
      check each meaning with your language collaborator. Don’t explain the meaning to the first person unless they ask.
    </p>

    <ol class="sheet">
      {
        cards.map((c) => (
          <li class="cell">
            <article class="ic">
              <div class="hd"><span>Kahavat</span><span>C3 · Tool 5</span></div>
              <div class="bd">
                <h4 lang="hi">{c.hi}</h4>
                <p class="lt">{c.lat}</p>
                <dl>
                  <div>
                    <dt class="lbl">Literally</dt> <dd>{c.lit}</dd>
                  </div>
                  <div>
                    <dt class="lbl">Usually means</dt> <dd>{c.mean}</dd>
                  </div>
                </dl>
                <p class="wq"><span aria-hidden="true">→</span> When has this happened to you?</p>
              </div>
            </article>
          </li>
        ))
      }
      {
        [1, 2, 3].map(() => (
          <li class="cell">
            <article class="ic ic--b">
              <span class="visually-hidden">Blank card for an idiom from the participants’ own language.</span>
              <div class="bd">
                <span class="lbl">Kahavat · from the participants’ own language</span>
                <div class="wl"></div>
                <div class="wl"></div>
                <span class="lbl lbl--m">Usually means</span>
                <div class="wl"></div>
                <p class="wq"><span aria-hidden="true">→</span> When has this happened to you?</p>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</ExFrame>

<style is:global>
  .e320 {
    --bk-teal: #3fa7a0;
    --bk-teal-deep: #1f5f5a;
    display: grid;
    gap: calc(var(--u) * 12);
  }
  .e320 .pl {
    margin: calc(var(--u) * 2) 0 0;
    font-variation-settings: 'opsz' 13;
    font-size: max(14px, calc(var(--u) * 9.8));
    line-height: 1.44;
    color: #4a453d;
  }
  .e320 .pl b {
    font-weight: 700;
    color: var(--bk-ink);
  }
  .e320 .sheet {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: calc(var(--u) * 0.6) dotted #a8a18f;
    border-left: calc(var(--u) * 0.6) dotted #a8a18f;
  }
  .e320 .cell {
    padding: calc(var(--u) * 6.6);
    border-right: calc(var(--u) * 0.6) dotted #a8a18f;
    border-bottom: calc(var(--u) * 0.6) dotted #a8a18f;
    min-height: calc(var(--u) * 201);
    display: flex;
  }
  .e320 .ic {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: calc(var(--u) * 1) solid var(--bk-ink);
    border-radius: calc(var(--u) * 10);
    overflow: hidden;
  }
  .e320 .hd {
    display: flex;
    justify-content: space-between;
    gap: calc(var(--u) * 6);
    background: var(--bk-teal);
    color: var(--bk-ink);
    padding: calc(var(--u) * 5.4) calc(var(--u) * 8);
    font-family: var(--font-mono);
    font-size: max(11px, calc(var(--u) * 7.3));
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  .e320 .bd {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: calc(var(--u) * 5) calc(var(--u) * 8) calc(var(--u) * 5.5);
  }
  .e320 .ic h4 {
    font-size: max(19px, calc(var(--u) * 19));
    font-weight: 700;
    line-height: 1.06;
  }
  .e320 .lt {
    margin-top: calc(var(--u) * 3);
    padding-bottom: calc(var(--u) * 3);
    border-bottom: calc(var(--u) * 0.6) dotted #b8b1a2;
    font-style: italic;
    font-variation-settings: 'opsz' 13;
    font-size: max(14px, calc(var(--u) * 9.4));
    line-height: 1.35;
    color: #4a453d;
  }
  .e320 dl {
    margin: calc(var(--u) * 3.4) 0 0;
  }
  .e320 dl > div {
    margin-top: calc(var(--u) * 3.4);
    font-variation-settings: 'opsz' 12;
    font-size: max(14px, calc(var(--u) * 9.1));
    line-height: 1.36;
  }
  .e320 dl > div:first-child {
    margin-top: 0;
  }
  .e320 dt,
  .e320 dd {
    display: inline;
    margin: 0;
  }
  .e320 dt.lbl {
    display: inline;
    font-size: max(11px, calc(var(--u) * 6.9));
    letter-spacing: 0.1em;
    color: #6f695e;
  }
  .e320 dt.lbl::after {
    content: ' ·';
  }
  .e320 .wq {
    margin-top: auto;
    padding-top: calc(var(--u) * 1.5);
    font-variation-settings: 'opsz' 14;
    font-size: max(14px, calc(var(--u) * 10));
    font-weight: 700;
    line-height: 1.16;
    color: var(--bk-teal-deep);
  }
  .e320 .ic--b {
    border-style: dashed;
  }
  .e320 .ic--b .bd {
    padding-top: calc(var(--u) * 9);
  }
  .e320 .ic--b .lbl {
    margin: 0;
    font-size: max(11px, calc(var(--u) * 7.3));
    letter-spacing: 0.1em;
    color: #4a5a58;
    line-height: 1.45;
  }
  .e320 .wl {
    margin-top: calc(var(--u) * 21);
    border-bottom: calc(var(--u) * 0.8) solid #b8b1a2;
  }
  .e320 .lbl--m {
    margin-top: calc(var(--u) * 12) !important;
  }
  @container (max-width: 45rem) {
    .e320 {
      --u: 1.33px;
    }
    .e320 .sheet {
      grid-template-columns: minmax(0, 1fr);
    }
    .e320 .cell {
      min-height: 0;
    }
    .e320 .wl {
      margin-top: var(--sp-4);
    }
  }
</style>
