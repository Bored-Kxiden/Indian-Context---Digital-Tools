---
import ExFrame from './ExFrame.astro';

// Booklet p.3.15 · Tool 3 Test, Part A: candidate wording and three lenses (filled example).
interface Props {
  alt: string;
  caption: string;
}
const { alt, caption } = Astro.props;

const lenses = [
  { l: 'N', name: 'New', what: 'Never filled this form. Knows WhatsApp and UPI, not portal words.', pass: true, result: 'Understood “college is checking”.' },
  { l: 'P', name: 'Proxy', what: 'Read aloud by her father over the phone.', pass: true, result: 'Father repeated it correctly.' },
  { l: 'T', name: 'Trust', what: 'Suspicious of anything that looks like a scam.', pass: false, result: '“Call your college” link looked like a scam. Removed.' },
] as const;
---

<ExFrame page="3.15" alt={alt} caption={caption}>
  <div class="e312">
    <div class="hyp">
      <span class="lbl">Hypothesis</span>
      <p>
        If the status names <b>who</b> is holding the application and <b>for how long</b>, students will stop reading “pending” as
        fate.
      </p>
    </div>

    <div class="swap">
      <div class="now">
        <span class="lbl">Now</span>
        <p>Status: Pending</p>
      </div>
      <svg class="to" viewBox="0 0 32 12" aria-hidden="true" focusable="false"><path d="M1 6h29M25 1.5 30.5 6 25 10.5" /></svg>
      <div class="cand">
        <span class="lbl">Candidate</span>
        <p class="en">Your college is checking your documents · day 3 of 15</p>
        <p class="hi" lang="hi">आपका कॉलेज आपके दस्तावेज़ जाँच रहा है · दिन 3 / 15</p>
      </div>
    </div>

    <section aria-labelledby="e312-l">
      <h4 class="sec" id="e312-l">Three lenses · this audience: first-generation students applying on a phone</h4>
      <div class="lt" role="region" aria-label="The three lenses: scroll sideways to see every column" tabindex="0">
        <table>
          <caption class="visually-hidden">Lens, what it asks, pass or fail, and what happened</caption>
          <colgroup>
            <col class="c1" />
            <col class="c2" />
            <col class="c3" />
            <col class="c4" />
            <col />
          </colgroup>
          <thead class="visually-hidden">
            <tr>
              <th scope="col">Lens</th>
              <th scope="col">Name</th>
              <th scope="col">What it asks</th>
              <th scope="col">Result</th>
              <th scope="col">What happened</th>
            </tr>
          </thead>
          <tbody>
            {
              lenses.map((r) => (
                <tr>
                  <th scope="row" class="lc">{r.l}</th>
                  <td class="ln">{r.name}</td>
                  <td class="lw">{r.what}</td>
                  <td class="lm">
                    {r.pass ? (
                      <svg class="ok" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m2.5 8.6 3.6 3.6L13.5 3.8" /></svg>
                    ) : (
                      <svg class="no" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.2 3.2l9.6 9.6M12.8 3.2 3.2 12.8" /></svg>
                    )}
                    <span class="visually-hidden">{r.pass ? 'Passed' : 'Failed'}</span>
                  </td>
                  <td class="lr">{r.result}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <div class="fin">
      <div class="where">
        <span class="lbl">Tested in a different context</span>
        <p>Hostel common room, 6 students, and 2 fathers by phone. Comprehension and use.</p>
      </div>
      <div class="res">
        <span class="lbl">Result</span>
        <p>Round 2 passed all three lenses. Store in the Design Language Library.</p>
      </div>
    </div>
  </div>
</ExFrame>

<style is:global>
  .e312 {
    --bk-terra: #a8432a;
    --bk-green: #2e5e4e;
    display: grid;
    gap: calc(var(--u) * 12);
  }
  .e312 .lbl {
    margin: 0 0 calc(var(--u) * 3);
    font-size: max(11px, calc(var(--u) * 7.2));
    letter-spacing: 0.1em;
  }
  .e312 .sec {
    margin: 0 0 calc(var(--u) * 6);
    font-family: var(--font-mono);
    font-size: max(11px, calc(var(--u) * 7.8));
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #6f695e;
  }
  .e312 .hyp {
    background: var(--bk-ink);
    color: #fff;
    border-radius: calc(var(--u) * 12);
    padding: calc(var(--u) * 12) calc(var(--u) * 12) calc(var(--u) * 12);
  }
  .e312 .hyp .lbl {
    color: #e3a72f;
    margin-bottom: calc(var(--u) * 4);
  }
  .e312 .hyp p {
    font-variation-settings: 'opsz' 15;
    font-size: max(15px, calc(var(--u) * 11));
    line-height: 1.37;
  }
  .e312 .hyp b,
  .e312 .cand .en {
    font-weight: 700;
  }
  .e312 .swap {
    display: grid;
    grid-template-columns: minmax(0, 240fr) calc(var(--u) * 31) minmax(0, 240fr);
    align-items: center;
    margin-top: calc(var(--u) * -3);
  }
  .e312 .now {
    background: #fff;
    border: calc(var(--u) * 1) solid var(--bk-ink);
    border-radius: calc(var(--u) * 10);
    padding: calc(var(--u) * 11) calc(var(--u) * 11) calc(var(--u) * 11);
    min-height: calc(var(--u) * 51.5);
  }
  .e312 .now .lbl {
    color: #6f695e;
  }
  .e312 .now p {
    font-variation-settings: 'opsz' 21;
    font-size: max(17px, calc(var(--u) * 15.6));
    font-weight: 700;
    line-height: 1.15;
    color: var(--bk-terra);
  }
  .e312 .to {
    justify-self: center;
    width: calc(var(--u) * 15);
    height: auto;
    fill: none;
    stroke: var(--bk-ink);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .e312 .cand {
    background: #f8e5c0;
    border-radius: calc(var(--u) * 12);
    padding: calc(var(--u) * 12) calc(var(--u) * 12) calc(var(--u) * 11);
  }
  .e312 .cand .lbl {
    color: #6b4f0a;
    margin-bottom: calc(var(--u) * 4);
  }
  .e312 .cand .en {
    font-variation-settings: 'opsz' 15;
    font-size: max(15px, calc(var(--u) * 11.5));
    line-height: 1.32;
  }
  .e312 .cand .hi {
    margin-top: calc(var(--u) * 2.5);
    font-size: max(15px, calc(var(--u) * 11.6));
    font-weight: 700;
    line-height: 1.38;
  }

  .e312 .lt {
    overflow-x: auto;
    background: #fff;
    border: calc(var(--u) * 1) solid var(--bk-ink);
    border-radius: calc(var(--u) * 10);
  }
  .e312 .lt table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    min-width: 30rem;
  }
  .e312 .lt th,
  .e312 .lt td {
    padding: calc(var(--u) * 6.5) 0;
    border-top: calc(var(--u) * 0.7) solid #dfd9d0;
    text-align: left;
    vertical-align: middle;
    font-variation-settings: 'opsz' 13;
    font-size: max(14px, calc(var(--u) * 9.8));
    line-height: 1.3;
  }
  .e312 .lt tbody tr:first-child > * {
    border-top: 0;
  }
  .e312 .lt .c1 {
    width: calc(var(--u) * 50);
  }
  .e312 .lt .c2 {
    width: calc(var(--u) * 68);
  }
  .e312 .lt .c3 {
    width: calc(var(--u) * 185);
  }
  .e312 .lt .c4 {
    width: calc(var(--u) * 25);
  }
  .e312 .lt .lc {
    padding-left: calc(var(--u) * 10);
    font-variation-settings: 'opsz' 20;
    font-size: max(17px, calc(var(--u) * 15.6));
    font-weight: 700;
    color: #8a5a00;
  }
  .e312 .lt .ln {
    font-weight: 700;
    font-size: max(14px, calc(var(--u) * 10.4));
  }
  .e312 .lt .lw {
    padding-right: calc(var(--u) * 8);
    color: #4a453d;
  }
  .e312 .lt .lm {
    padding-left: calc(var(--u) * 2);
  }
  .e312 .lt .lr {
    padding-right: calc(var(--u) * 8);
  }
  .e312 .lt svg {
    width: calc(var(--u) * 12.5);
    height: calc(var(--u) * 12.5);
    min-width: 13px;
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vertical-align: middle;
  }
  .e312 .lt .ok {
    stroke: var(--bk-green);
  }
  .e312 .lt .no {
    stroke: var(--bk-terra);
  }

  .e312 .fin {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--u) * 8);
    margin-top: calc(var(--u) * -3);
  }
  .e312 .where,
  .e312 .res {
    border-radius: calc(var(--u) * 10);
    padding: calc(var(--u) * 10) calc(var(--u) * 11) calc(var(--u) * 10);
    min-height: calc(var(--u) * 58);
  }
  .e312 .where {
    background: #fff;
    border: calc(var(--u) * 1) solid var(--bk-ink);
  }
  .e312 .where .lbl {
    color: #6f695e;
  }
  .e312 .res {
    background: var(--bk-green);
    color: #fff;
  }
  .e312 .res .lbl {
    color: #d9e8e1;
  }
  .e312 .fin p {
    font-variation-settings: 'opsz' 14;
    font-size: max(15px, calc(var(--u) * 10.2));
    line-height: 1.4;
  }
  @container (max-width: 45rem) {
    .e312 {
      --u: 1.33px;
    }
    .e312 .swap {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-1);
      margin-top: 0;
    }
    .e312 .to {
      transform: rotate(90deg);
      width: 2rem;
    }
    .e312 .fin {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0;
    }
    .e312 .where,
    .e312 .res {
      min-height: 0;
    }
  }
</style>
