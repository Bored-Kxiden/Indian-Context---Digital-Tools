---
import ExFrame from './ExFrame.astro';
import Tag from './Tag.astro';
import Lines from './Lines.astro';

// Booklet p.1.17 · Tool 3 The Break, Part C: the Villain Story (filled example).
interface Props {
  alt: string;
  caption: string;
}
const { alt, caption } = Astro.props;

const cards = ['System failure', 'Person unavailable', 'Object missing', 'Information gap', 'No time'];
const rows = [
  { step: '★ 3 Upload', star: true, card: 'Object missing', broke: ['No scanner, no PDF.', 'Pays a cybercafé.'], like: 8, pays: ['Meera: ₹30–50, half a', 'day'] },
  { step: '4 OTP', card: 'Person unavailable', broke: ['Father is in the field. OTP', 'expires; she retries at', 'night.'], like: 7, pays: ['Meera: a day. Father: his', 'work.'] },
  { step: '2 Details', card: 'Information gap', broke: ['Name spelled differently', 'on marksheet and', 'Aadhaar. An agent “fixes”', 'it.'], like: 6, pays: ['₹200, and her data with', 'a stranger'] },
  { step: '5 Submit', card: 'No time', broke: ['Exam week. Session', 'times out while she', 'finds the certificate.'], like: 5, pays: ['Starts over, progress', 'lost'] },
];
---

<ExFrame page="1.17" alt={alt} caption={caption}>
  <div class="vs">
    <div class="head">
      <section class="persona">
        <div class="ph">
          <span class="lbl">Persona</span>
          <Tag>S6 Constraint</Tag>
        </div>
        <h4>Meera, 19</h4>
        <p class="who"><Lines lines={['Hostel, Tier-2 town. Applying on her', 'phone.']} /></p>
        <p class="con"><Lines lines={['One constraint: the registered', 'phone is her father’s.']} /></p>
      </section>
      <div class="deck">
        <Tag>S5 Failure</Tag>
        <p class="lbl">Five failure cards · choose the likeliest at each step</p>
        <ul>
          {cards.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>

    <div class="tw" tabindex="0" role="region" aria-label="The Villain Story: one row per step">
      <table>
        <colgroup>
          <col class="k1" />
          <col class="k2" />
          <col class="k3" />
          <col class="k4" />
          <col />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">Step</th>
            <th scope="col">Card drawn</th>
            <th scope="col">What broke · workaround</th>
            <th scope="col">How likely</th>
            <th scope="col">Who pays</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr class:list={{ star: r.star }}>
                <th scope="row">{r.step}</th>
                <td><span class="chip4">{r.card}</span></td>
                <td><Lines lines={r.broke} /></td>
                <td>
                  <span class="meter" style={`--p:${r.like * 10}%`} role="img" aria-label={`${r.like} out of 10`}></span>
                  <span class="of">{r.like} / 10</span>
                </td>
                <td><Lines lines={r.pays} /></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="qs">
      <section>
        <div class="qh">
          <span class="lbl">Does she know she’s the exception?</span>
          <Tag>S5 Question</Tag>
        </div>
        <p><Lines lines={['No. Every error says the problem is her', 'document.']} /></p>
      </section>
      <section>
        <div class="qh">
          <span class="lbl">Is the workaround dignified?</span>
          <Tag>S5 Question</Tag>
        </div>
        <p><Lines lines={['Not really. She shares private details with an', 'agent she doesn’t know.']} /></p>
      </section>
    </div>
  </div>
</ExFrame>

<style is:global>
  .vs {
    --bk-terra: #a8432a;
    --bk-teal-ink: #1f5d58;
    display: grid;
    gap: calc(var(--u) * 10.8);
  }
  .vs p,
  .vs ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .vs .head {
    display: grid;
    grid-template-columns: calc(var(--u) * 196.5) minmax(0, 1fr);
    gap: calc(var(--u) * 12);
    align-items: start;
  }
  .vs .persona {
    background: var(--bk-yellow-dot);
    box-shadow: calc(var(--u) * 2.2) calc(var(--u) * 2.2) 0 rgb(0 0 0 / 0.1216);
    padding: calc(var(--u) * 10.5) calc(var(--u) * 12) calc(var(--u) * 12);
    white-space: nowrap;
  }
  .vs .ph {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--u) * 6);
  }
  .vs .ph .lbl {
    margin: 0;
    color: var(--bk-ink);
    font-size: max(11px, calc(var(--u) * 7.5));
  }
  .vs .persona h4 {
    margin: calc(var(--u) * 2) 0 calc(var(--u) * 3);
    font-size: max(18px, calc(var(--u) * 15));
    font-variation-settings: 'opsz' 20;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
  }
  .vs .who {
    font-size: max(13px, calc(var(--u) * 10.1));
    font-variation-settings: 'opsz' 13.5;
    line-height: 1.34;
  }
  .vs .con {
    margin-top: calc(var(--u) * 8.6);
    font-weight: 700;
    line-height: 1.21;
  }
  .vs .deck {
    padding-top: calc(var(--u) * 22.4);
  }
  .vs .deck .lbl {
    margin: calc(var(--u) * 3.5) 0 calc(var(--u) * 4.7);
    font-size: max(11px, calc(var(--u) * 7.5));
  }
  .vs .deck ul {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--u) * 4.4);
  }
  .vs .deck li {
    display: flex;
    align-items: center;
    height: calc(var(--u) * 18);
    min-height: 1.9em;
    padding: 0 calc(var(--u) * 6.7);
    border-radius: calc(var(--u) * 4.5);
    background: var(--bk-terra);
    color: #fff;
    font-size: max(13px, calc(var(--u) * 9));
    font-variation-settings: 'opsz' 12;
    font-weight: 600;
    white-space: nowrap;
  }

  .vs .tw {
    background: #fff;
    border: calc(var(--u) * 0.75) solid var(--bk-ink);
    border-radius: calc(var(--u) * 16);
    overflow: hidden;
  }
  .vs table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: max(13px, calc(var(--u) * 9.8));
    font-variation-settings: 'opsz' 13;
    line-height: 1.3;
  }
  .vs col.k1 {
    width: calc(var(--u) * 88.4);
  }
  .vs col.k2 {
    width: calc(var(--u) * 103.6);
  }
  .vs col.k3 {
    width: calc(var(--u) * 120);
  }
  .vs col.k4 {
    width: calc(var(--u) * 76.4);
  }
  .vs th,
  .vs td {
    text-align: left;
    vertical-align: middle;
    font-weight: 400;
    padding: calc(var(--u) * 8.4) 0;
    white-space: nowrap;
  }
  .vs th:first-child,
  .vs td:first-child {
    padding-left: calc(var(--u) * 9.4);
  }
  .vs thead th {
    background: #f6e5be;
    border-bottom: calc(var(--u) * 0.7) solid #cfc8ba;
    padding: calc(var(--u) * 6.9) 0 calc(var(--u) * 6.4);
    font-family: var(--font-mono);
    font-size: max(11px, calc(var(--u) * 7.1));
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bk-muted);
    line-height: 1.3;
  }
  .vs thead th:first-child {
    padding-left: calc(var(--u) * 9.4);
  }
  .vs tbody tr {
    border-bottom: calc(var(--u) * 0.7) solid #cfc8ba;
  }
  .vs tbody tr:last-child {
    border-bottom: 0;
  }
  .vs tbody tr.star {
    background: #fff8e6;
  }
  .vs tbody th {
    font-weight: 700;
  }
  .vs .chip4 {
    display: inline-flex;
    align-items: center;
    height: calc(var(--u) * 19.5);
    min-height: 1.9em;
    padding: 0 calc(var(--u) * 6.7);
    border-radius: calc(var(--u) * 4.5);
    background: var(--bk-terra);
    color: #fff;
    font-size: max(13px, calc(var(--u) * 9));
    font-variation-settings: 'opsz' 12;
    font-weight: 600;
  }
  .vs .meter {
    display: block;
    width: calc(var(--u) * 69.1);
    height: max(5px, calc(var(--u) * 6));
    border-radius: 999px;
    background: #e4ded2;
    position: relative;
    overflow: hidden;
  }
  .vs .meter::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--p);
    border-radius: 999px;
    background: var(--bk-terra);
  }
  .vs .of {
    display: block;
    margin-top: calc(var(--u) * 1.6);
    font-size: max(12px, calc(var(--u) * 8.2));
    font-variation-settings: 'opsz' 12;
  }

  .vs .qs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(var(--u) * 7.5);
  }
  .vs .qs section {
    background: var(--bk-teal);
    padding: calc(var(--u) * 9) calc(var(--u) * 10.5) calc(var(--u) * 8);
    min-height: calc(var(--u) * 72.7);
    white-space: nowrap;
  }
  .vs .qh {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--u) * 0.4) calc(var(--u) * 4);
    margin-bottom: calc(var(--u) * 2);
  }
  .vs .qh .lbl {
    margin: 0;
    color: var(--bk-teal-ink);
    font-weight: 600;
    font-size: max(11px, calc(var(--u) * 7.1));
    line-height: 1.37;
  }
  .vs .qs p {
    line-height: 1.37;
  }

  @container (max-width: 45rem) {
    .vs .persona,
    .vs .qs section,
    .vs th,
    .vs td {
      white-space: normal;
    }
    .vs .head {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
    .vs .deck {
      padding-top: 0;
    }
    .vs .deck ul {
      gap: var(--sp-1);
    }
    .vs .deck li {
      white-space: normal;
      padding-block: 6px;
    }
    .vs .tw {
      overflow-x: auto;
      border-radius: var(--r-md);
    }
    .vs table {
      --u: calc(44rem / 511.5);
      width: 44rem;
    }
    .vs .tw:focus-visible {
      outline-offset: 2px;
    }
    .vs .qs {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
    .vs .qs section {
      min-height: 0;
      padding: var(--sp-2);
    }
  }
</style>
