---
import ExFrame from './ExFrame.astro';
import Tag from './Tag.astro';
import Lines from './Lines.astro';

// Booklet p.1.14 · Tool 3 The Break, Part A: ideal flow + what each step needs (filled example).
interface Props {
  alt: string;
  caption: string;
}
const { alt, caption } = Astro.props;

const steps = [
  { n: 1, lines: ['Logs in with', 'mobile'] },
  { n: 2, lines: ['Fills in details'] },
  { n: 3, lines: ['Uploads', 'marksheet', 'PDF'] },
  { n: 4, lines: ['Enters OTP'] },
  { n: 5, lines: ['Submits'] },
  { n: 6, lines: ['Gets', 'confirmation'] },
];
// [text lines, left to the user?]  (an empty entry is the booklet's dash)
const rows: { name: string; cells: [string[], boolean?][] }[] = [
  {
    name: 'People',
    cells: [
      [[]],
      [['Parent, for', 'income details'], true],
      [['Cybercafé', 'owner'], true],
      [['Father, whose', 'phone it is'], true],
      [[]],
      [[]],
    ],
  },
  {
    name: 'Objects',
    cells: [
      [['Own phone', 'number'], true],
      [['Aadhaar, bank', 'passbook']],
      [['Scanner, PDF'], true],
      [['The', 'registered', 'phone'], true],
      [['Data pack'], true],
      [['Email account']],
    ],
  },
  {
    name: 'Systems',
    cells: [
      [['SMS gateway']],
      [['Aadhaar', 'match']],
      [['Portal upload']],
      [['SMS on time']],
      [['Server up']],
      [['College', 'verifies']],
    ],
  },
  {
    name: 'Information',
    cells: [
      [['Which number', 'is registered'], true],
      [['Name spelled', 'exactly as on', 'Aadhaar'], true],
      [['Files must be', 'under 200KB'], true],
      [['OTP expires in', 'minutes'], true],
      [['Deadline is', 'midnight'], true],
      [['Must chase', 'the college'], true],
    ],
  },
];
---

<ExFrame page="1.14" alt={alt} caption={caption}>
  <div class="bx">
    <div class="feat">
      <span class="lbl">Feature</span>
      <b class="ft">Upload documents &amp; submit</b>
      <span class="lbl goal">Goal</span>
      <q>Application submitted, confirmation received.</q>
    </div>

    <div class="mxw" tabindex="0" role="region" aria-label="Ideal flow: what each step needs">
      <table class="mx">
        <colgroup>
          <col class="c0" />
          {steps.map(() => <col />)}
        </colgroup>
        <thead>
          <tr>
            <td></td>
            {
              steps.map((s) => (
                <th scope="col">
                  <span class="n">{s.n}</span>
                  <span class="t"><Lines lines={s.lines} /></span>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">{r.name}</th>
                {
                  r.cells.map(([lines, left]) => (
                    <td class:list={{ left }}>
                      {lines.length ? <Lines lines={lines} /> : <span aria-label="none">—</span>}
                      {left && <span class="visually-hidden"> (left to the user)</span>}
                    </td>
                  ))
                }
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="legend">
      <p><i aria-hidden="true"></i> Left as the user’s problem to solve: 13 of 24.</p>
      <Tag>S4 Need card per cell · Fill its dot</Tag>
    </div>

    <section class="for">
      <span class="lbl">Who this was designed for</span>
      <p><Lines lines={['Their own laptop and phone. A scanner at home. Broadband. An uninterrupted hour. A', 'parent who knows forms.']} /></p>
    </section>
  </div>
</ExFrame>

<style is:global>
  .bx {
    --bk-terra: #a8432a;
    --bk-teal-ink: #1f5d58;
    --bk-amber: #e3a72f;
    display: grid;
    gap: calc(var(--u) * 10.8);
  }
  .bx .feat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--u) * 6) calc(var(--u) * 8.4);
  }
  .bx .feat .lbl {
    margin: 0;
    color: var(--bk-ink);
    font-size: max(11px, calc(var(--u) * 7.5));
  }
  .bx .feat .goal {
    margin-left: calc(var(--u) * 6.3);
  }
  .bx .ft {
    background: var(--bk-yellow-dot);
    padding: calc(var(--u) * 5) calc(var(--u) * 9);
    font-size: var(--t-lead);
    font-variation-settings: 'opsz' 15;
    font-weight: 700;
    line-height: 1.3;
  }
  .bx .feat q {
    font-size: var(--t-body);
    quotes: '“' '”';
  }

  .bx .mxw {
    overflow-x: visible;
  }
  .bx .mx {
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: calc(var(--u) * 3.8) calc(var(--u) * 3.75);
    width: calc(100% + var(--u) * 7.6);
    margin: calc(var(--u) * -3.75) calc(var(--u) * -3.8);
    font-size: max(12px, calc(var(--u) * 8.6));
    font-variation-settings: 'opsz' 12;
  }
  .bx .mx col.c0 {
    width: calc(var(--u) * 62.7);
  }
  .bx .mx th,
  .bx .mx td {
    padding: 0;
    text-align: left;
    font-weight: 400;
    vertical-align: top;
  }
  .bx .mx thead th {
    background: var(--bk-amber);
    height: calc(var(--u) * 55.4);
    padding: calc(var(--u) * 5) calc(var(--u) * 5.2);
    white-space: nowrap;
  }
  .bx .mx thead td {
    background: none;
  }
  .bx .mx .n {
    display: block;
    font-family: var(--font-mono);
    font-size: max(11px, calc(var(--u) * 6.8));
    line-height: 1.3;
    margin-bottom: calc(var(--u) * 3);
  }
  .bx .mx .t {
    display: block;
    font-size: max(13px, calc(var(--u) * 9.4));
    font-variation-settings: 'opsz' 12.5;
    font-weight: 700;
    line-height: 1.2;
  }
  .bx .mx tbody th {
    vertical-align: middle;
    font-family: var(--font-mono);
    font-size: max(11px, calc(var(--u) * 7.1));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bk-teal-ink);
  }
  .bx .mx tbody td {
    position: relative;
    background: var(--bk-teal);
    height: calc(var(--u) * 48);
    padding: calc(var(--u) * 6) calc(var(--u) * 5.2) calc(var(--u) * 4);
    line-height: 1.31;
    white-space: nowrap;
  }
  .bx .mx td.left::after {
    content: '';
    position: absolute;
    top: calc(var(--u) * 3.8);
    right: calc(var(--u) * 3.7);
    width: max(6px, calc(var(--u) * 6.8));
    height: max(6px, calc(var(--u) * 6.8));
    border-radius: 50%;
    background: var(--bk-terra);
  }

  .bx .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--u) * 6) calc(var(--u) * 12);
  }
  .bx .legend p {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 6);
    font-size: max(13px, calc(var(--u) * 9.8));
    font-variation-settings: 'opsz' 13;
    color: #3f3a33;
  }
  .bx .legend i {
    flex: none;
    width: max(8px, calc(var(--u) * 7.4));
    height: max(8px, calc(var(--u) * 7.4));
    border-radius: 50%;
    background: var(--bk-terra);
  }
  .bx .for {
    background: var(--bk-teal);
    box-shadow: calc(var(--u) * 2.2) calc(var(--u) * 2.2) 0 rgb(0 0 0 / 0.1216);
    padding: calc(var(--u) * 9.7) calc(var(--u) * 13.5) calc(var(--u) * 11.8);
  }
  .bx .for .lbl {
    color: var(--bk-teal-ink);
    font-size: max(11px, calc(var(--u) * 7.5));
    margin-bottom: calc(var(--u) * 1.7);
  }
  .bx .for p {
    font-size: var(--t-lead);
    font-variation-settings: 'opsz' 15;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* The grid needs about 44rem to keep its text readable. Narrower, it scrolls sideways
     inside its own region instead of squeezing. */
  @container (max-width: 45rem) {
    .bx .for p {
      white-space: normal;
    }
    .bx .mxw {
      overflow-x: auto;
      padding-bottom: var(--sp-1);
    }
    .bx .mx {
      --u: calc(44rem / 511.5);
      width: calc(44rem + var(--u) * 7.6);
    }
    .bx .mxw:focus-visible {
      outline-offset: 2px;
    }
  }
</style>
