---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import PageFigure from '../../components/PageFigure.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import Icon from '../../components/Icon.astro';
import { cardKitIntro, inside, printCards, printBoards, setUpTable, principle, sheets, boards, sheetMeta } from '../../data/card-kit';
import { getDownloadById } from '../../data/downloads';
import { cardKitImage } from '../../utils/assets';
import { url } from '../../utils/url';

const all = getDownloadById('card-kit-full');
const allSheets = getDownloadById('card-sheets');
const allBoards = getDownloadById('boards');
const toolHref = (slug: string) => `/components/existing-products/${slug}/`;
---

<BaseLayout title="Card kit" description={cardKitIntro} component="c1">
  <PageHead
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Card kit' }]}
    heading="Card kit"
    lead={cardKitIntro}
    chips={['Component 1', 'Print and play']}
  >
    <nav slot="aside" class="jump" aria-label="On this page">
      <a class="btn btn--accent" href="#print"><Icon name="print" size={20} /> Print the kit</a>
      <a class="btn btn--outline" href="#boards">Boards B1–B7</a>
      <a class="btn btn--outline" href="#sheets">Sheets S1–S8</a>
    </nav>
  </PageHead>

  <Section id="inside" eyebrow="What’s inside" title="Boards, and cards to lay on them." split>
    <p slot="lead" class="lead-text">Seven boards, one for each step of Component 1. Eight sheets of cards.</p>
    <ul class="inside">
      {
        inside.map((i) => (
          <li>
            <b>{i.name}</b>
            <span>{i.use}</span>
            <span class="tg">{i.sheet}</span>
          </li>
        ))
      }
    </ul>
    <div class="callout callout--ink principle">
      <strong>The one rule</strong>
      <p>{principle}</p>
    </div>
  </Section>

  <Section id="print" eyebrow="Print" title="Print and set up." tone="white" split>
    <div class="two">
      <div>
        <ul class="print-notes">
          <li><Icon name="cards" size={24} /> <span>{printCards}</span></li>
          <li><Icon name="board" size={24} /> <span>{printBoards}</span></li>
        </ul>
        <h3 class="h3">Set up the table</h3>
        <ol class="steps-list">
          {
            setUpTable.map((s, i) => (
              <li class="stp">
                <b>{i + 1}</b>
                <span>{s}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="dls">
        {all && <DownloadCard item={all} />}
        {allSheets && <DownloadCard item={allSheets} />}
        {allBoards && <DownloadCard item={allBoards} />}
      </div>
    </div>
  </Section>

  <Section id="boards" eyebrow="Boards" title="B1–B7">
    <p slot="lead" class="lead-text">Put one board in the middle of the table, the one for the tool you’re doing.</p>
    <div class="items">
      {
        boards.map((b) => {
          const dl = getDownloadById(`board-${b.id.toLowerCase()}`);
          return (
            <article class="item" id={b.id.toLowerCase()}>
              <div class="text">
                <p class="eb"><span class="tg">{b.id}</span> {b.page}</p>
                <h3>{b.name}</h3>
                <p class="for">{b.tool}</p>
                <p class="uses">
                  Uses: {b.cards.map((c, i) => <>{i > 0 && ', '}{/^S\d/.test(c) ? <a href={`#${c.toLowerCase()}`}>{c}</a> : c}</>)}
                </p>
                <p><a class="link-arrow" href={url(toolHref(b.toolSlug))}>Open the tool <Icon name="arrow" size={20} /></a></p>
                {dl && <DownloadCard item={dl} compact />}
              </div>
              <div class="fig board">
                <PageFigure
                  image={cardKitImage(b.id)}
                  alt={`Board ${b.id}, ${b.name}, from the card kit. Print at A2 landscape.`}
                  caption="A2 landscape. A3 works for pairs."
                />
              </div>
            </article>
          );
        })
      }
    </div>
  </Section>

  <Section id="sheets" eyebrow="Card sheets" title="S1–S8" tone="white">
    <p slot="lead" class="lead-text">Print on A4 card, 250–300 gsm. Cut along the dashed lines.</p>
    <div class="items">
      {
        sheets.map((s) => {
          const dl = getDownloadById(`sheet-${s.id.toLowerCase()}`);
          return (
            <article class="item" id={s.id.toLowerCase()}>
              <div class="text">
                <p class="eb"><span class="tg">{s.id}</span> {s.page} · {sheetMeta(s)}</p>
                <h3>{s.name}</h3>
                <p class="for">{s.tools}</p>
                <p class="uses">{s.blurb}</p>
                {dl && <DownloadCard item={dl} compact />}
              </div>
              <div class="fig sheet">
                <PageFigure
                  image={cardKitImage(s.id)}
                  alt={`Card sheet ${s.id}, ${s.name}, from the card kit. Print on A4 card and cut along the dashed lines.`}
                  caption={s.copies > 1 ? `Print ${s.copies} times.` : 'Print once.'}
                />
              </div>
            </article>
          );
        })
      }
    </div>
  </Section>
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    justify-content: flex-start;
  }
  @media (min-width: 64rem) {
    .jump {
      justify-content: flex-end;
    }
  }
  .inside {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .inside li {
    margin: 0;
    display: grid;
    gap: var(--sp-1);
    align-content: start;
    padding: var(--sp-3);
    border-radius: var(--r-md);
    background: var(--c1-tint);
  }
  .inside b {
    font-size: var(--fs-h4);
  }
  .inside li > span:not(.tg) {
    color: var(--ink-soft);
    font-size: var(--fs-ui);
    line-height: 1.45;
  }
  .inside .tg {
    justify-self: start;
    margin-top: var(--sp-half);
  }
  .principle {
    max-width: 44rem;
  }
  .principle p {
    margin: 0;
    font-size: var(--fs-lead);
  }
  .two {
    display: grid;
    gap: var(--sp-5) var(--sp-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    align-items: start;
  }
  .print-notes {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-3);
    display: grid;
    gap: var(--sp-2);
  }
  .print-notes li {
    margin: 0;
    display: flex;
    gap: var(--sp-2);
    align-items: flex-start;
    color: var(--ink-soft);
  }
  .print-notes :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--c1);
  }
  .h3 {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: var(--sp-4) 0 var(--sp-2);
  }
  .dls {
    display: grid;
    gap: var(--sp-2);
  }
  .items {
    display: grid;
    gap: var(--sp-8);
  }
  .item {
    display: grid;
    gap: var(--sp-3) var(--sp-5);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    scroll-margin-top: var(--scroll-offset);
  }
  @media (min-width: 64rem) {
    .item {
      grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
    }
  }
  .item h3 {
    margin: var(--sp-1) 0;
  }
  .item .eb {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-bottom: var(--sp-half);
  }
  .fig.board {
    --fig-max: 96rem;
  }
  .fig.sheet {
    --fig-max: 64rem;
  }
  .for {
    font-weight: 700;
    margin-bottom: var(--sp-1);
  }
  .uses {
    color: var(--ink-soft);
    font-size: var(--fs-ui);
  }
</style>
