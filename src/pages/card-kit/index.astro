---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageFigure from '../../components/PageFigure.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import Icon from '../../components/Icon.astro';
import { cardKitIntro, inside, printCards, printBoards, setUpTable, principle, sheets, boards, sheetMeta } from '../../data/card-kit';
import { getDownloadById } from '../../data/downloads';
import { cardKitImage } from '../../utils/assets';
import { url } from '../../utils/url';

const all = getDownloadById('card-kit-full');
const allSheets = getDownloadById('card-sheets');
const allBoards = getDownloadById('boards');
const toolHref = (slug: string) => `/components/existing-products/${slug}/`;
---

<BaseLayout title="Card kit" description={cardKitIntro} component="c1">
  <div class="page-head">
    <div class="wrap">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Card kit' }]} />
      <div class="chip-row chips">
        <span class="chip chip--quiet">Component 1</span>
        <span class="chip chip--quiet">Print and play</span>
      </div>
      <h1>Card kit</h1>
      <p class="lead">{cardKitIntro}</p>
      <p class="pick">
        <a class="btn btn--accent" href="#print"><Icon name="print" size={18} /> Print the kit</a>
        <a class="btn btn--outline" href="#boards">Boards B1–B7</a>
        <a class="btn btn--outline" href="#sheets">Sheets S1–S8</a>
      </p>
    </div>
  </div>

  <section class="section" aria-labelledby="inside-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eb">What’s inside</p>
        <h2 id="inside-h">Boards, and cards to lay on them.</h2>
        <p>Seven boards, one for each step of Component 1. Eight sheets of cards.</p>
      </div>
      <ul class="inside">
        {
          inside.map((i) => (
            <li>
              <b>{i.name}</b>
              <span>{i.use}</span>
              <span class="tg">{i.sheet}</span>
            </li>
          ))
        }
      </ul>
      <div class="callout callout--ink principle">
        <strong>The one rule</strong>
        <p>{principle}</p>
      </div>
    </div>
  </section>

  <section class="section section--white" id="print" aria-labelledby="print-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eb">Print</p>
        <h2 id="print-h">Print and set up.</h2>
      </div>
      <div class="two">
        <div>
          <ul class="print-notes">
            <li><Icon name="cards" size={22} /> <span>{printCards}</span></li>
            <li><Icon name="board" size={22} /> <span>{printBoards}</span></li>
          </ul>
          <h3 class="h3">Set up the table</h3>
          <ol class="steps-list">
            {
              setUpTable.map((s, i) => (
                <li class="stp">
                  <b>{i + 1}</b>
                  <span>{s}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="dls">
          {all && <DownloadCard item={all} />}
          {allSheets && <DownloadCard item={allSheets} />}
          {allBoards && <DownloadCard item={allBoards} />}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="boards" aria-labelledby="boards-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eb">Boards</p>
        <h2 id="boards-h">B1–B7</h2>
        <p>Put one board in the middle of the table, the one for the tool you’re doing.</p>
      </div>
      <div class="items">
        {
          boards.map((b) => {
            const dl = getDownloadById(`board-${b.id.toLowerCase()}`);
            return (
              <article class="item" id={b.id.toLowerCase()}>
                <div class="text">
                  <p class="eb"><span class="tg">{b.id}</span> {b.page}</p>
                  <h3>{b.name}</h3>
                  <p class="for">{b.tool}</p>
                  <p class="uses">
                    Uses: {b.cards.map((c, i) => <>{i > 0 && ', '}{/^S\d/.test(c) ? <a href={`#${c.toLowerCase()}`}>{c}</a> : c}</>)}
                  </p>
                  <p><a class="link-arrow" href={url(toolHref(b.toolSlug))}>Open the tool <Icon name="arrow" size={18} /></a></p>
                  {dl && <DownloadCard item={dl} compact />}
                </div>
                <PageFigure
                  image={cardKitImage(b.id)}
                  alt={`Board ${b.id}, ${b.name}, from the card kit. Print at A2 landscape.`}
                  caption="A2 landscape. A3 works for pairs."
                />
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section--white" id="sheets" aria-labelledby="sheets-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eb">Card sheets</p>
        <h2 id="sheets-h">S1–S8</h2>
        <p>Print on A4 card, 250–300 gsm. Cut along the dashed lines.</p>
      </div>
      <div class="items">
        {
          sheets.map((s) => {
            const dl = getDownloadById(`sheet-${s.id.toLowerCase()}`);
            return (
              <article class="item" id={s.id.toLowerCase()}>
                <div class="text">
                  <p class="eb"><span class="tg">{s.id}</span> {s.page} · {sheetMeta(s)}</p>
                  <h3>{s.name}</h3>
                  <p class="for">{s.tools}</p>
                  <p class="uses">{s.blurb}</p>
                  {dl && <DownloadCard item={dl} compact />}
                </div>
                <PageFigure
                  image={cardKitImage(s.id)}
                  alt={`Card sheet ${s.id}, ${s.name}, from the card kit. Print on A4 card and cut along the dashed lines.`}
                  caption={s.copies > 1 ? `Print ${s.copies} times.` : 'Print once.'}
                />
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .chips {
    margin-bottom: 1.25rem;
  }
  .page-head h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    margin-bottom: 1rem;
  }
  .page-head .lead {
    max-width: 44rem;
  }
  .pick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
  }
  .inside {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .inside li {
    margin: 0;
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius);
    background: var(--c1-tint);
  }
  .inside b {
    font-size: 1.1rem;
  }
  .inside li > span:not(.tg) {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .inside .tg {
    justify-self: start;
    margin-top: 0.25rem;
  }
  .principle {
    max-width: 44rem;
  }
  .principle p {
    margin: 0;
    font-size: 1.1rem;
  }
  .two {
    display: grid;
    gap: 2rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    align-items: start;
  }
  .print-notes {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 1rem;
  }
  .print-notes li {
    margin: 0;
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    color: var(--ink-soft);
  }
  .print-notes :global(svg) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--c1);
  }
  .h3 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 1.75rem 0 0.9rem;
  }
  .dls {
    display: grid;
    gap: 1rem;
  }
  .items {
    display: grid;
    gap: 3rem;
  }
  .item {
    display: grid;
    gap: 1.5rem 2.5rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    scroll-margin-top: 1.5rem;
  }
  @media (min-width: 62rem) {
    .item {
      grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
    }
  }
  .item h3 {
    margin: 0.25rem 0 0.4rem;
  }
  .item .eb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }
  .for {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .uses {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
</style>
