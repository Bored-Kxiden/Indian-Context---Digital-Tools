---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import Icon from '../../components/Icon.astro';
import { guideline, howToRead, meera, whyThisExists } from '../../data/booklet/shared';
import { url } from '../../utils/url';

---

<BaseLayout title="The guideline" description={guideline.body}>
  <PageHead
    crumbs={[{ label: 'Home', href: '/' }, { label: 'The guideline' }]}
    eyebrow={guideline.eyebrow}
    heading={guideline.title}
    lead={guideline.body}
  >
    <nav slot="aside" class="jump" aria-label="On this page">
      <a href="#one-real-thing">One real thing</a>
      <a href="#how-to-read">How to read a tool</a>
      <a href="#meera">Meet Meera</a>
    </nav>
  </PageHead>

  <Section id="one-real-thing" eyebrow="The rule" title={guideline.whatCounts.title} split>
    <p class="big">{guideline.whatCounts.body}</p>
    <p class="big">{guideline.adapt}</p>
    <div class="gt">
      <div class="gt-good">
        <span class="lbl">Good</span>
        <ul>
          {guideline.good.map((g) => <li><Icon name="check" size={22} /> {g}</li>)}
        </ul>
      </div>
      <div class="gt-broad">
        <span class="lbl">Too broad</span>
        <ul>
          {guideline.tooBroad.map((g) => <li><Icon name="x" size={22} /> {g}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="why" eyebrow="Why this exists" title={whyThisExists.title} tone="white" split>
    <p class="big">{whyThisExists.body}</p>
    <div class="pair">
      <figure class="q q--without">
        <figcaption class="lbl">Without it</figcaption>
        <blockquote>{whyThisExists.without}</blockquote>
      </figure>
      <figure class="q q--with">
        <figcaption class="lbl">With it</figcaption>
        <blockquote>{whyThisExists.with}</blockquote>
      </figure>
    </div>
  </Section>

  <Section id="how-to-read" eyebrow="How to read" title={howToRead.title} split>
    <ol class="hr-steps">
      {
        howToRead.steps.map((s, i) => (
          <li>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <b>{s.title}</b>
            <span>{s.body}</span>
          </li>
        ))
      }
    </ol>

    <h3 class="every">{howToRead.everyTool.title}</h3>
    <p class="big">{howToRead.everyTool.lead}</p>
    <ol class="ways">
      {
        howToRead.everyTool.parts.map((p, i) => (
          <li>
            <span class="wi" aria-hidden="true"><Icon name={p.icon} size={36} /></span>
            <div>
              <h4>{p.title}</h4>
              <p>{p.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="meera" eyebrow="The running example" title={meera.title} tone="white" split>
    <div class="meera">
      <article class="card persona">
        <div class="head">
          <span class="avatar" aria-hidden="true">M</span>
          <div>
            <b>{meera.name}</b>
            <small>{meera.eyebrow}</small>
          </div>
        </div>
        <dl>
          {meera.facts.map((f) => <><dt>{f.k}</dt><dd>{f.v}</dd></>)}
        </dl>
      </article>
      <div>
        <p class="big">{meera.lead}</p>
        <div class="screen">
          <span class="lbl">{meera.screen.label}</span>
          <p class="quote">{meera.screen.quote}</p>
          <p>{meera.screen.body}</p>
        </div>
        <p class="big"><b>{meera.outcome}</b></p>
        <div class="callout">
          <strong>{meera.useYourOwn.title}</strong>
          <p>{meera.useYourOwn.body}</p>
        </div>
        <p class="go">
          <a class="btn btn--accent" href={url('/#i-want-to')}>Find your tool <Icon name="arrow" size={20} /></a>
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  @media (min-width: 64rem) {
    .jump {
      justify-content: flex-end;
    }
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0 var(--sp-3);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    transition:
      background-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }
  .jump a:hover {
    background: var(--ink);
    color: #fff;
  }
  .big {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .go {
    margin: var(--sp-3) 0 0;
  }

  .gt {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin-top: var(--sp-4);
    max-width: 56rem;
  }
  .gt-good,
  .gt-broad {
    border-radius: var(--r-lg);
    padding: var(--sp-3);
  }
  .gt-good {
    background: var(--ink);
    color: #fff;
  }
  .gt-broad {
    background: var(--sand);
  }
  .gt .lbl {
    color: inherit;
    opacity: 0.9;
    margin-bottom: var(--sp-2);
  }
  .gt ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-2);
  }
  .gt li {
    display: flex;
    gap: var(--sp-1);
    align-items: flex-start;
    margin: 0;
    font-weight: 600;
    font-size: var(--fs-lead);
    line-height: 1.35;
  }
  .gt li :global(svg) {
    flex: none;
    margin-top: 4px;
  }

  .pair {
    display: grid;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .q {
    margin: 0;
    border-radius: var(--r-lg);
    padding: var(--sp-3) var(--sp-4);
  }
  .q blockquote {
    margin: var(--sp-1) 0 0;
    font-size: var(--fs-h3);
    line-height: 1.3;
    font-weight: 700;
  }
  .q--without {
    background: var(--ground);
    border: 2px solid var(--line-strong);
  }
  .q--with {
    background: var(--ink);
    color: #fff;
  }
  .q--with .lbl {
    color: rgb(255 255 255 / 0.85);
  }

  .hr-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .hr-steps li {
    margin: 0;
    display: grid;
    gap: var(--sp-1);
    align-content: start;
    padding: var(--sp-3);
    border: 2px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .hr-steps .n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-weight: 800;
    margin-bottom: var(--sp-1);
  }
  .hr-steps li > span:last-child {
    color: var(--ink-soft);
    font-size: var(--fs-ui);
  }
  .every {
    margin: var(--sp-8) 0 var(--sp-1);
  }
  .ways {
    list-style: none;
    margin: var(--sp-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }
  .ways li {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3);
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 2px solid var(--line-strong);
  }
  .ways h4 {
    margin: 0 0 var(--sp-half);
  }
  .ways p {
    margin: 0;
    color: var(--ink-soft);
  }
  .wi {
    display: inline-flex;
  }

  .meera {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }
  .persona .head {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-3);
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: var(--fs-h3);
  }
  .persona b {
    font-size: var(--fs-h4);
    display: block;
    line-height: 1.1;
  }
  .persona small {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .persona dl {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--sp-1) var(--sp-2);
    margin: 0;
  }
  .persona dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 4px;
  }
  .persona dd {
    margin: 0;
    font-weight: 600;
  }
  .screen {
    background: var(--ground);
    border: 2px solid var(--line-strong);
    border-radius: var(--r-md);
    padding: var(--sp-3);
    margin: var(--sp-3) 0;
    max-width: 40rem;
  }
  .screen p {
    margin: var(--sp-1) 0 0;
    color: var(--ink-soft);
  }
  .screen .quote {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--ink);
  }
</style>
