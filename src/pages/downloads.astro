---
import BaseLayout from '../layouts/BaseLayout.astro';
import DownloadCard from '../components/DownloadCard.astro';
import { getDownloads } from '../data/downloads';
import { site } from '../data/site';

const all = getDownloads();
const print = all.filter((d) => d.group === 'print');
const digital = all.filter((d) => d.group === 'digital');
---

<BaseLayout
  title="Downloads"
  description="Every downloadable asset in the Meaning-to-Interface Toolkit: print-ready card templates and digital CSV and JSON templates."
>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Downloads</p>
      <h1>Templates you can print, fill in, and digitize.</h1>
      <p class="lede">
        {all.length} files: physical cards for the field, and digital templates for moving validated moments into a spreadsheet or
        the Expression Library. All are free to use, adapt, and share under the {site.licenseName} License.
      </p>
    </div>
  </div>

  <div class="wrap body">
    <section class="section" aria-labelledby="print">
      <div class="section-head">
        <h2 id="print">Print-ready</h2>
        <p>Every card is 6 × 4 in (152 × 102 mm), a standard index-card and photo-print size. Print at 100% (actual size), double-sided.</p>
      </div>
      <div class="grid grid--2">
        {print.map((d) => <DownloadCard item={d} />)}
      </div>

      <div class="callout callout--warn">
        <strong>Printing tips</strong>
        <ul>
          <li>Turn off “fit to page” and “scale to fit”. Cards should measure 6 × 4 in on paper.</li>
          <li>Choose double-sided printing. If the back of a card comes out upside down, switch between “flip on long edge” and “flip on short edge”.</li>
          <li>Print one card first to check front-to-back alignment. Use 200 to 300 gsm card stock for cards that will be handled in the field.</li>
          <li>Most print shops can cut or print 6 × 4 in stock, since it is the standard photo-print size.</li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="digital">
      <div class="section-head">
        <h2 id="digital">Digital templates</h2>
        <p>For digitizing Meaning Cards and adding validated moments to the Expression Library.</p>
      </div>
      <div class="grid grid--2">
        {digital.map((d) => <DownloadCard item={d} />)}
      </div>
    </section>

    <section class="section">
      <div class="callout">
        <strong>Drafts</strong>
        <p>
          Files marked Draft are working versions. Content and layout may change as the toolkit is tested in the field. If you use
          a draft in research, note the date you downloaded it.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .body {
    padding-bottom: 2rem;
  }
  .section:first-child {
    border-top: 0;
  }
</style>
