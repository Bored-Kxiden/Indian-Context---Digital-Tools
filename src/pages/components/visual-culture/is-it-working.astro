---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import Section from '../../../components/Section.astro';
import ClosingChecks from '../../../components/ClosingChecks.astro';
import Icon from '../../../components/Icon.astro';
import { closing } from '../../../data/booklet/visual-culture';
import { componentById } from '../../../data/components';
import { url } from '../../../utils/url';

const comp = componentById['visual-culture'];
---

<ComponentLayout
  component="visual-culture"
  current="is-it-working"
  title="Is it working?"
  heading="Is it working?"
  lead="Check your reading against these signs before you hand it on. They apply to all four tools."
  chips={['Component 2', 'After Tool 4']}
  crumb="Is it working?"
>
  <Section id="signs" eyebrow="Before you hand off" title="Good signs and warning signs">
    <ClosingChecks good={closing.good} warnings={closing.warnings} />
  </Section>

  <Section id="remember" eyebrow="Remember" title="Edge case, or ordinary?" tone="c2">
    <p class="line">{closing.line}</p>
    <p class="go">
      <a class="btn btn--outline" href={url(comp.href)}>
        Back to the overview <Icon name="arrow" size={20} />
      </a>
    </p>
  </Section>

</ComponentLayout>

<style>
  .line {
    font-size: var(--fs-h2);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 30ch;
    margin: 0;
  }
  .go {
    margin: var(--sp-4) 0 0;
  }
</style>
