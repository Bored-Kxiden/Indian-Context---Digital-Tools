---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import PaperTop from '../../../components/file/PaperTop.astro';
import FileBasics from '../../../components/file/FileBasics.astro';
import PaperSection from '../../../components/file/PaperSection.astro';
import { overview, why, figjam, core } from '../../../data/booklet/visual-culture';
import { componentById } from '../../../data/components';
import { getDownloadById } from '../../../data/downloads';
import { bookletImage } from '../../../utils/assets';
import { url } from '../../../utils/url';

// File 03's overview, in the template's order and in plain words (D41, D42). The FigJam board stays the
// file's main tool (D37); its full description sits under "Working in FigJam?".
const comp = componentById['visual-culture'];
const board = getDownloadById(figjam.id)!;
const pack = getDownloadById('pack-visual-culture')!;
const cards = getDownloadById('c2-capture-cards')!;
const t = (slug: string) => `${comp.href}${slug}/`;
const how = [
  { title: 'Before you start', href: t('before-you-start'), body: 'Pick one setting and 3–6 participants with camera phones, and get their consent to use the photos.' },
  { title: 'Show', meta: 'Capture', href: t('show'), body: 'Participants photograph six things in their own world: what helps them, who helps, what they check twice, and more.' },
  { title: 'Read', meta: 'Group', href: t('read'), body: 'Group the photos three ways: by what people do, by the conditions around them, and by what the product doesn’t show.' },
  { title: 'Build', meta: 'Build and check', href: t('build'), body: 'Write one situation from a pattern that repeats, not from the first interesting photo. Then ask: is this really unusual, or did we nearly dismiss something ordinary?' },
  { title: 'Hand off', meta: 'Scenario', href: t('hand-off'), body: 'Pass the situation on, with its photos, as a question for the next file.' },
];
---

<ComponentLayout component="visual-culture" current="overview" title={comp.name} heading={comp.name} description={overview.descriptor}>
  <PaperTop slot="top" image={bookletImage('2.04')} alt="The Show worksheet from the booklet, filled in with Meera’s photos." caption="Meera’s photo missions · booklet p.2.04" text={comp.plain}>
    <Fragment slot="buttons">
      <a class="btn btn--sm" href={url(pack.href)} download>Download PDF ↓</a>
      <a class="btn btn--sm btn--outline" href={url(board.href)} download>FigJam template ↓</a>
    </Fragment>
  </PaperTop>

  <FileBasics
    comp={comp}
    facts={[overview.meta.time, '3–6 participants', 'Led by participants']}
    notes={[
      { kind: 'Digital worksheet', format: 'FigJam', title: 'Open the template', action: `download FigJam board (${board.size}) ↓`, href: board.href, tone: 'pink', download: true },
      { kind: 'Printable worksheets', format: `PDF · ${pack.pages} pages`, title: 'Print and fill in', action: 'download PDF ↓', href: pack.href, tone: 'yellow', download: true },
      { kind: 'For participants', format: 'PDF · A4', title: 'Capture cards', action: 'download the cards ↓', href: cards.href, tone: 'teal', download: true },
    ]}
    why={[
      'A product is never used on its own. Someone using a scholarship portal may also be juggling a message from a senior, a document on someone else’s phone, a deadline and a slow connection. None of this shows on the screen, yet it decides whether the product works.',
      'So instead of imagining people’s lives, you ask them to show you, in photos they take themselves.',
    ]}
    how={how}
  >
    <div slot="why" class="pair">
      <figure class="q">
        <figcaption>What the screen sees</figcaption>
        <blockquote>{why.pair.interface.quote}</blockquote>
      </figure>
      <figure class="q q--wide">
        <figcaption>What is really going on</figcaption>
        <blockquote>{why.pair.situation.quote}</blockquote>
      </figure>
    </div>
    <p slot="how" class="note-line">
      You end up with a <b>Context Scenario</b>: one real situation, backed by real photos. It asks who, where, when, under what conditions
      and with whose help, where a persona only asks who.
    </p>
  </FileBasics>

  <PaperSection id="meaning" title="What does “visual culture” mean here?">
    <p class="big">{overview.definition}</p>
    <p>
      People learn which signs mean “act now”, what looks trustworthy, what they can ignore and who to ask. Much of it is learned away from
      apps: on a noticeboard, in a WhatsApp forward, from a familiar logo or a handwritten note.
    </p>
  </PaperSection>

  <PaperSection id="evidence" title="How sure is each finding?">
    <p>Mark every finding with how you know it:</p>
    <ul class="status">
      {
        overview.evidence.statuses.map((st) => (
          <li>
            <b>{st.name}</b> {st.def}
          </li>
        ))
      }
    </ul>
    <p>{overview.evidence.rule}</p>
    <p class="warn"><b>Never</b> make a claim about a whole culture from one photo. If a pattern isn’t backed up, write it down as a question.</p>
  </PaperSection>

  <PaperSection id="template" title="Working in FigJam?">
    <p>{figjam.lead}</p>
    <details class="more">
      <summary>What is on the board, and how to set it up</summary>
      <ul class="frames">
        {
          figjam.sections.map((f) => (
            <li>
              <b>{f.name}</b> {f.what}
            </li>
          ))
        }
      </ul>
      <ol class="frames">
        {figjam.howTo.map((h) => <li>{h}</li>)}
      </ol>
      {figjam.differs.map((d) => <p class="small">{d}</p>)}
    </details>
  </PaperSection>

  <PaperSection id="next" title="Where does it go next?">
    <ul class="next">
      {
        overview.handOffs.map((h) => (
          <li>
            {h.href ? <a href={url(h.href)}>{h.to}</a> : <b>{h.to}</b>}
            <span>{h.ask}</span>
          </li>
        ))
      }
    </ul>
    <p class="big rule">{core.line}</p>
  </PaperSection>
</ComponentLayout>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }
  .q {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--line);
    padding: var(--sp-2) var(--sp-3);
  }
  .q--wide {
    background: var(--accent-tint);
    border-color: transparent;
  }
  .q figcaption {
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--sp-1);
  }
  .q blockquote {
    margin: 0;
    font-style: italic;
  }
  .note-line {
    margin-top: var(--sp-3);
  }
  .big {
    font-size: var(--fs-lead);
  }
  .status {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-3);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--sp-1);
  }
  .status li {
    margin: 0;
    border-left: 3px solid var(--accent);
    padding: var(--sp-1) var(--sp-2);
    background: var(--white);
  }
  .status b {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .warn {
    border-left: 4px solid var(--ink);
    padding-left: var(--sp-2);
  }
  .more summary {
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .frames {
    display: grid;
    gap: var(--sp-1);
    padding-left: var(--sp-3);
    margin-bottom: var(--sp-3);
  }
  .frames li {
    margin: 0;
  }
  .small {
    font-size: var(--fs-ui);
    color: var(--muted);
  }
  .next {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-4);
  }
  .next li {
    display: grid;
    gap: 2px;
    padding: var(--sp-1) 0;
    border-bottom: 1px solid var(--line);
    margin: 0;
  }
  .next a,
  .next b {
    font-weight: 600;
  }
  .rule {
    font-style: italic;
    border-left: 4px solid var(--accent);
    padding-left: var(--sp-3);
  }
</style>
