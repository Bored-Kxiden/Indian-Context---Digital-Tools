---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import PaperSection from '../../../components/file/PaperSection.astro';
import Steps from '../../../components/file/Steps.astro';
import { beforeYouStart as b } from '../../../data/booklet/visual-culture';
import { componentById } from '../../../data/components';
import { url } from '../../../utils/url';

// Before you start, in plain words (D42): what you need, how much to steer participants, what to avoid, and a
// checklist. The write-up's longer version is in the data (beforeYouStart, role) and in the booklet.
const comp = componentById['visual-culture'];
const needs = [
  { title: 'A specific context', body: `Who and what situation, as narrowly as you can. “${b.needs[0].example}”, not ${b.needs[0].avoid}` },
  { title: 'Participants who show you their world', body: 'They decide what is worth photographing. Prompts are there if you want them, not as a checklist.' },
  { title: 'A real activity', body: `Something people are actually trying to do: ${b.needs[2].list!.slice(0, 5).join(', ')}.` },
  { title: 'Their explanation, kept with each photo', body: `A photo alone is easy to misread. For every photo, write down: ${b.needs[3].record!.map((r) => r.toLowerCase()).join(' · ')}.` },
];
---

<ComponentLayout
  component="visual-culture"
  current="before-you-start"
  title="Before you start"
  heading="Before you start"
  lead="You need a few real participants and one real situation. Not a big sample: just enough to tell one person’s situation from a pattern."
  crumb="Before you start"
>
  <PaperSection id="needs" title="What do I need?">
    <Steps steps={needs} />
  </PaperSection>

  <PaperSection id="autonomy" title="Should I tell people what to photograph?">
    <p>Either works. Choose by what you want to learn.</p>
    <div class="pair">
      <figure class="q">
        <figcaption>{b.autonomy.open.label}</figcaption>
        <blockquote>“{b.autonomy.open.quote}”</blockquote>
        <p>Use it when you already have a strong hunch, so the photos don’t just confirm it.</p>
      </figure>
      <figure class="q q--tint">
        <figcaption>{b.autonomy.directed.label}</figcaption>
        <blockquote>“{b.autonomy.directed.quote}”</blockquote>
        <p>Use it to look into one specific question.</p>
      </figure>
    </div>
  </PaperSection>

  <PaperSection id="avoid" title="What should I avoid?">
    <ul class="avoid">
      {b.notToDo.list.map((l) => <li>Don’t {l}</li>)}
    </ul>
    <p>Instead, keep asking: <b>What do I actually know? What am I assuming?</b></p>
  </PaperSection>

  <PaperSection id="check" title="Ready?">
    <ul class="check">
      {b.checklist.items.map((i) => <li>{i}</li>)}
    </ul>
    <p class="go"><a class="btn" href={url(`${comp.href}reflect-before/`)}>Next: Reflect before you start →</a></p>
  </PaperSection>
</ComponentLayout>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--sp-2);
  }
  .q {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--line);
    padding: var(--sp-2) var(--sp-3);
  }
  .q--tint {
    background: var(--accent-tint);
    border-color: transparent;
  }
  .q figcaption {
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .q blockquote {
    margin: var(--sp-1) 0;
    font-style: italic;
    font-size: var(--fs-lead);
  }
  .q p {
    margin: 0;
    font-size: var(--fs-ui);
  }
  .avoid,
  .check {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-3);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--sp-1) var(--sp-3);
  }
  .avoid li,
  .check li {
    margin: 0;
    padding-left: 28px;
    position: relative;
  }
  .avoid li::before,
  .check li::before {
    position: absolute;
    left: 0;
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .avoid li::before {
    content: '✕';
  }
  .check li::before {
    content: '☐';
  }
  .go {
    margin-top: var(--sp-4);
  }
</style>
