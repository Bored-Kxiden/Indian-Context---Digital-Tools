---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import Section from '../../../components/Section.astro';
import GoalIndex from '../../../components/GoalIndex.astro';
import RouteList from '../../../components/RouteList.astro';
import Icon from '../../../components/Icon.astro';
import { overview, route } from '../../../data/booklet/existing-products';
import { goalsByComponent } from '../../../data/goals';
import { componentById } from '../../../data/components';
import { url } from '../../../utils/url';

const comp = componentById['existing-products'];
const items = [
  { label: 'Reflect: before (R·1A)', href: `${comp.href}reflect-before/`, blurb: 'Say where you stand and what you expect to find, before Tool 1.' },
  ...route.map((r) => ({ ...r, href: `${comp.href}${r.href}/` })),
  { label: 'Reflect: after (R·1B)', href: `${comp.href}reflect-after/`, blurb: 'Say what the process actually gave you, then check it against your own bias.' },
];
---

<ComponentLayout
  component="existing-products"
  current="overview"
  title={comp.name}
  heading={comp.name}
  lead={comp.blurb}
  chips={['Component 1', '3–4 hours', 'Paper or card kit']}
>
  <Section id="idea" eyebrow="The idea" title="Every product was designed for someone." split>
    <p class="big">{overview.lead}</p>
    {overview.intro.map((p) => <p class="big">{p}</p>)}
    <div class="callout">
      <strong>{overview.notAnAudit.title}</strong>
      <p>{overview.notAnAudit.body}</p>
    </div>
  </Section>

  <Section id="goals" eyebrow="Start here" title="I want to…" tone="white">
    <p slot="lead" class="lead-text">Start with what you want to find out. Every tool works on its own.</p>
    <GoalIndex groups={goalsByComponent('c1')} variant="list" search={false} />
  </Section>

  <Section id="route" eyebrow="The route" title="Four tools, then one claim." split>
    <p class="big">About 3 hours. Do them in order for the full picture, or pick the one you need: each tool also works on its own. Every page is a template with Meera’s example in [brackets].</p>
    <RouteList items={items} />
  </Section>

  <Section id="need" eyebrow="Before you start" title="You need" tone="white" split>
    <ul class="need">
      {overview.youNeed.map((n) => <li><Icon name="check" size={22} /> {n}</li>)}
    </ul>
    <h3 class="h3">Three colours of sticky note</h3>
    <ul class="notes">
      {
        overview.notes.map((n) => (
          <li class={`note note--${n.colour}`}>
            <b>{n.label}</b>
            <span>{n.use}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="ways" eyebrow="Two ways to work" title="On paper, or with cards." split>
    <div class="ways">
      <article class="card way">
        <Icon name="print" size={32} />
        <h3>{overview.twoWays.paper.title}</h3>
        <p>{overview.twoWays.paper.body}</p>
        <dl>
          <dt>Best for</dt>
          <dd>{overview.twoWays.paper.bestFor}</dd>
          <dt>You need</dt>
          <dd>{overview.twoWays.paper.youNeed}</dd>
        </dl>
      </article>
      <article class="card way way--cards">
        <Icon name="cards" size={32} />
        <h3>{overview.twoWays.cards.title}</h3>
        <p>{overview.twoWays.cards.body}</p>
        <dl>
          <dt>Best for</dt>
          <dd>{overview.twoWays.cards.bestFor}</dd>
          <dt>You need</dt>
          <dd>{overview.twoWays.cards.youNeed}</dd>
        </dl>
        <a class="link-arrow" href={url('/card-kit/')}>See the card kit <Icon name="arrow" size={20} /></a>
      </article>
    </div>
    <p class="small">{overview.twoWays.note}</p>
    <p class="small">{overview.team}</p>
  </Section>

  <Section id="claim" eyebrow="Where it ends" title="One design claim." tone="c1" split>
    <p class="claim">{overview.claim}</p>
    <p class="small">{overview.claimNote}</p>
  </Section>
</ComponentLayout>

<style>
  .big {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .h3 {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: var(--sp-5) 0 var(--sp-2);
  }
  .need {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-2);
    max-width: var(--measure);
  }
  .need li {
    display: flex;
    gap: var(--sp-2);
    align-items: flex-start;
    margin: 0;
    font-size: var(--fs-lead);
  }
  .need :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--c1);
  }
  .notes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }
  .notes li {
    margin: 0;
    display: grid;
    gap: var(--sp-half);
    min-height: 112px;
    align-content: start;
  }
  .notes b {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ways {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .way {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }
  .way h3 {
    margin: var(--sp-1) 0 0;
  }
  .way p {
    margin: 0;
    color: var(--ink-soft);
  }
  .way dl {
    display: grid;
    gap: var(--sp-half);
    margin: var(--sp-2) 0 0;
  }
  .way dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: var(--sp-1);
  }
  .way dd {
    margin: 0;
  }
  .way .link-arrow {
    margin-top: auto;
    padding-top: var(--sp-2);
  }
  .way--cards {
    background: var(--c1-tint);
    border-color: transparent;
  }
  .small {
    font-size: var(--fs-ui);
    color: var(--muted);
    max-width: var(--measure);
    margin-top: var(--sp-2);
  }
  .claim {
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 40rem;
  }
  :global(.sec--c1) .small {
    color: inherit;
    opacity: 0.9;
  }
</style>
