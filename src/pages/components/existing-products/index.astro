---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import GoalIndex from '../../../components/GoalIndex.astro';
import RouteList from '../../../components/RouteList.astro';
import Icon from '../../../components/Icon.astro';
import { overview, route } from '../../../data/booklet/existing-products';
import { goalsByComponent } from '../../../data/goals';
import { componentById } from '../../../data/components';
import { url } from '../../../utils/url';

const comp = componentById['existing-products'];
const items = route.map((r) => ({ ...r, href: `${comp.href}${r.href}/` }));
---

<ComponentLayout
  component="existing-products"
  current="overview"
  title={comp.name}
  heading={comp.name}
  lead={comp.blurb}
  chips={['Component 1', '3–4 hours', 'Paper or card kit']}
>
  <section class="block" aria-labelledby="idea">
    <p class="eb">The idea</p>
    <h2 id="idea">Every product has a user built into it.</h2>
    {overview.intro.map((p) => <p class="big">{p}</p>)}
    <div class="callout">
      <strong>{overview.notAnAudit.title}</strong>
      <p>{overview.notAnAudit.body}</p>
    </div>
  </section>

  <section class="block" aria-labelledby="c1-goals-h">
    <GoalIndex
      groups={goalsByComponent('c1')}
      lead="Start with what you want to find out. Every tool works on its own."
      search={false}
      showComponent={false}
      stack
      eyebrow="Start here"
      id="c1-goals"
      headingId="c1-goals-h"
    />
  </section>

  <section class="block" aria-labelledby="route-h">
    <p class="eb">The route</p>
    <h2 id="route-h">Four tools, then one claim.</h2>
    <p class="big">Do them in order for the full picture, or pick the one you need.</p>
    <RouteList items={items} numbered />
  </section>

  <section class="block" aria-labelledby="need-h">
    <p class="eb">Before you start</p>
    <h2 id="need-h">You need</h2>
    <ul class="need">
      {overview.youNeed.map((n) => <li><Icon name="check" size={18} /> {n}</li>)}
    </ul>

    <h3 class="h3">Three colours of sticky note</h3>
    <ul class="notes">
      {
        overview.notes.map((n) => (
          <li class={`note note--${n.colour}`}>
            <b>{n.label}</b>
            <span>{n.use}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block" aria-labelledby="ways-h">
    <p class="eb">Two ways to work</p>
    <h2 id="ways-h">On paper, or with cards.</h2>
    <div class="ways">
      <article class="card way">
        <Icon name="print" size={28} />
        <h3>{overview.twoWays.paper.title}</h3>
        <p>{overview.twoWays.paper.body}</p>
        <dl>
          <dt>Best for</dt>
          <dd>{overview.twoWays.paper.bestFor}</dd>
          <dt>You need</dt>
          <dd>{overview.twoWays.paper.youNeed}</dd>
        </dl>
      </article>
      <article class="card way way--cards">
        <Icon name="cards" size={28} />
        <h3>{overview.twoWays.cards.title}</h3>
        <p>{overview.twoWays.cards.body}</p>
        <dl>
          <dt>Best for</dt>
          <dd>{overview.twoWays.cards.bestFor}</dd>
          <dt>You need</dt>
          <dd>{overview.twoWays.cards.youNeed}</dd>
        </dl>
        <a class="link-arrow" href={url('/card-kit/')}>See the card kit <Icon name="arrow" size={18} /></a>
      </article>
    </div>
    <p class="small">{overview.twoWays.note}</p>
  </section>

  <section class="block" aria-labelledby="claim-h">
    <p class="eb">Where it ends</p>
    <h2 id="claim-h">One design claim.</h2>
    <p class="claim">{overview.claim}</p>
    <p class="small">{overview.claimNote}</p>
  </section>
</ComponentLayout>

<style>
  .big {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 44rem;
  }
  .h3 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 2rem 0 0.9rem;
  }
  .need {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
    max-width: 44rem;
  }
  .need li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    margin: 0;
    font-size: 1.05rem;
  }
  .need :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--c1);
  }
  .notes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }
  .notes li {
    margin: 0;
    display: grid;
    gap: 0.25rem;
    min-height: 6.5rem;
  }
  .notes b {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ways {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .way {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .way h3 {
    margin: 0.5rem 0 0;
  }
  .way p {
    margin: 0;
    color: var(--ink-soft);
  }
  .way dl {
    display: grid;
    gap: 0.15rem;
    margin: 0.75rem 0 0;
  }
  .way dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.5rem;
  }
  .way dd {
    margin: 0;
  }
  .way .link-arrow {
    margin-top: auto;
    padding-top: 1rem;
  }
  .way--cards {
    background: var(--c1-tint);
    border-color: transparent;
  }
  .small {
    font-size: 0.92rem;
    color: var(--muted);
    max-width: 44rem;
    margin-top: 1rem;
  }
  .claim {
    font-size: clamp(1.3rem, 2.6vw, 1.85rem);
    font-weight: 700;
    line-height: 1.3;
    background: var(--c1);
    color: #fff;
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
    max-width: 44rem;
    margin: 0;
  }
</style>
