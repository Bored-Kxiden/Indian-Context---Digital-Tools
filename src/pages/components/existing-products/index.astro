---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import FileBasics from '../../../components/file/FileBasics.astro';
import PaperSection from '../../../components/file/PaperSection.astro';
import { overview, route, figmaFile } from '../../../data/booklet/existing-products';
import { getDownloadById } from '../../../data/downloads';
import { componentById } from '../../../data/components';
import { url } from '../../../utils/url';

// File 02's overview, in the template's order and in plain words (D41, D42), with the v3 template's seven boards (D47).
const comp = componentById['existing-products'];
const pack = getDownloadById('pack-existing-products')!;
const figma = getDownloadById(figmaFile.id)!;
const toolName = Object.fromEntries(route.map((r) => [r.href, r.label]));
---

<ComponentLayout component="existing-products" current="overview" title={comp.name} heading={comp.name}>

  <FileBasics
    comp={comp}
    facts={['3–4 hours', '4 tools + Synthesis', 'Paper or card kit']}
    notes={[
      { kind: 'Printable worksheets', format: `PDF · ${pack.pages} pages`, title: 'Print and fill in', action: 'download PDF ↓', href: pack.href, tone: 'yellow', download: true },
      { kind: 'Digital worksheet', format: 'Figma', title: 'Open the template', action: `download Figma file (${figma.size}) ↓`, href: figma.href, tone: 'pink', download: true },
      { kind: 'For a group', format: 'Card kit', title: 'Play it with cards', action: 'see the card kit →', href: '/card-kit/', tone: 'teal' },
    ]}
    why={[
      'Every product was designed for someone. This tool finds out who, and who pays when the product is wrong about them. It is not a usability audit.',
      'You pick one product you can open right now. Not a category: “Google Maps”, not “navigation apps”. Five tools read it from different sides, and at the end of each you write one line to carry forward. Synthesis uses those lines, so you never have to reread.',
    ]}
    how={[
      'Step 0: pick one product you can open right now.',
      'Fill Before Component 1 (R·1A): your position and your prediction.',
      'Work through the five tools in order, or pick the one you need.',
      'At the end of each tool, write one line to carry forward.',
      'Fill After Component 1 (R·1B): your claim, tested against your own bias.',
    ]}
  />

  <PaperSection id="need" title="What do I need?">
    <p>The product open on a phone or laptop, and pens. Sticky notes help, in three colours:</p>
    <ul class="stickies">
      {
        overview.notes.map((n) => (
          <li class={`note note--${n.colour}`}>
            <b>{n.label}</b> {n.use}
          </li>
        ))
      }
    </ul>
    <p>Working as a team of 3–5? Use the <a href={url('/card-kit/')}>card kit</a>: big boards and printed cards. The questions are the same, and so is what you end up with.</p>
  </PaperSection>

  <PaperSection id="figma" title="Rather work in Figma?">
    <p>{figmaFile.lead}</p>
    <details class="more">
      <summary>What is in the Figma file</summary>
      <ol class="frames">
        {
          figmaFile.pages.map((p) => (
            <li>
              <b>{p.name}</b>
              {p.tool && <a href={url(`${comp.href}${p.tool}/`)}>{toolName[p.tool]}</a>}
            </li>
          ))
        }
      </ol>
      <p class="small">{figmaFile.alsoHolds}</p>
    </details>
  </PaperSection>

  <PaperSection id="claim" title="Where does it end?">
    <p>With one sentence, the design claim. Every blank points to something you already wrote:</p>
    <p class="claim">{overview.claim}</p>
  </PaperSection>
</ComponentLayout>

<style>
  .stickies {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--sp-2);
  }
  .stickies li {
    margin: 0;
    border-radius: 0;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);
  }
  .stickies b {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .more summary {
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .frames {
    display: grid;
    gap: var(--sp-1);
    padding-left: var(--sp-3);
  }
  .frames li {
    margin: 0;
  }
  .frames a {
    margin-left: var(--sp-1);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
  }
  .small {
    font-size: var(--fs-ui);
    color: var(--muted);
  }
  .claim {
    font-size: var(--fs-lead);
    font-style: italic;
    border-left: 4px solid var(--accent);
    padding-left: var(--sp-3);
  }
</style>
