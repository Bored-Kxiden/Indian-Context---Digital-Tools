---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import PaperTop from '../../../components/file/PaperTop.astro';
import FileBasics from '../../../components/file/FileBasics.astro';
import PaperSection from '../../../components/file/PaperSection.astro';
import { overview, route, figmaFile } from '../../../data/booklet/existing-products';
import { getDownloadById } from '../../../data/downloads';
import { componentById } from '../../../data/components';
import { bookletImage } from '../../../utils/assets';
import { url } from '../../../utils/url';

// File 02's overview, in the template's order and in plain words (D41, D42).
const comp = componentById['existing-products'];
const pack = getDownloadById('pack-existing-products')!;
const figma = getDownloadById(figmaFile.id)!;
const toolName = Object.fromEntries(route.map((r) => [r.href, r.label]));
const plainStep: Record<string, string> = {
  'pick-a-product': 'Choose one product you can open right now: “Google Maps”, not “navigation apps”.',
  'media-gossip': 'Compare what the product promises with what people actually say about it.',
  history: 'Find out what the product replaced, and who lost a role when it arrived.',
  'the-break': 'Find where the ideal story breaks, and who gets blamed for it.',
  power: 'See who gains power, and whose unpaid help keeps it running.',
  synthesis: 'Put your findings side by side and write one design claim.',
};
const how = route.map((r) => ({ title: r.label.replace(/^\d · /, ''), meta: r.time || undefined, body: plainStep[r.href], href: `${comp.href}${r.href}/` }));
---

<ComponentLayout component="existing-products" current="overview" title={comp.name} heading={comp.name}>
  <PaperTop slot="top" image={bookletImage('1.09')} alt="The Synthesis worksheet from the booklet, filled in with Meera’s example." caption="Where it ends: the Synthesis worksheet · booklet p.1.09" text={comp.plain}>
    <Fragment slot="buttons">
      <a class="btn btn--sm" href={url(pack.href)} download>Download PDF ↓</a>
      <a class="btn btn--sm btn--outline" href={url(figma.href)} download>Figma template ↓</a>
    </Fragment>
  </PaperTop>

  <FileBasics
    comp={comp}
    facts={['3–4 hours', '4 tools + Synthesis', 'Paper or card kit']}
    notes={[
      { kind: 'Printable worksheets', format: `PDF · ${pack.pages} pages`, title: 'Print and fill in', action: 'download PDF ↓', href: pack.href, tone: 'yellow', download: true },
      { kind: 'Digital worksheet', format: 'Figma', title: 'Open the template', action: `download Figma file (${figma.size}) ↓`, href: figma.href, tone: 'pink', download: true },
      { kind: 'For a group', format: 'Card kit', title: 'Play it with cards', action: 'see the card kit →', href: '/card-kit/', tone: 'teal' },
    ]}
    why={[
      'Every product was designed for someone. This file helps you find out who, and who pays when the product is wrong about them.',
      'It is not a usability check. You are reading whose assumptions are built into the product.',
    ]}
    how={how}
  >
    <p slot="how" class="note-line">Every worksheet has Meera’s example in [brackets]. Write over it with your own. Each tool also works on its own.</p>
  </FileBasics>

  <PaperSection id="need" title="What do I need?">
    <p>The product open on a phone or laptop, and pens. Sticky notes help, in three colours:</p>
    <ul class="stickies">
      {
        overview.notes.map((n) => (
          <li class={`note note--${n.colour}`}>
            <b>{n.label}</b> {n.use}
          </li>
        ))
      }
    </ul>
    <p>Working as a team of 3–5? Use the <a href={url('/card-kit/')}>card kit</a>: big boards and printed cards. The questions are the same, and so is what you end up with.</p>
  </PaperSection>

  <PaperSection id="figma" title="Rather work in Figma?">
    <p>{figmaFile.lead}</p>
    <details class="more">
      <summary>What is in the Figma file</summary>
      <ol class="frames">
        {
          figmaFile.pages.map((p) => (
            <li>
              <b>{p.name}</b>
              {p.tool && <a href={url(`${comp.href}${p.tool}/`)}>{toolName[p.tool]}</a>}
            </li>
          ))
        }
      </ol>
      <p class="small">{figmaFile.alsoHolds}</p>
    </details>
  </PaperSection>

  <PaperSection id="claim" title="Where does it end?">
    <p>With one sentence, the design claim. Every blank points to something you already wrote:</p>
    <p class="claim">{overview.claim}</p>
  </PaperSection>
</ComponentLayout>

<style>
  .note-line {
    margin-top: var(--sp-3);
    font-size: var(--fs-ui);
    color: var(--muted);
  }
  .stickies {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--sp-2);
  }
  .stickies li {
    margin: 0;
    border-radius: 0;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);
  }
  .stickies b {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .more summary {
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .frames {
    display: grid;
    gap: var(--sp-1);
    padding-left: var(--sp-3);
  }
  .frames li {
    margin: 0;
  }
  .frames a {
    margin-left: var(--sp-1);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
  }
  .small {
    font-size: var(--fs-ui);
    color: var(--muted);
  }
  .claim {
    font-size: var(--fs-lead);
    font-style: italic;
    border-left: 4px solid var(--accent);
    padding-left: var(--sp-3);
  }
</style>
