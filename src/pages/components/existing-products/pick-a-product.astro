---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import Section from '../../../components/Section.astro';
import Icon from '../../../components/Icon.astro';
import { overview } from '../../../data/booklet/existing-products';
import { url } from '../../../utils/url';

const p = overview.pickAProduct;
const how = overview.howEveryPageWorks;
---

<ComponentLayout
  component="existing-products"
  current="pick-a-product"
  title="Pick a product"
  heading="Pick a product"
  lead={p.lead}
  chips={['Step 0', 'Before Tool 1']}
  crumb="Pick a product"
>
  <Section id="good" eyebrow="One product, not a category" title="Specific enough to open." split>
    <div class="cmp">
      <div class="col col--good">
        <span class="lbl">Good</span>
        <ul>
          {p.good.map((g) => <li><Icon name="check" size={22} /> {g}</li>)}
        </ul>
      </div>
      <div class="col col--broad">
        <span class="lbl">Too broad</span>
        <ul>
          {p.tooBroad.map((g) => <li><Icon name="x" size={22} /> {g}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="do" eyebrow={p.step} title="Write it in one line." tone="white" split>
    <p class="sentence">{p.sentence}</p>
    <p class="small">{p.note}</p>
  </Section>

  <Section id="how" eyebrow={how.title} title="Every page after this is a template." split>
    {how.body.map((t) => <p class="big">{t}</p>)}
    <a class="btn btn--accent" href={url('/components/existing-products/media-gossip/')}>
      Start Tool 1 · Media &amp; Gossip <Icon name="arrow" size={20} />
    </a>
  </Section>
</ComponentLayout>

<style>
  .big {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .small {
    font-size: var(--fs-ui);
    color: var(--muted);
    max-width: var(--measure);
    margin: var(--sp-2) 0 var(--sp-3);
  }
  .cmp {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    max-width: 56rem;
  }
  .col {
    border-radius: var(--r-lg);
    padding: var(--sp-3);
  }
  .col--good {
    background: var(--c1);
    color: #fff;
  }
  .col--broad {
    background: var(--sand);
  }
  .col .lbl {
    color: inherit;
    opacity: 0.9;
    margin-bottom: var(--sp-2);
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }
  .col li {
    display: flex;
    gap: var(--sp-1);
    align-items: flex-start;
    margin: 0;
    font-weight: 600;
    font-size: var(--fs-lead);
    line-height: 1.35;
  }
  .col li :global(svg) {
    flex: none;
    margin-top: 4px;
  }
  .sentence {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.3;
    max-width: 36rem;
    margin: 0 0 var(--sp-2);
    padding: var(--sp-3);
    border-radius: var(--r-md);
    background: var(--ground);
    border: 2px dashed var(--line-strong);
  }
</style>
