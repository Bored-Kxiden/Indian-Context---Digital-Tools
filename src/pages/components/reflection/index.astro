---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import PaperTop from '../../../components/file/PaperTop.astro';
import FileBasics from '../../../components/file/FileBasics.astro';
import PaperSection from '../../../components/file/PaperSection.astro';
import { overview, stops, lookBack } from '../../../data/reflection';
import { componentById } from '../../../data/components';
import { getDownloadById } from '../../../data/downloads';
import { url } from '../../../utils/url';

// File 01's overview, in the template's order and in plain words (D41, D42). Reflection has a Before and an
// After page inside each of the other files, and three Look back pages of its own.
const comp = componentById['reflection'];
const all = getDownloadById('reflection-all')!;
const colour = { 'existing-products': 'c1', 'visual-culture': 'c2', language: 'c3', 'material-reality': 'c4' } as const;
const fileName = Object.fromEntries(stops.map((s) => [s.id, componentById[s.id].name]));
const how = [
  { title: 'Position', meta: 'before', body: 'Where are you speaking from? Write down what you already know and who you are, before you open a file.' },
  { title: 'Prediction', meta: 'before', body: 'What do you expect to find, and why?' },
  { title: 'Claim', meta: 'after', body: 'What did the work actually give you that you didn’t have before?' },
  { title: 'Redaction', meta: 'after', body: 'Cross out what you would have said anyway. What is left is your finding.' },
  { title: 'Look back', meta: 'at the end', href: `${comp.href}summarise/`, body: 'Compare your predictions with what you found: what changed, what surprised you, what is still missing.' },
];
---

<ComponentLayout component="reflection" current="overview" title={comp.name} heading={comp.name} description={comp.plain}>
  <PaperTop slot="top" image={{ src: '/reflection/r1a.webp', width: 1240, height: 1754 }} alt="The printable Before page for Reading Existing Products." caption="The Before page · R·1A" text={comp.blurb}>
    <Fragment slot="buttons">
      <a class="btn btn--sm" href={url(all.href)} download>Download PDF ↓</a>
      <a class="btn btn--sm btn--outline" href={url(`${stops[0].href}reflect-before/`)}>Start the first page →</a>
    </Fragment>
  </PaperTop>

  <FileBasics
    comp={comp}
    facts={['Under an hour', 'On your own', '12 A4 pages']}
    notes={[
      { kind: 'Digital worksheet', format: 'On screen', title: 'Fill it here', action: 'open the first page →', href: `${stops[0].href}reflect-before/#fill`, tone: 'pink' },
      { kind: 'Printable worksheets', format: `PDF · ${all.pages ?? 12} pages`, title: 'Print and fill in', action: 'download PDF ↓', href: all.href, tone: 'yellow', download: true },
    ]}
    why={[
      'Everyone starts with assumptions. If you don’t write them down first, they can come back at the end looking like findings.',
      'So you note where you stand and what you expect before each file, and check your claim against it afterwards. You end up with an honest account of what changed, what you can back up, and what you still don’t know.',
    ]}
    how={how}
  >
    <p slot="how" class="note-line">{overview.onlyOne}</p>
  </FileBasics>

  <PaperSection id="where" title="Where are the pages?">
    <p>One Before page and one After page sit inside each file. The three Look back pages are here, for the end.</p>
    <ul class="stops">
      {
        stops.map((s) => (
          <li data-c={colour[s.id]}>
            <span class="sq" aria-hidden="true" />
            <b>{fileName[s.id]}</b>
            <a href={url(`${s.href}reflect-before/`)}>Before ({s.before.code})</a>
            <a href={url(`${s.href}reflect-after/`)}>After ({s.after.code})</a>
          </li>
        ))
      }
      <li data-c="ink">
        <span class="sq" aria-hidden="true" />
        <b>At the end</b>
        {lookBack.map((p) => <a href={url(`${comp.href}${p.slug}/`)}>{p.short} ({p.code})</a>)}
      </li>
    </ul>
  </PaperSection>
</ComponentLayout>

<style>
  .note-line {
    margin-top: var(--sp-3);
  }
  .stops {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .stops li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-3);
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--line);
    margin: 0;
  }
  .stops b {
    flex: 1 1 14rem;
    font-weight: 600;
  }
  .sq {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: var(--accent);
  }
  .stops a {
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>
