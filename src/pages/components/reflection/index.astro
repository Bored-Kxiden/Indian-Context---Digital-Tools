---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import Section from '../../../components/Section.astro';
import CentralLine from '../../../components/CentralLine.astro';
import DownloadCard from '../../../components/DownloadCard.astro';
import Icon from '../../../components/Icon.astro';
import { overview, stops, lookBack } from '../../../data/reflection';
import { componentById } from '../../../data/components';
import { getDownloadById } from '../../../data/downloads';
import { url } from '../../../utils/url';

const comp = componentById['reflection'];
const all = getDownloadById('reflection-all')!;
const colour = { 'existing-products': 'c1', 'visual-culture': 'c2', language: 'c3', 'material-reality': 'c4' } as const;
---

<ComponentLayout
  component="reflection"
  current="overview"
  title={comp.name}
  heading={comp.name}
  lead={overview.quote}
  description={comp.blurb}
  chips={['Runs through every component', 'Five steps', 'Twelve A4 pages']}
>
  <Section id="idea" eyebrow="What is it & why should I do it?" title="Start before the work, not after it." split>
    {overview.what.body.map((p, i) => <p class={i === 0 ? 'big' : 'body-p'}>{p}</p>)}
    <div class="callout callout--ink">
      <strong>{overview.howTo.title}</strong>
      <p>{overview.howTo.body}</p>
    </div>
  </Section>

  <Section id="flow" eyebrow="The method" title="Five steps, in this order." tone="white" split>
    <ol class="flow">
      {
        overview.flow.map((s) => (
          <li>
            <span class="n" aria-hidden="true">{s.n}</span>
            <div>
              <b>{s.name}</b>
              <span>{s.ask}</span>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="note">Steps 1–2 sit before each component, steps 3–4 after it, and step 5 once, at the end.</p>
  </Section>

  <Section id="where" eyebrow="Where you’ll find these pages" title="In each component, then once at the end.">
    <div class="groups">
      <section class="grp" aria-labelledby="g-before">
        <p class="lbl">Steps 1–2</p>
        <h3 id="g-before">Before each component</h3>
        <ul>
          {
            stops.map((s) => (
              <li data-c={colour[s.id]}>
                <a href={url(`${s.href}reflect-before/`)}>
                  <span class="dot" aria-hidden="true">{s.n}</span>
                  <span class="t">
                    <b>{s.before.code} · Before Component {s.n}</b>
                    <small>after {s.before.after.label}</small>
                  </span>
                  <Icon name="arrow" size={20} />
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="grp" aria-labelledby="g-after">
        <p class="lbl">Steps 3–4</p>
        <h3 id="g-after">After each component</h3>
        <ul>
          {
            stops.map((s) => (
              <li data-c={colour[s.id]}>
                <a href={url(`${s.href}reflect-after/`)}>
                  <span class="dot" aria-hidden="true">{s.n}</span>
                  <span class="t">
                    <b>{s.after.code} · After Component {s.n}</b>
                    <small>after {s.after.after.label}</small>
                  </span>
                  <Icon name="arrow" size={20} />
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="grp" aria-labelledby="g-look">
        <p class="lbl">Step 5 · in Closing</p>
        <h3 id="g-look">Look back</h3>
        <ul>
          {
            lookBack.map((p) => (
              <li data-c="ink">
                <a href={url(`${comp.href}${p.slug}/`)}>
                  <span class="dot" aria-hidden="true">R</span>
                  <span class="t">
                    <b>{p.code} · {p.short}</b>
                    <small>{p.sub.replace(/^Step 5 · /, '')}</small>
                  </span>
                  <Icon name="arrow" size={20} />
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
    <div class="callout only">
      <strong>Only using one component?</strong>
      <p>{overview.onlyOne.replace(/^Only using one component\? /, '')}</p>
    </div>
  </Section>

  <Section id="print" eyebrow="Print it" title="Twelve pages, one file." tone="white" split>
    <p class="big">Print only the pages for the components you use. Every page is also its own file, on its own page.</p>
    <div class="dl"><DownloadCard item={all} /></div>
    <p class="go">
      <a class="btn btn--accent" href={url(`${stops[0].href}reflect-before/`)}>Start with Before Component 1 <Icon name="arrow" size={20} /></a>
    </p>
  </Section>

  <CentralLine id="central" withIdea={false} />
</ComponentLayout>

<style>
  .big {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .body-p {
    max-width: var(--measure);
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }
  .flow li {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--sp-2);
    align-items: center;
    padding: var(--sp-2) var(--sp-3);
    border: 2px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--ground);
  }
  .flow .n {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-weight: 800;
    font-size: var(--fs-h4);
  }
  .flow b {
    display: block;
    font-size: var(--fs-h3);
    line-height: 1.15;
  }
  .flow span:not(.n) {
    color: var(--ink-soft);
  }
  .note {
    margin: var(--sp-3) 0 0;
    color: var(--muted);
  }
  .groups {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 64rem) {
    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .grp {
    border: 2px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--surface);
    padding: var(--sp-3);
  }
  .grp h3 {
    margin: 0 0 var(--sp-2);
  }
  .grp ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-1);
  }
  .grp li {
    margin: 0;
  }
  .grp a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--sp-2);
    min-height: 64px;
    padding: var(--sp-1) var(--sp-2);
    border-radius: var(--r-md);
    background: var(--accent-tint);
    color: var(--ink);
    text-decoration: none;
  }
  .grp a:hover {
    outline: 2px solid var(--accent-deep);
  }
  .dot {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 800;
  }
  .t b {
    display: block;
    line-height: 1.2;
  }
  .t small {
    display: block;
    color: var(--ink-soft);
    font-size: var(--fs-sm);
  }
  .only {
    margin-top: var(--sp-3);
    max-width: 52rem;
  }
  .dl {
    max-width: 36rem;
    margin: var(--sp-3) 0;
  }
  .go {
    margin: 0;
  }
</style>
