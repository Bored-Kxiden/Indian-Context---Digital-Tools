---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import GoalIndex from '../../components/GoalIndex.astro';
import { goals } from '../../data/goals';
---

<BaseLayout title="All tools" description="Every tool in the kit, by what you want to do. Each file works on its own.">
  <PageHead
    crumbs={[{ label: 'All files', href: '/' }, { label: 'All tools' }]}
    eyebrow="Find a tool"
    heading="I want to…"
    lead="Start with what you want to find out. Each line opens the tool that does it. Every file also works on its own."
  />
  <section class="wrap list" id="i-want-to" aria-label="Every tool, by what you want to do">
    <h2 class="visually-hidden">Every tool, by file</h2>
    <GoalIndex groups={goals} />
  </section>
</BaseLayout>

<style>
  .list {
    padding-block: var(--sp-5) var(--sp-8);
  }
</style>
