---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import ComponentCards from '../../components/ComponentCards.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../utils/url';
---

<BaseLayout title="Components" description="The components of the toolkit. Each one works on its own; used together they give a fuller picture of the person you are designing for.">
  <PageHead
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Components' }]}
    heading="Components"
    lead="Each component is a way of reading. Each works on its own. Used together, they give you a fuller picture of the person you’re designing for."
  />

  <Section id="all" eyebrow="Pick a way of reading" title="Four components, one person.">
    <ComponentCards />
  </Section>

  <Section id="not-sure" eyebrow="Not sure where to start?" title="Start with what you want to do." tone="white" split>
    <p class="big">The “I want to…” list on the home page opens the right tool for the job, whichever component it sits in.</p>
    <p><a class="btn btn--accent" href={url('/#i-want-to')}>I want to… <Icon name="arrow" size={20} /></a></p>
  </Section>
</BaseLayout>

<style>
  .big {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
</style>
