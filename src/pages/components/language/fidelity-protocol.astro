---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import { INTERPRETERS, RENDERINGS } from '../../../utils/fidelity';
import { url } from '../../../utils/url';

const tags = [
  {
    n: 1,
    name: 'Source language',
    q: 'What language was actually spoken?',
    body: 'Record the actual language, and any code-switching, rather than collapsing it to “English”. A moment spoken in Hindi with English words dropped in is not the same as one spoken in English.',
    values: ['Free text, for example “Hindi–English (code-switched)”'],
  },
  {
    n: 2,
    name: 'Who interpreted',
    q: 'Whose reading is this?',
    body: 'Name who rendered the moment into the working language. Different interpreters shape meaning differently, and a reader downstream needs to know which one they are relying on.',
    values: Object.values(INTERPRETERS),
  },
  {
    n: 3,
    name: 'Rendering type',
    q: 'How closely does the written version follow the spoken one?',
    body: 'Say whether the rendering is the participant’s exact words, the same meaning in different words, or only the gist. A paraphrase should never be quoted as if it were what the person said.',
    values: Object.values(RENDERINGS),
  },
  {
    n: 4,
    name: 'Single-source flag',
    q: 'Has anyone else read it the same way?',
    body: 'Has a second interpreter read the moment the same way, or does it rest on one person alone? One person’s read, however fluent, is still one person’s read.',
    values: ['Second reader agrees', 'Rests on one person alone'],
  },
];
---

<ToolLayout
  slug="fidelity-protocol"
  intro="Four tags that record how much a finding was translated, by whom, and whether a second reader confirmed it. They let a design team tell a well-supported meaning from a single, unconfirmed guess."
>
  <section class="section" aria-labelledby="rule">
    <div class="prose">
      <h2 id="rule">The rule</h2>
      <div class="callout big">
        <strong>A finding missing any of the four tags cannot carry full confidence until it is re-checked.</strong>
        <p>It does not pass on gut feeling.</p>
      </div>
      <p>
        In a typical research pipeline nothing marks whether a finding is what a person meant or one interpreter’s best guess. Every
        finding travels with equal authority however many hops of translation produced it. The Fidelity Protocol makes those hops
        visible. It is the check behind the decision in Module 3: <em>is the meaning well supported?</em>
      </p>
      <ul>
        <li><strong>Not yet:</strong> the finding loops back to thick translation and is re-checked.</li>
        <li>
          <strong>Yes:</strong> the de-identified pattern is stored in the{' '}
          <a href={url('/components/language/expression-library/')}>Expression Library</a>, with its tags attached.
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="tags">
    <div class="section-head">
      <h2 id="tags">The four tags</h2>
      <p>Mark a meaning as supported only when all four are true.</p>
    </div>
    <div class="grid grid--2">
      {
        tags.map((t) => (
          <article class="card">
            <p class="num">{t.n}</p>
            <h3>{t.name}</h3>
            <p class="q">{t.q}</p>
            <p>{t.body}</p>
            <p class="vals-label">Record one of</p>
            <ul class="vals">
              {t.values.map((v) => <li>{v}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="try">
    <div class="section-head">
      <h2 id="try">Try the rule</h2>
      <p>
        Fill in the tags for a finding and see whether it can carry full confidence. Nothing is saved or sent anywhere: this runs in
        your browser.
      </p>
    </div>

    <form class="card checker" id="checker" autocomplete="off">
      <div class="form-grid">
        <label>
          <span>Source language</span>
          <input type="text" name="sourceLanguage" placeholder="e.g. Hindi–English (code-switched)" />
        </label>
        <label>
          <span>Who interpreted</span>
          <select name="interpreter">
            <option value="">Not recorded</option>
            {Object.entries(INTERPRETERS).map(([k, v]) => <option value={k}>{v}</option>)}
          </select>
        </label>
        <label>
          <span>Rendering type</span>
          <select name="rendering">
            <option value="">Not recorded</option>
            {Object.entries(RENDERINGS).map(([k, v]) => <option value={k}>{v}</option>)}
          </select>
        </label>
        <label>
          <span>Second reading</span>
          <select name="singleSource">
            <option value="">Not checked</option>
            <option value="no">A second reader agrees</option>
            <option value="yes">Rests on one person alone</option>
          </select>
        </label>
      </div>

      <div class="result" id="result" role="status" aria-live="polite">
        <p class="verdict chip chip--warn" id="verdict">Cannot carry full confidence yet</p>
        <ul id="gaps"></ul>
      </div>
    </form>
  </section>

  <section class="section" aria-labelledby="where">
    <div class="prose">
      <h2 id="where">How it fits with the other tools</h2>
      <ul>
        <li>
          On a <a href={url('/components/language/meaning-card/')}>Meaning Card</a>, the <em>translation review flag</em> marks that a collaborator
          still needs to check the rendering. The four tags are what get recorded when that review happens.
        </li>
        <li>
          In the <a href={url('/components/language/expression-library/')}>Expression Library</a>, every entry shows its tags, and entries that
          are missing any of them are labelled as needing a re-check.
        </li>
        <li>
          In the <a href={url('/components/language/design-language-library/')}>Design Language Library</a>, a pattern that rests on an entry
          that still needs a re-check is flagged, so weak evidence cannot quietly support a design decision.
        </li>
      </ul>
    </div>
  </section>
</ToolLayout>

<script>
  import { assessFidelity, type Interpreter, type Rendering } from '../../../utils/fidelity';

  const form = document.getElementById('checker') as HTMLFormElement | null;
  const verdict = document.getElementById('verdict');
  const gaps = document.getElementById('gaps');

  function update() {
    if (!form || !verdict || !gaps) return;
    const data = new FormData(form);
    const single = data.get('singleSource');
    const result = assessFidelity({
      sourceLanguage: String(data.get('sourceLanguage') ?? ''),
      interpreter: (String(data.get('interpreter') ?? '') || undefined) as Interpreter | undefined,
      rendering: (String(data.get('rendering') ?? '') || undefined) as Rendering | undefined,
      singleSource: single === 'yes' ? true : single === 'no' ? false : undefined,
    });

    verdict.textContent = result.full ? 'Can carry full confidence' : 'Cannot carry full confidence yet';
    verdict.className = `verdict chip ${result.full ? 'chip--ok' : 'chip--warn'}`;
    gaps.replaceChildren(
      ...result.gaps.map((g) => {
        const li = document.createElement('li');
        li.textContent = g;
        return li;
      }),
    );
  }

  form?.addEventListener('input', update);
  form?.addEventListener('change', update);
  update();
</script>

<style>
  .big {
    font-size: var(--fs-body);
  }
  .big strong {
    font-family: var(--font-head);
    font-size: var(--fs-lead);
    line-height: 1.25;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    margin: 0 0 var(--sp-1);
    border-radius: 50%;
    background: var(--m-interpret);
    color: var(--bg);
    font-weight: 700;
  }
  .q {
    font-style: italic;
    color: var(--ink-soft);
  }
  .vals-label {
    margin: var(--sp-2) 0 var(--sp-half);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .vals {
    margin: 0;
    font-size: var(--fs-ui);
    color: var(--ink-soft);
  }

  .checker {
    max-width: 52rem;
  }
  .form-grid {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  label span {
    display: block;
    font-weight: 600;
    font-size: var(--fs-ui);
    margin-bottom: var(--sp-half);
  }
  input,
  select {
    width: 100%;
    font: inherit;
    font-size: var(--fs-ui);
    padding: var(--sp-1) var(--sp-1);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
  }
  .result {
    margin-top: var(--sp-3);
    padding-top: var(--sp-2);
    border-top: 1px solid var(--line);
  }
  .verdict {
    font-size: var(--fs-ui);
    padding: var(--sp-1) var(--sp-2);
    margin: 0 0 var(--sp-2);
  }
  #gaps {
    margin: 0;
    color: var(--ink-soft);
  }
</style>
