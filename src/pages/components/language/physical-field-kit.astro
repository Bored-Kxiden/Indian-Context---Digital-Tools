---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import kit from '../../../../templates/kit-cards.json';
import { url } from '../../../utils/url';

const decks = kit.decks;
const total = decks.reduce((n, d) => n + d.cards.length, 0) + 1 + kit.blankMeaningCardCopies;
---

<ToolLayout
  slug="physical-field-kit"
  intro="A set of printable cards for taking into the field: Context Cards, Interview Cards, Reflection Cards, a Researcher Positionality Card, and blank Meaning Cards. Paper is quiet, needs no battery, and lets people write in the language they heard."
>
  <section class="section" aria-labelledby="why">
    <div class="prose">
      <h2 id="why">Why paper</h2>
      <p>
        Meaning moments happen quickly, often in the middle of a conversation. A card in your hand is faster than a laptop, less
        intrusive than a phone, and lets you write exact words in the script they were spoken in. Each deck is tied to a step in
        the process, so the kit doubles as a prompt for what to do next.
      </p>
      <p>
        Every card is 6 × 4 in, front and back. The whole kit is {total} cards and prints as a single PDF, together with a one-card
        guide.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="contents">
    <div class="section-head">
      <h2 id="contents">What is in the kit</h2>
    </div>
    <div class="grid grid--2 decks">
      {
        decks.map((d) => (
          <article class="card" id={`${d.id}-cards`}>
            <div class="chip-row head">
              <span class="chip chip--solid">{d.moduleLabel}</span>
              <span class="chip">{d.cards.length} cards</span>
            </div>
            <h3>{d.name}</h3>
            <p class="when">{d.when}</p>
            <p>{d.purpose}</p>
            <details>
              <summary>Card titles and prompts</summary>
              <ol class="titles">
                {
                  d.cards.map((c) => (
                    <li>
                      <b>{c.title}</b>
                      <ul>
                        {c.prompts.map((p) => (
                          <li>{p}</li>
                        ))}
                      </ul>
                    </li>
                  ))
                }
              </ol>
            </details>
          </article>
        ))
      }

      <article class="card" id="positionality-card">
        <div class="chip-row head">
          <span class="chip chip--solid">{kit.positionality.moduleLabel}</span>
          <span class="chip">1 card</span>
        </div>
        <h3>{kit.positionality.name}</h3>
        <p class="when">Before you start, once per place</p>
        <p>
          A structured place to write your positionality note: the languages you do and do not speak, how your background relates to
          participants’, how they may see you, and what you may find hard to notice. It is revisited at the end of fieldwork.
        </p>
        <p class="more">
          The {kit.positionality.prompts.length} prompts are on{' '}
          <a href={url('/components/language/before-you-start/#positionality')}>Before you start</a>.
        </p>
      </article>

      <article class="card" id="blank-meaning-cards">
        <div class="chip-row head">
          <span class="chip chip--solid">{kit.blankMeaningCardLabel}</span>
          <span class="chip">{kit.blankMeaningCardCopies} cards</span>
        </div>
        <h3>Blank Meaning Cards</h3>
        <p class="when">Tool 1 · Listen, during interviews</p>
        <p>
          Ready-to-fill copies of the <a href={url('/components/language/meaning-card/')}>Meaning Card</a>, front and back. Print as many copies
          of these pages as you expect to need: one card per meaning moment.
        </p>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="print">
    <div class="prose">
      <h2 id="print">Printing the kit</h2>
      <ul>
        <li>Print at <strong>100% (actual size)</strong>. Turn off “fit to page” so the cards measure 6 × 4 in (152 × 102 mm).</li>
        <li>Print <strong>double-sided</strong>. If a back comes out upside down, switch between “flip on long edge” and “flip on short edge”.</li>
        <li>Print one card first to check that the front and back line up on your printer.</li>
        <li>Use 200 to 300 gsm card stock for cards that will be handled in the field. Most print shops can cut or print 6 × 4 in, the standard photo-print size.</li>
        <li>Print several copies of the blank Meaning Card pages. A single interview can produce many moments.</li>
      </ul>
      <div class="callout callout--warn">
        <strong>Draft content</strong>
        <p>
          The prompts on these cards are a first draft, written from the steps of the process. Edit{' '}
          <code>templates/kit-cards.json</code> and run <code>npm run build:templates</code> to change them and regenerate the PDF.
        </p>
      </div>
    </div>
  </section>
</ToolLayout>

<style>
  .head {
    margin-bottom: var(--sp-1);
  }
  .when {
    margin: 0 0 var(--sp-1);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-soft);
  }
  details {
    margin-top: var(--sp-1);
  }
  .more {
    margin: var(--sp-1) 0 0;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--accent);
  }
  .titles {
    margin: var(--sp-2) 0 0;
    padding-left: var(--sp-2);
    font-size: var(--fs-ui);
  }
  .titles ul {
    margin: var(--sp-half) 0 var(--sp-1);
    color: var(--ink-soft);
  }
</style>
