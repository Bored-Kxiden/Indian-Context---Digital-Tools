---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import MeaningCardMock from '../../../components/MeaningCardMock.astro';
import fields from '../../../../templates/meaning-card-fields.json';
import { url } from '../../../utils/url';

const exampleFront = {
  momentId: 'P07-M03',
  setting: 'College computer lab; friend seated beside',
  time: '14 Mar, 3:40 pm (recording 00:22:10)',
  happening: 'First time reaching the document-upload step of a scholarship portal.',
  exactWords: '“Portal pe ‘domicile’ likha hai, papa se poochna padega.”',
  observed: 'Paused, leaned back, picked up phone. A half-laugh. Tone flat, not distressed.',
  guess: 'Does not know the term; relies on family to interpret official words.',
};

const exampleBack = {
  asked: '“Jab aapne ‘papa se poochna padega’ kaha, tab aap kya soch rahe the?”',
  explanation: '“Yeh word kabhi suna nahi tha. Papa kisi se pooch lenge.”',
  status: 'Corrected',
  otherMeaning: 'Reluctance to admit not knowing in front of a friend.',
  translationReview: true,
  sensitive: false,
};

// The booklet's Tool 1 · Listen already covers noticing, marking cues and asking what it meant.
// These steps are what the full card adds.
const steps = [
  {
    title: 'Fill the front, guess last',
    body: 'Record the moment ID, the setting, what was happening, the exact words in the language spoken, and what you observed. Only then write your guess at the meaning, and label it as a guess.',
  },
  {
    title: 'Ask, then fill the back',
    body: 'Write down the question you asked, their explanation in their own words, and whether they confirmed, corrected, or disagreed with your guess.',
  },
  {
    title: 'Flag what needs care',
    body: 'Tick the translation review flag if a collaborator still needs to check the rendering. Tick sensitive-to-reuse if quoting or sharing could expose the participant or their family.',
  },
  {
    title: 'Hand on',
    body: 'In Tool 2 · Translate, cards go through thick translation, reverse thick translation and the Fidelity Protocol. Cards that pass are digitized into the Expression Library.',
  },
];

// The booklet's short card, and where each of its lines lives on this one.
const shortCard: [string, string][] = [
  ['Said (in their language)', 'Exact words (original language)'],
  ['Observed', 'What was observed'],
  ['Inferred', 'Researcher’s guess at meaning'],
  ['What did that moment mean to you?', 'What was asked to confirm · Participant’s explanation'],
  ['Their correction or disagreement', 'Correction status · Another possible meaning'],
  ['Not on the short card', 'Moment ID · Setting · Time · What was happening · Translation review flag · Sensitive to reuse'],
];
---

<ToolLayout
  slug="meaning-card"
  intro="One card per meaning moment: a phrase, action, or pause worth a second look. It keeps what was said, what was observed, and what the researcher infers apart, then records what the participant said when asked."
>
  <section class="section" aria-labelledby="why">
    <div class="prose">
      <h2 id="why">Why one card per moment</h2>
      <p>
        The Meaning Card is the atomic unit the rest of the toolkit builds on. It is created in Tool 1 · Listen, for a single moment, and
        it does not yet claim that the researcher’s inference is correct. Keeping each moment on its own card means it can be
        translated, checked, tagged, and later cited by a design pattern, without dragging a whole interview along with it.
      </p>
      <p>
        The front captures the moment. The back is where the inference is tested with the participant, so a guess is never mistaken
        for a finding.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="short">
    <div class="section-head">
      <h2 id="short">The short card and the full card</h2>
      <p>
        In <a href={url('/components/language/listen/')}>Tool 1 · Listen</a>, the booklet uses a short card for the field: said, observed, inferred, then what it
        meant to them and their correction. This is the full card, for when a moment will be translated, checked and reused.
        Every line of the short card has a place on it.
      </p>
    </div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Short card and full card: scroll sideways to see both columns">
      <table>
        <caption>Where each line of the short card goes</caption>
        <thead>
          <tr>
            <th scope="col">Short card (booklet)</th>
            <th scope="col">Full card (this page)</th>
          </tr>
        </thead>
        <tbody>
          {
            shortCard.map(([a, b]) => (
              <tr>
                <th scope="row">{a}</th>
                <td>{b}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" aria-labelledby="front">
    <h2 id="front">The front: capture the moment</h2>
    <div class="split">
      <MeaningCardMock side="front" />
      <ul class="fields">
        {
          fields.front.map((f) => (
            <li>
              <b>{f.label}</b>
              <span>{f.hint}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="back">
    <h2 id="back">The back: check it with the participant</h2>
    <div class="split">
      <MeaningCardMock side="back" />
      <ul class="fields">
        {
          fields.back.map((f) => (
            <li>
              <b>{f.label}</b>
              <span>{f.hint}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="how">
    <div class="section-head">
      <h2 id="how">How to use it</h2>
    </div>
    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <b>{s.title}</b>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" aria-labelledby="example">
    <div class="section-head">
      <h2 id="example">A filled-in example</h2>
      <p>
        <strong>Illustrative only.</strong> This card was written to show how the fields work. It does not come from a real
        participant.
      </p>
    </div>
    <div class="grid grid--2">
      <MeaningCardMock side="front" values={exampleFront} />
      <MeaningCardMock side="back" values={exampleBack} />
    </div>
    <p class="after">
      Note the difference between the guess (“does not know the term”) and what the participant said. The correction status
      records that the guess was only partly right. The moment is not ready to enter the Expression Library until it has passed
      the <a href={url('/components/language/fidelity-protocol/')}>Fidelity Protocol</a>.
    </p>
  </section>
</ToolLayout>

<style>
  .split {
    display: grid;
    gap: var(--sp-3) var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    counter-reset: step;
    max-width: var(--prose);
  }
  .steps li {
    counter-increment: step;
    position: relative;
    margin: 0;
    padding-left: var(--sp-6);
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    display: grid;
    place-items: center;
  }
  .steps b {
    display: block;
    font-family: var(--font-head);
    font-size: var(--fs-body);
  }
  .steps p {
    margin: var(--sp-half) 0 0;
    color: var(--ink-soft);
  }
  .after {
    max-width: var(--prose);
    margin-top: var(--sp-3);
  }
</style>
