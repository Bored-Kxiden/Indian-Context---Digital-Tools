---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import SampleBanner from '../../../components/SampleBanner.astro';
import { getExpressions, lensNames } from '../../../data/library';
import { INTERPRETERS, RENDERINGS } from '../../../utils/fidelity';
import { url } from '../../../utils/url';

const entries = getExpressions();
const hasSample = entries.some((e) => e.sample);

const languages = [...new Set(entries.map((e) => e.fidelity.sourceLanguage).filter(Boolean))].sort() as string[];

// Every field that is searched, joined once per entry.
const haystack = (e: (typeof entries)[number]) =>
  [e.id, e.title, e.originalText, e.language, e.literal, e.implied, e.setting, e.fidelity.sourceLanguage]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();

const mapping = [
  ['Moment ID', 'Entry ID (a new, de-identified ID, for example EX-012)'],
  ['Exact words (original language)', 'Original text'],
  ['Thick translation of the exact words (Tool 2 · Translate)', 'Literal meaning'],
  ['Participant’s explanation, once confirmed', 'Implied meaning'],
  ['Setting', 'Setting, generalized: no names, and no details that identify people'],
  ['Translation review flag, and who reviewed', 'The four Fidelity tags'],
  ['Sensitive to reuse', 'Sensitive flag'],
];
---

<ToolLayout
  slug="expression-library"
  intro="The digital, searchable home for validated meaning moments, once they have been digitized from Meaning Cards. Nothing in it is a design instruction. It is evidence."
>
  <section class="section" aria-labelledby="what">
    <div class="prose">
      <h2 id="what">What goes in it</h2>
      <p>
        An entry is a meaning moment that has passed the decision “is the meaning well supported?” in Tool 2 · Translate, with the
        participant’s identity removed. It records the original words, the literal meaning, the implied meaning, and the four{' '}
        <a href={url('/components/language/fidelity-protocol/')}>Fidelity Protocol</a> tags.
      </p>
      <p>
        Entries missing any tag can be stored, but they are labelled <strong>Needs re-check</strong> and cannot carry full
        confidence. Design patterns cite entries from this library, so weak evidence is visible to anyone who follows the trail.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="browse">
    <div class="section-head">
      <h2 id="browse">Browse the library</h2>
    </div>
    {hasSample && <SampleBanner />}

    <form class="filters card" id="filters" role="search" aria-label="Filter Expression Library entries" onsubmit="return false">
      <label class="grow">
        <span>Search</span>
        <input type="search" id="q" placeholder="Search original text, meanings, settings…" />
      </label>
      <label>
        <span>Language</span>
        <select id="f-lang">
          <option value="">All languages</option>
          {languages.map((l) => <option value={l}>{l}</option>)}
        </select>
      </label>
      <label>
        <span>Rendering</span>
        <select id="f-render">
          <option value="">Any rendering</option>
          {Object.entries(RENDERINGS).map(([k, v]) => <option value={k}>{v}</option>)}
        </select>
      </label>
      <label>
        <span>Confidence</span>
        <select id="f-conf">
          <option value="">Any</option>
          <option value="full">Full confidence</option>
          <option value="recheck">Needs re-check</option>
        </select>
      </label>
      <label>
        <span>Relevant lens</span>
        <select id="f-lens">
          <option value="">Any lens</option>
          {Object.entries(lensNames).map(([k, v]) => <option value={k}>{k} · {v}</option>)}
        </select>
      </label>
    </form>

    <p class="count" id="count" role="status" aria-live="polite">{entries.length} of {entries.length} entries</p>

    <div class="list" id="list">
      {
        entries.map((e) => (
          <article
            class="card entry"
            id={e.id}
            data-search={haystack(e)}
            data-lang={e.fidelity.sourceLanguage ?? ''}
            data-render={e.fidelity.rendering ?? ''}
            data-conf={e.assessment.full ? 'full' : 'recheck'}
            data-lens={e.lenses.join(' ')}
          >
            <header>
              <div>
                <p class="id">
                  {e.id}
                  {e.sample && <span class="chip chip--warn">Sample</span>}
                  {e.sensitive && <span class="chip chip--bad">Sensitive to reuse</span>}
                </p>
                <h3>{e.title}</h3>
              </div>
              <span class:list={['chip', e.assessment.full ? 'chip--ok' : 'chip--warn']}>
                {e.assessment.full ? 'Full confidence' : 'Needs re-check'}
              </span>
            </header>

            <blockquote lang="hi-Latn">{e.originalText}</blockquote>
            <p class="lang">{e.language}</p>

            <dl>
              <div>
                <dt>Literal meaning</dt>
                <dd>{e.literal}</dd>
              </div>
              <div>
                <dt>Implied meaning</dt>
                <dd>{e.implied}</dd>
              </div>
              <div>
                <dt>Setting</dt>
                <dd>{e.setting}</dd>
              </div>
            </dl>

            <div class="tags">
              <h4>Fidelity tags</h4>
              <ul>
                <li>
                  <b>Source language</b>
                  {e.fidelity.sourceLanguage ?? <em>not recorded</em>}
                </li>
                <li>
                  <b>Who interpreted</b>
                  {e.fidelity.interpreter ? INTERPRETERS[e.fidelity.interpreter] : <em>not recorded</em>}
                </li>
                <li>
                  <b>Rendering</b>
                  {e.fidelity.rendering ? RENDERINGS[e.fidelity.rendering] : <em>not recorded</em>}
                </li>
                <li>
                  <b>Second reading</b>
                  {e.fidelity.singleSource == null ? (
                    <em>not checked</em>
                  ) : e.fidelity.singleSource ? (
                    'Rests on one person alone'
                  ) : (
                    'A second reader agrees'
                  )}
                </li>
              </ul>
              {!e.assessment.full && (
                <ul class="gaps">
                  {e.assessment.gaps.map((g) => (
                    <li>{g}</li>
                  ))}
                </ul>
              )}
            </div>

            <footer>
              <span class="lbl">Relevant lenses</span>
              {e.lenses.map((l) => <span class="chip chip--solid">{l} · {lensNames[l]}</span>)}
              {
                e.citedBy.length > 0 && (
                  <>
                    <span class="lbl">Cited by</span>
                    {e.citedBy.map((id) => (
                      <a class="chip" href={url(`/components/language/design-language-library/#${id}`)}>
                        {id}
                      </a>
                    ))}
                  </>
                )
              }
            </footer>
          </article>
        ))
      }
    </div>

    <p class="empty" id="empty" hidden>No entries match. Try clearing a filter.</p>
  </section>

  <section class="section" aria-labelledby="digitize">
    <div class="section-head">
      <h2 id="digitize">Digitizing a Meaning Card</h2>
      <p>Once a card has passed the Fidelity Protocol, it becomes an entry. The fields carry across like this.</p>
    </div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Table: scroll sideways to see every column">
      <table>
        <thead>
          <tr>
            <th scope="col">On the Meaning Card</th>
            <th scope="col">In the Expression Library</th>
          </tr>
        </thead>
        <tbody>
          {mapping.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="after">
      De-identify before you digitize: remove names, and generalize places and details that could identify a participant or their
      family. Cards flagged <em>sensitive to reuse</em> keep that flag. To add an entry to this site, fill in the JSON template and
      follow the README.
    </p>
  </section>
</ToolLayout>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement;
  const q = $('q');
  const lang = $('f-lang');
  const render = $('f-render');
  const conf = $('f-conf');
  const lens = $('f-lens');
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const items = [...document.querySelectorAll<HTMLElement>('#list .entry')];

  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const el of items) {
      const d = el.dataset;
      const ok =
        (!term || (d.search ?? '').includes(term)) &&
        (!lang.value || d.lang === lang.value) &&
        (!render.value || d.render === render.value) &&
        (!conf.value || d.conf === conf.value) &&
        (!lens.value || (d.lens ?? '').split(' ').includes(lens.value));
      el.hidden = !ok;
      if (ok) shown += 1;
    }
    count.textContent = `${shown} of ${items.length} entries`;
    empty.hidden = shown !== 0;
  }

  for (const el of [q, lang, render, conf, lens]) {
    el.addEventListener('input', apply);
  }

  // A link like #EX-002 must show its entry even if a filter hides it.
  function revealHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id && items.find((el) => el.id === id);
    if (target && target.hidden) {
      q.value = '';
      for (const s of [lang, render, conf, lens]) s.value = '';
      apply();
    }
    target?.scrollIntoView();
  }
  window.addEventListener('hashchange', revealHash);
  if (location.hash) revealHash();
</script>

<style>
  .filters {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    align-items: end;
    margin-bottom: var(--sp-2);
  }
  .filters .grow {
    grid-column: 1 / -1;
  }
  label span {
    display: block;
    font-weight: 600;
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-half);
  }
  input,
  select {
    width: 100%;
    font: inherit;
    font-size: var(--fs-ui);
    padding: var(--sp-1) var(--sp-1);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
  }
  .count {
    margin: 0 0 var(--sp-2);
    color: var(--ink-soft);
    font-size: var(--fs-ui);
  }
  .list {
    display: grid;
    gap: var(--sp-3);
  }
  .entry[hidden] {
    display: none;
  }
  .entry:target {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .entry header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .id {
    margin: 0 0 var(--sp-half);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink-soft);
  }
  .entry h3 {
    margin-bottom: var(--sp-1);
  }
  blockquote {
    margin: var(--sp-half) 0 var(--sp-half);
    padding: var(--sp-1) var(--sp-2);
    border-left: 4px solid var(--accent);
    background: var(--accent-tint);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-family: var(--font-head);
    font-size: var(--fs-body);
  }
  .lang {
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  dl {
    margin: 0 0 var(--sp-2);
    display: grid;
    gap: var(--sp-1);
  }
  dt {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  dd {
    margin: 0;
  }
  .tags {
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    padding: var(--sp-2) var(--sp-2);
    margin-bottom: var(--sp-2);
  }
  .tags h4 {
    margin: 0 0 var(--sp-1);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .tags ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-half) var(--sp-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    font-size: var(--fs-ui);
  }
  .tags li b {
    display: block;
    font-size: var(--fs-xs);
    color: var(--ink-soft);
  }
  .tags .gaps {
    display: block;
    margin-top: var(--sp-1);
    padding-top: var(--sp-1);
    border-top: 1px solid var(--line);
    padding-left: var(--sp-2);
    list-style: disc;
    color: var(--warn);
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1);
  }
  .lbl {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-right: var(--sp-half);
  }
  .lbl:not(:first-child) {
    margin-left: var(--sp-2);
  }
  .empty {
    padding: var(--sp-3);
    text-align: center;
    color: var(--ink-soft);
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--sp-1) var(--sp-2);
    border-bottom: 1px solid var(--line);
    min-width: 14rem;
  }
  thead th {
    background: var(--surface-2);
    font-size: var(--fs-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .after {
    max-width: var(--prose);
    margin-top: var(--sp-3);
  }
</style>
