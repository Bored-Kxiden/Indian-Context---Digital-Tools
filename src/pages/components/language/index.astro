---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import Section from '../../../components/Section.astro';
import GoalIndex from '../../../components/GoalIndex.astro';
import ProcessFlow from '../../../components/ProcessFlow.astro';
import ToolCard from '../../../components/ToolCard.astro';
import Icon from '../../../components/Icon.astro';
import { tools } from '../../../data/tools';
import { goalsByComponent } from '../../../data/goals';
import { componentById } from '../../../data/components';
import { url } from '../../../utils/url';

const comp = componentById['language'];

const problems = [
  {
    title: 'Meaning gets lost in translation',
    body: 'A phrase can shift with the language, the tone, the region, or the gesture that goes with it. Word-for-word translation keeps the words and drops the rest: rapport, tone, code-switching, and the gap between what someone says and what they mean.',
  },
  {
    title: 'Every finding looks equally certain',
    body: 'Nothing in a typical research pipeline marks whether a finding is what a person meant or one interpreter’s best guess. It travels with the same authority however many hops of translation or single-source judgment calls produced it.',
  },
  {
    title: 'Generic personas result',
    body: 'By the time a finding reaches a design team, meaning has quietly become approximation, and the interface gets built for an averaged, invented person rather than anyone real.',
  },
];

const applies = [
  'Public-service and civic platforms in any linguistically diverse country',
  'Healthcare intake and patient-facing tools used with immigrant or refugee populations',
  'Financial-inclusion products, banking apps, and lending platforms',
  'E-commerce, delivery, and logistics across dialect-rich regions',
  'Humanitarian and NGO field tools in crisis zones with no shared language',
  'Enterprise software used by distributed teams working in a second or third language',
  'Voice assistants, IVR systems, and chatbots deployed far outside the dialect they were trained on',
];
---

<ComponentLayout
  component="language"
  current="overview"
  title={comp.name}
  heading="Keep what people mean, not only what the words say."
  lead="Practical tools for capturing emotional and cultural meaning faithfully in cross-language field research, tagging how reliable each finding is, and carrying it through to interface wording that has actually been tested."
  description="Practical tools for capturing emotional and cultural meaning faithfully in cross-language field research, tagging how reliable each finding is, and carrying it through to interface wording that has actually been tested."
  chips={['Component 3', 'Meaning-to-Interface Toolkit']}
>
  <p slot="head" class="built">Built for research on first-generation Indian college students. Reusable for any cross-language qualitative research.</p>

  <Section id="goals" eyebrow="Start here" title="I want to…" tone="white">
    <p slot="lead" class="lead-text">Start with what you’re doing. Every tool works on its own.</p>
    <GoalIndex groups={goalsByComponent('c3')} variant="list" search={false} />
  </Section>

  <Section id="problem" eyebrow="The problem" title="Cross-language research loses exactly the thing that matters most." split>
    <p class="big">
      Run a conversation through a translator or transcriber once and the nuance is gone by the time it reaches a design team.
      Nobody downstream can tell what was meant from what was guessed.
    </p>
    <ol class="rows">
      {
        problems.map((p, i) => (
          <li>
            <span class="idx" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="process" eyebrow="The process" title="Three modules, an entry step, and a loop." tone="white">
    <p slot="lead" class="lead-text">
      Module 1 builds a picture of the setting. Module 2 captures meaning moments one person at a time. Module 3 turns raw moments
      into validated meaning, then into a tested design response. The last step feeds new questions back into Module 1, so the
      process compounds across research cycles.
    </p>
    <ProcessFlow />
    <p class="funnel">
      Not every Meaning Card travels all the way to a shipped pattern. Many surface something useful without further action, a
      smaller number justify a design hypothesis, and fewer still become tested, library-worthy patterns. A “not yet” or a “no” at
      a decision point is the toolkit doing its job.
    </p>
  </Section>

  <Section id="tools" eyebrow="Tools" title="The six tools, in the order you meet them" split>
    <div class="tool-rows">
      {tools.map((t, i) => <ToolCard tool={t} index={i + 1} />)}
    </div>
  </Section>

  <Section id="where" eyebrow="Where to use it" title="Not specific to one sector, or to India." tone="white" split>
    <div class="where">
      <div>
        <p class="big">
          The condition that makes this component necessary is simple: somewhere between the people building a product and the
          people using it, there is a language or meaning gap, and someone is bridging it by guesswork rather than a documented
          method.
        </p>
        <p class="big">
          The common thread is a research or design team on one side of a language boundary and real users on the other, with no
          method in place for checking whether meaning crossed.
        </p>
        <a class="link-arrow" href={url('/components/language/methodology/')}>Read the methodology <Icon name="arrow" size={20} /></a>
      </div>
      <ul class="applies">
        {applies.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </Section>
</ComponentLayout>

<style>
  .built {
    color: var(--muted);
    font-size: var(--fs-ui);
    max-width: 44rem;
    margin: var(--sp-2) 0 0;
  }
  .big {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .rows {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    border-top: 2px solid var(--line-strong);
  }
  .rows li {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--line-strong);
  }
  .idx {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--c3);
    min-width: 1ch;
  }
  .rows h3 {
    margin-bottom: var(--sp-1);
  }
  .rows p {
    margin: 0;
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .funnel {
    max-width: 56rem;
    margin: var(--sp-4) 0 0;
    color: var(--ink-soft);
  }
  .tool-rows {
    border-top: 2px solid var(--line-strong);
  }
  .where {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    align-items: start;
  }
  .applies {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-1);
  }
  .applies li {
    margin: 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--ground);
    border: 1px solid var(--line-strong);
    border-left: 4px solid var(--c3);
    border-radius: var(--r-sm);
    font-size: var(--fs-ui);
  }
</style>
