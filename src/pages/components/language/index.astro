---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import PaperTop from '../../../components/file/PaperTop.astro';
import FileBasics from '../../../components/file/FileBasics.astro';
import PaperSection from '../../../components/file/PaperSection.astro';
import { overview, reverseThickTranslation as rtt } from '../../../data/booklet/language';
import { componentById } from '../../../data/components';
import { getDownloadById } from '../../../data/downloads';
import { bookletImage } from '../../../utils/assets';
import { url } from '../../../utils/url';

// File 05's overview, in the template's order and in plain words (D41, D42).
const comp = componentById['language'];
const pack = getDownloadById('pack-language')!;
const card = getDownloadById('meaning-card-template')!;
const t = (slug: string) => `${comp.href}${slug}/`;
const how = [
  { title: 'Before you start', meta: 'a few days', href: t('before-you-start'), body: 'Get to know the place and its languages first, with a local language collaborator.' },
  { title: 'Listen', meta: '60–90 min per person', href: t('listen'), body: 'Write down what people said, in their words, and what you think they meant.' },
  { title: 'Translate', meta: 'about 1 hour + a short survey', href: t('translate'), body: 'Translate with the meaning kept in, then check it the other way with 6–8 people from the same group.' },
  { title: 'Test', meta: '45 min + testing', href: t('test'), body: 'Try your interface wording with the people who will read it.' },
  { title: 'Library', meta: '20 min per entry', href: t('library'), body: 'Keep what worked, so the next team can use it.' },
  { title: 'The Kahavat Relay', meta: '10 min per person', href: t('kahavat-relay'), body: 'When words can’t reach a meaning, ask people to draw it. Use it inside Listen.' },
];
---

<ComponentLayout component="language" current="overview" title={comp.name} heading={comp.name} description={`${overview.lead} ${overview.thick.body}`}>
  <PaperTop slot="top" image={bookletImage('3.10')} alt="The Translate worksheet from the booklet, filled in with Meera’s example." caption="Meera’s thick translation · booklet p.3.10" text={comp.blurb}>
    <Fragment slot="buttons">
      <a class="btn btn--sm" href={url(pack.href)} download>Download PDF ↓</a>
      <a class="btn btn--sm btn--outline" href={url(card.href)} download>Meaning Card ↓</a>
    </Fragment>
  </PaperTop>

  <FileBasics
    comp={comp}
    facts={['A few days', '5 tools', 'With a local language collaborator']}
    notes={[
      { kind: 'Printable worksheets', format: `PDF · ${pack.pages} pages`, title: 'Print and fill in', action: 'download PDF ↓', href: pack.href, tone: 'yellow', download: true },
      { kind: 'Digital worksheet', format: 'On screen', title: 'Fill Meaning Cards here', action: 'fill on screen →', href: `${t('meaning-card')}#fill`, tone: 'pink' },
      { kind: 'One card per moment', format: 'PDF · card', title: 'The Meaning Card', action: 'download ↓', href: card.href, tone: 'teal', download: true },
    ]}
    why={[
      'People rarely mean exactly what their words say. A phrase can mean something else depending on the language, the tone, the region or a gesture. Translate word for word and you lose all of that.',
      'This file keeps the meaning with the words, and checks it with people in both directions before any of it reaches a screen.',
    ]}
    how={how}
  >
    <p slot="why" class="cover">
      <span>The words say <b>{overview.cover.literal}</b></span>
      <span>What was meant: <b>{overview.cover.meant}</b></span>
    </p>
    <p slot="how" class="note-line">You need consent to record, a recorder, a local language collaborator, and time to go back to people.</p>
  </FileBasics>

  <PaperSection id="reverse" title="Why check it both ways?">
    <p class="big">{rtt.line}</p>
    <p>
      Your first translation is only your reading. In <a href={url(`${t('translate')}#reverse`)}>reverse thick translation</a> you show the
      phrase to other people from the same group and ask what it means to them. A translation counts only once it has been checked in both
      directions.
    </p>
    <p>You end up with {overview.endProduct.charAt(0).toLowerCase() + overview.endProduct.slice(1)}</p>
  </PaperSection>

  <PaperSection id="where" title="Where can I use it?">
    <p>Anywhere a team and the people it designs for don’t share a language, and someone is bridging the gap by guesswork. For example:</p>
    <ul class="applies">
      {overview.applies.slice(0, 5).map((a) => <li>{a}</li>)}
    </ul>
    <p>It works with <a href={url('/components/visual-culture/')}>Reading Visual Culture</a>: words from photo talk-backs come here, and drawings from the Kahavat Relay go there.</p>
  </PaperSection>
</ComponentLayout>

<style>
  .cover {
    display: grid;
    gap: var(--sp-1);
    margin-top: var(--sp-3);
    background: var(--white);
    border: 1px solid var(--line);
    padding: var(--sp-2) var(--sp-3);
  }
  .cover b {
    font-weight: 600;
  }
  .note-line {
    margin-top: var(--sp-3);
  }
  .big {
    font-size: var(--fs-lead);
    font-style: italic;
  }
  .applies {
    padding-left: var(--sp-3);
  }
</style>
