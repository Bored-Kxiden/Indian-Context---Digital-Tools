---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import Section from '../../../components/Section.astro';
import PageFigure from '../../../components/PageFigure.astro';
import DownloadCard from '../../../components/DownloadCard.astro';
import Icon from '../../../components/Icon.astro';
import { beforeYouStart } from '../../../data/booklet/material-reality';
import { getDownloadById } from '../../../data/downloads';
import { bookletImage } from '../../../utils/assets';
import { url } from '../../../utils/url';

const s1 = beforeYouStart.step1;
const s2 = beforeYouStart.step2;
const strip = getDownloadById('tpl-journey-strip');
---

<ComponentLayout
  component="material-reality"
  current="before-you-start"
  title="Before you start"
  heading="Before you start"
  lead="Two things to have on the table before Tool 1 · Build."
  chips={['Component 4', 'Before Tool 1']}
  crumb="Before you start"
>
  <Section id="journey" eyebrow="Step 1" title={s1.title}>
    <p slot="lead" class="lead-text">{s1.lead}</p>
    <div class="cols">
      <div class="left">
        <div class="two">
          <div class="card">
            <h3>{s1.alreadyHave.title}</h3>
            <p>{s1.alreadyHave.body}</p>
            <ul class="links">
              {
                s1.alreadyHave.links.map((l) => (
                  <li>
                    {l.href ? (
                      <a href={l.href} rel="noopener">
                        {l.label} <Icon name="arrow" size={16} />
                      </a>
                    ) : (
                      <span>{l.label}</span>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="card card--tint">
            <h3>{s1.newToThis.title}</h3>
            <p>{s1.newToThis.body}</p>
            <p class="note-line">{s1.newToThis.note}</p>
          </div>
        </div>
        {strip && <DownloadCard item={strip} />}
      </div>
      <PageFigure image={bookletImage(s1.image)} alt={s1.alt} caption={`Booklet ${s1.printed}. The top strip is the example; fill in the blank one below it.`} />
    </div>
  </Section>

  <Section id="visual-toolkit" eyebrow="Step 2" title={s2.title} tone="white">
    <p slot="lead" class="lead-text">{s2.lead}</p>
    <div class="cols">
      <div class="left">
        <ol class="steps-list narrow">
          {
            s2.steps.map((s, i) => (
              <li class="stp">
                <b>{i + 1}</b>
                <span>{s}</span>
              </li>
            ))
          }
        </ol>
        <div class="callout">
          <strong>{s2.isComponent2.title}</strong>
          <p>{s2.isComponent2.body}</p>
          <p><a href={url(s2.isComponent2.href)}>Open Component 2 · Reading Visual Culture</a></p>
        </div>
        <div class="callout">
          <strong>{s2.alsoBring.title}</strong>
          <p>{s2.alsoBring.body}</p>
        </div>
        <div class="callout callout--warn">
          <strong>{s2.noVisualToolkit.title}</strong>
          <p>{s2.noVisualToolkit.body}</p>
        </div>
        <p class="go">
          <a class="btn btn--accent" href={url('/components/material-reality/build/')}>
            Next: Tool 1 · Build <Icon name="arrow" size={20} />
          </a>
        </p>
      </div>
      <PageFigure image={bookletImage(s2.image)} alt={s2.alt} caption={s2.note} />
    </div>
  </Section>
</ComponentLayout>

<style>
  .cols {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .cols {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
  }
  .left {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
  }
  .two {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .card h3 {
    font-size: var(--fs-h4);
    margin-bottom: var(--sp-1);
  }
  .card p {
    color: var(--ink-soft);
  }
  .card--tint {
    background: var(--c4-tint);
    border-color: transparent;
  }
  .note-line {
    font-size: var(--fs-ui);
    margin: 0;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: var(--sp-1) 0 0;
    display: grid;
    gap: var(--sp-half);
  }
  .links li {
    margin: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-half);
    min-height: 32px;
  }
  .callout {
    margin: 0;
  }
  .callout p {
    margin: 0;
  }
  .narrow {
    max-width: var(--measure);
  }
  .go {
    margin: var(--sp-1) 0 0;
  }
</style>
