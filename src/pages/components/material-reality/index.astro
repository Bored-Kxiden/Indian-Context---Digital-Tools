---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import PaperTop from '../../../components/file/PaperTop.astro';
import FileBasics from '../../../components/file/FileBasics.astro';
import PaperSection from '../../../components/file/PaperSection.astro';
import Icon from '../../../components/Icon.astro';
import { overview } from '../../../data/booklet/material-reality';
import { componentById } from '../../../data/components';
import { getDownloadById } from '../../../data/downloads';
import { bookletImage } from '../../../utils/assets';
import { url } from '../../../utils/url';

// File 04's overview, in the template's order and in plain words (D41, D42).
const comp = componentById['material-reality'];
const pack = getDownloadById('pack-material-reality')!;
const strip = getDownloadById('tpl-journey-strip')!;
const t = (slug: string) => `${comp.href}${slug}/`;
const how = [
  { title: 'Before you start', href: t('before-you-start'), body: 'Draw the journey on a Journey Strip, and bring the photos from Reading Visual Culture.' },
  { title: 'Build', meta: '45 min', href: t('build'), body: 'List everything the task needs, and mark where it stops working for your person.' },
  { title: 'Break', meta: '45–60 min', href: t('break'), body: 'Find who fills each gap, and what happens when they can’t.' },
  { title: 'Weigh', meta: '30 min + desk time', href: t('weigh'), body: 'See what gets given up first, and how many people live like this.' },
  { title: 'Say', meta: '30 min', href: t('say'), body: 'Name the kind of problem, and write a short brief for the team.' },
  { title: 'Ask your participants', href: t('ask-your-participants'), body: 'Questions to ask, and how to ask them with consent and care.' },
];
---

<ComponentLayout component="material-reality" current="overview" title={comp.name} heading={comp.name}>
  <PaperTop slot="top" image={bookletImage('4.07')} alt="The Build worksheet from the booklet, filled in with Meera’s example." caption="Meera’s Build worksheet · booklet p.4.07" text={comp.blurb}>
    <Fragment slot="buttons">
      <a class="btn btn--sm" href={url(pack.href)} download>Download PDF ↓</a>
      <a class="btn btn--sm btn--outline" href={url(strip.href)} download>Journey Strip ↓</a>
    </Fragment>
  </PaperTop>

  <FileBasics
    comp={comp}
    facts={['2–4 hours', '4 tools', 'Paper']}
    notes={[
      { kind: 'Printable worksheets', format: `PDF · ${pack.pages} pages`, title: 'Print and fill in', action: 'download PDF ↓', href: pack.href, tone: 'yellow', download: true },
      { kind: 'Digital worksheet', format: 'On screen', title: 'Fill it here', action: 'open the Build tool →', href: `${t('build')}#fill`, tone: 'pink' },
      { kind: 'Start here', format: 'PDF · A4', title: 'The Journey Strip', action: 'download ↓', href: strip.href, tone: 'teal', download: true },
    ]}
    why={[overview.ideaLead, 'This file helps you stop asking “do they have it?” and start asking “can they really use it, and who or what do they lean on?”']}
    how={how}
  >
    <div slot="why" class="upload">
      <p class="lbl-s">{overview.simpleUpload.title}</p>
      <ul>
        {overview.simpleUpload.items.map((i) => <li>{i}</li>)}
      </ul>
    </div>
    <p slot="how" class="note-line">Short on time? Do Build and Break, then write a three-line brief (about an hour). With more time, do all four with participants.</p>
  </FileBasics>

  <PaperSection id="layers" title="What should I look for?">
    <p>Nine things around the screen that a product quietly assumes are there:</p>
    <ul class="layers">
      {
        overview.layers.map((l) => (
          <li>
            <Icon name={l.icon} size={24} />
            <b>{l.name}</b>
            <span>{l.blurb}</span>
          </li>
        ))
      }
    </ul>
  </PaperSection>
</ComponentLayout>

<style>
  .upload {
    margin-top: var(--sp-3);
    background: var(--white);
    border: 1px solid var(--line);
    padding: var(--sp-2) var(--sp-3);
  }
  .lbl-s {
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 var(--sp-1);
  }
  .upload ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .upload li {
    margin: 0;
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 2px 12px;
  }
  .note-line {
    margin-top: var(--sp-3);
  }
  .layers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--sp-2);
  }
  .layers li {
    margin: 0;
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 2px var(--sp-1);
    align-items: start;
  }
  .layers li :global(svg) {
    color: var(--accent-deep);
    grid-row: span 2;
  }
  .layers b {
    font-weight: 600;
  }
  .layers span {
    grid-column: 2;
    font-size: var(--fs-ui);
    color: var(--muted);
  }
</style>
