---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import GoalIndex from '../../../components/GoalIndex.astro';
import RouteList from '../../../components/RouteList.astro';
import Icon from '../../../components/Icon.astro';
import { overview, tools, beforeYouStart } from '../../../data/booklet/material-reality';
import { goalsByComponent } from '../../../data/goals';
import { componentById } from '../../../data/components';
import { url } from '../../../utils/url';

const comp = componentById['material-reality'];
const toolRoute = tools.map((t) => ({
  label: `${t.number} · ${t.name}`,
  href: `${comp.href}${t.slug}/`,
  blurb: t.question,
  time: t.time,
}));
const routes = [overview.routes.quick, overview.routes.deep];
---

<ComponentLayout
  component="material-reality"
  current="overview"
  title={comp.name}
  heading={comp.name}
  lead={comp.blurb}
  chips={['Component 4', '2–4 hours', 'Paper']}
>
  <section class="block" aria-labelledby="idea">
    <p class="eb">The idea</p>
    <h2 id="idea">Material reality.</h2>
    <p class="big">{overview.ideaLead}</p>
    <div class="callout">
      <strong>{overview.simpleUpload.title}</strong>
      <ul class="chip-row up">
        {overview.simpleUpload.items.map((i) => <li class="chip">{i}</li>)}
      </ul>
    </div>
    <p class="look">
      <span>{overview.lookPast.from}</span>
      <Icon name="arrow" size={22} />
      <b>{overview.lookPast.to}</b>
    </p>
  </section>

  <section class="block" aria-labelledby="c4-goals-h">
    <GoalIndex
      groups={goalsByComponent('c4')}
      lead="Start with what you want to find out. Every tool works on its own."
      search={false}
      showComponent={false}
      stack
      eyebrow="Start here"
      id="c4-goals"
      headingId="c4-goals-h"
    />
  </section>

  <section class="block" aria-labelledby="layers-h">
    <p class="eb">What to look for</p>
    <h2 id="layers-h">Nine layers around the screen.</h2>
    <ul class="layers">
      {
        overview.layers.map((l) => (
          <li>
            <span class="ic"><Icon name={l.icon} size={26} /></span>
            <b>{l.name}</b>
            <span>{l.blurb}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block" aria-labelledby="route-h">
    <p class="eb">The route</p>
    <h2 id="route-h">Four tools, in order.</h2>
    <p class="big">Start by mapping the journey. Then build, break, weigh and say.</p>
    <RouteList
      items={[
        { label: 'Before you start', href: `${comp.href}before-you-start/`, blurb: beforeYouStart.step1.title + ' Then bring the Visual Toolkit photos.' },
        ...toolRoute,
        { label: 'Ask your participants', href: `${comp.href}ask-your-participants/`, blurb: 'Field cards: questions, consent, care.' },
      ]}
    />
    <div class="routes">
      {
        routes.map((r) => (
          <div class="card">
            <b>{r.title}</b>
            <p>{r.body}</p>
          </div>
        ))
      }
    </div>
    <p class="small">The whole toolkit, in order: {overview.routes.all}</p>
    <a class="btn btn--accent" href={url(`${comp.href}before-you-start/`)}>
      Start with the Journey Strip <Icon name="arrow" size={18} />
    </a>
  </section>
</ComponentLayout>

<style>
  .big {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 44rem;
  }
  .up {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
  }
  .up li {
    margin: 0;
  }
  .look {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    margin: 1.5rem 0 0;
  }
  .look span {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }
  .look b {
    color: var(--c4);
  }
  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
  .layers li {
    margin: 0;
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius);
    background: var(--c4-tint);
  }
  .layers .ic {
    display: inline-flex;
    color: var(--c4);
    margin-bottom: 0.25rem;
  }
  .layers b {
    font-size: 1.1rem;
  }
  .layers li > span:last-child {
    color: var(--ink-soft);
    font-size: 0.93rem;
    line-height: 1.4;
  }
  .routes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin: 1.5rem 0 0;
  }
  .routes p {
    margin: 0.25rem 0 0;
    color: var(--ink-soft);
  }
  .small {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 1rem 0 1.5rem;
  }
</style>
