---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import Section from '../../../components/Section.astro';
import GoalIndex from '../../../components/GoalIndex.astro';
import RouteList from '../../../components/RouteList.astro';
import Icon from '../../../components/Icon.astro';
import { overview, tools, beforeYouStart } from '../../../data/booklet/material-reality';
import { goalsByComponent } from '../../../data/goals';
import { componentById } from '../../../data/components';
import { url } from '../../../utils/url';

const comp = componentById['material-reality'];
const toolRoute = tools.map((t) => ({
  label: `${t.number} · ${t.name}`,
  href: `${comp.href}${t.slug}/`,
  blurb: t.question,
  time: t.time,
}));
const routes = [overview.routes.quick, overview.routes.deep];
---

<ComponentLayout
  component="material-reality"
  current="overview"
  title={comp.name}
  heading={comp.name}
  lead={comp.blurb}
  chips={['Component 4', '2–4 hours', 'Paper']}
>
  <Section id="idea" eyebrow="The idea" title="Material reality." split>
    <p class="big">{overview.ideaLead}</p>
    <div class="callout">
      <strong>{overview.simpleUpload.title}</strong>
      <ul class="chip-row up" aria-label={overview.simpleUpload.title}>
        {overview.simpleUpload.items.map((i) => <li class="chip">{i}</li>)}
      </ul>
    </div>
    <p class="look">
      <span>{overview.lookPast.from}</span>
      <Icon name="arrow" size={24} />
      <b>{overview.lookPast.to}</b>
    </p>
  </Section>

  <Section id="goals" eyebrow="Start here" title="I want to…" tone="white">
    <p slot="lead" class="lead-text">Start with what you want to find out. Every tool works on its own.</p>
    <GoalIndex groups={goalsByComponent('c4')} variant="list" search={false} />
  </Section>

  <Section id="layers" eyebrow="What to look for" title="Nine layers around the screen." split>
    <ul class="layers">
      {
        overview.layers.map((l) => (
          <li>
            <span class="ic"><Icon name={l.icon} size={28} /></span>
            <b>{l.name}</b>
            <span>{l.blurb}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="route" eyebrow="The route" title="Four tools, in order." tone="white" split>
    <p class="big">Start by mapping the journey. Then build, break, weigh and say.</p>
    <RouteList
      items={[
        { label: 'Before you start', href: `${comp.href}before-you-start/`, blurb: beforeYouStart.step1.title + ' Then bring the Visual Toolkit photos.' },
        ...toolRoute,
        { label: 'Ask your participants', href: `${comp.href}ask-your-participants/`, blurb: 'Field cards: questions, consent, care.' },
      ]}
    />
    <div class="routes">
      {
        routes.map((r) => (
          <div class="card">
            <b>{r.title}</b>
            <p>{r.body}</p>
          </div>
        ))
      }
    </div>
    <p class="small">The whole toolkit, in order: {overview.routes.all}</p>
    <a class="btn btn--accent" href={url(`${comp.href}before-you-start/`)}>
      Start with the Journey Strip <Icon name="arrow" size={20} />
    </a>
  </Section>
</ComponentLayout>

<style>
  .big {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .up {
    list-style: none;
    padding: 0;
    margin: var(--sp-2) 0 0;
  }
  .up li {
    margin: 0;
  }
  .look {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
    font-size: var(--fs-h3);
    margin: var(--sp-4) 0 0;
  }
  .look span {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }
  .look b {
    color: var(--c4-deep);
  }
  .layers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .layers li {
    margin: 0;
    display: grid;
    gap: var(--sp-1);
    align-content: start;
    padding: var(--sp-3);
    border-radius: var(--r-md);
    background: var(--c4-tint);
  }
  .layers .ic {
    display: inline-flex;
    color: var(--c4-deep);
  }
  .layers b {
    font-size: var(--fs-h4);
  }
  .layers li > span:last-child {
    color: var(--ink-soft);
    font-size: var(--fs-ui);
    line-height: 1.45;
  }
  .routes {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin: var(--sp-4) 0 0;
  }
  .routes p {
    margin: var(--sp-half) 0 0;
    color: var(--ink-soft);
  }
  .small {
    font-size: var(--fs-ui);
    color: var(--muted);
    margin: var(--sp-2) 0 var(--sp-3);
  }
</style>
