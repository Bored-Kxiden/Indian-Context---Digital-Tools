---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import Section from '../../../components/Section.astro';
import PageFigure from '../../../components/PageFigure.astro';
import DownloadCard from '../../../components/DownloadCard.astro';
import Icon from '../../../components/Icon.astro';
import { participants } from '../../../data/booklet/material-reality';
import { getDownloadById } from '../../../data/downloads';
import { bookletImage } from '../../../utils/assets';

const dl = getDownloadById('tpl-participants');
---

<ComponentLayout
  component="material-reality"
  current="ask-your-participants"
  title={participants.title}
  heading={participants.title}
  lead={participants.lead}
  chips={['Reading Material Conditions', 'Field cards']}
  crumb={participants.title}
>
  <Section id="ask" eyebrow="Questions to ask" title="Four questions, one for each moment." split>
    <ul class="qs">
      {
        participants.cards.map((c) => (
          <li class="note note--yellow">
            <b>{c.tool}</b>
            <span>{c.text}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="consent" eyebrow={participants.consent.title} title="Say this before you start." tone="c4" split>
    <p class="consent">{participants.consent.text}</p>
  </Section>

  <Section id="care" eyebrow="Take care" title="Five reminders." split>
    <ul class="care">
      {participants.care.map((c) => <li><Icon name="check" size={22} /> {c}</li>)}
    </ul>
  </Section>

  <Section id="print" eyebrow="Print" title="The field cards." tone="white" split>
    <div class="fig">
      <PageFigure image={bookletImage(participants.image)} alt={participants.alt} caption={`Booklet ${participants.printed}`} />
      {dl && <DownloadCard item={dl} />}
    </div>
  </Section>
</ComponentLayout>

<style>
  .qs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .qs li {
    margin: 0;
    display: grid;
    gap: var(--sp-1);
    align-content: start;
    min-height: 144px;
    padding: var(--sp-3);
  }
  .qs b {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .qs span {
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.3;
  }
  .consent {
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 40rem;
  }
  .care {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-2);
    max-width: var(--measure);
  }
  .care li {
    display: flex;
    gap: var(--sp-2);
    align-items: flex-start;
    margin: 0;
    font-size: var(--fs-lead);
    font-weight: 600;
  }
  .care :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--c4-deep);
  }
  .fig {
    display: grid;
    gap: var(--sp-2);
    max-width: 48rem;
  }
</style>
