---
import ComponentLayout from '../../../layouts/ComponentLayout.astro';
import PageFigure from '../../../components/PageFigure.astro';
import DownloadCard from '../../../components/DownloadCard.astro';
import Icon from '../../../components/Icon.astro';
import { participants } from '../../../data/booklet/material-reality';
import { getDownloadById } from '../../../data/downloads';
import { bookletImage } from '../../../utils/assets';

const dl = getDownloadById('tpl-participants');
---

<ComponentLayout
  component="material-reality"
  current="ask-your-participants"
  title={participants.title}
  heading={participants.title}
  lead={participants.lead}
  chips={['Component 4', 'Field cards']}
  crumb={participants.title}
>
  <section class="block" aria-labelledby="ask-h">
    <p class="eb">Questions to ask</p>
    <h2 id="ask-h">Four questions, one for each moment.</h2>
    <ul class="qs">
      {
        participants.cards.map((c) => (
          <li class="note note--yellow">
            <b>{c.tool}</b>
            <span>{c.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block" aria-labelledby="consent-h">
    <p class="eb">{participants.consent.title}</p>
    <h2 id="consent-h">Say this before you start.</h2>
    <p class="consent">{participants.consent.text}</p>
  </section>

  <section class="block" aria-labelledby="care-h">
    <p class="eb">Take care</p>
    <h2 id="care-h">Five reminders.</h2>
    <ul class="care">
      {participants.care.map((c) => <li><Icon name="check" size={18} /> {c}</li>)}
    </ul>
  </section>

  <section class="block" aria-labelledby="print-h">
    <p class="eb">Print</p>
    <h2 id="print-h">The field cards.</h2>
    <div class="fig">
      <PageFigure image={bookletImage(participants.image)} alt={participants.alt} caption={`Booklet ${participants.printed}`} />
      {dl && <DownloadCard item={dl} />}
    </div>
  </section>
</ComponentLayout>

<style>
  .qs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .qs li {
    margin: 0;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    min-height: 8rem;
  }
  .qs b {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .qs span {
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .consent {
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 600;
    line-height: 1.35;
    background: var(--c4);
    color: #fff;
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
    max-width: 44rem;
    margin: 0;
  }
  .care {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
    max-width: 44rem;
  }
  .care li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .care :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--c4);
  }
  .fig {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }
</style>
