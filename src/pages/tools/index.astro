---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GoalIndex from '../../components/GoalIndex.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
import { url } from '../../utils/url';
---

<BaseLayout
  title="Tools"
  description="Practical tools for cross-language field research: Meaning Card, Physical Field Kit, Fidelity Protocol, Language Lens Audit, Expression Library, and Design Language Library."
>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Tools</p>
      <h1>Find the tool for what you are doing.</h1>
      <p class="lede">
        Six tools pass meaning from the field to the interface. Meaning Cards are the raw material. The Fidelity Protocol decides
        which meanings are trustworthy enough to enter the Expression Library. Patterns in the Design Language Library cite those
        entries, and pass the Language Lens before they are trusted.
      </p>
    </div>
  </div>

  <div class="wrap body">
    <section class="section first" aria-labelledby="i-want-to-heading">
      <GoalIndex />
    </section>

    <section class="section" aria-labelledby="all-tools">
      <div class="section-head">
        <h2 id="all-tools">The six tools, in the order you meet them</h2>
      </div>
      <div class="grid grid--3">
        {tools.map((t, i) => <ToolCard tool={t} index={i + 1} />)}
      </div>
    </section>

    <section class="section">
      <div class="callout">
        <strong>Looking for the files?</strong>
        <p>
          Every printable and digital template is on the <a href={url('/downloads/')}>Downloads page</a>. The overall sequence is
          on the <a href={url('/#process')}>home page</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .body {
    padding-bottom: 2rem;
  }
  .first {
    border-top: 0;
  }
</style>
