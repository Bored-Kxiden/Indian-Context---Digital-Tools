---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { toolBySlug, toolGroups, tools } from '../../data/tools';
import { url } from '../../utils/url';

const number = (slug: string) => tools.findIndex((t) => t.slug === slug) + 1;
---

<BaseLayout
  title="Tools"
  description="The six tools of the Meaning-to-Interface Toolkit: Meaning Card, Physical Field Kit, Fidelity Protocol, Language Lens Audit, Expression Library, and Design Language Library."
>
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Tools</p>
      <h1>Six tools that pass meaning from the field to the interface.</h1>
      <p class="lede">
        Meaning Cards are the raw material. The Fidelity Protocol decides which meanings are trustworthy enough to enter the
        Expression Library. Patterns in the Design Language Library cite those entries, and pass the Language Lens before they are
        trusted.
      </p>
    </div>
  </div>

  <div class="wrap body">
    {
      toolGroups.map((g) => (
        <section class="section group" aria-labelledby={`g-${g.title.replace(/\W+/g, '-').toLowerCase()}`}>
          <div class="section-head">
            <h2 id={`g-${g.title.replace(/\W+/g, '-').toLowerCase()}`}>{g.title}</h2>
            <p>{g.note}</p>
          </div>
          <div class="grid grid--2">
            {g.slugs.map((s) => <ToolCard tool={toolBySlug[s]} index={number(s)} />)}
          </div>
        </section>
      ))
    }

    <section class="section">
      <div class="callout">
        <strong>Looking for the files?</strong>
        <p>
          Every printable and digital template is on the <a href={url('/downloads/')}>Downloads page</a>. The overall sequence is
          on the <a href={url('/#process')}>home page</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .body {
    padding-bottom: 2rem;
  }
  .group:first-child {
    border-top: 0;
  }
  .section-head {
    margin-bottom: 1.25rem;
  }
</style>
