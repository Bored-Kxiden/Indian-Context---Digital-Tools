---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import Icon from '../../components/Icon.astro';
import CentralLine from '../../components/CentralLine.astro';
import { afterTheToolkit, whyThisExists } from '../../data/booklet/shared';
import { site } from '../../data/site';
import { url } from '../../utils/url';
---

<BaseLayout title="About" description="Who the toolkit is for, what to do after it, and where it comes from.">
  <PageHead crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]} heading="About" lead={site.tagline} />

  <CentralLine id="central" />

  <Section id="for" eyebrow="Who it’s for" title={whyThisExists.title} split>
    <p class="big">{whyThisExists.body}</p>
    <ul class="chip-row made" aria-label="Made for">
      {whyThisExists.madeFor.map((m) => <li class="chip chip--quiet">{m}</li>)}
    </ul>
    <div class="card from">
      <p class="eb">Where it comes from</p>
      <p>
        {site.name} is a toolkit from <b>BITSDES 2024–28</b>. It is built in components: each one is a different way of reading the
        world a product will land in. Each works on its own.
      </p>
      <p>
        This site holds the components that are ready, with their guides, filled examples, blank templates and the card kit. More
        components will be added as they’re finished.
      </p>
      <p class="links">
        <a class="link-arrow" href={url('/components/')}>See the components <Icon name="arrow" size={20} /></a>
        <a class="link-arrow" href={url('/components/language/translate/#reverse')}>How translation is checked, both ways <Icon name="arrow" size={20} /></a>
      </p>
    </div>
  </Section>

  <Section id="after" eyebrow={afterTheToolkit.eyebrow} title={afterTheToolkit.title} tone="white" split>
    <ol class="after">
      {
        afterTheToolkit.steps.map((s, i) => (
          <li>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <span>{s}</span>
          </li>
        ))
      }
    </ol>
    <div class="callout callout--ink principle">
      <strong>{afterTheToolkit.formPrinciple.label}</strong>
      <p>{afterTheToolkit.formPrinciple.text}</p>
    </div>
  </Section>

  <Section id="read" eyebrow="Further reading" title="Work this toolkit leans on." split>
    <ul class="reading">
      {afterTheToolkit.furtherReading.map((r) => <li>{r}</li>)}
    </ul>
  </Section>

  <Section id="open" eyebrow="Open" title="The code is open." tone="white" split>
    <p class="big">
      The website’s code is on GitHub under the {site.licenseName} licence. The booklet’s closing invitation stands: write your own tool
      card, and share it back.
    </p>
    <p class="btns">
      <a class="btn btn--outline" href={site.repoUrl} rel="noopener">View on GitHub <Icon name="arrow" size={20} /></a>
      <a class="btn btn--accent" href={url('/downloads/')}><Icon name="download" size={20} /> Downloads</a>
    </p>
  </Section>
</BaseLayout>

<style>
  .big {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .made {
    list-style: none;
    padding: 0;
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .made li {
    margin: 0;
  }
  .from {
    max-width: 44rem;
  }
  .from p {
    color: var(--ink-soft);
  }
  .from .eb {
    color: var(--muted);
  }
  .links {
    display: grid;
    gap: var(--sp-1);
    margin: var(--sp-2) 0 0;
  }
  .after {
    list-style: none;
    margin: 0 0 var(--sp-4);
    padding: 0;
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .after li {
    margin: 0;
    display: flex;
    gap: var(--sp-2);
    align-items: flex-start;
    padding: var(--sp-3);
    border: 2px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--ground);
    font-weight: 600;
    font-size: var(--fs-body);
    line-height: 1.4;
  }
  .after .n {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-weight: 800;
  }
  .principle {
    max-width: 44rem;
  }
  .principle p {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.3;
  }
  .reading {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--line-strong);
    max-width: 44rem;
  }
  .reading li {
    margin: 0;
    padding: var(--sp-2) var(--sp-1);
    border-bottom: 1px solid var(--line-strong);
    font-size: var(--fs-lead);
    font-weight: 600;
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-3) 0 0;
  }
</style>
