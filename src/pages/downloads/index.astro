---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import Section from '../../components/Section.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import { getDownloads, getDownloadsByGroup } from '../../data/downloads';
import { site } from '../../data/site';

const all = getDownloads();
const booklet = getDownloadsByGroup('booklet');
const kit = getDownloadsByGroup('card-kit');
const kitMain = kit.filter((d) => ['card-kit-full', 'card-sheets', 'boards'].includes(d.id));
const kitEach = kit.filter((d) => !['card-kit-full', 'card-sheets', 'boards'].includes(d.id));
const templates = getDownloadsByGroup('templates');
const c1 = templates.filter((d) => d.component === 'c1');
const c2 = templates.filter((d) => d.component === 'c2');
const c3 = templates.filter((d) => d.component === 'c3');
const c4 = templates.filter((d) => d.component === 'c4');
const language = getDownloadsByGroup('language');
---

<BaseLayout
  title="Downloads"
  description="Every file in the toolkit: the booklet, the card kit, the blank templates and the language templates."
>
  <PageHead
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Downloads' }]}
    heading="Downloads"
    lead={`${all.length} files to print and fill in. The site’s code is under the ${site.licenseName} licence.`}
  >
    <nav slot="aside" class="jump" aria-label="On this page">
      <a href="#booklet">Booklet</a>
      <a href="#card-kit">Card kit</a>
      <a href="#templates">Blank templates</a>
      <a href="#language">Language field kit</a>
    </nav>
  </PageHead>

  <Section id="booklet" eyebrow="The whole toolkit, in two booklets" title="Booklets">
    <div class="grid grid--2 single">
      {booklet.map((d) => <DownloadCard item={d} />)}
    </div>
  </Section>

  <Section id="card-kit" eyebrow="Component 1 · Reading Existing Products" title="Card kit" tone="white">
    <p slot="lead" class="lead-text">Print the sheets on A4 card and the boards at A2, or copy a board onto chart paper.</p>
    <div class="grid grid--3" data-c="c1">
      {kitMain.map((d) => <DownloadCard item={d} />)}
    </div>
    <details class="each">
      <summary>One sheet or board at a time ({kitEach.length} files)</summary>
      <div class="rows">
        {kitEach.map((d) => <DownloadCard item={d} compact />)}
      </div>
    </details>
  </Section>

  <Section id="templates" eyebrow="One page each, A4" title="Blank templates">
    <p slot="lead" class="lead-text">Print the blank for a tool and fill it in for your person, or copy it onto a big sheet.</p>
    <h3 class="grp" data-c="c1">Component 1 · Reading Existing Products</h3>
    <div class="grid grid--3">
      {c1.map((d) => <DownloadCard item={d} />)}
    </div>
    <h3 class="grp" data-c="c2">Component 2 · Reading Visual Culture</h3>
    <div class="grid grid--3">
      {c2.map((d) => <DownloadCard item={d} />)}
    </div>
    <h3 class="grp" data-c="c3">Component 3 · Reading Language</h3>
    <div class="grid grid--3">
      {c3.map((d) => <DownloadCard item={d} />)}
    </div>
    <h3 class="grp" data-c="c4">Component 4 · Reading Material Reality</h3>
    <div class="grid grid--3">
      {c4.map((d) => <DownloadCard item={d} />)}
    </div>
  </Section>

  <Section id="language" eyebrow="Component 3 · Reading Language" title="Field cards and digital templates" tone="c3">
    <p slot="lead" class="lead-text">
      Print-ready cards for the field, and digital templates for moving validated moments into a spreadsheet or the Expression Library.
      Every card is 6 × 4 in (152 × 102 mm). Print at 100% (actual size), double-sided.
    </p>
    <div class="grid grid--2 lang">
      {language.map((d) => <DownloadCard item={d} />)}
    </div>
    <div class="callout callout--warn tips">
      <strong>Printing tips for the cards</strong>
      <ul>
        <li>Turn off “fit to page” and “scale to fit”. Cards should measure 6 × 4 in on paper.</li>
        <li>Choose double-sided printing. If the back of a card comes out upside down, switch between “flip on long edge” and “flip on short edge”.</li>
        <li>Print one card first to check front-to-back alignment. Use 200 to 300 gsm card stock for cards that will be handled in the field.</li>
        <li>Most print shops can cut or print 6 × 4 in stock, since it is the standard photo-print size.</li>
      </ul>
    </div>
    <div class="callout drafts">
      <strong>Drafts</strong>
      <p>
        Files marked Draft are working versions. Content and layout may change as the toolkit is tested in the field. If you use a
        draft in research, note the date you downloaded it.
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  @media (min-width: 64rem) {
    .jump {
      justify-content: flex-end;
    }
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    padding: 0 var(--sp-3);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    transition:
      background-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }
  .jump a:hover {
    background: var(--ink);
    color: #fff;
  }
  .single {
    max-width: 56rem;
  }
  .grp {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    font-size: var(--fs-h4);
    margin: var(--sp-5) 0 var(--sp-2);
    color: var(--ink);
  }
  .grp::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }
  .grp:first-of-type {
    margin-top: 0;
  }
  .each {
    margin-top: var(--sp-3);
    border: 2px solid var(--line-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    padding: var(--sp-2) var(--sp-3);
  }
  .each summary {
    cursor: pointer;
    font-weight: 700;
    min-height: 32px;
    display: flex;
    align-items: center;
  }
  .each[open] summary {
    margin-bottom: var(--sp-2);
  }
  .rows {
    display: grid;
    gap: var(--sp-1);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
  }
  .callout ul {
    margin: var(--sp-1) 0 0;
    padding-left: var(--sp-3);
  }
  /* On the terracotta block the language cards stay white, and the notes below them too */
  .lang {
    color: var(--ink);
  }
  .tips,
  .drafts {
    color: var(--ink);
    max-width: 56rem;
  }
</style>
