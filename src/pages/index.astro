---
import BaseLayout from '../layouts/BaseLayout.astro';
import VennHero from '../components/VennHero.astro';
import { files, fileNo } from '../data/components';
import { railFor } from '../data/rail';
import { url } from '../utils/url';

// The home page (D41, D44, D47): the kit's name and what it is for, "Start from the situation, not the default" with
// the circles, then the five files as a stack of folders (the "drawer" in the guide's tour).
// A folder opens when you point at it, tap its "Show what's inside" button, or reach it with the keyboard;
// one is open at a time, Reflection first. Without JavaScript every folder is simply open.
const lefts = ['2%', '22%', '40%', '12%', '30%'];
const stack = [...files].reverse().map((f) => ({
  ...f,
  left: lefts[f.file - 1],
  tools: railFor(f.id).items.filter((i) => !i.slug.startsWith('reflect-')),
}));
---

<BaseLayout theme="night">
  <section class="hero" aria-labelledby="hero-h">
    <h1 id="hero-h">Beyond the Edge Case</h1>
    <p class="sub">A toolkit for designing in Indian contexts by questioning the universal assumptions behind what gets treated as an exception.</p>
  </section>

  <section class="intro" aria-labelledby="intro-h">
    <div class="il">
      <h2 id="intro-h">Start from the situation, not the default.</h2>
      <div class="art">
        <VennHero />
      </div>
    </div>
    <div class="ir">
      <p>Design often begins with a default user, a default environment and a default way of doing things.</p>
      <p>
        But India rarely offers a single set of conditions from which that default can be safely assumed. Some of these conditions may appear
        unusual when measured against a universalised model of use. But unusual to the system does not necessarily mean unusual to the person.
      </p>
      <p><b data-no-tip>Beyond the Edge Case</b> is a toolkit for finding and investigating these situations before they are reduced to exceptions.</p>
      <div class="fromto">
        <p><span class="ft">From</span>“How do I accommodate this edge case?”</p>
        <p><span class="ft">To</span>“What made this an edge case in the first place?”</p>
      </div>
      <ul class="starts">
        <li><a class="link-more" href={url('/guideline/')}>How to use the kit →</a></li>
        <li><a class="link-more" href={url('/about/')}>Why the kit exists →</a></li>
      </ul>
    </div>
  </section>

  <section class="stack-wrap" aria-labelledby="files-h" data-tour="drawer">
    <h2 id="files-h" class="visually-hidden">The five files</h2>
    <ol class="stack" data-stack>
      {
        stack.map((f) => (
          <li class:list={['fold', { open: f.file === 1 }]} data-c={f.c} data-fold={f.id}>
            <a class="ftab" href={url(f.href)} style={`left:${f.left}`}>
              <svg viewBox="0 0 300 66" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0,66 C26,66 30,0 62,0 H238 C270,0 274,66 300,66 Z" />
              </svg>
              <span class="tno">{fileNo(f)}</span>
              <span>
                {f.name.startsWith('Reading ') && <span class="rd">Reading </span>}
                {f.name.replace('Reading ', '')}
              </span>
            </a>
            <div class="body">
              <button type="button" class="ftog" aria-expanded={f.file === 1 ? 'true' : 'false'} aria-controls={`fold-${f.id}`} data-fold-toggle>
                <span class="vs">“{f.verb}”</span>
                <span class="act">
                  <span class="act-open">Show what’s inside</span>
                  <span class="act-close">Hide</span>
                  <span class="chev" aria-hidden="true" />
                </span>
              </button>
              <div class="more" id={`fold-${f.id}`}>
                <div class="more-in">
                  <p class="plain">{f.blurb}</p>
                  <p class="tl">Its steps</p>
                  <ul class="tools">
                    {f.tools.map((t) => (
                      <li>
                        <a href={url(t.href)}>
                          {t.label}
                          {t.meta && <small>{t.meta}</small>}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="btn open-f" href={url(f.href)}>
                    Open file {fileNo(f)} →
                  </a>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

</BaseLayout>

<script>
  // Folders: one open at a time. Hover opens on devices that can hover; the button opens on tap, click or keyboard.
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  if (stack) {
    document.documentElement.classList.add('js-folders');
    const folds = [...stack.querySelectorAll<HTMLElement>('[data-fold]')];
    const set = (f: HTMLElement | null) =>
      folds.forEach((x) => {
        const on = x === f;
        x.classList.toggle('open', on);
        x.querySelector('[data-fold-toggle]')?.setAttribute('aria-expanded', String(on));
      });
    const canHover = matchMedia('(hover: hover) and (pointer: fine)');
    let timer = 0;
    folds.forEach((f) => {
      const b = f.querySelector<HTMLButtonElement>('[data-fold-toggle]');
      b?.addEventListener('click', () => set(f.classList.contains('open') ? null : f));
      f.addEventListener('mouseenter', () => {
        if (!canHover.matches) return;
        clearTimeout(timer);
        timer = window.setTimeout(() => set(f), 120);
      });
      f.addEventListener('focusin', (e) => {
        if ((e.target as HTMLElement).closest('.more')) set(f);
      });
    });
    stack.addEventListener('mouseleave', () => clearTimeout(timer));
    // The guide's tour opens a folder to show how peeking works.
    document.addEventListener('bte:fold', (e) => set(folds.find((f) => f.dataset.fold === (e as CustomEvent<string>).detail) ?? null));
  }
</script>

<style>
  /* ---------- Hero: the kit's name, big and centred (v3) ---------- */
  .hero {
    padding: clamp(var(--sp-8), 8vw, 110px) var(--gutter) clamp(var(--sp-6), 6vw, 80px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero h1 {
    width: 100%;
    text-wrap: balance;
    font-size: clamp(3.5rem, 0.6rem + 10.5vw, 11.875rem);
    line-height: 0.92;
    letter-spacing: -0.005em;
    color: var(--on-night);
    margin: 0;
  }
  .sub {
    font-size: clamp(1.25rem, 0.9rem + 1.2vw, 1.75rem);
    line-height: 1.45;
    color: var(--on-night-soft);
    max-width: 56rem;
    margin: var(--sp-4) 0 0;
    text-wrap: pretty;
  }

  /* ---------- Start from the situation: heading and circles left, the words right ---------- */
  .intro {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--gutter) var(--sp-2);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-5);
    align-items: start;
    color: var(--on-night);
    --focus: #fff;
  }
  @media (min-width: 56rem) {
    .intro {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 60px;
    }
  }
  .intro h2 {
    font-family: var(--font-cover);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2.25rem, 1.2rem + 3vw, 3.75rem);
    line-height: 1;
    margin: 0;
    color: var(--on-night);
  }
  .art {
    display: flex;
    justify-content: center;
    margin-top: var(--sp-5);
  }
  .ir {
    font-size: clamp(1.1875rem, 1rem + 0.6vw, 1.4375rem);
    line-height: 1.5;
    color: var(--on-night-soft);
    text-wrap: pretty;
  }
  .ir p {
    margin: 0 0 var(--sp-2);
  }
  .ir b {
    color: var(--on-night);
    font-weight: 500;
  }
  .fromto {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 20px;
    margin-top: var(--sp-2);
    font-style: italic;
    color: var(--on-night);
  }
  .fromto p {
    margin: 0;
  }
  .ft {
    display: block;
    font-family: var(--font-ui);
    font-style: normal;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-night-soft);
    margin-bottom: 6px;
  }
  .starts {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-3);
  }
  .starts li {
    margin: 0;
  }
  .link-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--on-night);
    text-underline-offset: 4px;
  }

  /* ---------- The stack of folders ---------- */
  .stack-wrap {
    max-width: 137.5rem;
    margin: 0 auto;
    padding: calc(62px + clamp(var(--sp-6), 6vw, 90px)) var(--gutter) 0;
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fold {
    position: relative;
    margin: 0;
    color: var(--accent-ink);
    --focus: currentColor;
  }
  .ftab {
    position: absolute;
    bottom: 100%;
    height: 62px;
    padding: 0 clamp(var(--sp-4), 4vw, 60px);
    margin-bottom: -2px;
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    color: inherit;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.125rem, 1.8vw, 1.625rem);
    white-space: nowrap;
    text-decoration: none;
    z-index: 1;
  }
  .ftab svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--accent);
  }
  .ftab span {
    position: relative;
  }
  .tno {
    font-family: var(--font-ui);
    font-size: 0.8em;
    font-weight: 800;
    opacity: 0.85;
  }
  .ftab:hover > span:last-child {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }
  .body {
    position: relative;
    background: var(--accent);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    padding: var(--sp-2) clamp(var(--sp-2), 4vw, 56px) calc(62px + var(--sp-3));
    box-shadow: 0 -10px 24px -18px rgb(0 0 0 / 0.6);
    transition: filter var(--t-med) var(--ease);
  }
  .fold:hover .body,
  .fold:hover .ftab svg {
    filter: brightness(1.06);
  }
  .fold:last-child .body {
    padding-bottom: var(--sp-5);
  }
  .ftog {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
    width: 100%;
    min-height: 48px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .vs {
    font-style: italic;
    font-weight: 400;
    font-size: var(--fs-lead);
  }
  .act {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-height: 40px;
    padding: 0 var(--sp-2);
    border: 2px solid currentColor;
    border-radius: 999px;
    font-weight: 800;
    font-size: var(--fs-sm);
  }
  .ftog:hover .act {
    background: rgb(255 255 255 / 0.16);
  }
  [data-c='c3'] .ftog:hover .act {
    background: rgb(27 27 27 / 0.1);
  }
  .chev {
    width: 10px;
    height: 10px;
    border-right: 2.5px solid currentColor;
    border-bottom: 2.5px solid currentColor;
    transform: rotate(45deg) translateY(-3px);
    transition: transform var(--t-med) var(--ease);
  }
  .act-close {
    display: none;
  }
  .fold.open .act-open {
    display: none;
  }
  .fold.open .act-close {
    display: inline;
  }
  .fold.open .chev {
    transform: rotate(-135deg) translateY(-3px);
  }

  /* Opening: the folder's contents slide down (grid rows animate from 0 to their full height) */
  .more {
    display: grid;
    grid-template-rows: 1fr;
  }
  .more-in {
    min-height: 0;
    overflow: hidden;
  }
  :global(.js-folders) .more {
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--t-slow) var(--ease);
  }
  :global(.js-folders) .more-in {
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  :global(.js-folders) .fold.open .more {
    grid-template-rows: 1fr;
  }
  :global(.js-folders) .fold.open .more-in {
    opacity: 1;
  }
  :global(html:not(.js-folders)) .act {
    display: none;
  }
  .plain {
    margin-top: var(--sp-2) !important;
    font-size: var(--fs-body);
    max-width: 46rem;
    margin: 0 0 var(--sp-3);
  }
  .tl {
    margin: 0 0 var(--sp-1);
    font-weight: 800;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .tools {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .tools li {
    margin: 0;
  }
  .tools a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sp-1);
    min-height: 40px;
    padding: var(--sp-1) var(--sp-2);
    border: 2px solid currentColor;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    font-weight: 700;
  }
  .tools a:hover {
    background: rgb(255 255 255 / 0.16);
  }
  [data-c='c3'] .tools a:hover {
    background: rgb(27 27 27 / 0.1);
  }
  .tools small {
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .open-f {
    margin-bottom: var(--sp-1);
    background: var(--accent-ink);
    border-color: var(--accent-ink);
    color: var(--accent);
  }
  .open-f:hover {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
    color: var(--accent);
    opacity: 0.9;
  }
  [data-c='c3'] .open-f {
    color: var(--c3-tint);
  }
  @media (max-width: 47.99rem) {
    .ftab {
      left: 0 !important;
      padding: 0 var(--sp-3);
    }
  }
  /* Small phones: "Reading" drops from the tab so the name fits */
  @media (max-width: 30rem) {
    .rd {
      display: none;
    }
  }
  @media (max-width: 47.99rem) {
    .act-open {
      font-size: 0;
    }
    .act-open::after {
      content: 'Show';
      font-size: var(--fs-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .more,
    .more-in,
    .ftab {
      transition: none !important;
    }
  }
</style>
