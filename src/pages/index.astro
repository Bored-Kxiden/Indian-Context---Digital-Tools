---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Section from '../components/Section.astro';
import VennHero from '../components/VennHero.astro';
import GoalIndex from '../components/GoalIndex.astro';
import ComponentCards from '../components/ComponentCards.astro';
import EdgeIntro from '../components/EdgeIntro.astro';
import CentralLine from '../components/CentralLine.astro';
import { goals } from '../data/goals';
import { site } from '../data/site';
import { whyThisExists, howToRead, guideline, meera } from '../data/booklet/shared';
import { url } from '../utils/url';

const ways = howToRead.everyTool.parts;
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero-grid">
      <div class="copy">
        <div class="chip-row rise" style="--i: 0">
          <span class="chip chip--quiet">Toolkit</span>
          <span class="chip chip--quiet">BITSDES 2024–28</span>
        </div>
        <h1 id="hero-h" class="rise" style="--i: 1">{site.name}</h1>
        <p class="lead rise" style="--i: 2">{site.tagline}</p>
        <div class="btn-row rise" style="--i: 3">
          <a class="btn" href="#i-want-to">Find your tool <Icon name="arrow" size={20} /></a>
          <a class="btn btn--outline" href="#components">Pick a component</a>
          <a class="btn btn--outline" href={url(site.bookletPdf)} download><Icon name="download" size={20} /> Booklet (PDF)</a>
        </div>
        <p class="free rise" style="--i: 4">Print it, run it with cards, or work straight from this site.</p>
      </div>
      <div class="art" aria-hidden="false">
        <VennHero />
      </div>
    </div>
  </section>

  <EdgeIntro />

  <CentralLine />

  <Section id="i-want-to" eyebrow="Start here" title="I want to…" tone="white">
    <p slot="lead" class="lead-text">
      Say what you’re trying to do and go straight to the tool. Every tool works on its own. Used in order, they build one picture.
    </p>
    <GoalIndex groups={goals} />
  </Section>

  <Section id="components" eyebrow="Components" title="Pick a way of reading.">
    <p slot="lead" class="lead-text">
      Each component works on its own. Used together, they give you a fuller picture of the person you’re designing for.
    </p>
    <ComponentCards />
  </Section>

  <Section id="why" eyebrow="Why this exists" title={whyThisExists.title} tone="white" split>
    <p class="big">{whyThisExists.body}</p>
    <ul class="chip-row made" aria-label="Made for">
      {whyThisExists.madeFor.map((m) => <li class="chip chip--quiet">{m}</li>)}
    </ul>
    <div class="quotes">
      <figure class="q q--without">
        <figcaption class="lbl">Without it</figcaption>
        <blockquote>{whyThisExists.without}</blockquote>
      </figure>
      <figure class="q q--with">
        <figcaption class="lbl">With it</figcaption>
        <blockquote>{whyThisExists.with}</blockquote>
      </figure>
    </div>
  </Section>

  <Section id="how" eyebrow="How every tool works" title="Read it, see it, do it." split>
    <ol class="ways">
      {
        ways.map((w, i) => (
          <li>
            <span class="idx" aria-hidden="true">{i + 1}</span>
            <div class="wt">
              <h3>{w.title.replace(/^\d · /, '')}</h3>
              <p>{w.body}</p>
            </div>
            <span class="wi" aria-hidden="true"><Icon name={w.icon} size={40} /></span>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="guideline" eyebrow={guideline.eyebrow} title={guideline.title} tone="ink" split>
    <p class="on-dark-body">{guideline.body}</p>
    <div class="gt">
      <div class="gt-good">
        <span class="lbl">Good</span>
        <ul>
          {guideline.good.map((g) => <li><Icon name="check" size={20} /> {g}</li>)}
        </ul>
      </div>
      <div class="gt-broad">
        <span class="lbl">Too broad</span>
        <ul>
          {guideline.tooBroad.map((g) => <li><Icon name="x" size={20} /> {g}</li>)}
        </ul>
      </div>
    </div>
    <a class="link-arrow light" href={url('/guideline/')}>Read the guideline <Icon name="arrow" size={20} /></a>
  </Section>

  <Section id="meera" eyebrow="The running example" title={meera.note} split>
    <div class="meera">
      <article class="card persona">
        <div class="head">
          <span class="avatar" aria-hidden="true">M</span>
          <div>
            <b>{meera.name}</b>
            <small>{meera.eyebrow}</small>
          </div>
        </div>
        <dl>
          {meera.facts.map((f) => <><dt>{f.k}</dt><dd>{f.v}</dd></>)}
        </dl>
      </article>
      <div class="story">
        <p class="big">{meera.useYourOwn.body}</p>
        <a class="btn btn--outline" href={url('/guideline/#meera')}>Read Meera’s story <Icon name="arrow" size={20} /></a>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(var(--sp-6), 6vw, var(--sp-12));
    border-bottom: 1px solid var(--line);
    overflow: clip;
  }
  .hero-grid {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--sp-8);
    }
  }
  .copy h1 {
    margin: var(--sp-4) 0 var(--sp-3);
    max-width: 14ch;
  }
  .copy .lead {
    margin-bottom: var(--sp-4);
    max-width: 36rem;
  }
  .free {
    margin: var(--sp-3) 0 0;
    color: var(--muted);
    font-size: var(--fs-ui);
  }
  .art {
    display: flex;
    justify-content: center;
  }

  .big {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: 44rem;
  }
  .made {
    list-style: none;
    padding: 0;
    margin: var(--sp-3) 0 var(--sp-5);
  }
  .made li {
    margin: 0;
  }
  .quotes {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .q {
    margin: 0;
    border-radius: var(--r-lg);
    padding: var(--sp-3) var(--sp-4);
  }
  .q blockquote {
    margin: var(--sp-1) 0 0;
    font-size: var(--fs-h3);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.005em;
  }
  .q--without {
    background: var(--ground);
    border: 2px solid var(--line-strong);
  }
  .q--with {
    background: var(--ink);
    color: #fff;
  }
  .q--with .lbl {
    color: rgb(255 255 255 / 0.85);
  }

  .ways {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }
  .ways li {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 2px solid var(--line-strong);
  }
  .idx {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    min-width: 1ch;
  }
  .wt h3 {
    margin: 0 0 var(--sp-half);
  }
  .wt p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 40rem;
  }
  .wi {
    display: inline-flex;
    color: var(--ink);
  }
  @media (max-width: 40rem) {
    .ways li {
      grid-template-columns: auto minmax(0, 1fr);
      padding: var(--sp-3);
    }
    .wi {
      display: none;
    }
    .idx {
      font-size: 3rem;
    }
  }

  .on-dark-body {
    color: var(--on-dark);
    font-size: var(--fs-lead);
    max-width: 44rem;
  }
  .gt {
    display: grid;
    gap: var(--sp-2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin: var(--sp-4) 0;
  }
  .gt-good,
  .gt-broad {
    border-radius: var(--r-lg);
    padding: var(--sp-3);
  }
  .gt-good {
    background: var(--surface);
    color: var(--ink);
  }
  .gt-good .lbl {
    color: var(--muted);
  }
  .gt-broad {
    background: #2a261e;
  }
  .gt .lbl {
    color: rgb(255 255 255 / 0.85);
    margin-bottom: var(--sp-1);
  }
  .gt ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-2);
  }
  .gt li {
    display: flex;
    gap: var(--sp-1);
    align-items: flex-start;
    margin: 0;
    font-weight: 600;
    line-height: 1.35;
  }
  .gt li :global(svg) {
    flex: none;
    margin-top: 2px;
  }
  .gt-broad li {
    color: var(--on-dark);
    font-weight: 500;
  }
  .link-arrow.light {
    color: #fff;
  }

  .meera {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }
  .persona .head {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-3);
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: var(--fs-h3);
  }
  .persona b {
    font-size: var(--fs-h4);
    display: block;
    line-height: 1.1;
  }
  .persona small {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .persona dl {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--sp-1) var(--sp-2);
    margin: 0;
  }
  .persona dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 4px;
  }
  .persona dd {
    margin: 0;
    font-weight: 600;
  }
  .story .btn {
    margin-top: var(--sp-1);
  }
</style>
