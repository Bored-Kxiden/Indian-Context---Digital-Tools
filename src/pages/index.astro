---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import VennHero from '../components/VennHero.astro';
import GoalIndex from '../components/GoalIndex.astro';
import ComponentCards from '../components/ComponentCards.astro';
import { goals } from '../data/goals';
import { site } from '../data/site';
import { whyThisExists, howToRead, guideline, meera } from '../data/booklet/shared';
import { url } from '../utils/url';
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="chip-row tags">
          <span class="chip chip--quiet">Toolkit</span>
          <span class="chip chip--quiet">BITSDES 2024–28</span>
        </div>
        <h1>Designing for the Indian Context</h1>
        <p class="lead">{site.tagline}</p>
        <div class="btn-row">
          <a class="btn" href="#i-want-to">Find your tool <Icon name="arrow" size={18} /></a>
          <a class="btn btn--outline" href="#components">Pick a component</a>
          <a class="btn btn--outline" href={url(site.bookletPdf)} download><Icon name="download" size={18} /> Booklet (PDF)</a>
        </div>
        <p class="free">Print it, run it with cards, or work straight from this site.</p>
      </div>
      <div class="art">
        <VennHero />
      </div>
    </div>
  </section>

  <section class="section section--white goals-section" aria-labelledby="i-want-to-heading">
    <div class="wrap">
      <GoalIndex
        groups={goals}
        lead="Find what you need and go to that tool. Every tool works on its own. Used in order, they build one picture."
      />
    </div>
  </section>

  <section class="section" id="components" aria-labelledby="components-heading">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eb">Components</p>
          <h2 id="components-heading">Pick a way of reading.</h2>
        </div>
        <p>Each component works on its own. Used together, they give you a fuller picture of the person you’re designing for.</p>
      </div>
      <ComponentCards />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="why-heading">
    <div class="wrap two">
      <div>
        <p class="eb">Why this exists</p>
        <h2 id="why-heading">{whyThisExists.title}</h2>
        <p class="bd">{whyThisExists.body}</p>
        <ul class="chip-row made">
          {whyThisExists.madeFor.map((m) => <li class="chip chip--quiet">{m}</li>)}
        </ul>
      </div>
      <div class="quotes">
        <div class="q q--without">
          <span class="lbl">Without it</span>
          <p>{whyThisExists.without}</p>
        </div>
        <div class="q q--with">
          <span class="lbl">With it</span>
          <p>{whyThisExists.with}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eb">How every tool works</p>
        <h2 id="how-heading">Read it, see it, do it.</h2>
      </div>
      <div class="grid grid--3 how">
        {
          howToRead.everyTool.parts.map((p, i) => (
            <article class={`how-card how-card--${i}`}>
              <span class="ico"><Icon name={p.icon} size={30} /></span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--ink guide" aria-labelledby="guide-heading">
    <div class="wrap two">
      <div>
        <p class="eb on-dark">{guideline.eyebrow}</p>
        <h2 id="guide-heading">Be specific. <br />One real person, one real thing.</h2>
        <p class="on-dark-body">{guideline.body}</p>
        <a class="link-arrow light" href={url('/guideline/')}>Read the guideline <Icon name="arrow" size={18} /></a>
      </div>
      <div class="gt">
        <div class="gt-good">
          <span class="lbl">Good</span>
          <ul>
            {guideline.good.map((g) => <li><Icon name="check" size={18} /> {g}</li>)}
          </ul>
        </div>
        <div class="gt-broad">
          <span class="lbl">Too broad</span>
          <ul>
            {guideline.tooBroad.map((g) => <li><Icon name="x" size={18} /> {g}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="meera-heading">
    <div class="wrap two meera">
      <article class="card persona">
        <div class="head">
          <span class="avatar" aria-hidden="true">M</span>
          <div>
            <b>{meera.name}</b>
            <small>{meera.eyebrow}</small>
          </div>
        </div>
        <dl>
          {meera.facts.map((f) => <><dt>{f.k}</dt><dd>{f.v}</dd></>)}
        </dl>
      </article>
      <div>
        <p class="eb">The running example</p>
        <h2 id="meera-heading">{meera.note}</h2>
        <p class="bd">{meera.useYourOwn.body}</p>
        <a class="btn btn--outline" href={url('/guideline/#meera')}>Read Meera’s story <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 62rem) {
    .hero-grid {
      grid-template-columns: 1.15fr 1fr;
    }
  }
  .tags {
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    margin-bottom: 1.25rem;
    max-width: 12ch;
  }
  .hero .lead {
    margin-bottom: 2rem;
  }
  .free {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .art {
    display: flex;
    justify-content: center;
  }
  .goals-section {
    border-top: 0;
  }
  .split {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 3rem;
  }
  .split p {
    max-width: 26rem;
    margin: 0;
  }
  .two {
    display: grid;
    gap: 2.5rem 4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    align-items: center;
  }
  .bd {
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 32rem;
  }
  .made {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .made li {
    margin: 0;
  }
  .quotes {
    display: grid;
    gap: 1rem;
  }
  .q {
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
  }
  .q p {
    margin: 0.4rem 0 0;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.35;
    font-weight: 600;
  }
  .q--without {
    background: var(--ground);
    border: 1px solid var(--line-strong);
  }
  .q--with {
    background: var(--c1);
    color: #fff;
  }
  .q--with .lbl {
    color: rgb(255 255 255 / 0.8);
  }
  .q--with p {
    font-weight: 700;
  }
  .how-card {
    border-radius: var(--radius);
    padding: 1.75rem;
    min-height: 15rem;
  }
  .how-card--0 { background: var(--ground); border: 1px solid var(--line-strong); }
  .how-card--1 { background: var(--c2-tint); }
  .how-card--2 { background: var(--c1-tint); }
  .how-card h3 {
    margin: 1.25rem 0 0.5rem;
  }
  .how-card p {
    margin: 0;
    color: var(--ink-soft);
  }
  .ico {
    display: inline-flex;
    color: var(--ink);
  }
  .how-card--2 .ico {
    color: var(--c1);
  }

  .guide h2 {
    color: #fff;
  }
  .on-dark {
    color: #b9b1a0;
  }
  .on-dark-body {
    color: var(--on-dark);
    font-size: 1.1rem;
    max-width: 30rem;
  }
  .link-arrow.light {
    color: #fff;
  }
  .gt {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .gt-good,
  .gt-broad {
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem;
  }
  .gt-good { background: var(--c1); }
  .gt-broad { background: #2a261e; }
  .gt .lbl {
    color: rgb(255 255 255 / 0.75);
    margin-bottom: 0.6rem;
  }
  .gt ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .gt li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0;
    font-weight: 600;
    line-height: 1.35;
  }
  .gt li :global(svg) {
    flex: none;
    margin-top: 0.15rem;
  }
  .gt-broad li {
    color: var(--on-dark);
    font-weight: 500;
  }

  .persona .head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .avatar {
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: var(--c2);
    color: var(--ink);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 1.5rem;
  }
  .persona b {
    font-size: 1.35rem;
    display: block;
    line-height: 1.1;
  }
  .persona small {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .persona dl {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.6rem 1rem;
    margin: 0;
  }
  .persona dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.3rem;
  }
  .persona dd {
    margin: 0;
    font-weight: 600;
  }
</style>
