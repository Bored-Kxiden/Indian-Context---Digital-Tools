---
import BaseLayout from '../layouts/BaseLayout.astro';
import { files, fileNo } from '../data/components';
import { url } from '../utils/url';

// The home page, as in the owner's v3 template (D47, D48): the kit's name, "Start from the situation, not the
// default", then the drawer: the five files as a stack of folders, 05 at the top and 01 at the bottom. Pointing at
// a folder (or reaching it with the keyboard) opens it to a preview and the others close; leaving the drawer goes
// back to Reflection. Clicking a folder opens its file. On touch screens the first tap opens the preview and the
// second opens the file. Without JavaScript, Reflection is open and every folder's tab is a link.
const lefts = ['1%', '20%', '38%', '10%', '28%'];
const stack = [...files].reverse().map((f) => ({ ...f, left: lefts[f.file - 1], num: fileNo(f) }));
---

<BaseLayout theme="night">
  <section class="hero" aria-labelledby="hero-h">
    <h1 id="hero-h">Beyond the Edge Case</h1>
    <p class="sub">A toolkit for designing in Indian contexts by questioning the universal assumptions behind what gets treated as an exception.</p>
  </section>

  <section class="intro" aria-labelledby="intro-h" data-no-tip>
    <h2 id="intro-h">Start from the situation, not the default.</h2>
    <div class="ir">
      <p>Design often begins with a default user, a default environment and a default way of doing things.</p>
      <p>
        But India rarely offers a single set of conditions from which that default can be safely assumed. Some of these conditions may appear
        unusual when measured against a universalised model of use. But unusual to the system does not necessarily mean unusual to the person.
      </p>
      <p><b>Beyond the Edge Case</b> is a toolkit for finding and investigating these situations before they are reduced to exceptions.</p>
      <div class="fromto">
        <p><span class="ft">From</span>“How do I accommodate this edge case?”</p>
        <p><span class="ft">To</span>“What made this an edge case in the first place?”</p>
      </div>
    </div>
  </section>

  <section class="drawer" aria-labelledby="files-h" data-tour="drawer" data-drawer>
    <h2 id="files-h" class="visually-hidden">The five files</h2>
    <ol class="stack">
      {
        stack.map((f) => (
          <li class:list={['fold', { on: f.file === 1 }]} data-c={f.c} data-fold={f.id} data-href={url(f.href)}>
            <a class="ftab" href={url(f.href)} style={`left:${f.left}`}>
              <svg viewBox="0 0 300 66" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0,66 C26,66 30,0 62,0 H238 C270,0 274,66 300,66 Z" />
              </svg>
              <span class="nm">{f.name}</span>
            </a>
            <div class="body" data-fold-body>
              <p class="row">
                <span>
                  Tool {f.num} — {f.tag}
                </span>
                <span class="chev" aria-hidden="true" />
              </p>
              <p class="pv">{f.blurb}</p>
              <a class="of" href={url(f.href)}>
                Open file {f.num} →
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<script>
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  if (drawer) {
    const folds = [...drawer.querySelectorAll<HTMLElement>('[data-fold]')];
    const first = folds.find((f) => f.dataset.fold === 'reflection') ?? folds[folds.length - 1];
    const set = (f: HTMLElement) => folds.forEach((x) => x.classList.toggle('on', x === f));
    const canHover = matchMedia('(hover: hover) and (pointer: fine)');
    folds.forEach((f) => {
      // Whether the folder was already open when the tap began (focus opens it before the click arrives).
      let wasOn = false;
      f.addEventListener('pointerdown', () => (wasOn = f.classList.contains('on')));
      f.addEventListener('mouseenter', () => canHover.matches && set(f));
      f.addEventListener('focusin', () => set(f));
      // A click anywhere on the folder opens its file; on a touch screen the first tap opens the preview.
      f.querySelector('[data-fold-body]')!.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        if (!canHover.matches && !wasOn) set(f);
        else location.href = f.dataset.href!;
      });
      f.querySelector('.ftab')!.addEventListener('click', (e) => {
        if (!canHover.matches && !wasOn && e.detail > 0) {
          e.preventDefault();
          set(f);
        }
      });
    });
    drawer.addEventListener('mouseleave', () => canHover.matches && set(first));
    // The guide's tour opens a folder to show how peeking works.
    document.addEventListener('bte:fold', (e) => {
      const f = folds.find((x) => x.dataset.fold === (e as CustomEvent<string>).detail);
      if (f) set(f);
    });
  }
</script>

<style>
  /* ---------- The kit's name, big and centred ---------- */
  .hero {
    padding: 110px 32px 80px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero h1 {
    width: 100%;
    text-wrap: balance;
    font-family: var(--font-cover);
    font-weight: 400;
    font-size: clamp(64px, 10.5vw, 190px);
    line-height: 0.92;
    margin: 0;
    text-transform: uppercase;
    color: #faf9f4;
    letter-spacing: -0.005em;
  }
  .sub {
    font-family: var(--font-read);
    font-size: clamp(20px, 1.9vw, 28px);
    line-height: 1.45;
    color: #8b8a86;
    max-width: 900px;
    margin: 30px 0 0;
    text-wrap: pretty;
  }

  /* ---------- Start from the situation ---------- */
  .intro {
    padding: 0 32px 20px;
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 60px;
    align-items: start;
    --focus: #fff;
  }
  .intro h2 {
    font-family: var(--font-cover);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(36px, 4vw, 60px);
    line-height: 1;
    margin: 0;
    color: #faf9f4;
  }
  .ir {
    font-family: var(--font-read);
    font-size: clamp(19px, 1.6vw, 23px);
    line-height: 1.5;
    color: #a9a8a3;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-wrap: pretty;
  }
  .ir p {
    margin: 0;
  }
  .ir b {
    color: #faf9f4;
    font-weight: 500;
  }
  .fromto {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 10px;
    font-style: italic;
    color: #faf9f4;
  }
  .ft {
    display: block;
    font-family: var(--font-ui);
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8b8a86;
    margin-bottom: 6px;
  }

  /* ---------- The drawer ---------- */
  .drawer {
    padding: 90px 32px 0;
    max-width: 2200px;
    margin: 0 auto;
  }
  .stack {
    list-style: none;
    margin: 66px 0 0;
    padding: 0;
  }
  .fold {
    position: relative;
    margin: 0;
    color: var(--accent-ink);
    --focus: currentColor;
  }
  .ftab {
    position: absolute;
    bottom: 100%;
    height: 66px;
    padding: 0 64px;
    display: flex;
    align-items: center;
    margin-bottom: -1px;
    color: inherit;
    font-family: var(--font-read);
    font-size: clamp(22px, 2.2vw, 34px);
    white-space: nowrap;
    text-decoration: none;
  }
  .ftab svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    fill: var(--accent);
  }
  .ftab .nm {
    position: relative;
    z-index: 1;
  }
  .ftab:hover {
    opacity: 0.85;
  }
  .body {
    background: var(--accent);
    height: 146px;
    border-radius: 4px 4px 0 0;
    overflow: hidden;
    cursor: pointer;
    padding: 24px 50px 0 90px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-family: var(--font-ui);
  }
  .fold.on .body {
    height: 396px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .body {
      transition: height 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .pv,
    .of {
      transition: opacity 0.4s;
    }
  }
  .row {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    font-size: 15px;
    white-space: nowrap;
    margin: 0;
  }
  .chev::before {
    content: '‹';
  }
  .fold.on .chev::before {
    content: '⌄';
  }
  .pv {
    font-size: 16px;
    line-height: 1.85;
    max-width: 780px;
    margin: 0;
    opacity: 0;
  }
  .of {
    align-self: flex-start;
    font-size: 13px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    opacity: 0;
  }
  .fold.on .pv,
  .fold.on .of,
  .of:focus-visible {
    opacity: 1;
  }

  /* ---------- Smaller screens ---------- */
  @media (max-width: 56rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
  @media (max-width: 48rem) {
    .hero {
      padding: 72px 16px 56px;
    }
    .intro,
    .drawer {
      padding-left: 16px;
      padding-right: 16px;
    }
    .drawer {
      padding-top: 64px;
    }
    .ftab {
      left: 0 !important;
      padding: 0 36px;
      font-size: 20px;
    }
    .body {
      padding: 20px 20px 0;
      gap: 16px;
    }
    .fold.on .body {
      height: 380px;
    }
    .row {
      justify-content: flex-start;
      font-size: 13px;
    }
    .pv {
      font-size: 15px;
      line-height: 1.7;
    }
  }
  @media (max-width: 30rem) {
    .fromto {
      grid-template-columns: 1fr;
    }
    .ftab {
      padding: 0 30px;
      font-size: 18px;
    }
  }
</style>
