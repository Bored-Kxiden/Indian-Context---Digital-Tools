---
import BaseLayout from '../layouts/BaseLayout.astro';
import { files, fileNo } from '../data/components';
import { railFor } from '../data/rail';
import { intro } from '../data/site';
import { url } from '../utils/url';

// The home page, from the owner's template (D41): the kit's name, one plain sentence, and the five files as a
// stack of folders. Pointing at (or tabbing into) a folder opens it to show what the file is for, its tools and
// a link into it; Reflection is open to begin with. On a phone every folder is open. No JavaScript needed.
const lefts = ['1%', '20%', '38%', '10%', '28%'];
const stack = [...files].reverse().map((f) => ({
  ...f,
  left: lefts[f.file - 1],
  tools: railFor(f.id).items.filter((i) => !i.slug.startsWith('reflect-')),
}));
---

<BaseLayout theme="night">
  <section class="hero" aria-labelledby="hero-h">
    <h1 id="hero-h">Beyond the Edge Case</h1>
    <p class="sub">
      A toolkit for designing in India. It helps you find the people a product treats as exceptions, and ask what made them exceptions
      in the first place.
    </p>
  </section>

  <section class="stack" aria-labelledby="files-h">
    <h2 id="files-h" class="visually-hidden">The five files of the kit</h2>
    <ol>
      {
        stack.map((f) => (
          <li class:list={['fold', { first: f.file === 1 }]} data-c={f.c}>
            <a class="ftab" href={url(f.href)} style={`left:${f.left}`}>
              <svg viewBox="0 0 300 66" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0,66 C26,66 30,0 62,0 H238 C270,0 274,66 300,66 Z" />
              </svg>
              <span>{f.name}</span>
            </a>
            <div class="body">
              <p class="top">
                <span>
                  File {fileNo(f)} — {f.short}
                </span>
                <span class="chev" aria-hidden="true" />
              </p>
              <div class="more">
                <p class="verb">“{f.verb}”</p>
                <p class="plain">{f.plain}</p>
                <ul class="tools" aria-label={`Tools in ${f.name}`}>
                  {f.tools.map((t) => (
                    <li>
                      <a href={url(t.href)}>
                        {t.label}
                        {t.meta && <small>{t.meta}</small>}
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="open" href={url(f.href)}>
                  Open file {fileNo(f)} →
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="idea" aria-labelledby="idea-h">
    <h2 id="idea-h">{intro.central}</h2>
    <p>
      Design often starts from one default user. In India, one person may use the same product across different languages, networks,
      budgets and kinds of help. Unusual to the system is not unusual to the person. <a href={url('/about/')}>Why the kit exists</a>
    </p>
    <ul class="starts">
      <li><a href={url('/components/reflection/')}>Start with File 01: Reflection</a></li>
      <li><a href={url('/components/')} data-finder-open>Find a tool for a job</a></li>
      <li><a href={url('/guideline/')}>How to use the kit</a></li>
      <li><a href={url('/ask/')} data-ask-open>Ask the toolkit a question</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(var(--sp-10), 9vw, 110px) var(--gutter) clamp(var(--sp-8), 6vw, 80px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero h1 {
    width: 100%;
    font-size: clamp(3.5rem, 10.5vw, 11.875rem);
    line-height: 0.92;
    color: var(--on-night);
    margin: 0;
    max-width: none;
  }
  .sub {
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    line-height: 1.45;
    color: var(--on-night-soft);
    max-width: 56rem;
    margin: var(--sp-4) 0 0;
  }

  /* ---------- The stack of folders ---------- */
  .stack {
    padding: clamp(var(--sp-10), 6vw, 90px) var(--gutter) 0;
    max-width: 2200px;
    margin: 0 auto;
  }
  .stack ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fold {
    position: relative;
    margin: 0;
    color: var(--accent-ink);
    --focus: currentColor;
  }
  .fold + .fold {
    margin-top: 66px;
  }
  .ftab {
    position: absolute;
    bottom: 100%;
    height: 66px;
    padding: 0 clamp(var(--sp-4), 4vw, 64px);
    margin-bottom: -1px;
    display: flex;
    align-items: center;
    color: inherit;
    font-family: var(--font-read);
    font-size: clamp(1.25rem, 2.2vw, 2.125rem);
    white-space: nowrap;
    text-decoration: none;
    z-index: 1;
  }
  .ftab svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--accent);
  }
  .ftab span {
    position: relative;
  }
  .ftab:hover span {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
  .body {
    position: relative;
    background: var(--accent);
    border-radius: var(--r-md) var(--r-md) 0 0;
    padding: var(--sp-3) clamp(var(--sp-3), 3.5vw, 50px) var(--sp-4) clamp(var(--sp-3), 6vw, 90px);
  }
  .top {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 15px;
  }
  .chev::after {
    content: '‹';
  }
  .verb {
    font-style: italic;
    font-size: clamp(1.25rem, 1.6vw, 1.625rem);
    margin: var(--sp-2) 0 var(--sp-1);
  }
  .plain {
    font-family: var(--font-ui);
    font-size: var(--fs-ui);
    line-height: 1.85;
    max-width: 48rem;
    margin: 0 0 var(--sp-3);
  }
  .tools {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .tools li {
    margin: 0;
  }
  .tools a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sp-1);
    min-height: 40px;
    padding: var(--sp-1) var(--sp-2);
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-read);
    font-size: 1.125rem;
  }
  .tools a:hover {
    background: rgb(255 255 255 / 0.16);
  }
  [data-c='c3'] .tools a:hover {
    background: rgb(27 27 27 / 0.1);
  }
  .tools small {
    font-family: var(--font-ui);
    font-size: var(--fs-xs);
  }
  .open {
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    color: inherit;
    text-underline-offset: 4px;
  }

  /* Large screens: folders open one at a time. The first (Reflection) is open until you point at another. */
  @media (min-width: 48rem) and (hover: hover) {
    .fold + .fold {
      margin-top: 0;
    }
    .body {
      height: 146px;
      overflow: hidden;
      transition: height var(--t-slow) var(--ease);
    }
    .more {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s var(--ease);
    }
    .fold:hover .body,
    .fold:focus-within .body,
    .stack ol:not(:hover):not(:focus-within) .first .body {
      height: 396px;
    }
    .fold:hover .more,
    .fold:focus-within .more,
    .stack ol:not(:hover):not(:focus-within) .first .more {
      opacity: 1;
      pointer-events: auto;
    }
    .fold:hover .chev::after,
    .fold:focus-within .chev::after,
    .stack ol:not(:hover):not(:focus-within) .first .chev::after {
      content: '⌄';
    }
    .fold.first .body {
      border-radius: var(--r-md) var(--r-md) 0 0;
    }
  }
  @media (max-width: 47.99rem) {
    .ftab {
      left: 0 !important;
    }
  }

  /* ---------- The idea ---------- */
  .idea {
    background: var(--r);
    color: #fff;
    padding: var(--sp-6) var(--gutter) var(--sp-8);
    margin-top: -1px;
    --focus: #fff;
  }
  .idea > * {
    max-width: 64rem;
  }
  .idea h2 {
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 3rem);
    margin-bottom: var(--sp-3);
  }
  .idea p {
    font-size: var(--fs-lead);
    margin-bottom: var(--sp-4);
  }
  .idea a {
    color: inherit;
  }
  .starts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-3);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
  }
  .starts li {
    margin: 0;
  }
  .starts a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .body,
    .more {
      transition: none;
    }
  }
</style>
