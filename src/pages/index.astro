---
import BaseLayout from '../layouts/BaseLayout.astro';
import VennHero from '../components/VennHero.astro';
import { files, fileNo } from '../data/components';
import { railFor } from '../data/rail';
import { intro } from '../data/site';
import { url } from '../utils/url';

// The home page (D41, D44): the kit's name and the circles, then the five files as a stack of folders.
// A folder opens when you point at it, tap its "Show what's inside" button, or reach it with the keyboard;
// one is open at a time, Reflection first. Without JavaScript every folder is simply open.
const lefts = ['2%', '22%', '40%', '12%', '30%'];
const stack = [...files].reverse().map((f) => ({
  ...f,
  left: lefts[f.file - 1],
  tools: railFor(f.id).items.filter((i) => !i.slug.startsWith('reflect-')),
}));
---

<BaseLayout theme="night">
  <section class="hero" aria-labelledby="hero-h">
    <div class="copy">
      <p class="kick">A toolkit for designing in India</p>
      <h1 id="hero-h">Beyond the Edge Case</h1>
      <p class="sub">Find the people a product treats as exceptions, and ask <em>what made them exceptions in the first place</em>.</p>
      <div class="cta">
        <a class="btn btn--light" href={url('/components/reflection/')}>Start with File 01 →</a>
        <a class="btn btn--ghost-light" href={url('/components/')} data-finder-open>Find a tool</a>
      </div>
      <p class="hint">Five files. Each works on its own. Pick a circle, or open a folder below.</p>
    </div>
    <div class="art">
      <VennHero />
    </div>
  </section>

  <section class="stack-wrap" aria-labelledby="files-h">
    <h2 id="files-h" class="files-h">The five files</h2>
    <ol class="stack" data-stack>
      {
        stack.map((f) => (
          <li class:list={['fold', { open: f.file === 1 }]} data-c={f.c} data-fold>
            <a class="ftab" href={url(f.href)} style={`left:${f.left}`}>
              <svg viewBox="0 0 300 66" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0,66 C26,66 30,0 62,0 H238 C270,0 274,66 300,66 Z" />
              </svg>
              <span class="tno">{fileNo(f)}</span>
              <span>
                {f.name.startsWith('Reading ') && <span class="rd">Reading </span>}
                {f.name.replace('Reading ', '')}
              </span>
            </a>
            <div class="body">
              <button type="button" class="ftog" aria-expanded={f.file === 1 ? 'true' : 'false'} aria-controls={`fold-${f.id}`} data-fold-toggle>
                <span class="vs">“{f.verb}”</span>
                <span class="act">
                  <span class="act-open">Show what’s inside</span>
                  <span class="act-close">Hide</span>
                  <span class="chev" aria-hidden="true" />
                </span>
              </button>
              <div class="more" id={`fold-${f.id}`}>
                <div class="more-in">
                  <p class="plain">{f.plain}</p>
                  <p class="tl">Its steps</p>
                  <ul class="tools">
                    {f.tools.map((t) => (
                      <li>
                        <a href={url(t.href)}>
                          {t.label}
                          {t.meta && <small>{t.meta}</small>}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="btn open-f" href={url(f.href)}>
                    Open file {fileNo(f)} →
                  </a>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="idea" aria-labelledby="idea-h">
    <h2 id="idea-h">{intro.central}</h2>
    <p>
      Design often starts from one default user. In India, one person may use the same product across different languages, networks,
      budgets and kinds of help. <em>Unusual to the system is not unusual to the person.</em>
    </p>
    <ul class="starts">
      <li><a class="btn" href={url('/guideline/')}>How to use the kit</a></li>
      <li><a class="btn btn--outline" href={url('/ask/')} data-ask-open>Ask a question</a></li>
      <li><a class="btn btn--outline" href={url('/about/')}>Why the kit exists</a></li>
    </ul>
  </section>
</BaseLayout>

<script>
  // Folders: one open at a time. Hover opens on devices that can hover; the button opens on tap, click or keyboard.
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  if (stack) {
    document.documentElement.classList.add('js-folders');
    const folds = [...stack.querySelectorAll<HTMLElement>('[data-fold]')];
    const set = (f: HTMLElement | null) =>
      folds.forEach((x) => {
        const on = x === f;
        x.classList.toggle('open', on);
        x.querySelector('[data-fold-toggle]')?.setAttribute('aria-expanded', String(on));
      });
    const canHover = matchMedia('(hover: hover) and (pointer: fine)');
    let timer = 0;
    folds.forEach((f) => {
      const b = f.querySelector<HTMLButtonElement>('[data-fold-toggle]');
      b?.addEventListener('click', () => set(f.classList.contains('open') ? null : f));
      f.addEventListener('mouseenter', () => {
        if (!canHover.matches) return;
        clearTimeout(timer);
        timer = window.setTimeout(() => set(f), 120);
      });
      f.addEventListener('focusin', (e) => {
        if ((e.target as HTMLElement).closest('.more')) set(f);
      });
    });
    stack.addEventListener('mouseleave', () => clearTimeout(timer));
  }
</script>

<style>
  /* ---------- Hero: words on the left, the circles on the right ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: center;
    max-width: 92rem;
    margin: 0 auto;
    padding: clamp(var(--sp-6), 7vw, var(--sp-12)) var(--gutter) var(--sp-6);
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--sp-8);
    }
  }
  .kick {
    margin: 0 0 var(--sp-2);
    font-weight: 800;
    font-size: var(--fs-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-night-soft);
  }
  .hero h1 {
    font-size: var(--fs-display);
    line-height: 0.95;
    color: var(--on-night);
    margin: 0 0 var(--sp-3);
    max-width: 12ch;
  }
  .sub {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--on-night-soft);
    max-width: 34rem;
    margin: 0 0 var(--sp-4);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .hint {
    margin: var(--sp-3) 0 0;
    font-size: var(--fs-sm);
    color: var(--on-night-soft);
  }
  .art {
    display: flex;
    justify-content: center;
  }

  /* Buttons on the dark page */
  :global(.btn--light) {
    background: var(--on-night);
    border-color: var(--on-night);
    color: var(--ink);
  }
  :global(.btn--light:hover) {
    background: #fff;
    border-color: #fff;
    color: var(--ink);
  }
  :global(.btn--ghost-light) {
    background: transparent;
    border-color: var(--on-night);
    color: var(--on-night);
  }
  :global(.btn--ghost-light:hover) {
    background: var(--on-night);
    border-color: var(--on-night);
    color: var(--ink);
  }

  /* ---------- The stack of folders ---------- */
  .stack-wrap {
    max-width: 92rem;
    margin: 0 auto;
    padding: var(--sp-6) var(--gutter) 0;
  }
  .files-h {
    color: var(--on-night);
    margin-bottom: calc(66px + var(--sp-2));
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fold {
    position: relative;
    margin: 0;
    color: var(--accent-ink);
    --focus: currentColor;
  }
  .ftab {
    position: absolute;
    bottom: 100%;
    height: 62px;
    padding: 0 clamp(var(--sp-4), 4vw, 60px);
    margin-bottom: -2px;
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    color: inherit;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.125rem, 1.8vw, 1.625rem);
    white-space: nowrap;
    text-decoration: none;
    z-index: 1;
  }
  .ftab svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: var(--accent);
  }
  .ftab span {
    position: relative;
  }
  .tno {
    font-family: var(--font-ui);
    font-size: 0.8em;
    font-weight: 800;
    opacity: 0.85;
  }
  .ftab:hover > span:last-child {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }
  .body {
    position: relative;
    background: var(--accent);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    padding: var(--sp-2) clamp(var(--sp-2), 4vw, 56px) calc(62px + var(--sp-3));
    box-shadow: 0 -10px 24px -18px rgb(0 0 0 / 0.6);
    transition: filter var(--t-med) var(--ease);
  }
  .fold:hover .body,
  .fold:hover .ftab svg {
    filter: brightness(1.06);
  }
  .fold:last-child .body {
    padding-bottom: var(--sp-5);
  }
  .ftog {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
    width: 100%;
    min-height: 48px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .vs {
    font-style: italic;
    font-weight: 600;
    font-size: var(--fs-lead);
  }
  .act {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    min-height: 40px;
    padding: 0 var(--sp-2);
    border: 2px solid currentColor;
    border-radius: 999px;
    font-weight: 800;
    font-size: var(--fs-sm);
  }
  .ftog:hover .act {
    background: rgb(255 255 255 / 0.16);
  }
  [data-c='c3'] .ftog:hover .act {
    background: rgb(27 27 27 / 0.1);
  }
  .chev {
    width: 10px;
    height: 10px;
    border-right: 2.5px solid currentColor;
    border-bottom: 2.5px solid currentColor;
    transform: rotate(45deg) translateY(-3px);
    transition: transform var(--t-med) var(--ease);
  }
  .act-close {
    display: none;
  }
  .fold.open .act-open {
    display: none;
  }
  .fold.open .act-close {
    display: inline;
  }
  .fold.open .chev {
    transform: rotate(-135deg) translateY(-3px);
  }

  /* Opening: the folder's contents slide down (grid rows animate from 0 to their full height) */
  .more {
    display: grid;
    grid-template-rows: 1fr;
  }
  .more-in {
    min-height: 0;
    overflow: hidden;
  }
  :global(.js-folders) .more {
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--t-slow) var(--ease);
  }
  :global(.js-folders) .more-in {
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  :global(.js-folders) .fold.open .more {
    grid-template-rows: 1fr;
  }
  :global(.js-folders) .fold.open .more-in {
    opacity: 1;
  }
  :global(html:not(.js-folders)) .act {
    display: none;
  }
  .plain {
    margin-top: var(--sp-2) !important;
    font-size: var(--fs-body);
    max-width: 46rem;
    margin: 0 0 var(--sp-3);
  }
  .tl {
    margin: 0 0 var(--sp-1);
    font-weight: 800;
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .tools {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
  }
  .tools li {
    margin: 0;
  }
  .tools a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sp-1);
    min-height: 40px;
    padding: var(--sp-1) var(--sp-2);
    border: 2px solid currentColor;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    font-weight: 700;
  }
  .tools a:hover {
    background: rgb(255 255 255 / 0.16);
  }
  [data-c='c3'] .tools a:hover {
    background: rgb(27 27 27 / 0.1);
  }
  .tools small {
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .open-f {
    margin-bottom: var(--sp-1);
    background: var(--accent-ink);
    border-color: var(--accent-ink);
    color: var(--accent);
  }
  .open-f:hover {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
    color: var(--accent);
    opacity: 0.9;
  }
  [data-c='c3'] .open-f {
    color: var(--c3-tint);
  }
  @media (max-width: 47.99rem) {
    .ftab {
      left: 0 !important;
      padding: 0 var(--sp-3);
    }
  }
  /* Small phones: "Reading" drops from the tab so the name fits */
  @media (max-width: 30rem) {
    .rd {
      display: none;
    }
  }
  @media (max-width: 47.99rem) {
    .act-open {
      font-size: 0;
    }
    .act-open::after {
      content: 'Show';
      font-size: var(--fs-sm);
    }
  }

  /* ---------- The idea ---------- */
  /* The central line on paper, so it never runs into the red Reflection folder above it */
  .idea {
    background: var(--surface);
    color: var(--ink);
    padding: var(--sp-8) var(--gutter);
    --focus: var(--ink);
    --muted: #5f5c56;
  }
  .idea > * {
    max-width: 64rem;
    margin-left: auto;
    margin-right: auto;
  }
  .idea h2 {
    font-family: var(--font-read);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.875rem);
    line-height: 1.2;
    margin-bottom: var(--sp-3);
    padding-left: var(--sp-3);
    border-left: 6px solid var(--r);
  }
  .idea p {
    font-size: var(--fs-lead);
    margin-bottom: var(--sp-4);
  }
  .starts {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .starts li {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .more,
    .more-in,
    .ftab {
      transition: none !important;
    }
  }
</style>
